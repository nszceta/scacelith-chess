lesson.almost.2 = Ei aivan. Kokeile samaa siirtoa kuin esimerkissäni.
lesson.almost.3 = Lähellä. Muista, mitä juuri näytin.
# A wrong move without a line of its own.
lesson.try_again = Ei tuo. Yritä uudelleen.
lesson.try_again.2 = Ei tämä. Yritä vielä.
lesson.try_again.3 = Yritetään vielä kerran.
lesson.use_your = Käytä {your:part}.
lesson.use_your.2 = Kokeile {your:ade}.
lesson.watch = Katso.
lesson.like_this = Näin.
lesson.and_back = Ja takaisin.
# A check that is not checkmate (the coach then shows the escape).
