# Coach speech (Finnish): the rules lesson (level 0, src/coach/lesson.cpp).
# Same keys and variants as assets/coach/speech/en/lesson.lang.
#
# Placeholders: {your} / {my} = a piece of the player / of the coach, with the forms of common.lang
# ({my:acc} "lähettini", {your:part} "torniasi", {your:ade} "ratsullasi", {my:ill} "kuningattareeni"...);
# the pronoun for any piece is "se" ("Lyö se!"). {sq}, {sq2}, {to}, {esc} = squares, never inflected:
# "ruutuun {sq}", "ruudussa {sq}", "ruudusta {sq}". {move} = a move. {@}, {@2}, {@3} are invisible
# marks: the coach points at something while saying the word right after the mark. A ".spoken" key is
# what the voice says instead (here: letters said by their Finnish names, "aa", "hoo", "ee", "äl").
# Files = linjat, ranks = rivit, back rank = takarivi (glossary/fi.md).

# ---- Chapter titles (said inside "Jatketaan oppituntia: {chapter}.") ----------------------------------
# Nominative, lower case (see event.lesson.* in events.lang).
lesson.title.welcome = shakkilauta
lesson.title.pieces = miten nappulat liikkuvat
lesson.title.safety = turvalliset ja vaaralliset lyönnit
lesson.title.check = shakki
lesson.title.mate = matti
lesson.title.castling = linnoittautuminen
lesson.title.en_passant = ohestalyönti
lesson.title.promotion = sotilaan korotus
lesson.title.draws = patti ja tasapelit
lesson.title.before_move = katso ennen siirtoa
lesson.title.opening = avaus
lesson.title.etiquette = vahvuusluku, kello ja käytöstavat oikeissa peleissä

# ---- Lines every exercise uses ------------------------------------------------------------------------
