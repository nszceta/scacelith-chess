ex.stalemate_trick.b1.2 = Varo: {my} on melkein jumissa. Voin saada tasapelin.
ex.stalemate_trick.b2 = Varovasti: voin uhrata, ja {my} jäisi pattiin.
ex.stalemate_trick.b2.2 = {my:ade} ei ole juuri yhtään ruutua. Voin pakottaa patin!
ex.stalemate_trick.b3 = Tämän jälkeen pelastun patilla: {my:abl} loppuvat siirrot.
ex.stalemate_trick.b3.2 = Varovasti: jatkon {line} jälkeen {my} on patissa.
ex.stalemate_trick.b4 = {move} sallii pattikikan: {line}, eikä {my} voi liikkua.
ex.stalemate_trick.b4.2 = Nyt {my} voi piiloutua pattiin: {line}.
ex.stalemate_trick.b5 = {move} sallii patin: {line}; {my} on saarrettu.
ex.stalemate_trick.b5.2 = Pattikikka: {line}, eikä {my:ade} ole siirtoja.
ex.stalemate_trick.b6 = {line}, patti: {my} on saarrettu.
ex.stalemate_trick.b6.2 = Patti jatkon {line} jälkeen; {my} on jumissa.

