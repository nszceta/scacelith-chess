ex.verdict.blunder.b1.2 = Varovasti! Tuo siirto voi tulla kalliiksi.
ex.verdict.blunder.b1.3 = Oho, hetkinen. Tuossa siirrossa on ongelma.
ex.verdict.blunder.b2 = Hmm, tuossa siirrossa on ongelma.
ex.verdict.blunder.b2.2 = Tämä on paha virhe.
ex.verdict.blunder.b2.3 = Varovasti, tuo siirto maksaa sinulle jotain.
ex.verdict.blunder.b3 = Se on vakava virhe.
ex.verdict.blunder.b3.2 = {move} on todellinen virhe.
ex.verdict.blunder.b3.3 = Auts, {move} on iso virhe.
ex.verdict.blunder.b4 = {move} on vakava virhe.
ex.verdict.blunder.b4.2 = {move} on raskas virhe.
ex.verdict.blunder.b4.3 = Se on valitettavasti vakava virhe.
ex.verdict.blunder.b5 = {move} on raskas virhe.
ex.verdict.blunder.b5.2 = {move} on vakava virhe.
ex.verdict.blunder.b5.3 = {move} on kallis virhe.
ex.verdict.blunder.b6 = {move} on raskas virhe.
ex.verdict.blunder.b6.2 = {move} on vakava virhe.
ex.verdict.blunder.b6.3 = {move}? Vakava virhe.
# A blunder that leaves the coach's threat standing (levels 1-2: the threat the engine found after the
# coach's last move is what the reply carries out).
ex.verdict.ignored.b1 = Hups! Et vastannut uhkaani.
ex.verdict.ignored.b1.2 = Varovasti! Uhkani oli yhä voimassa.
ex.verdict.ignored.b1.3 = Oho, hetkinen. Unohdit uhkani.
ex.verdict.ignored.b2 = Hmm, uhkani oli yhä voimassa.
ex.verdict.ignored.b2.2 = Jätit uhkani torjumatta.
ex.verdict.ignored.b2.3 = Varovasti, et vastannut uhkaani.
ex.verdict.mistake.b3 = Tuo ei ole hyvä siirto.
ex.verdict.mistake.b3.2 = Hmm, siirrossa {move} on ongelma.
ex.verdict.mistake.b3.3 = Se on virhe.
ex.verdict.mistake.b4 = {move} on virhe.
ex.verdict.mistake.b4.2 = {move} ei ole hyvä.
ex.verdict.mistake.b4.3 = Tuo on virhe.
ex.verdict.mistake.b5 = {move} on selvä virhe.
ex.verdict.mistake.b5.2 = {move} on virhe.
ex.verdict.mistake.b5.3 = {move} ei ole hyvä.
ex.verdict.mistake.b6 = {move} on virhe.
ex.verdict.mistake.b6.2 = {move}? Virhe.
ex.verdict.mistake.b6.3 = Ei {move}.
# A dubious move (an inaccuracy; a costly move with nothing concrete to show while still better):
# only the better move is named ({best} is pointed at), never a scenario.
ex.verdict.inaccuracy.b3 = Ei huono, mutta {best} oli vähän parempi.
ex.verdict.inaccuracy.b3.2 = {best} oli hieman tarkempi.
ex.verdict.inaccuracy.b3.3 = Pieni lipsahdus: {best} oli tässä parempi.
ex.verdict.inaccuracy.b4 = Epätarkka: {best} oli tarkempi.
ex.verdict.inaccuracy.b4.2 = Pieni epätarkkuus. {best} oli vähän parempi.
ex.verdict.inaccuracy.b4.3 = Ei aivan paras: {best} oli tarkempi.
ex.verdict.inaccuracy.b5 = {move} on epätarkka; {best} oli vahvempi.
ex.verdict.inaccuracy.b5.2 = Hieman epätarkka. Olisin pelannut siirron {best}.
ex.verdict.inaccuracy.b5.3 = {best} oli tarkempi kuin {move}.
ex.verdict.inaccuracy.b6 = {move} on epätarkka; {best}.
ex.verdict.inaccuracy.b6.2 = Epätarkka. {best}.
ex.verdict.inaccuracy.b6.3 = {best} oli parempi.
# Level 6, an inaccuracy at the bottom of its class (deeper searches often clear it): a hedged word.
ex.verdict.inaccuracy.maybe = {best} olisi ehkä ollut hieman tarkempi.
ex.verdict.inaccuracy.maybe.2 = Olisin ehkä pelannut siirron {best}.
# A dubious move that loses material (levels 3-6): the remark alone, never "a bit better" (at level 6
# under 6 points, the hedged word above unless a piece is lost).
ex.verdict.dubious = Tuo siirto näyttää kyseenalaiselta.
ex.verdict.dubious.2 = Tuo siirto vaikuttaa kyseenalaiselta.
# Something good was missed (levels 1-2).
ex.verdict.missed.b1 = Hetkinen! Sinulta jäi huomaamatta jotain hyvää.
ex.verdict.missed.b1.2 = Katso uudestaan! Tarjolla oli jotain parempaa.
ex.verdict.missed.b1.3 = Odota, sinulla oli tuossa tilaisuus!
ex.verdict.missed.b2 = Tuossa sinulta meni tilaisuus ohi.
ex.verdict.missed.b2.2 = Hmm, tarjolla oli jotain parempaa.
ex.verdict.missed.b2.3 = Odota, sinulla oli tuossa hieno siirto.

# ---- The better move (levels 3-6; {best} is pointed at) ----------------------------------------
