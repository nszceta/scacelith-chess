ex.better.b3.2 = {best} oli parempi siirto.
ex.better.b3.3 = Sen sijaan {best} oli hyvä.
ex.better.b4 = {best} oli vahvempi.
ex.better.b4.2 = {best} oli oikea siirto.
ex.better.b4.3 = Parempi oli {best}.
ex.better.b5 = {best}, ideana {line}.
ex.better.b5.2 = Oikea siirto oli {best}: {line}.
ex.better.b5.3 = Parempi oli {best}, ja sen jälkeen {line}.
ex.better.b6 = {best}: {eval}.
ex.better.b6.2 = Sen sijaan {best}, {eval}.
ex.better.b6.3 = {best} oli {eval}.

