# Coach speech (Finnish): the review of the player's moves (src/coach/review.cpp, review_explain.cpp).
# Same keys and variants as assets/coach/speech/en/review.lang (its header documents every placeholder).
#
# Register: the coach says "sinä" in standard Finnish (no colloquial forms), drops subject pronouns.
# Finnish has no grammatical gender: nothing agrees with the player or the coach.
# Pieces carry their possessive suffix ({your} = "ratsusi", {my:part} = "lähettiäni"); the forms
# (nom gen acc part ine ela ill ade abl all) are in common.lang. "It" for a piece is se / sen / sitä.
# Objects: "uhata" and negated verbs take the partitive ({t1:part}); "lyödä", "voittaa", "menettää"
# take the accusative ({your:acc}); "X had a move" = "{your:ade} oli siirto".
# Squares, moves and lines never take an ending: "ruutuun {sq}", "ruudussa {sq}", "ruudusta {sq}",
# "siirrolla {best}", "siirron {reply} jälkeen", "jatkon {line} jälkeen" (after the line).
# Counted numbers: {m:move_ine} "kolmessa siirrossa" (mate in 3: "matti {m:move_ine}"), {pts:point_acc}
# "kolme pistettä" (object), {pts:point_ade} "kolmella pisteellä tappiolla" (down), {n:point_gen}
# "viiden pisteen arvoinen" (worth), {n:time} "kolme kertaa", {n:piece} "kaksi nappulaa".
# Terms (glossary): vakava virhe (blunder), virhe, epätarkkuus, haarukka, kiinnitys, varras,
# paljastettu hyökkäys, patti, takarivi, pakoruutu, vapaasotilas, oppositio, lähettipari, neliö
# (the square of the pawn). "Falls" = "kaatuu".

# ---- Announcements (either side's move) -------------------------------------------------------
# The player gives check (levels 1-2: say what it means).
ann.check.human.b1 = Shakki! Kuninkaani on uhattuna.
ann.check.human.b1.2 = Shakki! Uhkaat kuningastani.
ann.check.human.b1.3 = Se on shakki! Kuninkaani on päästävä siitä pois.
ann.check.human = Shakki.
ann.check.human.2 = Shakki!
ann.check.human.3 = Ja se on shakki.
# The coach gives check.
ann.check.coach = Shakki!
ann.check.coach.2 = Shakki.
ann.check.coach.3 = Ja shakki!
# Once per game at levels 1-2, right after the coach's first check ({your} = the player's king).
ann.check.coach.first = Se tarkoittaa, että {your} on uhattuna. Sinun täytyy saada se pois shakista.
ann.check.coach.first.2 = Shakki tarkoittaa, että {your} on uhattuna. Siirrä sitä, laita nappula väliin tai lyö nappulani.
ann.double_check.coach = Kaksoisshakki! Kaksi nappulaani uhkaa kuningastasi yhtä aikaa, joten sen täytyy liikkua.
ann.double_check.coach.2 = Se on kaksoisshakki: nyt auttaa vain kuninkaan siirto.
ann.double_check.human = Kaksoisshakki! Kaksi nappulaasi uhkaa kuningastani yhtä aikaa, joten sen täytyy liikkua.
ann.double_check.human.2 = Kaksoisshakki! Vain kuninkaan siirto voi enää pelastaa minut.
# The player checkmates the coach.
ann.mate.human.b1 = Matti! Voitit! Kuninkaani ei pääse pakoon.
ann.mate.human.b1.2 = Se on matti! Hienoa, voitit pelin!
ann.mate.human.b1.3 = Matti! Kuninkaani on ansassa. Onneksi olkoon!
ann.mate.human = Matti. Hyvin pelattu.
ann.mate.human.2 = Se on matti. Onneksi olkoon.
ann.mate.human.3 = Matti! Hienosti tehty.
# The coach checkmates the player.
ann.mate.coach.b1 = Se on matti. Kuninkaallasi ei ole pakotietä.
ann.mate.coach.b1.2 = Matti. Kuninkaasi on uhattuna, eikä se pääse pakoon.
ann.mate.coach.b1.3 = Valitettavasti se on matti. Kuninkaasi ei pääse karkuun.
ann.mate.coach = Matti.
ann.mate.coach.2 = Ja se on matti.
ann.mate.coach.3 = Matti, valitettavasti.

