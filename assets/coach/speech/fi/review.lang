ex.stalemate.b5.2 = Patti: {my:ade} ei ole ruutuja.
ex.stalemate.b5.3 = Se on patti, {my} on jumissa.
ex.stalemate.b6 = Patti. {my:ade} ei ole siirtoja.
ex.stalemate.b6.2 = {move}, patti: {my} on saarrettu.
ex.stalemate.b6.3 = Patti; {my} ei voi liikkua.
ex.stalemate.tip.b1 = Kun olet voittamassa, jätä kuninkaalleni aina ruutu, johon liikkua.
ex.stalemate.tip.b1.2 = Muista: kun olet edellä, anna kuninkaalleni vähän tilaa.
