# Coach speech (Simplified Chinese, mainland): the appraisal after the game (src/coach/appraisal.cpp).
# Same keys and variants as assets/coach/speech/en/appraisal.lang. Subtitle text only: the voice
# speaks the English line of the same key and variant, so each variant translates its English twin.
# The ".spoken" key below is the English value, copied unchanged (never used).
# The appraisal is always positive and never blames.
#
# Placeholders: {moves} = full moves ("{moves}回合"); {n} = a move number ("第{n}回合") or a count;
# {crit_no} = a move number ("第{crit_no}回合"); {move} {crit_move} {crit_best} = moves ("♘f3");
# {my} = a piece of the coach's, owner included ("我的马"); {n:piece} = "3个子", {m:time} = "2次",
# {n:move} = "3步", {n:mistake} = "1步错着" ... (count.* in common.lang); {pts} = points of material;
# {acc} {acc_coach} {acc_phase} = whole percentages, written "72%"; {eval} = "+1.3";
# {opening} = the opening's name (assets/coach/openings/zh-Hans.lang); {text} = appraisal.phase.*
# ("你在{text}下得非常好") or appraisal.reason.* ("{text}和棋", "{text}成和"); {theme} = theme.*,
# always after a colon ("可以练习的一点：{theme}。"); {level} = appraisal.level.*, in quotes
# ("试试“{level}”"), the names of coach.level.*.name in assets/i18n/zh-Hans.lang.
# Move numbers: 第…回合, as in the opening texts. Out of book: 脱谱 / 离开开局理论.

# ---- Names used inside the lines ------------------------------------------------------------------
