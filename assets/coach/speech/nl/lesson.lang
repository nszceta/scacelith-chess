# Coach speech (Dutch): the rules lesson (level 0, src/coach/lesson.cpp).
# Same keys and variants as assets/coach/speech/en/lesson.lang.
#
# Placeholders: {your} / {my} = a piece of the player / of the coach ("je toren", "mijn paard"), with
# the forms of common.lang: {your:subj} = hij / het / ze, {my:obj} = hem / het / haar, {my:poss} =
# zijn / haar, so that every sentence fits whatever piece the program passes.
# {sq}, {sq2}, {to}, {esc} = squares; {move} = a move. {@}, {@2}, {@3} are invisible marks: the coach
# points at something while saying the word right after the mark.
# A ".spoken" key is what the voice says instead (here: the letters a, e, h and L said by their names).
# Terms: file = lijn, rank = rij, back rank = achterste rij (KNSB usage, as the glossary).

# ---- Chapter titles (said inside "We gaan verder met {chapter}.") ------------------------------------
# Lower-case noun phrases that fit after "met", "bij" and a colon (event.lesson.* in events.lang).
lesson.title.welcome = het schaakbord
lesson.title.pieces_lines = de zetten van de toren, de loper en de dame
lesson.title.pieces_steps = de zetten van de koning, het paard en de pion
lesson.title.values_setup = de waarde van de stukken en de eerste zetten
lesson.title.safety = veilig en onveilig slaan
lesson.title.check = schaak geven
lesson.title.mate = mat zetten
lesson.title.castling = de rokade
lesson.title.en_passant = en passant slaan
lesson.title.promotion = promotie
lesson.title.draws = pat en remise
lesson.title.before_move = kijken voor je zet
lesson.title.opening = de opening
lesson.title.review = een korte herhaling
lesson.title.etiquette = de afspraken bij onze partijen

# ---- Lines every exercise uses ------------------------------------------------------------------------
# After the coach demonstrated the solution.
lesson.now_you = Probeer het nu zelf.
lesson.now_you.2 = Nu is het jouw beurt.
lesson.now_you.3 = Nu jij.
# Another wrong move after the demonstration.
lesson.almost = Bijna! Speel de zet die ik je liet zien.
lesson.almost.2 = Niet helemaal. Probeer de zet uit mijn voorbeeld.
lesson.almost.3 = Dichtbij. Denk aan wat ik je net liet zien.
# A wrong move without a line of its own.
lesson.try_again = Dat is het niet. Probeer het nog eens.
lesson.try_again.2 = Deze niet. Probeer het opnieuw.
lesson.try_again.3 = Laten we het nog een keer proberen.
lesson.use_your = Gebruik {your}.
lesson.use_your.2 = Probeer het met {your}.
lesson.watch = Kijk goed.
lesson.like_this = Zo gaat dat.
lesson.and_back = En weer terug.
# A check that is not checkmate (the coach then shows the escape).
lesson.check_escape = Schaak, maar mijn koning ontsnapt naar {esc}.
lesson.check_takes = Schaak, maar mijn koning slaat gewoon {your}.
lesson.check_block = Schaak, maar ik kan er een stuk tussen zetten.
lesson.stalemate = Pat! Mijn koning kan niet bewegen en staat niet schaak. Remise, terwijl je gewonnen stond!

# ---- Why a move is not allowed (the coach points at the piece or square in question) ----------------
# {sq} = the square in question, {my} = the coach's piece that attacks, pins, blocks or gives
# check, {your} = the piece the player tried to move.
why.KingIntoCheck = Niet naar {sq}: {my} valt dat veld aan. Een koning gaat nooit naar een aangevallen veld.
why.PathBlocked = Er staat iets in de {@}weg: stukken kunnen niet springen, behalve het paard.
why.WrongGeometry = Zo beweegt {your} niet.
why.MustAnswerCheck = Je staat {@}schaak: dat moet je eerst opheffen.
why.CastlingThroughCheck = Je koning zou over {sq} gaan, en {my} valt dat veld aan.
why.CastlingNoRights = Die koning of die toren heeft al bewogen: rokeren mag niet meer.
why.CastlingBlocked = Voor de rokade moeten de velden tussen de koning en de toren leeg zijn.
why.CastlingOutOfCheck = Je mag niet rokeren als je schaak staat.
why.PawnForwardBlocked = Pionnen kunnen niet recht vooruit slaan: dat veld is {@}geblokkeerd.
why.LeavesKingInCheck = {your} staat gepend: als je {your:obj} verplaatst, staat je koning schaak door {my}.
why.OwnPieceOnTarget = Je kunt niet op je eigen stuk gaan staan.
why.PawnCaptureNeedsVictim = Een pion gaat alleen schuin als hij slaat.
why.EnPassantExpired = En passant slaan mag alleen direct na de dubbele stap van de pion.
why.NotYourTurn = Wacht even: ik ben aan zet.

# ---- Chapter 0: welcome and the board -------------------------------------------------------------------
lesson.welcome.hello = Hallo! Ik ben je coach. Laten we samen de schaakregels leren, stap voor stap.
lesson.welcome.board = Dit is het schaakbord: vierenzestig velden, licht en donker, acht bij acht.
lesson.welcome.light = Het hoekveld aan je {@}rechterkant is altijd een licht veld. Onthoud: rechtsonder licht.
# Dutch "rij" is already the plain word for a row, so the lines say what the ranks are, not what
# they are called.
lesson.welcome.files = De kolommen heten lijnen. Ze hebben letters, van {@}a tot {@2}h.
lesson.welcome.files.spoken = De kolommen heten lijnen. Ze hebben letters, van {@}aa tot {@2}ha.
lesson.welcome.ranks = De rijen lopen van links naar rechts. Ze hebben cijfers, van {@}één tot {@2}acht, te beginnen aan jouw kant.
lesson.welcome.square = Elk veld heeft een naam: eerst de letter, dan het cijfer. Dit veld is {sq}.
lesson.welcome.square2 = En dit is {sq}.
lesson.welcome.kings = Dit zijn de twee koningen. De jouwe staat op {sq}, de mijne op {sq2}.
lesson.welcome.ask = Jouw beurt: zet je koning één veld vooruit, naar {sq}.
lesson.welcome.wrong = Dat is {to}. We moeten naar {sq}: letter e, cijfer twee.
lesson.welcome.wrong.spoken = Dat is {to}. We moeten naar {sq}: letter ee, cijfer twee.
lesson.welcome.ok = Perfect. Je koning staat op {sq}.

# ---- Chapter 1: how the pieces move and capture -----------------------------------------------------------
# Rook
lesson.rook.intro = Dit is {your}. {your:subj} beweegt in rechte banen, over lijnen en rijen, zo ver als je wilt.
lesson.rook.lines = Omhoog over de lijn, {@}of opzij over de rij.
lesson.rook.capture = Slaan doe je door op het veld van een {@}vijandelijk stuk te gaan staan. Dat stuk gaat dan van het bord.
lesson.rook.ask = Sla {my} met je toren!
lesson.rook.short = Goede richting! Ga verder de lijn op, helemaal tot {my}.
lesson.rook.rank = Dat gaat over de rij. {my} staat hogerop, op de lijn.
lesson.rook.king = Dat is je koning. Gebruik {your}, in de hoek.
lesson.rook.ok = Geslagen! {my} gaat van het bord.
# Pieces don't jump
lesson.jump.blocked = Stukken kunnen niet over andere stukken heen springen. Je pion op {sq} verspert de toren de weg.
lesson.jump.all = Voor de loper en de dame is het hetzelfde: ook zij kunnen niet over stukken heen springen.
# Bishop
lesson.bishop.intro = Dit is {your}. {your:subj} beweegt schuin, zo ver als je wilt.
lesson.bishop.colour = Een loper blijft altijd op velden van dezelfde kleur.
lesson.bishop.ask = {my} staat op de diagonaal van je loper. Sla {my:obj}!
lesson.bishop.short = Goede diagonaal! Ga verder, tot je bij {my} bent.
lesson.bishop.other = Dat is de andere diagonaal. Kijk in de richting van {my}.
lesson.bishop.ok = Uitstekend. Lopers houden van lange diagonalen.
# Queen
lesson.queen.intro = Dit is {your}, het sterkste stuk. {your:subj} beweegt als een toren en een loper samen.
lesson.queen.ask = Zoek {my} en sla {my:obj} met je dame.
lesson.queen.wrong = Je dame kan {my} in één zet bereiken, over een diagonaal.
lesson.queen.ok = Goed gedaan! Houd je dame veilig: ze is veel waard.
# King
lesson.king.intro = De koning beweegt maar één veld, in alle richtingen.
lesson.king.important = De koning is het belangrijkste stuk. Als hij gevangen zit, is de partij verloren.
lesson.king.ask = De koning kan ook slaan. Sla {my}!
lesson.king.wrong = Je koning staat vlak naast {my}. Ga op {my:poss} veld staan om {my:obj} te slaan.
lesson.king.ok = Goed! De koning is langzaam, maar van dichtbij sterk.
# Knight
lesson.knight.intro = Dit is {your}. {your:subj} beweegt in de vorm van een L: twee velden rechtdoor, dan één opzij.
lesson.knight.intro.spoken = Dit is {your}. {your:subj} beweegt in de vorm van een el: twee velden rechtdoor, dan één opzij.
lesson.knight.l = Op {@}deze manier. Het paard komt altijd terecht op een veld van de andere kleur.
lesson.knight.jump = Het paard is het enige stuk dat over andere stukken heen kan springen.
lesson.knight.ask = Sla {my} met je paard!
lesson.knight.wrong = Dat is een echte paardenzet, maar die komt niet bij {my}. Probeer een andere L.
lesson.knight.wrong.spoken = Dat is een echte paardenzet, maar die komt niet bij {my}. Probeer een andere el.
lesson.knight.ok = Mooie sprong!
# Pawn: moving
lesson.pawn.intro = Nu {your}. {your:subj} gaat recht vooruit, één veld per keer, en nooit achteruit.
lesson.pawn.first = Bij zijn eerste zet mag een pion één of twee velden vooruit.
lesson.pawn.ask = Zet je pion twee velden vooruit.
lesson.pawn.one = Dat is één veld: dat mag, maar ga deze keer twee velden vooruit.
lesson.pawn.use = Gebruik de pion.
lesson.pawn.ok = Goed.
# Pawn: capturing
lesson.pawncap.blocked = Mijn pion blokkeert de jouwe. Pionnen kunnen niet recht vooruit slaan.
lesson.pawncap.diagonal = Maar een pion slaat schuin, één veld vooruit.
lesson.pawncap.ask = Sla {my} met je pion.
lesson.pawncap.use = Gebruik {your}: {your:subj} slaat schuin vooruit.
lesson.pawncap.ok = Ja! Rechtdoor om te lopen, schuin om te slaan.
# Values, set-up and the first moves
lesson.values.pawn = Elk stuk heeft een waarde in punten. Een pion is één punt waard.
lesson.values.pieces = Een paard of een {@}loper: drie. Een {@2}toren: vijf. De {@3}dame: negen.
lesson.values.king = De koning is onbetaalbaar: die kun je nooit weggeven.
lesson.values.trade = Ruil geen groter stuk tegen een kleiner stuk, tenzij je meer wint dan je verliest.
lesson.values.two = Je paard valt twee stukken van mij aan: {sq} en {sq2}. Geen van beide wordt gedekt.
lesson.values.ask = Sla het stuk dat meer waard is!
lesson.values.small = Dat is een pion, één punt waard. {my} stond ook vrij, en {my:subj} is negen waard.
lesson.values.look = Kijk wat je paard aanvalt, en sla het stuk dat meer waard is.
lesson.values.ok = Ja! Een dame is negen waard. Als twee stukken vrijstaan, sla dan het grootste.
lesson.setup.corners = Elke partij begint zo: de torens in de {@}hoeken, dan de {@2}paarden, dan de {@3}lopers.
lesson.setup.queen = De dame staat op haar eigen kleur: je dame staat op een licht veld.
lesson.setup.king = De koning staat naast haar. Wit begint altijd.
lesson.first.ask = Begin de partij: zet de pion voor je koning twee velden vooruit, naar {sq}.
lesson.first.wrong = Dat is ook een legale zet! Maar speel nu even je koningspion naar {sq}.
lesson.first.ok = Een prima eerste zet: hij maakt de weg vrij voor je dame en je loper.
lesson.first.reply = Ik antwoord op dezelfde manier. Breng nu een paard in het spel: spring van {sq} naar {sq2}.
lesson.first.knight_wrong = Paarden springen over de pionnen heen. Probeer het van {sq} naar {sq2}.
lesson.first.knight_ok = Perfect. Paarden en lopers komen vroeg in het spel.

# ---- Chapter 2: safe and unsafe captures ---------------------------------------------------------------------
lesson.safety.defended = Een stuk is gedekt als een eigen stuk kan terugslaan.
lesson.safety.pawn = Mijn {@}pion dekt {my}.
lesson.safety.free = Maar {my} heeft geen verdediger. Je dame valt beide stukken aan.
lesson.safety.ask = Sla het ongedekte stuk!
lesson.safety.watch = Kijk wat er gebeurt.
lesson.safety.gave = Je hebt je dame, die negen waard is, gegeven voor mijn paard, dat drie waard is.
lesson.safety.other = Probeer het andere stuk.
lesson.safety.look = Zoek het stuk dat door niets gedekt wordt.
lesson.safety.ok = Uitstekend! Vraag je altijd af: is dat stuk gedekt?
lesson.safety.pawns = Je dame valt twee pionnen van mij aan: {sq} en {sq2}.
lesson.safety.pawns_ask = Sla de pion die je veilig kunt slaan.
lesson.safety.gave_pawn = Je hebt je dame, die negen waard is, gegeven voor een pion, die één waard is.
lesson.safety.pawns_other = Ook een pion kan gedekt zijn. Probeer de andere pion.
lesson.safety.pawns_ok = Juist! Riskeer je dame nooit voor een gedekte pion.
lesson.safety.small = Nu andersom. {my} is gedekt, maar je pion valt {my:obj} aan.
lesson.safety.small_count = Als je mijn dame slaat, slaat mijn {@}pion de jouwe terug. Jij geeft één punt en wint er negen.
lesson.safety.small_ask = Sla mijn dame met het juiste stuk!
lesson.safety.small_other = Sla mijn dame liever met je pion: het goedkoopste stuk dat dat kan.
lesson.safety.small_look = Je pion valt mijn dame aan. Sla haar daarmee.
lesson.safety.small_ok = Ja! Een klein stuk mag een groot stuk slaan, zelfs een gedekt stuk: je verliest één punt en wint er negen.
lesson.safety.count = Tel vóór elke slag wat je wint en wat je terug kunt verliezen.

# ---- Chapter 3: check and getting out of check -----------------------------------------------------------------
# "Het schaak opheffen" is the Dutch term for getting out of check.
lesson.danger.rank = Mijn toren beheerst de hele tweede rij.
lesson.danger.rule = Een koning mag nooit naar een veld waar hij geslagen kan worden.
lesson.danger.ask = Zet je koning op een veilig veld.
lesson.danger.ok = Juist. Daar staat je koning veilig.
lesson.check.what = Mijn toren valt je koning aan. Dat heet schaak.
lesson.check.must = Als je schaak staat, moet je het schaak meteen opheffen.
lesson.check.ways = Dat kan op drie manieren: {@}de koning verplaatsen, {@2}de aanval blokkeren, of {@3}de aanvaller slaan.
lesson.check.ask = Breng je koning hier uit het schaak.
lesson.check.file = {to} ligt nog op de lijn van {@}mijn toren. Stap van die lijn af.
lesson.check.ok = Goed: je staat niet meer schaak.
lesson.block.again = Weer schaak! Deze keer heeft je koning geen vrij veld.
lesson.block.ask = Blokkeer dan de aanval: zet er een stuk tussen.
lesson.block.queen = Dat blokkeert! Maar mijn toren zou je dame kunnen slaan. Blokkeer met een goedkoper stuk.
lesson.block.queen_ok = Het werkt. Onthoud: blokkeer met je goedkoopste stuk.
lesson.block.ok = Perfect. Blokkeer met je minst waardevolle stuk.
lesson.capture.check = Mijn dame geeft schaak, vlak naast je koning.
lesson.capture.ask = Sla de aanvaller!
lesson.capture.king_ok = Ja! Mijn dame had geen verdediger, dus je koning kon haar slaan.
lesson.capture.knight_ok = Ja! Je paard heeft de aanvaller uitgeschakeld.
lesson.check.open.ask = Weer schaak! Kom er deze keer op een manier uit die je zelf kiest.
lesson.check.open.king = Je hebt de koning weggezet. Je had ook een stuk ertussen kunnen zetten, of mijn toren met je paard kunnen slaan.
lesson.check.open.block = Je hebt de aanval geblokkeerd. Je koning had ook opzij kunnen stappen, of je paard had mijn toren kunnen slaan.
lesson.check.open.take = Je sloeg mijn toren, het stuk dat schaak gaf. De koning verplaatsen of blokkeren had ook gewerkt.
lesson.check.open.hint = Drie manieren: {@}de koning verplaatsen, {@2}blokkeren op de lijn, of {@3}mijn toren met je paard slaan.

# ---- Chapter 4: checkmate ------------------------------------------------------------------------------------
lesson.mate1.what = Schaakmat: de koning staat schaak en heeft geen uitweg. Daarmee is de partij gewonnen.
lesson.mate1.stuck = Mijn koning zit vast achter zijn {@}eigen pionnen.
lesson.mate1.ask = Zet me mat in één zet!
lesson.mate1.wrong = Bijna! Geef schaak op mijn achterste rij, waar mijn koning niet kan ontsnappen.
lesson.mate1.ok = Schaakmat! Dat is mat op de achterste rij. Onthoud het goed!
lesson.mate1.king = Je koning staat goed waar hij staat. Geef schaak met de toren.
lesson.mate1.why = Zie je? De toren bestrijkt mijn {@}hele achterste rij, en mijn {@2}eigen pionnen vullen de velden voor mijn koning.
lesson.mate2.ask = Je koning en je dame werken samen. Zet me mat in één zet.
lesson.mate2.wrong = Zoek een schaak dat mijn koning geen enkel veld laat.
lesson.mate2.ok = Schaakmat! Je koning dekt de dame, dus de mijne kan haar niet slaan.
lesson.mate2.ok_rank = Schaakmat op de achterste rij! Je koning bewaakt alle velden vóór de mijne.
lesson.mate2.king = Je koning bewaakt de velden naast de mijne. Laat hem daar staan en gebruik de dame.
lesson.mate2.half = Dat bewaakt {sq}, maar mijn koning kan nog naar {sq2}.
lesson.mate2.why = Zie je? Je dame bestrijkt {sq} en {sq2}, en je koning dekt de velden voor de mijne. Mijn koning kan nergens heen.
lesson.mate3.edge = Je toren op de zevende rij houdt mijn koning aan de rand.
lesson.mate3.ask = Gebruik nu {your} om mat te zetten.
lesson.mate3.free = Schaak, maar nu is de zevende rij vrij, en mijn koning ontsnapt.
lesson.mate3.takes = Mijn koning slaat gewoon je toren.
lesson.mate3.hint = Geef schaak op de achterste rij met de toren die de zevende rij niet bewaakt.
lesson.mate3.ok = Schaakmat! De twee torens werkten samen als een ladder.
lesson.mate3.why = Zie je? De ene toren sluit de {@}zevende rij af, en de andere geeft schaak op de {@2}achterste rij. Mijn koning kan nergens heen.
lesson.mate4.look = Schaak is niet altijd schaakmat. Laten we kijken wat er gebeurt.
lesson.mate4.ask = Geef mijn koning schaak met je toren.
lesson.mate4.king = Je koning blijft staan. Geef schaak met de toren.
lesson.mate4.wrong = Dat is geen schaak. Je toren kan mijn koning aanvallen vanaf de achterste rij.
lesson.mate4.ok = Ja, dat is schaak! Maar is het ook mat? Kijk maar.
lesson.mate4.after = Mijn pion op {sq} gaf mijn koning ruimte. Tel, voordat je een schaak viert, de velden die mijn koning nog kan gebruiken.
lesson.mate5.ask = Twee torenzetten geven schaak, en maar één is schaakmat. Tel de velden van mijn koning en kies dan.
lesson.mate5.king = Je koning dekt al {sq} en {sq2}. Laat hem staan en zet de toren.
lesson.mate5.wrong = Dat is geen schaak. Zoek een torenzet die mijn koning aanvalt.
lesson.mate5.hint = Je koning dekt {sq} en {sq2}. Welk torenschaak neemt ook {sq3} weg?
lesson.mate5.why = Zie je? De toren dekt {sq}, je koning dekt de andere twee velden, en mijn koning zit vast.
lesson.mate5.ok = Schaakmat! Je hebt de velden van mijn koning geteld: er was er geen meer over.

# ---- Chapter 5: castling ---------------------------------------------------------------------------------------
lesson.castle.what = Rokeren is een speciale zet die je koning in veiligheid brengt. Koning en toren bewegen samen.
lesson.castle.how = De {@}koning gaat twee velden naar een toren toe, en de {@2}toren springt naar de andere kant van de koning.
lesson.castle.ask = Raak altijd eerst de koning aan. Nu jij: doe de korte rokade, aan de koningskant.
lesson.castle.rook = Zo beweeg je alleen de toren. Om te rokeren zet je de koning twee velden naar de toren toe.
lesson.castle.long = Dat is de lange rokade, die mag ook! Rokeer deze keer naar de dichtstbijzijnde toren.
lesson.castle.one = Eén veld is een gewone koningszet. Bij het rokeren gaat de koning twee velden.
lesson.castle.other = Om te rokeren zet je de koning twee velden naar de toren op {sq}.
lesson.castle.ok = Gerokeerd! Je koning zit veilig weggestopt, en je toren staat klaar om mee te doen.
lesson.castle2.moved = Je kunt niet rokeren als je koning of die toren al eerder heeft bewogen.
lesson.castle2.attacked = Ook niet als je schaak staat, of als je koning over een aangevallen veld gaat of erop terechtkomt.
lesson.castle2.bishop = Mijn loper valt {sq} aan. Daarom mag je aan deze kant nu niet rokeren.
lesson.castle2.ask = Rokeer naar de andere kant.
lesson.castle2.other = Rokeer naar je andere toren, aan de damekant.
lesson.castle2.ok = Goed zo! Met de lange rokade komt je koning op {sq}.
lesson.ep0.rule = En passant begint met de dubbele stap. Alleen een pion die {@}nog op zijn plaats staat, mag twee velden. Een pion die {@2}al bewogen heeft, gaat één veld per keer.
lesson.ep0.ask = Zet een van je pionnen twee velden vooruit.
lesson.ep0.moved = Die pion heeft al bewogen, dus hij mag maar één veld. Gebruik een pion die nog op zijn plaats staat.
lesson.ep0.ok = Juist: alleen een pion op zijn beginveld mag twee velden.

# ---- Chapter 6: en passant ------------------------------------------------------------------------------------
lesson.ep.what = Er is een speciale manier waarop een pion kan slaan: en passant. Dat betekent "in het voorbijgaan".
lesson.ep.watch = Kijk naar mijn pion: hij gaat twee velden vooruit en komt vlak naast de jouwe te staan.
lesson.ep.how = Jouw pion mag hem slaan alsof hij maar één veld vooruit was gegaan: naar {sq}.
lesson.ep.now = Maar alleen nu meteen, bij deze zet. Sla en passant!
lesson.ep.gone = De kans is voorbij: en passant kan alleen meteen. Laten we het opnieuw proberen.
lesson.ep.ok = En passant! Mijn pion op {sq} gaat van het bord.
lesson.ep2.old = Mijn pion op {sq} staat al een tijdje naast de jouwe. Het is te laat om hem en passant te slaan.
lesson.ep2.watch = Kijk nu naar mijn andere pion.
lesson.ep2.ask = Twee pionnen van mij staan naast de jouwe, maar er is er maar één net twee velden gegaan. Sla die en passant!
lesson.ep2.push = Daarmee schuif je alleen je pion op. Sla de pion die net twee velden is gegaan.
lesson.ep2.wrong = Zoek de pion die net zijn dubbele stap deed, en sla hem en passant.
lesson.ep2.hint = Mijn pion op {sq} is net twee velden gegaan. Sla hem en passant, naar {sq2}.
lesson.ep2.ok = En passant! Mijn pion op {sq} kon niet geslagen worden: zijn kans was voorbij.

# ---- Chapter 7: promotion -------------------------------------------------------------------------------------
lesson.promo.what = Als een pion de laatste rij bereikt, promoveert hij: hij wordt een dame, toren, loper of paard.
lesson.promo.ask = Kies bijna altijd een dame. Promoveer nu je pion!
lesson.promo.under = Dat mag! Maar een dame is sterker. Laten we de dame kiezen.
lesson.promo.under_ok = Prima. Toch kiezen de meeste spelers de dame.
lesson.promo.push = Schuif je pion naar de laatste rij, naar {sq}.
lesson.promo.ok = Een nieuwe dame! Je kunt zelfs twee dames tegelijk hebben.
lesson.promo2.ask = Een pion kan ook promoveren door te slaan, schuin. Sla mijn toren en maak een dame!
lesson.promo2.push = Dat promoveert ook, maar mijn toren bewaakt {sq}. Kijk maar.
lesson.promo2.lost = Mijn toren sloeg je nieuwe stuk. Sla eerst mijn toren.
lesson.promo2.wrong = Daarmee sla je mijn toren niet. Je pion slaat schuin, op {sq}.
lesson.promo2.hint = Sla mijn toren met je pion, op {sq}: hij promoveert terwijl hij slaat.
lesson.promo2.ok = Geslagen en gepromoveerd! Een pion kan allebei in één zet.

# ---- Chapter 8: stalemate and draws -----------------------------------------------------------------------------
lesson.stale.what = Ik ben aan zet. Mijn koning staat niet schaak, maar {@}elk veld eromheen wordt aangevallen.
lesson.stale.draw = Ik heb geen enkele legale zet. Dat is pat, en de partij is remise.
lesson.stale2.ask = Pas op voor pat als je gewonnen staat. Zet me mat in één zet, zonder pat!
lesson.stale2.wrong = Zoek een schaak dat mijn koning geen veld laat. Pas op: een rustige zet kan mij pat zetten.
lesson.stale2.king = Je koning dekt al {sq} en {sq2}. Laat hem staan en gebruik de dame.
lesson.stale2.hint = Je koning dekt {sq} en {sq2}. Geef schaak langs de achterste rij, dan kan mijn koning nergens heen.
lesson.stale2.why = Zie je? Mijn koning staat schaak {@}en heeft geen vrij veld: dat is schaakmat. Zonder het schaak was het pat.
lesson.stale2.ok = Schaakmat! Laat de vijandelijke koning altijd een zet over, tenzij je mat zet.
lesson.draws.kings = Andere remises: als niemand nog mat kan zetten, zoals bij twee koningen alleen, is de partij remise.
lesson.draws.agree = Spelers kunnen ook samen remise afspreken.
lesson.draws.repeat = Ook bij drie keer dezelfde stelling, of na vijftig zetten zonder slaan of pionzet, is remise mogelijk.

# ---- Chapter 9: before you move (the safety habit) ---------------------------------------------------------------
lesson.before.habit = Sta voor elke zet even stil en kijk. Sterke spelers doen dat elke keer.
lesson.before.last = Eerste vraag: wat deed mijn laatste zet? Kijk maar.
lesson.before.threat = {my} valt {your} aan. Dat is een dreiging.
lesson.before.safe = Wegzetten is niet genoeg. Het nieuwe veld moet ook veilig zijn.
lesson.before.dodge.ask = Zet je paard op een veilig veld.
lesson.before.dodge.still = Je paard wordt nog steeds aangevallen. Kijk maar.
lesson.before.dodge.hint = Mijn pionnen bewaken {sq} en {sq2}. Kies een ander veld.
lesson.before.dodge.ok = Veilig! Je zag de dreiging en je controleerde het veld.
# A wrong move onto a guarded square ({my} guards {to}); the coach then takes the piece.
lesson.before.unsafe = Niet naar {to}, want {my} bewaakt dat veld. Kijk maar.
# Said after the coach took the piece, before the move is taken back.
lesson.before.lost = {your} is verloren. Eerst kijken, dan zetten.
lesson.before.again = Nog een keer, eerst mijn zet. Kijk maar.
lesson.before.free.ask = Kijk naar mijn laatste zet. Kun je iets gratis slaan?
lesson.before.free.missed = Kijk nog eens naar {my}. Wat kan {my:obj} slaan?
lesson.before.free.hint = {my} heeft geen verdediger. Je {@}pion kan {my:obj} slaan.
lesson.before.free.ok = Ja! Mijn loper stond vrij. Kijk altijd naar mijn laatste zet.
lesson.before.check.ask = Geef schaak, op een veld waar ik niet kan slaan.
lesson.before.check.wrong = Dat is geen schaak. Zoek een schaak vanaf een veilig veld.
lesson.before.check.hint = {my} bewaakt {sq}. Geef schaak vanaf een veilig veld.
lesson.before.check.ok = Mooi schaak! Je dame staat daar veilig.
lesson.before.done = Maak er een gewoonte van: eerst kijken, dan zetten.

# ---- Chapter 10: the opening ------------------------------------------------------------------------------------
lesson.opening.what = De opening is het begin van de partij. Een paar simpele regels helpen.
lesson.opening.goals = {@}Neem het centrum, {@2}breng paarden en lopers in het spel en {@3}rokeer vroeg.
lesson.opening.centre = De vier velden in het {@}midden vormen het centrum.
lesson.opening.pawn.ask = Zet een pion in het centrum: twee velden vooruit.
lesson.opening.pawn.one = Niet slecht, maar twee velden pakken meer van het centrum.
lesson.opening.pawn.knight = De paarden komen zo. Eerst een pion in het centrum.
lesson.opening.pawn.wrong = Gebruik de pion voor je koning of voor je dame.
lesson.opening.pawn.ok = Goed! Je pion neemt ruimte in het centrum.
lesson.opening.queen = Breng je dame niet te vroeg in het spel: mijn stukken zouden haar jagen.
lesson.opening.knight.ask = Breng een paard in het spel, richting het centrum.
lesson.opening.rim = Een paard op de rand bereikt weinig velden. Spring richting het centrum.
lesson.opening.bishop = Ontwikkelen, goed! Maar nu een paard.
lesson.opening.knight.ok = Goed! Vanaf daar houdt je paard het centrum in de gaten.
lesson.opening.later = Een paar zetten later: je paard en je {@}loper staan in het spel.
lesson.opening.twice = Zet niet twee keer met hetzelfde stuk zonder goede reden.
lesson.opening.castle.ask = De weg is vrij. Rokeer en breng je koning in veiligheid.
lesson.opening.castle.wrong = Je koning is klaar. Rokeer nu, zolang de weg vrij is.
lesson.opening.castle.ok = Gerokeerd! Je koning staat veilig en je toren doet mee.
lesson.opening.done = Centrum, stukken, rokade: zo begin je elke partij goed.

# ---- Chapter 11: review (no teaching: the coach only asks) ----------------------------------------------------------
lesson.review.start = Korte herhaling, deze keer in een andere volgorde. Ik leg niets uit: jij laat het mij zien.
lesson.review.promo.ask = Promoveer deze pion.
lesson.review.promo.ok = Goed: een nieuwe dame, en schaak!
lesson.review.check.ask = Je koning staat schaak. Hef het schaak op.
lesson.review.check.ok = Uit het schaak. Goed.
lesson.review.castle.ask = Rokeer, aan de kant waar het mag.
lesson.review.castle.other = Dat is geen rokade. Rokeer aan de kant waar het mag.
lesson.review.castle.ok = Gerokeerd, aan de veilige kant!
lesson.review.ep.ask = Sla mijn pion en passant.
lesson.review.ep.ok = En passant! Je hebt het onthouden.
lesson.review.mate.ask = Zet me mat in één zet.
lesson.review.mate.ok = Schaakmat! Herhaling klaar.

# ---- Chapter 12: how our games work (no clock, touch-move, handshake, and how the coach helps) ----------------------
lesson.talk.rules = Je kent nu alle schaakregels. Goed gedaan!
lesson.talk.real = Ik vertel je hoe onze partijen gaan werken.
lesson.talk.no_clock = Bij mij is er geen klok en geen rating. Neem alle tijd die je nodig hebt om na te denken.
lesson.talk.touch = Een stuk dat je aanraakt, moet je zetten: kijk dus eerst, en raak dan pas aan.
lesson.talk.handshake = Partijen beginnen en eindigen met een handdruk. Die betekent: goede partij, en bedankt.
lesson.talk.polite = Of je nu wint of verliest: blijf beleefd, en stoor je tegenstander nooit terwijl die nadenkt.
lesson.talk.help = In onze partijen help ik je. Als een van je stukken wordt aangevallen of niet gedekt staat, zeg ik het je.
lesson.talk.help_back = Na een grote fout laat ik zien waarom, en bied ik aan je zet terug te nemen.
lesson.talk.help_skip = En praat ik te veel? Druk dan op de spatiebalk: dan stop ik.
lesson.talk.next = Als je er klaar voor bent, speel dan Eerste stappen. Ik speel rustig.
lesson.talk.welcome = Welkom in de wereld van het schaken! Laten we elkaar de hand schudden.
