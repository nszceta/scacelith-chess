ex.verdict.inaccuracy.b3.2 = {best} was net iets nauwkeuriger.
ex.verdict.inaccuracy.b3.3 = Een kleine misstap: {best} was hier beter.
ex.verdict.inaccuracy.b4 = Onnauwkeurig: {best} was preciezer.
ex.verdict.inaccuracy.b4.2 = Een kleine onnauwkeurigheid. {best} was iets beter.
ex.verdict.inaccuracy.b4.3 = Niet helemaal de beste zet: {best} was nauwkeuriger.
ex.verdict.inaccuracy.b5 = {move} is onnauwkeurig; {best} was sterker.
ex.verdict.inaccuracy.b5.2 = Iets onnauwkeurig. Ik had {best} gespeeld.
