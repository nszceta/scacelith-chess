ex.verdict.blunder.b2.2 = Det er en stor fejl.
ex.verdict.blunder.b2.3 = Pas på, det træk koster dig noget.
ex.verdict.blunder.b3 = Det er en brøler.
ex.verdict.blunder.b3.2 = {move} er virkelig en fejl.
ex.verdict.blunder.b3.3 = Av, {move} er en stor fejl.
ex.verdict.blunder.b4 = {move} er en brøler.
ex.verdict.blunder.b4.2 = {move} er en alvorlig fejl.
ex.verdict.blunder.b4.3 = Det er desværre en brøler.
ex.verdict.blunder.b5 = {move} er en alvorlig fejl.
ex.verdict.blunder.b5.2 = {move} er en brøler.
ex.verdict.blunder.b5.3 = {move} er en dyr fejl.
ex.verdict.blunder.b6 = {move} er en grov fejl.
ex.verdict.blunder.b6.2 = {move} er en brøler.
ex.verdict.blunder.b6.3 = {move}? En brøler.
# A blunder that leaves the coach's threat standing (levels 1-2: the threat the engine found after the
# coach's last move is what the reply carries out).
ex.verdict.ignored.b1 = Ups! Du gjorde ikke noget ved min trussel.
ex.verdict.ignored.b1.2 = Pas på! Min trussel var der stadig.
ex.verdict.ignored.b1.3 = Åh, vent. Du glemte min trussel.
ex.verdict.ignored.b2 = Hmm, min trussel var der stadig.
ex.verdict.ignored.b2.2 = Du lod min trussel stå ubesvaret.
ex.verdict.ignored.b2.3 = Pas på, du gjorde ikke noget ved min trussel.
ex.verdict.mistake.b3 = Det er ikke et godt træk.
ex.verdict.mistake.b3.2 = Hmm, der er et problem med {move}.
ex.verdict.mistake.b3.3 = Det er en fejl.
ex.verdict.mistake.b4 = {move} er en fejl.
ex.verdict.mistake.b4.2 = {move} er ikke godt.
ex.verdict.mistake.b4.3 = Det er en fejl.
ex.verdict.mistake.b5 = {move} er en klar fejl.
ex.verdict.mistake.b5.2 = {move} er en fejl.
ex.verdict.mistake.b5.3 = {move} er ikke godt.
ex.verdict.mistake.b6 = {move} er en fejl.
ex.verdict.mistake.b6.2 = {move}? En fejl.
ex.verdict.mistake.b6.3 = Ikke {move}.
# A dubious move (an inaccuracy; a costly move with nothing concrete to show while still better):
# only the better move is named ({best} is pointed at), never a scenario.
ex.verdict.inaccuracy.b3 = Ikke dårligt, men {best} var lidt bedre.
ex.verdict.inaccuracy.b3.2 = {best} var en anelse mere præcist.
ex.verdict.inaccuracy.b3.3 = En lille smutter: {best} var bedre her.
ex.verdict.inaccuracy.b4 = Unøjagtigt: {best} var mere præcist.
ex.verdict.inaccuracy.b4.2 = En lille unøjagtighed. {best} var lidt bedre.
ex.verdict.inaccuracy.b4.3 = Ikke helt det bedste: {best} var mere nøjagtigt.
ex.verdict.inaccuracy.b5 = {move} er unøjagtigt; {best} var stærkere.
ex.verdict.inaccuracy.b5.2 = Lidt unøjagtigt. Jeg ville have spillet {best}.
ex.verdict.inaccuracy.b5.3 = {best} var mere præcist end {move}.
ex.verdict.inaccuracy.b6 = {move} er unøjagtigt; {best}.
ex.verdict.inaccuracy.b6.2 = Unøjagtigt. {best}.
ex.verdict.inaccuracy.b6.3 = {best} var bedre.
# Level 6, an inaccuracy at the bottom of its class (deeper searches often clear it): a hedged word.
ex.verdict.inaccuracy.maybe = {best} var måske en anelse mere præcist.
ex.verdict.inaccuracy.maybe.2 = Jeg ville måske have spillet {best}.
# A dubious move that loses material (levels 3-6): the remark alone, never "a bit better" (at level 6
# under 6 points, the hedged word above unless a piece is lost).
ex.verdict.dubious = Det træk ser tvivlsomt ud.
ex.verdict.dubious.2 = Det træk virker tvivlsomt.
# Something good was missed (levels 1-2).
ex.verdict.missed.b1 = Åh, vent! Du overså noget godt.
ex.verdict.missed.b1.2 = Kig igen! Der var noget bedre.
ex.verdict.missed.b1.3 = Vent lidt, der havde du en chance!
ex.verdict.missed.b2 = Der lod du en chance gå fra dig.
ex.verdict.missed.b2.2 = Hmm, der var noget bedre.
ex.verdict.missed.b2.3 = Vent, der havde du et fremragende træk.

# ---- The better move (levels 3-6; {best} is pointed at) ----------------------------------------
