ex.better.b3.2 = {best} var det bedre træk.
ex.better.b3.3 = I stedet var {best} godt.
ex.better.b4 = {best} var stærkere.
ex.better.b4.2 = {best} var det rigtige træk.
ex.better.b4.3 = Bedre var {best}.
ex.better.b5 = {best}, med idéen {line}.
ex.better.b5.2 = {best} var trækket: {line}.
ex.better.b5.3 = Bedre var {best}, efterfulgt af {line}.
ex.better.b6 = {best}: {eval}.
ex.better.b6.2 = {best} i stedet, {eval}.
ex.better.b6.3 = {best} var {eval}.

