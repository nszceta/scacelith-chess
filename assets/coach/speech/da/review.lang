# ---- Demonstration narration: one short line per move shown on the board ------------------------
# Levels 4-6: just the move.
demo.move = {move}.
demo.move.2 = {move}.
demo.move.3 = Så {move}.
# Levels 1-3, the coach's moves.
demo.my.move = {my} går til {sq}.
demo.my.move.2 = Jeg flytter {my} til {sq}.
demo.my.move.3 = Så går {my} til {sq}.
demo.my.take = Jeg slår {your}.
demo.my.take.2 = {my} slår {your}.
demo.my.take.3 = Og så slår jeg {your}.
demo.my.check = {my} går til {sq}. Skak.
demo.my.check.2 = Skak med {my} på {sq}.
demo.my.check.3 = {my} til {sq}, skak!
demo.my.mate = {my} går til {sq}. Skakmat.
demo.my.mate.2 = Og {my} til {sq} er skakmat.
demo.my.mate.3 = {my} til {sq}. Det er skakmat.
# Levels 1-3, the coach's in-between move: a capture, a check or a quiet move played first while a
# bigger piece of the player's ({t1}) is attacked; the next move of the coach's takes it.
# "{t1} står der stadig bagefter" = "{t1} will still be there".
demo.my.first.take = Først slår {my} {your}. {t1} kan vente.
demo.my.first.take.2 = {my} slår {your} først. {t1} står der stadig bagefter.
demo.my.first.check = {my} slår {your}, og det er skak! {t1} kan vente.
demo.my.first.check.2 = Først slår {my} {your} med skak. {t1} står der stadig bagefter.
demo.my.first.check_move = Først skak med {my} på {sq}. {t1} kan vente.
demo.my.first.check_move.2 = {my} går til {sq}: først skak! {t1} står der stadig bagefter.
demo.my.first.move = Først går {my} til {sq}. {t1} kan vente.
demo.my.first.move.2 = Først {my} til {sq}. {t1} står der stadig bagefter.
# The piece that moves was attacked itself: it takes something before it can be taken.
demo.my.first.attacked = {my} er angrebet, så {my:den} slår {your} først.
demo.my.first.attacked.2 = {my} er under angreb: {my:den} snupper {your} først.
# Levels 4-6, the same in-between move.
demo.first = Først {move}: {t1} kan vente.
demo.first.2 = Først {move}. {t1} står der stadig bagefter.
# After the rewind when no takeback is offered: the coach's real move comes next.
demo.play_on = Nu spiller jeg mit træk.
demo.play_on.2 = Her er mit rigtige træk.
demo.play_on.3 = Og nu mit træk for alvor.
# Levels 1-3, the player's moves (what they would play).
demo.your.move = Du ville flytte {your} til {sq}.
demo.your.move.2 = Lad os sige at du flytter {your} til {sq}.
demo.your.move.3 = Så går {your} til {sq}.
demo.your.take = Du ville slå {my}.
demo.your.take.2 = Du slår {my} med {your}.
demo.your.take.3 = Så slår du {my}.
demo.your.back = Du slår tilbage.
demo.your.back.2 = Du slår tilbage på {sq}.
demo.your.back.3 = Og så slår du tilbage.
demo.your.king = Din konge skal flytte.
demo.your.king.2 = Kongen må træde til side, til {sq}.
demo.your.king.3 = Din konge flygter til {sq}.
# Levels 4-6 (and 1-3 when the whole line is too long): the demonstration stops where the problem
# stands, and the coach points at what comes next ({t1} {t2} = the pieces that fall, pointed at;
# {reply} = the mating move, traced; the pieces where they stand at that moment).
ex.point.piece = Nu kan {t1} ikke reddes.
ex.point.piece.2 = Og {t1} er tabt.
ex.point.piece.3 = Derefter falder {t1}.
ex.point.two = {t1} og {t2} er begge angrebet: den ene af dem falder.
ex.point.two.2 = Nu angriber jeg {t1} og {t2}. Du kan ikke redde dem begge.
ex.point.mate = Og nu er {reply:nomate} skakmat.
ex.point.mate.2 = Derefter kommer {reply:nomate}, og det er skakmat.
# Levels 1-3, at the end of a whole sequence shown on the board: what it cost ({pts} from before the
# move, every capture of the sequence counted).
ex.result.b1 = Kan du se? Nu har du tabt {pts:point}.
ex.result.b1.2 = Sådan taber du {pts:point}.
