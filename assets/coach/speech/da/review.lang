# ---- The coach's own threats (levels 1-2, before the player moves) ------------------------------
# A mate threat ({sq} = where it would mate, pointed at at level 1; {my} = the piece).
threat.mate.b1 = Pas på! Jeg truer med skakmat på {sq}.
threat.mate.b1.2 = Pas på: {my} vil gerne til {sq}. Det ville være skakmat.
threat.mate.b1.3 = Se på {sq}. Hvis jeg kommer derhen, er det skakmat!
threat.mate.b2 = Pas på, jeg truer med mat.
threat.mate.b2.2 = Pas på: der er en mattrussel på {sq}.
threat.mate.b2.3 = Se godt efter: jeg truer med skakmat.
threat.mate.b3 = Pas på, jeg truer med mat på {sq}.
threat.mate.b3.2 = Der er en mattrussel: {my} vil gå til {sq}.
threat.mate.b3.3 = Se dig for: jeg truer med skakmat.
# A threat on a piece ({my} = my attacker, pointed at at level 1; {your} = the target, pointed at).
threat.piece.b1 = Se: {my} angriber {your}.
threat.piece.b1.2 = Pas på! {your} er angrebet af {my}.
threat.piece.b1.3 = Pas på, {my} vil gerne slå {your}.
threat.piece.b2 = Pas på {your}.
threat.piece.b2.2 = {your} er under angreb.
threat.piece.b2.3 = Hold øje med {your}.
threat.piece.b3 = {my} angriber {your}, og at slå {your:den} ville vinde materiale.
threat.piece.b3.2 = {your} er i fare: {my} truer med at slå {your:den}.
threat.piece.b3.3 = Pas på: mit sidste træk angriber {your}.
threat.fork.b2 = {my} på {sq} angriber både {t1} og {t2}. Det er en gaffel!
threat.fork.b2.2 = Pas på, det er en gaffel: {my} angriber {t1} og {t2}.
threat.fork.b2.3 = {my} laver gaffel på {t1} og {t2}. Du kan ikke let redde begge.
threat.pin.b2 = {my} på {sq} binder {your} til {t1}. Flytter {your:den}, slår jeg {t1}.
threat.pin.b2.2 = Pas på: {your} er bundet af {my}. Flytter {your:den}, falder {t1}.
threat.pin.b2.3 = {your} er bundet: forlader {your:den} feltet, slår {my} {t1}.
threat.only.b3 = Det er en kritisk stilling: kun ét træk er virkelig godt. Tag dig tid.
threat.only.b3.2 = Pas på, der er kun ét godt træk her. Se på det hele først.
threat.only.b3.3 = Sænk farten: de fleste træk går galt i denne stilling.
threat.punish.b1 = Mit sidste træk var en fejl. Kan du straffe det?
threat.punish.b1.2 = Hmm, jeg tror jeg lavede en fejl. Kan du finde den?

