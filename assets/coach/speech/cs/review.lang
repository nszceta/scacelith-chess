ex.verdict.mistake.b3.2 = Hm, {move} má háček.
ex.verdict.mistake.b3.3 = To je chyba.
ex.verdict.mistake.b4 = {move} je chyba.
ex.verdict.mistake.b4.2 = {move} není dobrý tah.
ex.verdict.mistake.b4.3 = To je chyba.
ex.verdict.mistake.b5 = {move} je jasná chyba.
ex.verdict.mistake.b5.2 = {move} je chyba.
ex.verdict.mistake.b5.3 = {move} není dobrý tah.
ex.verdict.mistake.b6 = {move} je chyba.
