# ---- Tips: principles, never a fault claim (levels 1-3) ----------------------------------------
tip.early_queen.b1 = {your} jde do hry moc brzy. Nejdřív vyveď jezdce a střelce.
tip.early_queen.b1.2 = Opatrně se {your:refl_ins} tak brzy: moje figury {your:pron_acc} můžou honit po šachovnici.
tip.early_queen.b1.3 = Táhnout {your:bare_ins} je zábava, ale nejdřív vyvíjej lehké figury.
tip.early_queen.b2 = Když táhneš {your:bare_ins} takhle brzy, můžu {your:pron_acc} napadat a získávat čas.
tip.early_queen.b2.2 = {your} venku tak brzy? Nejdřív jezdci a střelci!
tip.early_queen.b3 = Brzký výpad {your:gen} mi dává tempa proti {your:npron_dat}.
tip.early_queen.b3.2 = Tak brzy se {your} dá snadno honit. Nejdřív vývin.
tip.queen_grab.b1 = {your} vzal{your:past} vzdáleného pěšce a teď se může dostat do potíží.
tip.queen_grab.b1.2 = Sbírání pěšců {your:bare_ins} stojí čas. Nejdřív vyvíjej!
tip.queen_grab.b2 = {your} si vyrazil{your:past} na lov pěšců na kraji. To stojí spoustu času.
tip.queen_grab.b2.2 = Opatrně, když posíláš {your:refl_acc} pro vzdálené pěšce.
tip.queen_grab.b3 = Takhle brzký lov pěšců {your:bare_ins} znamená ztrátu času.
tip.queen_grab.b3.2 = {your} je teď daleko od domova; můj vývin bude znát.
tip.queen_grab.b4 = {your} bere pěšce, ale ztrácí příliš času.
tip.queen_grab.b4.2 = Lov pěšce na kraji {your:bare_ins} stojí tempa.
tip.same_piece.b1 = {your} táhne už podruhé. Zkus každým tahem vyvinout novou figuru.
tip.same_piece.b1.2 = Zase {your}? Vyveď i ostatní figury.
tip.same_piece.b1.3 = Každým tahem zkus vyvinout novou figuru, ne znovu {your:refl_acc}.
tip.same_piece.b2 = Dva tahy {your:bare_ins} v zahájení stojí čas.
tip.same_piece.b2.2 = {your} táhne znovu; tvoje ostatní figury jsou pořád doma.
tip.same_piece.b3 = Dva tahy {your:bare_ins} brzdí vývin.
tip.same_piece.b3.2 = Další tah {your:bare_ins}; zbytek tvé armády čeká.
tip.castle.b1 = {your} je pořád uprostřed. Rošáda by {your:pron_acc} ochránila.
tip.castle.b1.2 = Čas na rošádu! V rohu je {your} víc v bezpečí.
tip.castle.b1.3 = Mysli na brzkou rošádu. {your} je na ráně.
tip.castle.b2 = {your} je pořád v centru. Brzy udělej rošádu!
tip.castle.b2.2 = Rošáda by {your:acc} bezpečně schovala.
tip.castle.b3 = Centrum se otevírá, a tak by {your} měl{your:past} udělat rošádu.
tip.castle.b3.2 = {your} je pořád v centru; rošáda už byla na čase.
tip.knight_rim.b1 = {your} na okraji moc nedělá. Jezdci mají rádi střed.
tip.knight_rim.b1.2 = Jezdec na okraji je špatný jezdec! {your} tam ovládá méně polí.
