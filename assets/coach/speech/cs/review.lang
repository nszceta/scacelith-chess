ex.verdict.inaccuracy.b3.2 = O trochu přesnější bylo {best}.
ex.verdict.inaccuracy.b3.3 = Malé zaváhání: tady bylo lepší {best}.
ex.verdict.inaccuracy.b4 = Nepřesné: přesnější bylo {best}.
ex.verdict.inaccuracy.b4.2 = Drobná nepřesnost. O něco lepší bylo {best}.
ex.verdict.inaccuracy.b4.3 = Ne úplně nejlepší: přesnější bylo {best}.
