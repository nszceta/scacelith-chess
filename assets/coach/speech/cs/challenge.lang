# Coach speech (Czech): the challenges (src/coach/challenge_run.cpp). Same keys and variants as
# assets/coach/speech/en/challenge.lang.
#
# Placeholders:
#   {n}      a number; "{n:position}" says it with its noun ("6 pozic", count.position in
#            common.lang), "{n:move}" likewise; "{n:ord_ins}" is the Czech "mate in N": "mat
#            {n:ord_ins} tahem" = "mat 2. tahem", spoken "mat druhým tahem"
#   {move}   one of the coach's moves, played on the board while the line is said;
#            "{move:nomate}" says a mating move without "mat" (the line says it)
#   {your}   one of the player's pieces; the coach points at it on that word. The player is the
#            subject of these lines, so they use "svůj": {your:refl_acc} = "svou věž", "svého jezdce"
#   {sq}     a square ("pole {sq}": never v/s/z/k right before it); the coach points at it on that word
# The player always has the white pieces. The coach says "ty" to the player and is male
# ("odpověděl bych"); the player's gender is unknown: no past tense or adjective about the player.
# The challenge names are exactly those of assets/i18n/cs.lang (challenge.<id>.name); a name in the
# menu's formal imperative is quoted as a title ("Výzva „Najděte únik“."), so the coach's "ty" stays
# intact; the written "Mat 1. tahem" titles have a ".spoken" line with the ordinal in words.

# ---- A challenge started from the end card of a game: said before its introduction ------------------
# {theme}: the one thing the coach named at the end of that game.
ch.practise = Z tvé poslední partie: {theme}. Tahle sada je na to jako stvořená.
ch.practise.2 = V poslední partii bylo něco k procvičení: {theme}. Pojďme si to natrénovat.
ch.practise.3 = Tip z poslední partie: {theme}. Tady je trocha cvičení.

# ---- The start of a challenge: what it trains ({n:position}: how many positions) ------------------
ch.intro.mate1 = Mat 1. tahem. {n:position} a v každé dá mat jediný tah. Prověř každý šach.
ch.intro.mate1.spoken = Mat prvním tahem. {n:position} a v každé dá mat jediný tah. Prověř každý šach.
ch.intro.mate2 = Mat 2. tahem. {n:position}: tvůj první tah mi nesmí nechat žádnou obranu, pak dáš mat.
ch.intro.mate2.spoken = Mat druhým tahem. {n:position}: tvůj první tah mi nesmí nechat žádnou obranu, pak dáš mat.
ch.intro.mate3 = Mat 3. tahem. {n:position}. Šachy, braní a hrozby: pokaždé si propočítej moji nejlepší odpověď.
ch.intro.mate3.spoken = Mat třetím tahem. {n:position}. Šachy, braní a hrozby: pokaždé si propočítej moji nejlepší odpověď.
ch.intro.backrank = Maty na základní řadě. {n:position}, kde je král uvězněný za vlastními pěšci.
ch.intro.patterns = Matové obrazce. {n:position} s klasickými matovými sítěmi. Poznej obrazec a pak udeř.
ch.intro.hanging = Figury zadarmo. {n:position}: něco mého zůstalo bez krytí. Najdi to a vezmi si to.
ch.intro.fork = Vidličky. {n:position}: najdi tah, který napadne dva cíle najednou.
ch.intro.pin = Vazby. {n:position}: svaž figuru, nebo využij vazbu.
ch.intro.skewer = Napíchnutí. {n:position}: napadni cennou figuru a získej to, co stojí za ní.
ch.intro.discovered = Odtažné útoky. {n:position}: odtáhni jednou figurou a uvolni tak jinou.
ch.intro.deflection = Odlákání a vlákání. {n:position}: odlákej obránce pryč, nebo ho vlákej na osudné pole.
ch.intro.intermezzo = Mezitahy. {n:position}: před samozřejmým tahem najdi silnější.
ch.intro.trapped = Chycené figury. {n:position}: jedna z mých figur nemá kam bezpečně ustoupit. Získej ji.
ch.intro.promotion = Proměna. {n:position}, kde partii rozhodne daleko postoupený pěšec.
ch.intro.quiet = Tiché tahy. {n:position}: vítězný tah není šach ani braní.
ch.intro.opening = Pasti v zahájení. {n:position} z prvních tahů skutečných partií. Potrestej moji chybu.
ch.intro.escape = Výzva „Najděte únik“. {n:position}: tvůj král je v nebezpečí a zachrání ho jen jeden tah.
ch.intro.defend = Obranné tahy. {n:position}: najdi ten jediný tah, který udrží tvou pozici pohromadě.
ch.intro.kq = Dáma a král proti králi. {n:position}: dej mat mému králi. Pozor na pat.
ch.intro.kr = Věž a král proti králi. {n:position}: dej mat mému králi, krok za krokem.
ch.intro.kp = Král a pěšec proti králi. {n:position}: udělej si novou dámu. Pěšce veď králem.
ch.intro.kp_hold = Výzva „Zastavte pěšce“. {n:position}: máš jen krále. Udrž remízu.
ch.intro.rook = Věžové koncovky. {n:position}: postav most k proměně a udrž remízu Philidorovou obranou.
ch.intro.endgame = Taktika v koncovce. {n:position} s několika málo figurami a ostrými nápady.

# ---- At each position: the task --------------------------------------------------------------------
# A line that ends in checkmate: {n} = the player's moves to the mate ("mat {n:ord_ins} tahem").
ch.task.mate = Mat {n:ord_ins} tahem.
ch.task.mate.2 = Najdi mat {n:ord_ins} tahem.
ch.task.hanging = Něco zůstalo bez krytí.
ch.task.hanging.2 = Co můžeš vzít zadarmo?
ch.task.fork = Najdi vidličku.
ch.task.fork.2 = Hledej vidličku.
ch.task.pin = Klíčem je tady vazba.
ch.task.skewer = Tady vyhrává napíchnutí.
ch.task.discovered = Tady vyhrává odtažný útok.
ch.task.deflection = Přetiž obránce, nebo ho vlákej.
ch.task.intermezzo = Hledej mezitah.
ch.task.trapped = Jedna z mých figur nemůže uniknout. Získej ji.
ch.task.promotion = Využij svého daleko postoupeného pěšce.
ch.task.quiet = Vyhrává tichý tah.
ch.task.opening = Potrestej můj poslední tah.
ch.task.escape = Zachraň svého krále: funguje jen jeden tah.
ch.task.defend = Najdi jediný dobrý tah.
ch.task.endgame = Najdi nejlepší tah.
ch.task.default = Najdi nejlepší tah.
# The endgames played out: the coach defends, or tries to win, with its best moves.
ch.task.play.mate = Dej mat mému králi. Budu se bránit, jak nejlépe umím.
ch.task.play.promote = Proměň pěšce a udrž výhru. Pokusím se ti v tom zabránit.
# {n:move} as an accusative of duration: "Vydrž 10 tahů".
ch.task.play.hold = Vydrž {n:move} a udrž remízu. Já se pokusím vyhrát.

# ---- Setting up ----------------------------------------------------------------------------------
# Before the coach plays the first move into a position (once per challenge).
ch.lead.first = Tyhle pozice pocházejí ze skutečných partií. Zahraju poslední tah a pak jsi na tahu ty.
ch.lead.first.2 = Každá pozice pochází ze skutečné partie: zahraju tah, který k ní vedl, a pak hraješ ty.
ch.next = Další pozice.
ch.next.2 = Tady je další.
ch.next.3 = Jdeme na další.
ch.last = Poslední pozice.
ch.last.2 = A teď ta poslední.

# ---- The player's move -----------------------------------------------------------------------------
# A right move in the middle of a line (the coach then answers it).
ch.good = Dobře.
ch.good.2 = Ano.
ch.good.3 = Správně.
ch.good.4 = Přesně tak.
# The position is solved.
ch.solved = To je ono! Výborně.
ch.solved.2 = Naprosto správně.
ch.solved.3 = Velmi dobře.
ch.solved.mate = Mat! Výborně.
ch.solved.mate.2 = A je to mat. Velmi dobře.
ch.solved.mate.3 = Mat. Pěkně zahráno.
ch.solved.promote = Nová dáma a výhra je jistá. Výborně.
ch.solved.hold = Remíza je udržená. Výborně ubráněno!
ch.solved.draw = Na šachovnici je remíza. Výborně ubráněno!
# A wrong move: the coach plays its answer {move} while saying the line, then takes both back.
ch.wrong.reply = Tenhle ne: odpověděl bych tahem {move}.
ch.wrong.reply.2 = Ne tak docela: zahrál bych {move}.
ch.wrong.reply.3 = Pak bych zahrál {move}.
ch.wrong.mate = Pozor: tah {move:nomate} by byl mat.
ch.wrong.mate.2 = Opatrně: odpověděl bych tahem {move:nomate} a je to mat.
ch.wrong.mated = Pozor: po tahu {move} můžu vynutit mat {m:ord_ins} tahem.
# A move that still mates, but in more moves than the position asks.
ch.wrong.slower = I tohle vede k matu, ale trvá to déle. Jde to rychleji.
# A move that mates just as fast, but is not the solution the coach answers.
ch.wrong.other = I tohle vede k matu, ale já mám na mysli jiný tah. Podívej se znovu.
# A move that keeps an advantage, but less than the solution.
ch.wrong.weaker = Není to špatné, ale existuje něco silnějšího. Podívej se znovu.
ch.wrong.weaker.2 = Dá se to hrát, ale dokážeš to líp.
ch.wrong.stalemate = Pat! Můj král nemá kam táhnout, a to je jen remíza.
# Play-outs: the win slips away (the coach would hold), or the draw is lost (the coach would win).
ch.wrong.draw = Tenhle ne: po tahu {move} udržím remízu.
ch.wrong.loses = Pozor: po tahu {move} bych vyhrával já.
# No answer from the engine: the move is simply not the one.
ch.wrong.plain = To není ono.
ch.try_again = Zkus to znovu.
ch.try_again.2 = Podívej se ještě jednou.
ch.try_again.3 = Hledej znovu.

# ---- Hints (only when the player asks for one, or accepts the coach's offer) ------------------------
ch.offer = Chceš nápovědu?
ch.offer.2 = Mám ti trochu napovědět?
ch.no_hint = Dobře. Hledej dál.
ch.no_hint.2 = Jasně, dej si na čas.
ch.hint.piece = Podívej se na {your:refl_acc}.
ch.hint.piece.2 = Zaměř se na {your:refl_acc}.
ch.hint.square = Podívej se na pole {sq}.
ch.hint.square.2 = Klíčové pole je {sq}.
ch.hint.square.3 = Měj na očích pole {sq}.
ch.hint.show = Tady je ten tah. Sleduj.
ch.hint.show.2 = Ukážu ti to. Sleduj.
ch.hint.now = Teď ho zahraj ty.
ch.hint.now.2 = Jsi na tahu: zahraj ho.

# ---- The end -----------------------------------------------------------------------------------------
ch.complete = Výzva je hotová. Výborně!
ch.complete.2 = Všechny pozice vyřešené. Výborně!
