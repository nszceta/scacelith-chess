lesson.safety.other = Zkus tu druhou figuru.
lesson.safety.look = Hledej figuru, kterou nic nekryje.
lesson.safety.ok = Výborně! Vždycky se ptej: je ta figura krytá?

# ---- Chapter 3: check and getting out of check -----------------------------------------------------------------
lesson.danger.rank = Moje věž ovládá celou druhou řadu.
lesson.danger.rule = Král nikdy nesmí vstoupit na pole, kde by mohl být sebrán.
lesson.danger.ask = Táhni králem na bezpečné pole.
lesson.danger.ok = Správně. Tam je tvůj král v bezpečí.
lesson.check.what = Moje věž napadá tvého krále. Tomu se říká šach.
lesson.check.must = Když dostaneš šach, musíš se z něj hned dostat.
lesson.check.ways = Jsou tři možnosti: {@}ustoupit králem, {@2}zaclonit útok, nebo {@3}vzít útočníka.
