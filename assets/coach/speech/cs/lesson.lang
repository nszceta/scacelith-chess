lesson.block.queen_ok = Funguje to. Pamatuj si: cloň tou nejlevnější figurou.
lesson.block.ok = Výborně. Cloň figurou s nejmenší hodnotou.
lesson.capture.check = Moje dáma dává šach, hned vedle tvého krále.
lesson.capture.ask = Vezmi útočníka!
lesson.capture.king_ok = Ano! Moje dáma neměla obránce, a tak ji tvůj král mohl vzít.
lesson.capture.knight_ok = Ano! Tvůj jezdec útočníka odstranil.

# ---- Chapter 4: checkmate ------------------------------------------------------------------------------------
lesson.mate1.what = Mat: král je v šachu a nemá kam uniknout. Tím je partie vyhraná.
lesson.mate1.stuck = Můj král je uvězněný za {@}svými pěšci.
lesson.mate1.ask = Dej mi mat jedním tahem!
lesson.mate1.wrong = Skoro! Dej šach na mé základní řadě, kde můj král nemůže uniknout.
lesson.mate1.ok = Mat! Tohle je mat na základní řadě. Zapamatuj si ho!
lesson.mate2.ask = Tvůj král a dáma spolupracují. Dej mi mat jedním tahem.
lesson.mate2.wrong = Najdi šach, po kterém můj král nebude mít vůbec žádné pole.
lesson.mate2.ok = Mat! Tvůj král kryje dámu, takže ji můj vzít nemůže.
lesson.mate2.ok_rank = Mat na základní řadě! Tvůj král hlídá všechna pole před mým.
lesson.mate3.edge = Tvoje věž na sedmé řadě drží mého krále na okraji šachovnice.
