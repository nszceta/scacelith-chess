# Coach speech (Czech): the rules lesson (level 0, src/coach/lesson.cpp).
# Same keys and variants as assets/coach/speech/en/lesson.lang.
#
# Placeholders: {your} / {my} = a piece of the player / of the coach ("tvoje věž", "můj jezdec"), with
# the forms of common.lang ({my:acc}, {my:gen}, {my:dat}, {my:pron_acc}, {my:poss}, {your:refl_acc},
# {your:refl_ins}, {your:past} ...); {sq}, {sq2}, {to}, {esc} = squares; {move} = a move. {@}, {@2},
# {@3} are invisible marks: the coach points at something while saying the word right after the
# mark. A ".spoken" key is what the voice says instead (here: file letters spelled for the voice).
# Rules the lines follow: no past tense or adjective agreeing with the player; "svůj" when the
# player acts with their own piece ("Použij svou věž": {your:refl_acc}); files = sloupce, ranks =
# řady, back rank = základní řada; never v/s/z/k right before a square ("z pole {sq}").

# ---- Chapter titles (said inside "Pokračujeme kapitolou „{chapter}“.") ------------------------------
# Nominative, lower case (see event.lesson.* in events.lang).
lesson.title.welcome = šachovnice
lesson.title.pieces = jak táhnou figury
lesson.title.safety = bezpečné a nebezpečné braní
lesson.title.check = šach
lesson.title.mate = mat
lesson.title.castling = rošáda
lesson.title.en_passant = braní mimochodem
lesson.title.promotion = proměna pěšce
lesson.title.draws = pat a remíza
lesson.title.before_move = před tahem
lesson.title.opening = zahájení
lesson.title.etiquette = rating, hodiny a etiketa ve skutečných partiích

# ---- Lines every exercise uses ------------------------------------------------------------------------
# After the coach demonstrated the solution.
lesson.now_you = Teď to zkus ty.
lesson.now_you.2 = Teď jsi na řadě ty.
lesson.now_you.3 = Teď ty.
# Another wrong move after the demonstration.
lesson.almost = Skoro! Zahraj tah, který jsem ti ukázal.
lesson.almost.2 = Ne tak úplně. Zkus tah, který jsem předvedl.
lesson.almost.3 = Těsně vedle. Vzpomeň si, co jsem ti právě ukázal.
# A wrong move without a line of its own.
lesson.try_again = To není ono. Zkus to znovu.
lesson.try_again.2 = Tenhle ne. Zkus to ještě jednou.
lesson.try_again.3 = Zkusme to ještě jednou.
lesson.use_your = Použij {your:refl_acc}.
lesson.use_your.2 = Zkus to {your:refl_ins}.
lesson.watch = Sleduj.
lesson.like_this = Takhle.
lesson.and_back = A zpátky.
# A check that is not checkmate (the coach then shows the escape).
lesson.check_escape = Šach, ale můj král uteče na {esc}.
lesson.check_takes = Šach, ale můj král prostě vezme {your:acc}.
lesson.check_block = Šach, ale můžu ho zaclonit figurou.
lesson.stalemate = Pat! Můj král nemá kam táhnout a přitom není v šachu. Je to remíza, i když tvoje pozice byla vyhraná!

# ---- Why a move is not allowed (the coach points at the piece or square in question) ----------------
# {sq} = the square in question, {my} = the coach's piece that attacks, pins, blocks or gives
# check, {your} = the piece the player tried to move.
why.KingIntoCheck = Na {sq} ne: to pole napadá {my}. Král nikdy nesmí vstoupit na napadené pole.
why.PathBlocked = Něco ti stojí v {@}cestě: figury nemohou přeskakovat, jedině jezdec.
why.WrongGeometry = {your} takhle netáhne.
why.MustAnswerCheck = Tvůj král je v {@}šachu: nejdřív musíš šach odvrátit.
why.CastlingThroughCheck = Tvůj král by přešel přes {sq} a to pole napadá {my}.
why.CastlingNoRights = Tímhle králem nebo věží se už táhlo: rošáda není možná.
why.CastlingBlocked = K rošádě musí být pole mezi králem a věží volná.
why.CastlingOutOfCheck = Když je tvůj král v šachu, rošádu udělat nemůžeš.
why.PawnForwardBlocked = Pěšec nebere rovně dopředu: to pole je {@}obsazené.
why.LeavesKingInCheck = {your} je ve vazbě: kdyby odtáhl{your:past}, {my} by dával{my:past} šach tvému králi.
why.OwnPieceOnTarget = Na pole s vlastní figurou táhnout nemůžeš.
why.PawnCaptureNeedsVictim = Šikmo táhne pěšec jen tehdy, když bere.
why.EnPassantExpired = Brát mimochodem se smí jen hned po dvojkroku pěšce.
why.NotYourTurn = Počkej: teď jsem na tahu já.

# ---- Chapter 0: welcome and the board -------------------------------------------------------------------
lesson.welcome.hello = Ahoj! Jsem tvůj trenér. Pojďme se spolu naučit pravidla šachu, pěkně krůček po krůčku.
lesson.welcome.board = Tohle je šachovnice: čtyřiašedesát polí, světlých a tmavých, osm řad po osmi polích.
lesson.welcome.light = Rohové pole {@}vpravo od tebe je vždycky světlé. Zapamatuj si: vpravo je světlé.
lesson.welcome.files = Svislé linie se nazývají sloupce. Označují se písmeny od {@}a do {@2}h.
lesson.welcome.files.spoken = Svislé linie se nazývají sloupce. Označují se písmeny od {@}á do {@2}há.
lesson.welcome.ranks = Vodorovné linie se nazývají řady. Mají čísla od {@}jedné do {@2}osmi, počítáno od tvé strany.
lesson.welcome.square = Každé pole má jméno: nejdřív písmeno, potom číslo. Tohle pole je {sq}.
lesson.welcome.square2 = A tohle je {sq}.
lesson.welcome.kings = Tohle jsou dva králové. Tvůj stojí na {sq}, můj na {sq2}.
lesson.welcome.ask = Teď ty: táhni králem o jedno pole dopředu, na {sq}.
lesson.welcome.wrong = Tohle je {to}. Potřebujeme {sq}: písmeno e, číslo dva.
lesson.welcome.wrong.spoken = Tohle je {to}. Potřebujeme {sq}: písmeno é, číslo dva.
lesson.welcome.ok = Výborně. Tvůj král stojí na {sq}.

# ---- Chapter 1: how the pieces move and capture -----------------------------------------------------------
# Rook
lesson.rook.intro = Tohle je {your}. Táhne rovně, po sloupcích a po řadách, tak daleko, jak chce.
lesson.rook.lines = Nahoru po sloupci, {@}nebo do strany po řadě.
lesson.rook.capture = Při braní figura vstoupí na pole {@}soupeřovy figury a ta pak opustí šachovnici.
lesson.rook.ask = Vezmi {my:acc} svou věží!
lesson.rook.short = Správný směr! Pokračuj nahoru po sloupci, až k {my:dat}.
lesson.rook.rank = Tohle je tah po řadě. {my} stojí nahoře na sloupci.
lesson.rook.king = To je tvůj král. Použij {your:refl_acc} v rohu.
lesson.rook.ok = Sebráno! {my} opouští šachovnici.
# Pieces don't jump
lesson.jump.blocked = Figury nemohou přeskakovat jiné figury. Tvůj pěšec na {sq} stojí věži v cestě.
lesson.jump.knight = Přeskakovat umí jen jezdec. S ním se brzy seznámíme.
# Bishop
lesson.bishop.intro = Tohle je {your}. Táhne šikmo, tak daleko, jak chce.
lesson.bishop.colour = Střelec zůstává vždycky na polích stejné barvy.
lesson.bishop.ask = {my} stojí na téhle diagonále. Vezmi {my:pron_acc}!
lesson.bishop.short = Správná diagonála! Jdi dál, až k {my:dat}.
lesson.bishop.other = To je ta druhá diagonála. Podívej se směrem k {my:dat}.
lesson.bishop.ok = Výborně. Střelci milují dlouhé diagonály.
# Queen
lesson.queen.intro = Tohle je {your}, nejsilnější figura. Táhne jako věž a střelec dohromady.
lesson.queen.ask = Najdi {my:acc} a vezmi {my:pron_acc} svou dámou.
lesson.queen.wrong = Tvoje dáma se k {my:dat} dostane jedním tahem, po diagonále.
lesson.queen.ok = Výborně! Na dámu dávej pozor: má velkou cenu.
# King
lesson.king.intro = Král táhne jen o jedno pole, libovolným směrem.
lesson.king.important = Král je nejdůležitější figura. Když už nemá kam uniknout, partie je prohraná.
lesson.king.ask = Král může také brát. Vezmi {my:acc}!
lesson.king.wrong = Tvůj král stojí hned vedle {my:gen}. Vstup na {my:poss} pole a vezmi {my:pron_acc}.
lesson.king.ok = Dobře! Král je pomalý, ale zblízka je silný.
# Knight
lesson.knight.intro = Tohle je {your}. Skáče do písmene L: dvě pole rovně, potom jedno do strany.
lesson.knight.l = {@}Takhle. Vždycky dopadne na pole opačné barvy.
lesson.knight.jump = Jezdec je jediná figura, která umí přeskakovat ostatní.
lesson.knight.ask = Vezmi {my:acc} svým jezdcem!
lesson.knight.wrong = Tohle je správný skok jezdce, ale k {my:dat} nevede. Zkus jiné L.
lesson.knight.ok = Skvělý skok!
# Pawn: moving
lesson.pawn.intro = Teď {your}. Táhne rovně dopředu, vždy o jedno pole, a nikdy dozadu.
lesson.pawn.first = Svým prvním tahem může pěšec postoupit o jedno nebo o dvě pole.
lesson.pawn.ask = Táhni pěšcem o dvě pole dopředu.
lesson.pawn.one = Tohle je o jedno pole: je to povolené, ale tentokrát jdi o dvě.
lesson.pawn.use = Táhni pěšcem.
lesson.pawn.ok = Dobře.
# Pawn: capturing
lesson.pawncap.blocked = Můj pěšec blokuje tvého. Pěšci nemohou brát rovně dopředu.
lesson.pawncap.diagonal = Pěšec ale bere šikmo, o jedno pole dopředu.
lesson.pawncap.ask = Vezmi {my:acc} svým pěšcem.
lesson.pawncap.use = Použij {your:refl_acc}: bere šikmo dopředu.
lesson.pawncap.ok = Ano! Táhne rovně, bere šikmo.
# Values, set-up and the first moves
lesson.values.pawn = Každá figura má svou hodnotu v bodech. Pěšec má hodnotu jednoho bodu.
lesson.values.pieces = Jezdec nebo {@}střelec tři. {@2}Věž pět. {@3}Dáma devět.
lesson.values.king = Král je k nezaplacení: o krále nikdy přijít nesmíš.
lesson.values.trade = Snaž se nikdy nedávat figuru za méně, než kolik stojí.
lesson.setup.corners = Každá partie začíná takhle: věže v {@}rozích, vedle nich {@2}jezdci, potom {@3}střelci.
lesson.setup.queen = Dáma stojí na poli své barvy: tvoje dáma je na světlém poli.
lesson.setup.king = Král stojí vedle ní. Bílý táhne vždycky první.
lesson.first.ask = Začni partii: táhni pěšcem před svým králem o dvě pole, na {sq}.
lesson.first.wrong = I to je povolený tah! Teď ale prosím zahraj královským pěšcem na {sq}.
lesson.first.ok = Skvělý první tah: otevírá cestu tvé dámě a střelci.
lesson.first.reply = Odpovídám stejně. Teď vyveď jezdce: skoč z pole {sq} na {sq2}.
lesson.first.knight_wrong = Jezdci přeskakují pěšce. Zkus to z pole {sq} na {sq2}.
lesson.first.knight_ok = Výborně. Jezdce a střelce vyvíjíme hned na začátku.

# ---- Chapter 2: safe and unsafe captures ---------------------------------------------------------------------
lesson.safety.defended = Figura je krytá, když může jiná figura stejné barvy brát zpět.
lesson.safety.pawn = Můj {@}pěšec kryje {my:acc}.
lesson.safety.free = Ale {my} žádného obránce nemá. Tvoje dáma napadá obě figury.
lesson.safety.ask = Vezmi nekrytou figuru!
lesson.safety.watch = Sleduj, co se stane.
