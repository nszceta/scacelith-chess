# Coach speech (Russian): the appraisal after the game (src/coach/appraisal.cpp).
# Same keys and variants as assets/coach/speech/en/appraisal.lang (its header documents every placeholder).
#
# Always positive, never blaming. The player's gender is unknown: no "ты выиграл", "ты нашёл", "ты
# сыграл", "ты готов"; nouns ("победа твоя"), impersonal forms ("удалось", "получилось", "можно было"),
# "мы" ("мы сыграли вничью") or a move as the subject ("нашёлся ход") instead.
# Forms from common.lang: move numbers are ordinals, "{n:ord_pre}" = "на 21-м ходу" (spoken "на
# двадцать первом ходу"), "{n:ord}" = "21-й ход", "{crit_no:ord_gen}" = "до 21-го хода";
# "{acc:percent}" = "85%" (spoken "восемьдесят пять процентов"); "{n:piece_acc}" = "одну фигуру";
# "{m:check}" = "2 шаха"; "{n:capture}" = "3 взятия"; "{n:best_move}" = "5 лучших ходов";
# "{text:pre}" = a phase in the prepositional case ("в миттельшпиле", appraisal.phase.*.pre).
# {level} is a level name, said inside «...» after "уровень": "на уровень «Любитель»".
# {opening:def} is the opening's lower-case nominative ("итальянская партия").

# ---- Names used inside the lines ------------------------------------------------------------------
# Phases: nominative masculine nouns ("{text} у тебя получился"); the prepositional forms
# ("в {text:pre}") are in common.lang (appraisal.phase.<phase>.pre).
appraisal.phase.opening = дебют
appraisal.phase.middlegame = миттельшпиль
appraisal.phase.endgame = эндшпиль
# Draw reasons, said right after "Ничья" / "закончилась вничью" ("Ничья по соглашению.").
appraisal.reason.stalemate = из-за пата
appraisal.reason.material = из-за недостатка материала
appraisal.reason.repetition = из-за повторения позиции
appraisal.reason.fifty = по правилу пятидесяти ходов
appraisal.reason.agreement = по соглашению
appraisal.reason.other = по правилам
# The level names of assets/i18n/ru.lang (coach.level.<n>.name).
appraisal.level.l1 = Первые шаги
appraisal.level.l2 = Начинающий
appraisal.level.l3 = Любитель
appraisal.level.l4 = Клубный игрок
appraisal.level.l5 = Сильный клубный игрок
appraisal.level.l6 = Эксперт
# What to practise: an infinitive phrase in lower case, no full stop. The lines say it after a colon
# ("Совет: ...") or after a verb ("постарайся ...", "научиться ...", "важно ...", "стоит ...").
# "Свой" for the player's own pieces (the player is the subject of the infinitive).
theme.general = смотреть на всю доску, прежде чем ходить
theme.mate_allowed = проверять безопасность своего короля перед каждым ходом
theme.mate_missed = искать мат, начиная с шахов
