ex.verdict.blunder.b2.3 = Обережно, за цей хід доведеться заплатити.
ex.verdict.blunder.b3 = Це груба помилка.
ex.verdict.blunder.b3.2 = {move} — справжня помилка.
ex.verdict.blunder.b3.3 = Ой, {move} — серйозна помилка.
ex.verdict.blunder.b4 = {move} — груба помилка.
ex.verdict.blunder.b4.2 = {move} — серйозна помилка.
ex.verdict.blunder.b4.3 = Боюся, це груба помилка.
ex.verdict.blunder.b5 = {move} — серйозна помилка.
ex.verdict.blunder.b5.2 = {move} — груба помилка.
ex.verdict.blunder.b5.3 = {move} — дорога помилка.
ex.verdict.blunder.b6 = {move} — серйозна помилка.
ex.verdict.blunder.b6.2 = {move} — груба помилка.
