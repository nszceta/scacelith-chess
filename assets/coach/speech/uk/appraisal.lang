# Coach speech (Ukrainian): the appraisal after the game (src/coach/appraisal.cpp).
# Same keys and variants as assets/coach/speech/en/appraisal.lang (see its header for every placeholder).
#
# The appraisal is always positive and never blames. The coach says "ти"; the player's gender is
# unknown: no "ти виграв / ти знайшов / ти готовий"; present or future tense, impersonal forms in
# -но/-то ("Взято одну фігуру", "Повернуто 3 ходи", "знайдено"), noun phrases ("Перемога твоя").
# Grammar forms from common.lang:
#   {n:nth_move_loc} "на 12-му ході" (said "на дванадцятому ході"), {n:nth_move_gen} "до 12-го ходу",
#   {n:nth_move} "12-й хід"; {acc:pct} "87 %" (said "вісімдесят сім відсотків");
#   {n:piece_acc} "одну фігуру" after "взято" / "взяти"; {n:top_move} "3 найкращі ходи".
# The names inserted by {text}, {theme} and {level}:
#   appraisal.phase.*   nominative, all masculine (дебют, мітельшпіль, ендшпіль): "{text} тобі вдався"
#   appraisal.reason.*  a prepositional phrase right after "Нічия": "Нічия через пат."
#   theme.*             an infinitive phrase (lower case) after a colon, "спробуй" or "не забувай"
#   appraisal.level.*   the level names of assets/i18n/uk.lang, always in quotes after "рівень":
#                       "рівень «Аматор»" (the quoted name keeps its nominative)

