tip.early_queen.b1 = {your} wychodzi bardzo wcześnie. Najpierw wyprowadź skoczki i gońce.
tip.early_queen.b1.2 = Uważaj ze {your:refl_ins} tak wcześnie: moje bierki mogą {your:pron_acc} przeganiać.
tip.early_queen.b1.3 = Fajnie jest grać {your:bare_ins}, ale najpierw wyprowadź skoczki i gońce.
tip.early_queen.b2 = Tak wczesny ruch {your:ins} pozwala mi {your:pron_acc} atakować i zyskiwać czas.
tip.early_queen.b2.2 = {your} już w grze? Najpierw skoczki i gońce!
tip.early_queen.b3 = Wczesne wyjście {your:gen} daje mi ruchy z tempem przeciwko {your:npron_dat}.
tip.early_queen.b3.2 = Tak wcześnie łatwo przeganiać {your:acc}. Najpierw rozwój.
tip.queen_grab.b1 = {your} zbija odległego pionka i teraz może wpaść w kłopoty.
tip.queen_grab.b1.2 = Zbieranie pionków {your:ins} kosztuje czas. Najpierw rozwój!
tip.queen_grab.b2 = {your} wybiera się po pionka na skrzydło. To kosztuje dużo czasu.
tip.queen_grab.b2.2 = Uważaj, kiedy wysyłasz {your:refl_acc} po odległe pionki.
tip.queen_grab.b3 = Tak wczesne łapanie pionków {your:ins} to strata czasu.
tip.queen_grab.b3.2 = {your} jest teraz daleko od domu; mój rozwój będzie się liczył.
tip.queen_grab.b4 = {your} zgarnia pionka, ale traci za dużo czasu.
tip.queen_grab.b4.2 = Bicie pionka {your:ins} na skrzydle kosztuje tempo.
tip.same_piece.b1 = {your} rusza się już drugi raz. Staraj się w każdym ruchu wyprowadzać nową figurę.
tip.same_piece.b1.2 = Znowu {your}? Wyprowadź też inne figury.
tip.same_piece.b1.3 = W każdym ruchu rozwijaj nową figurę, a nie znowu {your:refl_acc}.
tip.same_piece.b2 = Dwa ruchy {your:ins} w debiucie to strata czasu.
tip.same_piece.b2.2 = {your} znowu się rusza, a twoje pozostałe figury wciąż stoją w domu.
tip.same_piece.b3 = Dwa ruchy {your:ins} hamują rozwój.
tip.same_piece.b3.2 = Kolejny ruch {your:ins}; reszta twojej armii czeka.
tip.castle.b1 = {your} wciąż stoi na środku. Roszada by {your:pron_acc} ochroniła.
tip.castle.b1.2 = Czas na roszadę! W rogu {your:dat} jest bezpieczniej.
tip.castle.b1.3 = Pomyśl niedługo o roszadzie. {your} stoi bez osłony.
tip.castle.b2 = {your} wciąż stoi w centrum. Zrób szybko roszadę!
tip.castle.b2.2 = Roszada bezpiecznie schowałaby {your:acc}.
tip.castle.b3 = Centrum się otwiera: {your:dat} przyda się roszada.
tip.castle.b3.2 = {your} wciąż stoi w centrum; roszada była już potrzebna.
tip.knight_rim.b1 = {your} na brzegu niewiele robi. Skoczki lubią środek.
tip.knight_rim.b1.2 = Skoczek na brzegu to słaby skoczek! Tam {your} kontroluje mniej pól.
tip.knight_rim.b2 = {your} na brzegu kontroluje mało pól. Celuj w centrum.
tip.knight_rim.b2.2 = Skoczek na brzegu to słaby skoczek: {your} ciągnie do centrum.
tip.knight_rim.b3 = {your} na brzegu jest poza grą.
tip.knight_rim.b3.2 = Brzeg szachownicy to kiepskie miejsce dla {your:gen}.
tip.flank.b1 = Najpierw ruszaj środkowymi pionkami. Pionki z brzegu mało pomagają.
tip.flank.b1.2 = Pionki z boku nie pomagają wyprowadzić figur. Graj środkowymi.
tip.flank.b2 = Ruchy pionkami brzegowymi niczego nie rozwijają. Graj pionkami centralnymi.
tip.flank.b2.2 = Za dużo ruchów pionkami z boku. Rozwijaj figury!
tip.flank.b3 = Ruchy pionkami skrzydłowymi w debiucie hamują rozwój.
tip.flank.b3.2 = Pionki brzegowe poczekają; rozwijaj się i walcz o centrum.
tip.centre.b1 = Staraj się kontrolować środek szachownicy, na przykład pole {sq}.
tip.centre.b1.2 = Centrum jest ważne. Postaw pionka albo figurę blisko pola {sq}.
tip.centre.b1.3 = Figury na środku są silne. Celuj w pola takie jak {sq}.
tip.centre.b2 = Walcz o centrum: pola takie jak {sq} są ważne.
tip.centre.b2.2 = Oddajesz mi centrum. Spójrz na pole {sq}.
tip.centre.b3 = Nie walczysz o centrum; pole {sq} jest moje.
tip.centre.b3.2 = Walcz o centrum, wokół pola {sq}.
tip.develop.b1 = Twoje skoczki i gońce wciąż stoją w domu. Wyprowadź na przykład {your:acc}.
tip.develop.b1.2 = Czas na rozwój! Twoje małe figury wciąż stoją w domu. Spróbuj {your:bare_ins}.
tip.develop.b2 = Żadna z twoich lekkich figur jeszcze się nie ruszyła. Wyprowadź {your:acc} i pozostałe.
tip.develop.b2.2 = Twoje figury jeszcze śpią. Zacznij od {your:gen}.
# Endgame technique tips.
tip.mate_technique.b1 = Gdy zostaje sam król, zepchnij go na brzeg, a potem daj mata.
tip.mate_technique.b1.2 = Rada: spychaj mojego króla w stronę brzegu. Trzymaj też swojego króla blisko.
tip.fifty.b1 = Uwaga: po pięćdziesięciu ruchach bez bicia i bez ruchu pionkiem jest remis.
tip.fifty.b1.2 = Czas ucieka: pięćdziesiąt ruchów bez bicia i ruchu pionkiem to remis.
tip.repetition.b1 = Uwaga! Jeśli ta sama pozycja powtórzy się trzeci raz, będzie remis.
tip.repetition.b1.2 = Unikaj powtarzania ruchów: trzecie powtórzenie to remis, a ty wygrywasz.

