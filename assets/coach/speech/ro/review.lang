# ---- Demonstration narration: one short line per move shown on the board ------------------------
# Levels 4-6: just the move.
demo.move = {move}.
demo.move.2 = {move}.
demo.move.3 = Apoi {move}.
# Levels 1-3, the coach's moves.
demo.my.move = {my} merge pe {sq}.
demo.my.move.2 = Mut {my} pe {sq}.
demo.my.move.3 = Apoi {my} merge pe {sq}.
demo.my.take = Iau {your}.
demo.my.take.2 = {my} ia {your}.
demo.my.take.3 = Și capturez {your}.
demo.my.check = {my} merge pe {sq}. Șah.
demo.my.check.2 = Șah, cu {my} pe {sq}.
demo.my.check.3 = {my} pe {sq}, șah!
