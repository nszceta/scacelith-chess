ex.better.b4 = {best} era mai puternică.
ex.better.b4.2 = {best} era mutarea corectă.
ex.better.b4.3 = Mai bună era {best}.
ex.better.b5 = {best}, cu ideea {line}.
ex.better.b5.2 = {best} era mutarea: {line}.
ex.better.b5.3 = Mai bună era {best}, urmată de {line}.
ex.better.b6 = {best}: {eval}.
ex.better.b6.2 = În schimb, {best}: {eval}.
ex.better.b6.3 = {best} dădea {eval}.

