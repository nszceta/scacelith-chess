threat.ask_mate.b2 = Ultima mea mutare e o amenințare serioasă. Vezi ce vreau să fac?
threat.ask_mate.b2.2 = Uită-te la ultima mea mutare: amenință ceva mare. Vezi?

# ---- The coach's own threats (levels 1-2, before the player moves) ------------------------------
# A mate threat ({sq} = where it would mate, pointed at at level 1; {my} = the piece).
threat.mate.b1 = Atenție! Amenint cu șah mat pe {sq}.
threat.mate.b1.2 = Atenție: {my} vrea să meargă pe {sq}. Ar fi șah mat.
threat.mate.b1.3 = Uită-te la {sq}. Dacă ajung acolo, e șah mat!
threat.mate.b2 = Atenție, amenint mat.
threat.mate.b2.2 = Atenție: e o amenințare de mat pe {sq}.
threat.mate.b2.3 = Privește cu atenție: amenint șah mat.
threat.mate.b3 = Atenție, amenint cu mat pe {sq}.
threat.mate.b3.2 = E o amenințare de mat: {my} vrea să meargă pe {sq}.
threat.mate.b3.3 = Ai grijă: amenint cu șah mat.
# A threat on a piece ({my} = my attacker, pointed at at level 1; {your} = the target, pointed at).
threat.piece.b1 = Uite: {my} atacă {your}.
threat.piece.b1.2 = Atenție! {your} e ataca{your:agr_t} de {my}.
threat.piece.b1.3 = Atenție, {my} vrea să ia {your}.
threat.piece.b2 = Atenție la {your}.
threat.piece.b2.2 = {your} e sub atac.
threat.piece.b2.3 = Ai grijă de {your}.
threat.piece.b3 = {my} atacă {your}, iar dacă {your:cl} iau, câștig material.
threat.piece.b3.2 = {your} e în pericol: {my} amenință să {your:cl} ia.
threat.piece.b3.3 = Atenție: ultima mea mutare atacă {your}.
threat.fork.b2 = {my} de pe {sq} atacă și {t1}, și {t2} deodată. E o furculiță!
threat.fork.b2.2 = Atenție, e o furculiță: {my} atacă și {t1}, și {t2}.
threat.fork.b2.3 = {my} face o furculiță: atacă și {t1}, și {t2}. Greu le salvezi pe amândouă.
threat.pin.b2 = {my} de pe {sq} leagă {your} de {t1}. Dacă se mută, iau {t1}.
threat.pin.b2.2 = Atenție: {my} leagă {your}. Dacă se mută, cade {t1}.
threat.pin.b2.3 = {your} e lega{your:agr_t}: dacă pleacă, {my} ia {t1}.
threat.only.b3 = Poziție critică: doar o mutare e cu adevărat bună. Nu te grăbi.
threat.only.b3.2 = Atenție, aici există o singură mutare bună. Privește mai întâi totul.
threat.only.b3.3 = Încet: majoritatea mutărilor nu merg în poziția asta.
threat.punish.b1 = Ultima mea mutare a fost o greșeală. Poți s-o pedepsești?
threat.punish.b1.2 = Hm, cred că am făcut o greșeală. Poți s-o găsești?

# ---- Takebacks ------------------------------------------------------------------------------------
# After the takeback is accepted, a hint (levels 1-2).
tb.hint.b1 = De data asta, gândește-te la {your}.
tb.hint.b1.2 = Fii cu ochii pe {your}.
tb.hint.king.b1 = Gândește-te la siguranța {your:gen}.
tb.hint.king.b1.2 = Uită-te întâi la {your}. E în siguranță?
tb.hint.missed.b1 = Caută piese pe care le poți lua gratis.
tb.hint.missed.b1.2 = Privește cu atenție: poți captura ceva?
tb.hint.mate_missed.b1 = Uită-te la regele meu. Îi poți da șah mat?
tb.hint.mate_missed.b1.2 = Încearcă întâi șahurile. Poate există un mat!
tb.hint.general.b1 = Nu te grăbi și uită-te la toată tabla.
tb.hint.general.b1.2 = Încearcă să găsești o mutare mai sigură.
tb.hint.b3 = Verifică ce piese ale tale atacă răspunsul meu.
tb.hint.b3.2 = Uită-te ce ar ataca răspunsul meu, înainte să joci.
# The retry.
tb.fixed.b1 = Mult mai bine!
tb.fixed.b1.2 = Da, așa e mai bine!
tb.fixed.b1.3 = Bine, așa merge mult mai bine.
tb.fixed = Așa e mai bine.
tb.fixed.2 = Mai bine.
tb.fixed.3 = Bine corectat.
# After a good retry of a move taken back for a fault with a named cause (levels 1-3), one line that
# names the habit; {theme} is a phrase from appraisal.lang (theme.*), no full stop.
tb.why.b1 = Ține minte pentru data viitoare: {theme}.
tb.why.b1.2 = Un obicei bun: {theme}.
tb.why.b2 = Lecția de aici: {theme}.
tb.why.b2.2 = Ce a ajutat: {theme}.
tb.why.b3 = Merită ținut minte: {theme}.
tb.why.b3.2 = Obiceiul de format: {theme}.
tb.same = Iar aceeași mutare? Bine, să vedem.
tb.same.2 = Îți place mutarea asta. Hai s-o jucăm până la capăt.
# The retry after a hint-only offer is the move the coach had in mind.
tb.found.b1 = Da! Asta e mutarea la care mă gândeam.
tb.found.b1.2 = Ai găsit-o! Asta e mutarea mai bună.
tb.found = Asta e mutarea pe care o aveam în minte.
tb.found.2 = Exact, asta e.
# Levels 4-6, once per game: the level's takebacks are used up, so no offer this time (said
# where the offer would have been).
tb.none_left = Din păcate, în partida asta nu mai poți lua mutări înapoi.
tb.none_left.2 = Nu mai ai nicio anulare de mutare în partida asta.

