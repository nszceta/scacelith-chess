# Coach speech (Romanian): the review of the player's moves (src/coach/review.cpp, review_explain.cpp).
# Same keys and variants as assets/coach/speech/en/review.lang (its header documents every placeholder).
#
# Register (see the glossary): the coach says "tu" and is male. The player's gender is unknown: no
# adjective or participle agrees with the player; the active perfect is invariable ("ai pierdut").
# Pieces ({your} {your2} {my} {my2} {t1} {t2}) carry their article and owner ("calul tău", "dama mea"):
# never add "tău", "meu", "al" or an article. Forms (common.lang): gen ("în fața {t1:gen}", "dau mat
# {your:gen}"), cl ("{your:cl} pot lua" = "îl" / "o"), cl_imp ("ia{my:cl_imp}" = "ia-l" / "ia-o"),
# cl_imp_a ("Mut{your:cl_imp_a}" = "Mută-l" / "Mut-o"), cl_ger ("atacând{my:cl_ger}"), pron / pron_gen
# ("în spatele {t1:pron_gen}" = "lui" / "ei"), and the endings of agreeing participles
# ("lega{your:agr_t}" = "legat" / "legată", "prin{your:agr_s}", "singu{your:agr_r}").
# A clitic never stands before a perfect or conditional auxiliary: present or future instead.
# Two pieces never share an agreeing word: "și {t1}, și {t2} sunt sub atac", "ambele piese".
# Squares are never inflected: "pe {sq}", "de pe {sq}", "câmpul {sq}".
# A move as the subject agrees in the feminine (the implied "mutarea"): "{best} era mai bună".
# Counts: {pts:point} "3 puncte", {n:time} "de 3 ori", {n:attacker}, {n2:defender}, {n:square}; a mate
# distance always uses {m:in_move} ("mat în 3 mutări", "mat într-o mutare"), never "în {m:move}".
# Mate patterns (name.pattern.*) carry their article: "matul înăbușit".
# A loose piece or square is "fără apărare" or "în priză", never a predicative "neapărat" (heard as the
# adverb "necessarily"); a fork is "atacă dublu" / "furculiță" (glossary).

# ---- Announcements (either side's move) -------------------------------------------------------
# The player gives check (levels 1-2: say what it means).
ann.check.human.b1 = Șah! Regele meu e atacat.
ann.check.human.b1.2 = Șah! Îmi ataci regele.
ann.check.human.b1.3 = E șah! Regele meu trebuie să iasă din șah.
ann.check.human = Șah.
ann.check.human.2 = Șah!
ann.check.human.3 = Și e șah.
# The coach gives check.
ann.check.coach = Șah!
ann.check.coach.2 = Șah.
ann.check.coach.3 = Și șah!
# Once per game at levels 1-2, right after the coach's first check ({your} = the player's king).
ann.check.coach.first = Asta înseamnă că {your} e ataca{your:agr_t}. Trebuie să {your:cl} scoți din șah.
ann.check.coach.first.2 = Șah înseamnă că {your} e sub atac. Mut{your:cl_imp_a}, acoperă șahul sau ia piesa mea.
ann.double_check.coach = Șah dublu! Două dintre piesele mele îți atacă regele deodată, deci el trebuie să se miște.
ann.double_check.coach.2 = E șah dublu: acum te poate ajuta doar o mutare de rege.
ann.double_check.human = Șah dublu! Două dintre piesele tale îmi atacă regele deodată, deci el trebuie să se miște.
ann.double_check.human.2 = Un șah dublu! Acum mă poate salva doar o mutare de rege.
# The player checkmates the coach.
ann.mate.human.b1 = Șah mat! Ai câștigat! Regele meu nu mai are scăpare.
ann.mate.human.b1.2 = E șah mat! Bravo, ai câștigat partida!
ann.mate.human.b1.3 = Șah mat! Regele meu e prins. Felicitări!
ann.mate.human = Șah mat. Bine jucat.
ann.mate.human.2 = E mat. Felicitări.
ann.mate.human.3 = Șah mat! Frumos jucat.
# The coach checkmates the player.
ann.mate.coach.b1 = E șah mat. Regele tău nu mai are nicio ieșire.
ann.mate.coach.b1.2 = Șah mat. Regele tău e atacat și nu poate scăpa.
ann.mate.coach.b1.3 = Mă tem că e șah mat. Regele tău nu mai poate fugi.
ann.mate.coach = Șah mat.
ann.mate.coach.2 = Și e mat.
ann.mate.coach.3 = Șah mat, mă tem.

