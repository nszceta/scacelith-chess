ex.stalemate_trick.b2 = Atenție: pot sacrifica, iar {my} ar fi în pat.
ex.stalemate_trick.b2.2 = {my} aproape că nu mai are câmpuri. Pot forța patul!
ex.stalemate_trick.b3 = Asta îmi permite să scap prin pat: {my} rămâne fără mutări.
ex.stalemate_trick.b3.2 = Atenție: după {line}, {my} e în pat.
ex.stalemate_trick.b4 = {move} permite o capcană de pat: {line}, iar {my} nu se mai poate mișca.
ex.stalemate_trick.b4.2 = Acum {my} se poate salva prin pat: {line}.
ex.stalemate_trick.b5 = {move} permite patul: {line}; {my} e închi{my:agr_s}.
ex.stalemate_trick.b5.2 = Capcană de pat: {line}, iar {my} nu are mutări.
ex.stalemate_trick.b6 = {line}, pat: {my} e închi{my:agr_s}.
ex.stalemate_trick.b6.2 = Pat după {line}; {my} e bloca{my:agr_t}.

# ---- 4. Fork (b1 b2: {my} {t1} {t2} pointed at; b3-b5: {reply} {t1} {t2}; b6: {reply}) ----------
ex.fork.b1 = {my} poate merge pe {sq}, de unde atacă {t1} și {t2}.
ex.fork.b1.2 = {my} merge pe {sq} și atacă două piese: {t1} și {t2}.
ex.fork.b1.3 = Atenție la {my}: de pe {sq} atacă deodată {t1} și {t2}.
