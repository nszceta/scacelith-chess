# Coach speech (Romanian): the rules lesson (level 0, src/coach/lesson.cpp).
# Same keys and variants as assets/coach/speech/en/lesson.lang.
#
# Placeholders: {your} / {my} = a piece of the player / of the coach, with its article and owner
# ("turnul tău", "dama mea"), and the forms of common.lang: {your:dem} "acesta" / "aceasta",
# {my:cl_imp} "-l" / "-o" ("Ia-l!" / "Ia-o!"), {my:cl} "îl" / "o", {my:pron_gen} "lui" / "ei".
# {sq}, {sq2}, {to}, {esc} = squares, never inflected ("pe {sq}", "câmpul {to}"); {move} = a move.
# {@}, {@2}, {@3} are invisible marks: the coach points at something while saying the word right
# after the mark. A ".spoken" key is what the voice says instead (here: file letters spelled).
# Terms (glossary): files = coloane, ranks = linii, back rank = ultima linie, light / dark squares =
# câmpuri deschise / închise la culoare. No adjective or participle about the player.

# ---- Chapter titles (said inside "Continuăm lecția: {chapter}.") --------------------------------------
# Lower case, with the article, always after a colon (see event.lesson.* in events.lang).
lesson.title.welcome = tabla de șah
lesson.title.pieces_lines = cum se mută turnul, nebunul și dama
lesson.title.pieces_steps = cum se mută regele, calul și pionul
lesson.title.values_setup = valoarea pieselor și primele mutări
lesson.title.safety = capturile sigure și cele riscante
lesson.title.check = șahul dat regelui
lesson.title.mate = șahul mat
lesson.title.castling = rocada
lesson.title.en_passant = luarea en passant
lesson.title.promotion = promovarea
lesson.title.draws = patul și remiza
lesson.title.before_move = verificarea înainte de mutare
lesson.title.opening = deschiderea
lesson.title.review = o scurtă recapitulare
lesson.title.etiquette = cum se desfășoară partidele noastre

# ---- Lines every exercise uses ------------------------------------------------------------------------
# After the coach demonstrated the solution.
lesson.now_you = Acum încearcă tu.
lesson.now_you.2 = Acum e rândul tău.
lesson.now_you.3 = Acum tu.
# Another wrong move after the demonstration.
lesson.almost = Aproape! Joacă mutarea pe care ți-am arătat-o.
lesson.almost.2 = Nu chiar. Încearcă mutarea din demonstrația mea.
lesson.almost.3 = Ești aproape. Amintește-ți ce ți-am arătat adineauri.
# A wrong move without a line of its own.
lesson.try_again = Nu e asta. Mai încearcă.
lesson.try_again.2 = Nu mutarea asta. Mai încearcă o dată.
lesson.try_again.3 = Hai să mai încercăm o dată.
lesson.use_your = Folosește {your}.
lesson.use_your.2 = Încearcă cu {your}.
lesson.watch = Uită-te.
lesson.like_this = Uite așa.
lesson.and_back = Și înapoi.
# A check that is not checkmate (the coach then shows the escape).
lesson.check_escape = Șah, dar regele meu scapă pe {esc}.
lesson.check_takes = Șah, dar regele meu ia pur și simplu {your}.
lesson.check_block = Șah, dar pot pune o piesă în cale.
lesson.stalemate = Pat! Regele meu nu se poate muta și nu e în șah. Remiză, deși erai pe câștig!

# ---- Why a move is not allowed (the coach points at the piece or square in question) ----------------
# {sq} = the square in question, {my} = the coach's piece that attacks, pins, blocks or gives
# check, {your} = the piece the player tried to move.
why.KingIntoCheck = Nu pe {sq}: {my} atacă acest câmp. Regele nu se mută niciodată pe un câmp atacat.
why.PathBlocked = Ceva stă în {@}cale: piesele nu pot sări peste altele, cu excepția calului.
why.WrongGeometry = {your} nu se mișcă așa.
why.MustAnswerCheck = Ești în {@}șah: mai întâi trebuie să scapi de el.
why.CastlingThroughCheck = Regele tău ar trece prin {sq}, iar {my} atacă acest câmp.
why.CastlingNoRights = Regele sau acest turn a fost deja mutat: rocada nu mai e posibilă.
why.CastlingBlocked = Pentru rocadă, câmpurile dintre rege și turn trebuie să fie libere.
why.CastlingOutOfCheck = Nu poți face rocada când ești în șah.
why.PawnForwardBlocked = Pionii nu pot lua drept înainte: câmpul din față e {@}blocat.
why.LeavesKingInCheck = {your} e lega{your:agr_t}: dacă {your:cl} muți, regele tău rămâne expus atacului {my:gen}.
why.OwnPieceOnTarget = Nu poți muta pe un câmp ocupat de o piesă de-a ta.
why.PawnCaptureNeedsVictim = Pionul se mișcă pe diagonală doar când ia o piesă.
why.EnPassantExpired = Luarea en passant e permisă doar imediat după ce pionul a avansat două câmpuri.
why.NotYourTurn = Stai puțin: e rândul meu.

# ---- Chapter 0: welcome and the board -------------------------------------------------------------------
lesson.welcome.hello = Salut! Sunt antrenorul tău. Hai să învățăm împreună regulile șahului, pas cu pas.
lesson.welcome.board = Aceasta este tabla de șah: șaizeci și patru de câmpuri, deschise și închise la culoare, opt rânduri a câte opt.
lesson.welcome.light = Câmpul din colț, din {@}dreapta ta, e mereu deschis la culoare. Ține minte: câmp deschis în dreapta.
lesson.welcome.files = Rândurile verticale se numesc coloane. Sunt notate cu litere, de la {@}a până la {@2}h.
lesson.welcome.files.spoken = Rândurile verticale se numesc coloane. Sunt notate cu litere, de la {@}a până la {@2}haș.
lesson.welcome.ranks = Rândurile orizontale se numesc linii. Sunt numerotate de la {@}unu la {@2}opt, începând din partea ta.
lesson.welcome.square = Fiecare câmp are un nume: întâi litera, apoi numărul. Acesta este câmpul {sq}.
lesson.welcome.square2 = Iar acesta este {sq}.
lesson.welcome.kings = Aceștia sunt cei doi regi. Al tău e pe {sq}, al meu pe {sq2}.
lesson.welcome.ask = E rândul tău: mută-ți regele un câmp înainte, pe {sq}.
lesson.welcome.wrong = Acesta e câmpul {to}. Noi vrem {sq}: litera e, numărul doi.
lesson.welcome.ok = Perfect. Regele tău e pe {sq}.

# ---- Chapter 1: how the pieces move and capture -----------------------------------------------------------
# Rook
lesson.rook.intro = {your:dem} este {your}. Se mută în linie dreaptă, pe coloane și pe linii, oricât de departe.
lesson.rook.lines = În sus pe coloană, {@}sau de-a lungul liniei.
lesson.rook.capture = Ca să ia, o piesă se mută pe câmpul unei piese {@}adverse, care apoi iese de pe tablă.
lesson.rook.ask = Ia {my} cu turnul tău!
lesson.rook.short = Direcția e bună! Mergi mai departe în sus pe coloană, până la {my}.
lesson.rook.rank = Asta e pe linie. {my} e mai sus, pe coloană.
lesson.rook.king = Acela e regele tău. Folosește {your}, din colț.
lesson.rook.ok = Captură reușită! {my} iese de pe tablă.
# Pieces don't jump
lesson.jump.blocked = Piesele nu pot sări peste altele. Pionul tău de pe {sq} blochează drumul turnului.
lesson.jump.all = La fel e și cu nebunul, și cu dama: nici ei nu pot sări peste alte piese.
# Bishop
lesson.bishop.intro = {your:dem} este {your}. Se mută pe diagonală, oricât de departe.
lesson.bishop.colour = Un nebun rămâne mereu pe câmpuri de aceeași culoare.
lesson.bishop.ask = {my} stă pe diagonala nebunului tău. Ia{my:cl_imp}!
lesson.bishop.short = Diagonala e bună! Mergi mai departe, până ajungi la {my}.
lesson.bishop.other = Aceea e cealaltă diagonală. Uită-te spre {my}.
lesson.bishop.ok = Excelent. Nebunii iubesc diagonalele lungi.
# Queen
lesson.queen.intro = {your:dem} este {your}, cea mai puternică piesă. Se mută ca un turn și un nebun la un loc.
lesson.queen.ask = Găsește {my} și ia{my:cl_imp} cu dama ta.
lesson.queen.wrong = Dama ta poate ajunge la {my} dintr-o singură mutare, pe diagonală.
lesson.queen.ok = Bravo! Ține-ți dama la adăpost: valorează mult.
# King
lesson.king.intro = Regele se mută doar un câmp, în orice direcție.
lesson.king.important = Regele este cea mai importantă piesă. Dacă nu mai are scăpare, partida e pierdută.
lesson.king.ask = Și regele poate lua. Ia {my}!
lesson.king.wrong = Regele tău e chiar lângă {my}. Pășește cu regele pe câmpul {my:pron_gen} ca să {my:cl} iei.
lesson.king.ok = Bine! Regele e lent, dar puternic de aproape.
# Knight
lesson.knight.intro = {your:dem} este {your}. Se mută în formă de L: două câmpuri drept, apoi unul în lateral.
lesson.knight.intro.spoken = {your:dem} este {your}. Se mută în formă de le: două câmpuri drept, apoi unul în lateral.
lesson.knight.l = Uite {@}așa. Ajunge mereu pe un câmp de cealaltă culoare.
lesson.knight.jump = Calul este singura piesă care poate sări peste altele.
lesson.knight.ask = Ia {my} cu calul tău!
lesson.knight.wrong = E o mutare corectă de cal, dar nu ajunge la {my}. Încearcă alt L.
lesson.knight.wrong.spoken = E o mutare corectă de cal, dar nu ajunge la {my}. Încearcă alt le.
lesson.knight.ok = Ce săritură frumoasă!
# Pawn: moving
lesson.pawn.intro = Acum, {your}. Se mută drept înainte, câte un câmp, și niciodată înapoi.
lesson.pawn.first = La prima lui mutare, un pion poate avansa un câmp sau două.
lesson.pawn.ask = Mută-ți pionul două câmpuri înainte.
lesson.pawn.one = Doar un câmp: e permis, dar de data asta avansează două.
lesson.pawn.use = Folosește pionul.
lesson.pawn.ok = Bine.
# Pawn: capturing
lesson.pawncap.blocked = Pionul meu îl blochează pe al tău. Pionii nu pot lua drept înainte.
lesson.pawncap.diagonal = Dar un pion ia pe diagonală, un câmp înainte.
lesson.pawncap.ask = Ia {my} cu pionul tău.
lesson.pawncap.use = Folosește {your}: ia pe diagonală, înainte.
lesson.pawncap.ok = Da! Drept ca să avansezi, pe diagonală ca să iei.
# Values, set-up and the first moves
lesson.values.pawn = Fiecare piesă are o valoare în puncte. Un pion valorează un punct.
lesson.values.pieces = Un cal sau un {@}nebun, trei. Un {@2}turn, cinci. {@3}Dama, nouă.
lesson.values.king = Regele e de neprețuit: nu-l poți da niciodată.
lesson.values.trade = Nu da o piesă mai mare pe una mai mică, decât dacă câștigi mai mult decât pierzi.
# Practice: two pieces nothing defends ({sq} = the queen's square, {sq2} = the pawn's, {my} = the queen)
lesson.values.two = Calul tău atacă două piese de-ale mele: {sq} și {sq2}. Niciuna nu e apărată.
lesson.values.ask = Ia piesa care valorează mai mult!
lesson.values.small = Acela e un pion, care valorează unu. Și {my} era gratis, iar ea valorează nouă.
lesson.values.look = Uită-te la ce atacă calul tău și ia piesa care valorează mai mult.
lesson.values.ok = Da! Dama valorează nouă. Când două piese sunt libere, ia-o pe cea mai mare.
lesson.setup.corners = Orice partidă începe așa: turnurile în {@}colțuri, apoi {@2}caii, apoi {@3}nebunii.
lesson.setup.queen = Dama stă pe câmpul de culoarea ei: dama ta e pe un câmp deschis la culoare.
lesson.setup.king = Regele stă lângă ea. Albul mută întotdeauna primul.
lesson.first.ask = Începe partida: mută pionul din fața regelui tău două câmpuri, pe {sq}.
lesson.first.wrong = Și aceasta e o mutare permisă! Deocamdată, te rog, mută pionul regelui pe {sq}.
lesson.first.ok = O primă mutare excelentă: deschide linii pentru dama ta și pentru nebunul tău.
lesson.first.reply = Eu răspund la fel. Acum scoate un cal: sari de pe {sq} pe {sq2}.
lesson.first.knight_wrong = Caii sar peste pioni. Încearcă de pe {sq} pe {sq2}.
lesson.first.knight_ok = Perfect. Caii și nebunii ies devreme în joc.

# ---- Chapter 2: safe and unsafe captures ---------------------------------------------------------------------
lesson.safety.defended = O piesă e apărată când o piesă de aceeași culoare poate lua înapoi.
lesson.safety.pawn = {@}Pionul meu apără {my}.
lesson.safety.free = Dar {my} nu are niciun apărător. Dama ta atacă ambele piese.
lesson.safety.ask = Ia piesa neapărată!
lesson.safety.watch = Uite ce se întâmplă.
lesson.safety.gave = Ți-ai dat dama, care valorează nouă, pe calul meu, care valorează trei.
lesson.safety.other = Încearcă cealaltă piesă.
lesson.safety.look = Caută piesa pe care n-o apără nimic.
lesson.safety.ok = Excelent! Întreabă-te mereu: piesa aceea e apărată?
lesson.safety.pawns = Dama ta atacă doi pioni de-ai mei: {sq} și {sq2}.
lesson.safety.pawns_ask = Ia pionul pe care îl poți lua fără risc.
lesson.safety.gave_pawn = Ți-ai dat dama, care valorează nouă, pe un pion, care valorează unu.
lesson.safety.pawns_other = Și un pion poate fi apărat. Încearcă celălalt pion.
lesson.safety.pawns_ok = Corect! Nu-ți risca niciodată dama pentru un pion apărat.
lesson.safety.small = Acum invers. {my} e apărată, dar pionul tău o atacă.
lesson.safety.small_count = Dacă o iei, {@}pionul meu îl ia pe al tău înapoi. Dai un punct și câștigi nouă.
lesson.safety.small_ask = Ia dama mea cu piesa potrivită!
lesson.safety.small_other = Ia-o cu pionul tău: e cea mai ieftină piesă care o poate lua.
lesson.safety.small_look = Pionul tău atacă dama mea. Ia-o cu el.
lesson.safety.small_ok = Da! O piesă mică poate lua una mare, chiar apărată: pierzi un punct și câștigi nouă.
lesson.safety.count = Înainte de fiecare captură, numără ce câștigi și ce ai putea pierde la schimb.

# ---- Chapter 3: check and getting out of check -----------------------------------------------------------------
lesson.danger.rank = Turnul meu controlează toată linia a doua.
lesson.danger.rule = Regele nu se poate muta niciodată pe un câmp unde ar putea fi luat.
lesson.danger.ask = Mută-ți regele pe un câmp sigur.
lesson.danger.ok = Corect. Acolo regele tău e în siguranță.
lesson.check.what = Turnul meu îți atacă regele. Asta se numește șah.
lesson.check.must = Când ești în șah, trebuie să scapi imediat de el.
lesson.check.ways = Ai trei posibilități: {@}muți regele, {@2}blochezi atacul sau {@3}iei piesa care atacă.
lesson.check.ask = Aici, scoate-ți regele din șah.
lesson.check.file = Câmpul {to} e tot pe coloana {@}turnului meu. Ieși din bătaia lui.
lesson.check.ok = Bine: nu mai ești în șah.
lesson.block.again = Iar șah! De data asta regele tău nu are niciun câmp liber.
lesson.block.ask = Atunci blochează atacul: pune o piesă în cale.
lesson.block.queen = Așa blochezi! Dar turnul meu ți-ar putea lua dama. Blochează cu o piesă de valoare mai mică.
lesson.block.queen_ok = Merge. Ține minte: blochezi cu piesa cea mai puțin valoroasă.
lesson.block.ok = Perfect. Blochează cu piesa ta de cea mai mică valoare.
lesson.capture.check = Dama mea dă șah, chiar lângă regele tău.
lesson.capture.ask = Ia piesa care atacă!
lesson.capture.king_ok = Da! Dama mea nu avea niciun apărător, așa că regele tău a putut s-o ia.
lesson.capture.knight_ok = Da! Calul tău a eliminat piesa care ataca.
lesson.check.open.ask = Iar șah! De data asta scapă de el oricum vrei.
lesson.check.open.king = Ți-ai mutat regele din bătaie. Puteai și să blochezi cu o piesă, sau calul tău putea lua turnul meu.
lesson.check.open.block = Ai blocat atacul. Regele tău putea și să se dea la o parte, sau calul tău putea lua turnul meu.
lesson.check.open.take = Ai luat turnul meu, piesa care dădea șah. Ar fi mers și mutarea regelui, sau blocarea.
lesson.check.open.hint = Trei posibilități: {@}muți regele, {@2}blochezi pe coloană sau {@3}iei turnul meu cu calul.

# ---- Chapter 4: checkmate ------------------------------------------------------------------------------------
lesson.mate1.what = Șah mat: regele e în șah și nu are nicio scăpare. Asta câștigă partida.
lesson.mate1.stuck = Regele meu e blocat în spatele {@}propriilor pioni.
lesson.mate1.ask = Dă-mi mat într-o mutare!
lesson.mate1.wrong = Aproape! Dă șah pe ultima linie, unde regele meu nu are scăpare.
lesson.mate1.ok = Șah mat! Acesta e matul pe ultima linie. Ține-l minte!
lesson.mate1.king = Regele tău e bine acolo unde e. Dă șah cu turnul.
lesson.mate1.why = Vezi? Turnul controlează {@}toată ultima mea linie, iar {@2}propriii mei pioni ocupă câmpurile din fața regelui meu.
lesson.mate2.ask = Regele tău și dama ta lucrează în echipă. Dă-mi mat într-o mutare.
lesson.mate2.wrong = Găsește un șah care nu-i lasă regelui meu niciun câmp.
lesson.mate2.ok = Șah mat! Regele tău apără dama, așa că al meu nu o poate lua.
lesson.mate2.ok_rank = Mat pe ultima linie! Regele tău controlează toate câmpurile din fața regelui meu.
lesson.mate2.king = Regele tău păzește câmpurile de lângă al meu. Lasă-l acolo și folosește dama.
lesson.mate2.half = Așa controlezi {sq}, dar regele meu mai poate merge pe {sq2}.
lesson.mate2.why = Vezi? Dama ta acoperă {sq} și {sq2}, iar regele tău acoperă câmpurile din fața regelui meu. Regele meu nu mai are scăpare.
lesson.mate3.edge = Turnul tău de pe linia a șaptea îmi ține regele pe margine.
lesson.mate3.ask = Acum folosește {your} ca să dai mat.
lesson.mate3.free = Șah, dar linia a șaptea e acum liberă, iar regele meu scapă.
lesson.mate3.takes = Regele meu îți ia pur și simplu turnul.
lesson.mate3.hint = Dă șah pe ultima linie cu turnul care nu păzește linia a șaptea.
lesson.mate3.ok = Șah mat! Cele două turnuri au lucrat împreună, ca o scară.
lesson.mate3.why = Vezi? Un turn taie linia a {@}șaptea, iar celălalt dă șah pe {@2}ultima linie. Regele meu nu mai are scăpare.
lesson.mate4.look = Șahul nu e mereu șah mat. Să vedem ce se întâmplă.
lesson.mate4.ask = Dă șah regelui meu cu turnul.
lesson.mate4.king = Regele tău rămâne unde e. Dă șah cu turnul.
lesson.mate4.wrong = Asta nu e șah. Turnul tău poate ataca regele meu de pe ultima linie.
lesson.mate4.ok = Da, e șah! Dar e și mat? Privește.
lesson.mate4.after = Pionul meu de pe {sq} a lăsat loc regelui meu. Înainte să te bucuri de un șah, numără câmpurile pe care regele meu le mai poate folosi.
lesson.mate5.ask = Două mutări de turn dau șah și doar una dă mat. Numără câmpurile regelui meu, apoi alege.
lesson.mate5.king = Regele tău acoperă deja {sq} și {sq2}. Lasă-l acolo și mută turnul.
lesson.mate5.wrong = Asta nu e șah. Caută o mutare de turn care atacă regele meu.
lesson.mate5.hint = Regele tău acoperă {sq} și {sq2}. Care șah de turn îmi ia și câmpul {sq3}?
lesson.mate5.why = Vezi? Turnul acoperă {sq}, regele tău acoperă celelalte două câmpuri, iar regele meu e blocat.
lesson.mate5.ok = Șah mat! Ai numărat câmpurile regelui meu: nu mai rămăsese niciunul.

# ---- Chapter 5: castling ---------------------------------------------------------------------------------------
lesson.castle.what = Rocada e o mutare specială care îți pune regele la adăpost. Regele și turnul se mută împreună.
lesson.castle.how = {@}Regele se mută două câmpuri spre un turn, iar {@2}turnul sare de cealaltă parte a lui.
lesson.castle.ask = Atinge întotdeauna întâi regele. Acum tu: fă rocada mică, pe flancul regelui.
lesson.castle.rook = Așa muți doar turnul. Pentru rocadă, mută-ți regele două câmpuri spre el.
lesson.castle.long = Asta e rocada mare, și ea permisă! De data asta, fă rocada spre turnul mai apropiat.
lesson.castle.one = Un singur câmp e o mutare obișnuită de rege. La rocadă, regele se mută două câmpuri.
lesson.castle.other = Pentru rocadă, mută-ți regele două câmpuri spre turnul de pe {sq}.
lesson.castle.ok = Rocada e făcută! Regele tău e la adăpost, iar turnul e gata de joc.
lesson.castle2.moved = Nu poți face rocada dacă regele tău sau turnul acela a fost deja mutat.
lesson.castle2.attacked = Nici când ești în șah, nici dacă regele tău ar trece printr-un câmp atacat sau ar ajunge pe unul.
lesson.castle2.bishop = Nebunul meu atacă {sq}. Așa că rocada pe partea asta e interzisă acum.
lesson.castle2.ask = Fă rocada pe partea cealaltă.
lesson.castle2.other = Fă rocada spre celălalt turn, pe flancul damei.
lesson.castle2.ok = Corect! Rocada mare îți duce regele pe {sq}.
lesson.ep0.rule = En passant începe cu pasul dublu. Doar un pion {@}rămas acasă poate avansa două câmpuri. Un pion care {@2}s-a mutat deja merge câte un câmp.
lesson.ep0.ask = Mută unul dintre pionii tăi două câmpuri.
lesson.ep0.moved = Pionul acela s-a mutat deja, așa că poate avansa doar un câmp. Folosește un pion rămas acasă.
lesson.ep0.ok = Corect: doar un pion de pe câmpul de start poate avansa două.

# ---- Chapter 6: en passant ------------------------------------------------------------------------------------
lesson.ep.what = O captură specială cu pionul se numește en passant. Înseamnă „în trecere”.
lesson.ep.watch = Urmărește pionul meu: avansează două câmpuri și ajunge chiar lângă al tău.
lesson.ep.how = Pionul tău îl poate lua ca și cum ar fi avansat doar un câmp: pe {sq}.
lesson.ep.now = Dar numai acum, la mutarea asta. Ia en passant!
lesson.ep.gone = Ocazia a trecut: luarea en passant e posibilă doar imediat. Mai încercăm o dată.
lesson.ep.ok = En passant! Pionul meu de pe {sq} iese de pe tablă.
lesson.ep2.old = Pionul meu de pe {sq} stă lângă al tău de ceva vreme. E prea târziu să-l iei en passant.
lesson.ep2.watch = Acum urmărește celălalt pion al meu.
lesson.ep2.ask = Doi pioni de-ai mei stau lângă al tău, dar doar unul tocmai a avansat două câmpuri. Ia-l pe acela en passant!
lesson.ep2.push = Asta doar îți avansează pionul. Ia pionul care tocmai a avansat două câmpuri.
lesson.ep2.wrong = Caută pionul care tocmai a făcut pasul dublu și ia-l en passant.
lesson.ep2.hint = Pionul meu de pe {sq} tocmai a avansat două câmpuri. Ia-l en passant, pe {sq2}.
lesson.ep2.ok = En passant! Pionul meu de pe {sq} nu mai putea fi luat: ocazia lui trecuse.

# ---- Chapter 7: promotion -------------------------------------------------------------------------------------
lesson.promo.what = Când un pion ajunge pe ultima linie, este promovat: se transformă în damă, turn, nebun sau cal.
lesson.promo.ask = Aproape întotdeauna, alege dama. Promovează-ți pionul acum!
lesson.promo.under = E permis! Dar dama e mai puternică. Hai să alegem dama.
lesson.promo.under_ok = Bine. Totuși, majoritatea jucătorilor aleg dama.
lesson.promo.push = Avansează cu pionul până pe ultima linie, pe {sq}.
lesson.promo.ok = O damă nouă! Poți avea chiar și două dame în același timp.
lesson.promo2.ask = Un pion poate promova și luând, pe diagonală. Ia turnul meu și fă o damă!
lesson.promo2.push = Și asta promovează, dar turnul meu apără {sq}. Privește.
lesson.promo2.lost = Turnul meu ți-a luat piesa nouă. Ia mai întâi turnul meu.
lesson.promo2.wrong = Asta nu ia turnul meu. Pionul tău ia pe diagonală, pe {sq}.
lesson.promo2.hint = Ia turnul meu cu pionul, pe {sq}: promovează în timp ce ia.
lesson.promo2.ok = Luat și promovat! Un pion poate face ambele într-o singură mutare.

# ---- Chapter 8: stalemate and draws -----------------------------------------------------------------------------
lesson.stale.what = E rândul meu. Regele meu nu e în șah, dar {@}toate câmpurile din jurul lui sunt atacate.
lesson.stale.draw = Nu am nicio mutare legală. Asta e pat, iar partida e remiză.
lesson.stale2.ask = Când ești pe câștig, ferește-te de pat. Dă-mi mat într-o mutare, fără pat!
lesson.stale2.wrong = Găsește un șah care nu-i lasă regelui meu niciun câmp. Atenție: o mutare liniștită mă poate pune pat.
lesson.stale2.king = Regele tău acoperă deja {sq} și {sq2}. Lasă-l acolo și folosește dama.
lesson.stale2.hint = Regele tău acoperă {sq} și {sq2}. Dă-mi șah pe ultima linie și regele meu nu mai are unde merge.
lesson.stale2.why = Vezi? Regele meu e atacat {@}și nu are niciun câmp liber: e mat. Fără șah ar fi fost pat.
lesson.stale2.ok = Șah mat! Lasă-i mereu regelui advers o mutare, în afară de cazul în care îi dai mat.
lesson.draws.kings = Alte remize: când nimeni nu mai poate da mat, de exemplu când au rămas doar cei doi regi, partida e remiză.
lesson.draws.agree = Jucătorii pot și să cadă de acord asupra remizei.
lesson.draws.repeat = Remiza e posibilă și când aceeași poziție apare de trei ori sau după cincizeci de mutări fără nicio captură și fără nicio mutare de pion.

# ---- Chapter 9: before you move (the safety habit) ----------------------------------------
lesson.before.habit = Înainte de fiecare mutare, oprește-te și privește. Jucătorii buni fac asta mereu.
lesson.before.last = Prima întrebare: ce a făcut ultima mea mutare? Privește.
lesson.before.threat = {my} atacă {your}. Asta e o amenințare.
lesson.before.safe = Nu e destul să te muți de acolo. Și câmpul nou trebuie să fie sigur.
lesson.before.dodge.ask = Mută-ți calul pe un câmp sigur.
lesson.before.dodge.still = Calul tău e tot atacat. Privește.
lesson.before.dodge.hint = Pionii mei apără {sq} și {sq2}. Alege alt câmp.
lesson.before.dodge.ok = Sigur! Ai văzut amenințarea și ai verificat câmpul.
# A wrong move onto a guarded square ({my} guards {to}); the coach then takes the piece.
lesson.before.unsafe = Nu pe {to}: {my} apără acel câmp. Privește.
# Said after the coach took the piece, before the move is taken back.
lesson.before.lost = Ai pierdut {your}. Mai întâi privește, apoi mută.
lesson.before.again = Încă o dată, mai întâi mut eu. Privește.
lesson.before.free.ask = Privește ultima mea mutare. Poți lua ceva gratis?
lesson.before.free.missed = Privește din nou {my}. Cine poate {my:cl} lua?
lesson.before.free.hint = {my} nu are apărare. {@}Pionul tău poate {my:cl} lua.
lesson.before.free.ok = Da! Nebunul meu era liber. Privește mereu ultima mea mutare.
lesson.before.check.ask = Dă-mi șah de pe un câmp unde nu pot lua piesa ta.
lesson.before.check.wrong = Nu e șah. Găsește un șah de pe un câmp sigur.
lesson.before.check.hint = {my} apără {sq}. Dă șah de pe un câmp sigur.
lesson.before.check.ok = Șah bun! Dama ta e în siguranță acolo.
lesson.before.done = Fă din asta un obicei: mai întâi privește, apoi mută.

# ---- Chapter 10: the opening ------------------------------------------------------------
lesson.opening.what = Deschiderea e începutul partidei. Câteva reguli simple ajută.
lesson.opening.goals = {@}Ia centrul, {@2}scoate caii și nebunii și {@3}fă rocada devreme.
lesson.opening.centre = Cele patru câmpuri din {@}mijloc formează centrul.
lesson.opening.pawn.ask = Pune un pion în centru: două câmpuri înainte.
lesson.opening.pawn.one = Nu e rău, dar două câmpuri iau mai mult din centru.
lesson.opening.pawn.knight = Caii vin imediat. Mai întâi, un pion în centru.
lesson.opening.pawn.wrong = Folosește pionul din fața regelui sau al damei.
lesson.opening.pawn.ok = Bine! Pionul tău ocupă loc în centru.
lesson.opening.queen = Nu scoate dama devreme: piesele mele ar alunga-o.
lesson.opening.knight.ask = Scoate un cal, spre centru.
lesson.opening.rim = Un cal pe margine ajunge la puține câmpuri. Sari spre centru.
lesson.opening.bishop = Dezvoltarea e bună! Dar de data asta, un cal.
lesson.opening.knight.ok = Bine! De acolo calul tău supraveghează centrul.
lesson.opening.later = Câteva mutări mai târziu: calul tău și {@}nebunul tău sunt scoși.
lesson.opening.twice = Nu muta aceeași piesă de două ori fără un motiv bun.
lesson.opening.castle.ask = Drumul e liber. Fă rocada ca să-ți pui regele la adăpost.
lesson.opening.castle.wrong = Regele tău e gata. Fă rocada acum, cât timp drumul e liber.
lesson.opening.castle.ok = Rocadă făcută! Regele tău e în siguranță, iar turnul intră în joc.
lesson.opening.done = Centru, piese, rocadă: e un început bun pentru orice partidă.

# ---- Chapter 11: review (no teaching: the coach only asks) ------------------------------------------------
lesson.review.start = Recapitulare rapidă, de data asta în altă ordine. Nu explic nimic: tu îmi arăți.
lesson.review.promo.ask = Promovează pionul acesta.
lesson.review.promo.ok = Bine: o damă nouă, și cu șah!
lesson.review.check.ask = Regele tău e în șah. Scapă de el.
lesson.review.check.ok = Ai scăpat de șah. Bine.
lesson.review.castle.ask = Fă rocada, pe partea unde e permisă.
lesson.review.castle.other = Asta nu e rocadă. Fă rocada pe partea unde e permisă.
lesson.review.castle.ok = Rocadă făcută, pe partea sigură!
lesson.review.ep.ask = Ia pionul meu en passant.
lesson.review.ep.ok = En passant! Ți-ai amintit.
lesson.review.mate.ask = Dă-mi mat într-o mutare.
lesson.review.mate.ok = Șah mat! Recapitularea s-a încheiat.

# ---- Chapter 12: how our games work (no rating, no clock, touch-move, help, manners) ---------------------
lesson.talk.rules = Acum cunoști toate regulile șahului. Bravo!
lesson.talk.real = Hai să-ți spun cum se vor desfășura partidele noastre.
lesson.talk.no_clock = Cu mine nu există ceas și nici rating. Gândește-te cât ai nevoie.
lesson.talk.touch = O piesă pe care ai atins-o trebuie mutată, așa că privește întâi, apoi atinge.
lesson.talk.handshake = Partidele încep și se termină cu o strângere de mână. Înseamnă: partidă frumoasă și mulțumesc.
lesson.talk.polite = Câștigi sau pierzi, politețea e pe primul loc. Și nu-ți deranja niciodată adversarul cât timp se gândește.
lesson.talk.help = În partidele noastre te ajut. Dacă una dintre piesele tale e atacată sau rămâne fără apărare, îți spun.
lesson.talk.help_back = După o greșeală mare, îți arăt de ce și îți ofer să iei mutarea înapoi.
lesson.talk.help_skip = Iar dacă vorbesc prea mult, apasă Spațiu: mă opresc.
lesson.talk.next = Când ești gata, joacă „Primii pași”. Voi juca blând.
lesson.talk.welcome = Bun venit în lumea șahului! Hai să dăm mâna.
