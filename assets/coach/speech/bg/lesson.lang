# Coach speech (Bulgarian): the rules lesson (level 0, src/coach/lesson.cpp).
# Same keys and variants as assets/coach/speech/en/lesson.lang.
#
# Placeholders: {your} / {my} = a piece of the player / of the coach ("конят ти", "офицерът ми"),
# with the forms of common.lang: {my:obj} after a verb or a preposition ("Вземи коня ми"),
# {your:refl} when the player acts with their own piece ("Използвай коня си"), {your:pron} /
# {my:pron_obj} / {my:pron_dat} for the pronouns (той/тя, го/я, му/ѝ), {your:a} for the feminine
# ending of a participle ("свързан{your:a}"). {sq}, {sq2}, {to}, {esc} = squares ("на {sq}",
# "полето {to}"); {move} = a move. {@}, {@2}, {@3} are invisible marks: the coach points at
# something while saying the word right after the mark. A ".spoken" key is what the voice says
# instead (here: the Latin file letters said as their Cyrillic names, "Elo" in Cyrillic, and the
# letter "Г" of the knight's move said as its letter name "гъ").
# Files = вертикали, ranks = хоризонтали, back rank = задната линия, castling kingside / queenside =
# малка / голяма рокада. No l-participle or adjective about the player (gender unknown).

# ---- Chapter titles (said inside "Да продължим с темата „{chapter}“.") ---------------------------------
# Lower-case noun phrases (see event.lesson.* in events.lang).
lesson.title.welcome = шахматната дъска
lesson.title.pieces_lines = как се движат топът, офицерът и дамата
lesson.title.pieces_steps = как се движат царят, конят и пешката
lesson.title.values_setup = стойността на фигурите и първите ходове
lesson.title.safety = безопасни и опасни вземания
lesson.title.check = шах
lesson.title.mate = мат
lesson.title.castling = рокада
lesson.title.en_passant = вземане ан пасан
lesson.title.promotion = произвеждане на пешка
lesson.title.draws = пат и реми
lesson.title.before_move = преди хода
lesson.title.opening = дебютът
lesson.title.review = бързото повторение
lesson.title.etiquette = как играем нашите партии

# ---- Lines every exercise uses ------------------------------------------------------------------------
# After the coach demonstrated the solution.
lesson.now_you = Сега опитай ти.
lesson.now_you.2 = Сега ти си на ход.
lesson.now_you.3 = Сега ти.
# Another wrong move after the demonstration.
lesson.almost = Почти! Изиграй хода, който ти показах.
lesson.almost.2 = Не съвсем. Опитай хода от моя пример.
lesson.almost.3 = Близо си. Спомни си какво ти показах току-що.
# A wrong move without a line of its own.
lesson.try_again = Не е това. Опитай пак.
lesson.try_again.2 = Не този ход. Пробвай отново.
lesson.try_again.3 = Да опитаме още веднъж.
lesson.use_your = Използвай {your:refl}.
lesson.use_your.2 = Опитай с {your:refl}.
lesson.watch = Гледай.
lesson.like_this = Ето така.
lesson.and_back = И обратно.
# A check that is not checkmate (the coach then shows the escape).
lesson.check_escape = Шах, но царят ми бяга на {esc}.
lesson.check_takes = Шах, но царят ми просто взема {your:obj}.
lesson.check_block = Шах, но мога да се закрия с фигура.
lesson.stalemate = Пат! Царят ми няма ход и не е под шах. Реми, макар че печелеше!

# ---- Why a move is not allowed (the coach points at the piece or square in question) ----------------
# {sq} = the square in question, {my} = the coach's piece that attacks, pins, blocks or gives
# check, {your} = the piece the player tried to move.
why.KingIntoCheck = Не на {sq}: {my} напада това поле. Царят никога не застава под удар.
why.PathBlocked = Нещо препречва {@}пътя: фигурите не могат да прескачат други, освен коня.
why.WrongGeometry = {your} не се движи така.
why.MustAnswerCheck = Под {@}шах си: първо трябва да се справиш с него.
why.CastlingThroughCheck = Царят ти би минал през {sq}, а {my} напада това поле.
why.CastlingNoRights = Този цар или топ вече се е движил: рокада не е възможна.
why.CastlingBlocked = За рокада полетата между царя и топа трябва да са празни.
why.CastlingOutOfCheck = Не можеш да правиш рокада, докато си под шах.
why.PawnForwardBlocked = Пешките не вземат право напред: това поле е {@}заето.
why.LeavesKingInCheck = {your} е свързан{your:a}: ако {your:pron_obj} преместиш, царят ти ще остане под удара на {my:obj}.
why.OwnPieceOnTarget = Не можеш да стъпиш на поле, заето от твоя собствена фигура.
why.PawnCaptureNeedsVictim = Пешката се движи по диагонал само когато взема.
why.EnPassantExpired = Вземане ан пасан е позволено само веднага след хода на пешката с две полета.
why.NotYourTurn = Чакай: сега е мой ход.

# ---- Chapter 0: welcome and the board -------------------------------------------------------------------
lesson.welcome.hello = Здравей! Аз съм твоят треньор. Да научим заедно правилата на шаха, стъпка по стъпка.
lesson.welcome.board = Това е шахматната дъска: шестдесет и четири полета, светли и тъмни, осем реда по осем.
lesson.welcome.light = Ъгловото поле {@}вдясно от теб винаги е светло. Запомни: вдясно – светло.
lesson.welcome.files = Колоните се наричат вертикали. Те се означават с букви, от {@}a до {@2}h.
lesson.welcome.files.spoken = Колоните се наричат вертикали. Те се означават с букви, от {@}а до {@2}аш.
lesson.welcome.ranks = Редовете се наричат хоризонтали. Те се означават с числа, от {@}едно до {@2}осем, като започват от твоята страна.
lesson.welcome.square = Всяко поле се назовава с буквата си, а после с числото си. Това поле е {sq}.
lesson.welcome.square2 = А това е {sq}.
lesson.welcome.kings = Това са двата царя. Твоят е на {sq}, моят – на {sq2}.
lesson.welcome.ask = Твой ход: премести царя си едно поле напред, на {sq}.
lesson.welcome.wrong = Това е {to}. Трябва ни {sq}: буквата e, числото две.
lesson.welcome.wrong.spoken = Това е {to}. Трябва ни {sq}: буквата е, числото две.
lesson.welcome.ok = Отлично. Царят ти е на {sq}.

# ---- Chapter 1: how the pieces move and capture -----------------------------------------------------------
# Rook
lesson.rook.intro = Това е {your}. {your:pron} се движи по права линия, по вертикалите и хоризонталите, на колкото полета поиска.
lesson.rook.intro.spoken = Това е {your}. {your:pron} се движи по пра́ва линия, по вертикалите и хоризонталите, на колкото полета поиска.
lesson.rook.lines = Нагоре по вертикалата {@}или по хоризонталата.
lesson.rook.capture = За да вземе, фигурата застава на мястото на {@}противникова фигура, а тя напуска дъската.
lesson.rook.ask = Вземи {my:obj} с топа си!
lesson.rook.short = Посоката е правилна! Продължи нагоре по вертикалата, чак до {my:obj}.
lesson.rook.rank = Това е по хоризонталата. {my} е нагоре по вертикалата.
lesson.rook.king = Това е царят ти. Използвай {your:refl} в ъгъла.
lesson.rook.ok = Готово! {my} напуска дъската.
# Pieces don't jump
lesson.jump.blocked = Фигурите не могат да прескачат други фигури. Пешката ти на {sq} препречва пътя на топа.
lesson.jump.all = Същото важи за офицера и дамата: и те не могат да прескачат фигури.
# Bishop
lesson.bishop.intro = Това е {your}. {your:pron} се движи по диагонал, на колкото полета поиска.
lesson.bishop.colour = Офицерът винаги остава на полета от един и същ цвят.
lesson.bishop.ask = {my} стои на диагонала на офицера ти. Вземи {my:pron_obj}!
lesson.bishop.short = Правилният диагонал! Продължи, докато стигнеш до {my:obj}.
lesson.bishop.other = Това е другият диагонал. Погледни към {my:obj}.
lesson.bishop.ok = Отлично. Офицерите обичат дългите диагонали.
# Queen
lesson.queen.intro = Това е {your}, най-силната фигура. {your:pron} се движи като топ и офицер, взети заедно.
lesson.queen.ask = Намери {my:obj} и {my:pron_obj} вземи с дамата си.
lesson.queen.wrong = Дамата ти може да стигне до {my:obj} с един ход, по диагонал.
lesson.queen.ok = Браво! Пази дамата си: тя струва много.
# King
lesson.king.intro = Царят се движи само с едно поле, във всяка посока.
lesson.king.important = Царят е най-важната фигура. Ако попадне в капан, партията е загубена.
lesson.king.ask = Царят също може да взема. Вземи {my:obj}!
lesson.king.wrong = Царят ти е точно до {my:obj}. Стъпи на полето {my:pron_dat}, за да {my:pron_obj} вземеш.
lesson.king.ok = Добре! Царят е бавен, но отблизо е силен.
# Knight
lesson.knight.intro = Това е {your}. {your:pron} се движи като буквата Г: две полета направо, после едно встрани.
lesson.knight.intro.spoken = Това е {your}. {your:pron} се движи като буквата гъ: две полета направо, после едно встрани.
lesson.knight.l = Ето {@}така. Конят винаги попада на поле от другия цвят.
lesson.knight.jump = Конят е единствената фигура, която може да прескача други.
lesson.knight.ask = Вземи {my:obj} с коня си!
lesson.knight.wrong = Това е истински ход на кон, но не стига до {my:obj}. Опитай друго Г.
lesson.knight.wrong.spoken = Това е истински ход на кон, но не стига до {my:obj}. Опитай друго гъ.
lesson.knight.ok = Страхотен скок!
# Pawn: moving
lesson.pawn.intro = А сега – {your}. {your:pron} се движи право напред, по едно поле, и никога назад.
lesson.pawn.first = При първия си ход пешката може да се придвижи с едно или с две полета.
lesson.pawn.ask = Премести пешката си две полета напред.
lesson.pawn.one = Това е едно поле: позволено е, но този път я премести с две.
lesson.pawn.use = Използвай пешката.
lesson.pawn.ok = Добре.
# Pawn: capturing
lesson.pawncap.blocked = Пешката ми спира твоята. Пешките не могат да вземат право напред.
lesson.pawncap.diagonal = Но пешката взема по диагонал, едно поле напред.
lesson.pawncap.ask = Вземи {my:obj} с пешката си.
lesson.pawncap.use = Използвай {your:refl}: {your:pron} взема по диагонал напред.
lesson.pawncap.ok = Да! Право напред – за ход, по диагонал – за вземане.
# Values, set-up and the first moves
lesson.values.pawn = Всяка фигура има стойност в точки. Пешката струва една точка.
lesson.values.pieces = Конят или {@}офицерът – три. {@2}Топът – пет. {@3}Дамата – девет.
lesson.values.king = Царят е безценен: никога не можеш да го дадеш.
lesson.values.trade = Не давай по-голяма фигура за по-малка, освен ако печелиш повече, отколкото губиш.
lesson.values.two = Конят ти напада две от моите фигури: {sq} и {sq2}. Нищо не защитава нито една от тях.
lesson.values.ask = Вземи по-ценната!
lesson.values.small = Това е пешка, която струва едно. {my} също беше свободна, а тя струва девет.
lesson.values.look = Виж какво напада конят ти и вземи по-ценната фигура.
lesson.values.ok = Да! Дамата струва девет. Когато две фигури са свободни, вземи по-голямата.
lesson.setup.corners = Всяка партия започва така: топовете в {@}ъглите, после {@2}конете, после {@3}офицерите.
lesson.setup.queen = Дамата стои на поле от своя цвят: дамата ти е на светло поле.
lesson.setup.king = Царят стои до нея. Белите винаги започват първи.
lesson.first.ask = Започни партията: премести пешката пред царя си с две полета, на {sq}.
lesson.first.wrong = И това е позволен ход! Но засега, моля те, изиграй царската си пешка на {sq}.
lesson.first.ok = Чудесен първи ход: той отваря път на дамата и офицера ти.
lesson.first.reply = Отговарям по същия начин. Сега изведи кон: скочи от {sq} на {sq2}.
lesson.first.knight_wrong = Конете прескачат пешките. Опитай от {sq} на {sq2}.
lesson.first.knight_ok = Отлично. Конете и офицерите излизат рано.

# ---- Chapter 2: safe and unsafe captures ---------------------------------------------------------------------
lesson.safety.defended = Фигурата е защитена, когато друга фигура от същия цвят може да вземе обратно.
lesson.safety.pawn = {@}Пешката ми защитава {my:obj}.
lesson.safety.free = Но {my} няма защитник. Дамата ти напада и двете фигури.
lesson.safety.ask = Вземи незащитената фигура!
lesson.safety.watch = Гледай какво става.
lesson.safety.gave = Даде дамата си, която струва девет, за коня ми, който струва три.
lesson.safety.other = Опитай с другата фигура.
lesson.safety.look = Търси фигурата, която нищо не защитава.
lesson.safety.ok = Отлично! Винаги се питай: защитена ли е тази фигура?
lesson.safety.pawns = Дамата ти напада две от моите пешки: {sq} и {sq2}.
lesson.safety.pawns_ask = Вземи пешката, която е безопасно да се вземе.
lesson.safety.gave_pawn = Даде дамата си, която струва девет, за пешка, която струва едно.
lesson.safety.pawns_other = Дори пешка може да е защитена. Опитай другата пешка.
lesson.safety.pawns_ok = Точно така! Никога не рискувай дамата си за защитена пешка.
lesson.safety.small = Сега е обратното. {my} е защитена, но пешката ти я напада.
lesson.safety.small_count = Ако я вземеш, моята {@}пешка взема твоята обратно. Даваш една точка и печелиш девет.
lesson.safety.small_ask = Вземи дамата ми с правилната фигура!
lesson.safety.small_other = Вземи я по-добре с пешката си: най-евтината фигура, която може.
lesson.safety.small_look = Пешката ти напада дамата ми. Вземи я с нея.
lesson.safety.small_ok = Да! Малка фигура може да вземе голяма, дори защитена: губиш една точка и печелиш девет.
lesson.safety.count = Преди всяко вземане смятай какво печелиш и какво може да изгубиш обратно.

# ---- Chapter 3: check and getting out of check -----------------------------------------------------------------
lesson.danger.rank = Топът ми контролира цялата втора хоризонтала.
lesson.danger.rule = Царят никога не може да отиде на поле, където би могъл да бъде взет.
lesson.danger.ask = Премести царя си на безопасно поле.
lesson.danger.ok = Правилно. Там царят ти е в безопасност.
lesson.check.what = Топът ми напада царя ти. Това се нарича шах.
lesson.check.must = Когато си под шах, трябва веднага да се измъкнеш от него.
lesson.check.ways = Има три начина: да {@}преместиш царя, да {@2}закриеш атаката или да {@3}вземеш нападащата фигура.
lesson.check.ask = Тук измъкни царя си от шаха.
lesson.check.file = Полето {to} все още е на {@}вертикалата на топа ми. Излез от тази линия.
lesson.check.ok = Добре: вече не си под шах.
lesson.block.again = Пак шах! Този път царят ти няма свободно поле.
lesson.block.ask = Затова закрий атаката: постави фигура на пътя ѝ.
lesson.block.queen = Това закрива шаха! Но топът ми може да вземе дамата ти. Закрий с по-евтина фигура.
lesson.block.queen_ok = Получава се. Запомни: закривай с най-евтината си фигура.
lesson.block.ok = Отлично. Закривай с най-малко ценната си фигура.
lesson.capture.check = Дамата ми дава шах, точно до царя ти.
lesson.capture.ask = Вземи нападащата фигура!
lesson.capture.king_ok = Да! Дамата ми нямаше защитник, затова царят ти можа да я вземе.
lesson.capture.knight_ok = Да! Конят ти премахна нападащата фигура.
lesson.check.open.ask = Пак шах! Този път се измъкни както искаш.
lesson.check.open.king = Отмести царя встрани. Можеше и да закриеш с фигура, или конят ти да вземе топа ми.
lesson.check.open.block = Закри атаката. Можеше и царят ти да отстъпи, или конят ти да вземе топа ми.
lesson.check.open.take = Взе топа ми, фигурата, която дава шах. Можеше и да преместиш царя, или да закриеш.
lesson.check.open.hint = Три начина: да {@}преместиш царя, да {@2}закриеш по вертикалата или да {@3}вземеш топа ми с коня си.

# ---- Chapter 4: checkmate ------------------------------------------------------------------------------------
lesson.mate1.what = Мат: царят е под шах и няма изход. Така се печели партията.
lesson.mate1.stuck = Царят ми е заклещен зад {@}собствените си пешки.
lesson.mate1.ask = Дай ми мат в един ход!
lesson.mate1.wrong = Близо си! Дай шах на задната ми линия, откъдето царят ми не може да избяга.
lesson.mate1.ok = Мат! Това е мат на задната линия. Запомни го!
lesson.mate1.king = Царят ти е добре там, където е. Дай шах с топа.
lesson.mate1.why = Виждаш ли? Топът контролира {@}цялата ми задна линия, а {@2}собствените ми пешки запълват полетата пред царя.
lesson.mate2.ask = Царят и дамата ти работят като отбор. Дай ми мат в един ход.
lesson.mate2.wrong = Намери шах, след който на царя ми не остава нито едно поле.
lesson.mate2.ok = Мат! Царят ти пази дамата, затова моят не може да я вземе.
lesson.mate2.ok_rank = Мат на задната линия! Царят ти пази всички полета пред моя.
lesson.mate2.king = Царят ти пази полетата до моя. Остави го там и използвай дамата.
lesson.mate2.half = Това пази {sq}, но царят ми още може да отиде на {sq2}.
lesson.mate2.why = Виждаш ли? Дамата ти покрива {sq} и {sq2}, а царят ти – полетата пред моя. Царят ми няма изход.
lesson.mate3.edge = Топът ти на седмата хоризонтала държи царя ми на ръба на дъската.
lesson.mate3.ask = Сега дай мат с {your:refl}.
lesson.mate3.free = Шах, но сега седмата хоризонтала е свободна и царят ми избягва.
lesson.mate3.takes = Царят ми просто взема топа ти.
lesson.mate3.hint = Дай шах на задната линия с топа, който не пази седмата хоризонтала.
lesson.mate3.ok = Мат! Двата топа работиха като стълбичка.
lesson.mate3.why = Виждаш ли? Единият топ отрязва {@}седмата хоризонтала, а другият дава шах на {@2}задната линия. Царят ми няма изход.
lesson.mate4.look = Шахът не винаги е мат. Да видим какво ще стане.
lesson.mate4.ask = Дай шах на царя ми с топа си.
lesson.mate4.king = Царят ти си стои. Дай шах с топа.
lesson.mate4.wrong = Това не е шах. Топът ти може да нападне царя ми от задната линия.
lesson.mate4.ok = Да, това е шах! Но мат ли е? Гледай.
lesson.mate4.after = Пешката ми на {sq} даде място на царя ми. Преди да се радваш на шаха, преброй полетата, които царят ми още може да ползва.
lesson.mate5.ask = Два хода на топа ти дават шах и само единият е мат. Преброй полетата на царя ми и избери.
lesson.mate5.king = Царят ти вече покрива {sq} и {sq2}. Остави го там и мести топа.
lesson.mate5.wrong = Това не е шах. Търси ход на топа, който напада царя ми.
lesson.mate5.hint = Царят ти покрива {sq} и {sq2}. Кой шах с топа отнема и {sq3}?
lesson.mate5.why = Виждаш ли? Топът покрива {sq}, царят ти – другите две полета, и царят ми е заклещен.
lesson.mate5.ok = Мат! Преброи полетата на царя ми: не остана нито едно.

# ---- Chapter 5: castling ---------------------------------------------------------------------------------------
lesson.castle.what = Рокадата е специален ход, който пази царя в безопасност. Царят и топът се местят заедно.
lesson.castle.how = {@}Царят се премества с две полета към топа, а {@2}топът прескача от другата страна на царя.
lesson.castle.ask = Винаги докосвай първо царя. Сега ти: направи малка рокада.
lesson.castle.rook = Така се мести само топът. За рокада премести царя си с две полета към него.
lesson.castle.long = Това е голяма рокада – и тя е позволена! Този път направи рокада към по-близкия топ.
lesson.castle.one = Едно поле е обикновен ход на царя. При рокада царят се мести с две.
lesson.castle.other = За рокада премести царя си с две полета към топа на {sq}.
lesson.castle.ok = Рокадата е направена! Царят ти е на сигурно място, а топът ти е готов за игра.
lesson.castle2.moved = Не можеш да правиш рокада, ако царят ти или този топ вече са се движили.
lesson.castle2.attacked = Нито докато си под шах, нито ако царят ти трябва да мине през нападнато поле или да застане на такова.
lesson.castle2.bishop = Офицерът ми напада {sq}. Затова рокадата от тази страна сега е забранена.
lesson.castle2.ask = Направи рокада от другата страна.
lesson.castle2.other = Направи рокада към другия си топ, към дамския фланг.
lesson.castle2.ok = Правилно! При голямата рокада царят ти отива на {sq}.
lesson.ep0.rule = Ан пасан започва с двойната крачка. Само пешка {@}на мястото си може да мине две полета; {@2}движилата се върви по едно.
lesson.ep0.ask = Премести една от пешките си с две полета.
lesson.ep0.moved = Тази пешка вече се е движила, затова може само с едно поле. Използвай пешка, която още е на мястото си.
lesson.ep0.ok = Точно: само пешка на началното си поле може да мине две.

# ---- Chapter 6: en passant ------------------------------------------------------------------------------------
lesson.ep.what = Едно специално вземане с пешка се нарича ан пасан. Това е френски израз и означава „мимоходом“.
lesson.ep.watch = Гледай пешката ми: тя се придвижва с две полета и застава точно до твоята.
lesson.ep.how = Пешката ти може да я вземе така, сякаш тя е минала само едно поле: на {sq}.
lesson.ep.now = Но само сега, на този ход. Вземи ан пасан!
lesson.ep.gone = Шансът отмина: ан пасан е възможно само веднага. Да опитаме пак.
lesson.ep.ok = Ан пасан! Пешката ми на {sq} напуска дъската.
lesson.ep2.old = Пешката ми на {sq} стои до твоята отдавна. Късно е да я вземеш ан пасан.
lesson.ep2.watch = Сега гледай другата ми пешка.
lesson.ep2.ask = Две мои пешки са до твоята, но само една току-що мина две полета. Вземи нея ан пасан!
lesson.ep2.push = Това само придвижва пешката ти. Вземи пешката, която току-що мина две полета.
lesson.ep2.wrong = Търси пешката, която току-що направи двойна крачка, и я вземи ан пасан.
lesson.ep2.hint = Пешката ми на {sq} току-що мина две полета. Вземи я ан пасан, на {sq2}.
lesson.ep2.ok = Ан пасан! Пешката ми на {sq} не можеше да бъде взета: шансът ѝ беше отминал.

# ---- Chapter 7: promotion -------------------------------------------------------------------------------------
lesson.promo.what = Когато пешка стигне последната хоризонтала, тя се произвежда: превръща се в дама, топ, офицер или кон.
lesson.promo.ask = Почти винаги избирай дама. Произведи пешката си сега!
lesson.promo.under = Позволено е! Но дамата е по-силна. Да изберем дама.
lesson.promo.under_ok = Добре. Все пак повечето играчи избират дама.
lesson.promo.push = Придвижи пешката си до последната хоризонтала, на {sq}.
lesson.promo.ok = Нова дама! Можеш да имаш дори две дами едновременно.
lesson.promo2.ask = Пешката може да се произведе и като взема, по диагонал. Вземи топа ми и направи дама!
lesson.promo2.push = И това я произвежда, но топът ми пази {sq}. Гледай.
lesson.promo2.lost = Топът ми взе новата ти фигура. Първо вземи топа ми.
lesson.promo2.wrong = Това не взема топа ми. Пешката ти взема по диагонал, на {sq}.
lesson.promo2.hint = Вземи топа ми с пешката си, на {sq}: тя се произвежда, докато взема.
lesson.promo2.ok = Взета и произведена! Пешката може и двете в един ход.

# ---- Chapter 8: stalemate and draws -----------------------------------------------------------------------------
lesson.stale.what = Мой ход е. Царят ми не е под шах, но {@}всяко поле около него е нападнато.
lesson.stale.draw = Нямам нито един позволен ход. Това е пат и партията завършва реми.
lesson.stale2.ask = Когато печелиш, пази се от пат. Дай ми мат в един ход, без пат!
lesson.stale2.wrong = Намери шах, след който на царя ми не остава поле. Внимавай: тих ход може да ми даде пат.
lesson.stale2.king = Царят ти вече покрива {sq} и {sq2}. Остави го там и използвай дамата.
lesson.stale2.hint = Царят ти покрива {sq} и {sq2}. Дай ми шах по задната линия и царят ми няма къде да отиде.
lesson.stale2.why = Виждаш ли? Царят ми е под шах {@}и няма свободно поле: това е мат. Без шаха щеше да е пат.
lesson.stale2.ok = Мат! Винаги оставяй ход на противниковия цар, освен ако не му даваш мат.
lesson.draws.kings = Има и други случаи на реми: когато никой не може да даде мат, например при два сами царя, партията е реми.
lesson.draws.agree = Играчите могат и да се споразумеят за реми.
lesson.draws.repeat = Трикратното повторение на позиция или петдесет хода без вземане и без ход с пешка също позволяват реми.

# ---- Chapter 9: before you move (the safety habit) ---------------------------------------------------------------
lesson.before.habit = Преди всеки ход спри и огледай. Силните играчи го правят всеки път.
lesson.before.last = Първи въпрос: какво направи последният ми ход? Гледай.
lesson.before.threat = {my} напада {your:obj}. Това е заплаха.
lesson.before.safe = Да се махнеш не стига. Новото поле също трябва да е безопасно.
lesson.before.dodge.ask = Премести коня си на безопасно поле.
lesson.before.dodge.still = Конят ти все още е под удар. Гледай.
lesson.before.dodge.hint = Пешките ми защитават полетата {sq} и {sq2}. Избери друго поле.
lesson.before.dodge.ok = Безопасно! Ти видя заплахата и провери полето.
# A wrong move onto a guarded square ({my} guards {to}); the coach then takes the piece.
lesson.before.unsafe = Не на {to}: {my} защитава това поле. Гледай.
# Said after the coach took the piece, before the move is taken back.
lesson.before.lost = Губиш {your:refl}. Първо гледай, после ходи.
lesson.before.again = Пак, първо моят ход. Гледай.
lesson.before.free.ask = Погледни последния ми ход. Можеш ли да вземеш нещо безплатно?
lesson.before.free.missed = Погледни пак {my:obj}. Какво може да {my:pron_obj} вземе?
lesson.before.free.hint = {my} няма защитник. {@}Пешката ти може да {my:pron_obj} вземе.
lesson.before.free.ok = Да! Офицерът ми беше свободен. Винаги гледай последния ми ход.
lesson.before.check.ask = Дай ми шах така, че да не мога да взема фигурата ти.
lesson.before.check.wrong = Това не е шах. Намери шах от безопасно поле.
lesson.before.check.hint = {my} защитава полето {sq}. Дай шах от безопасно поле.
lesson.before.check.ok = Добър шах! Дамата ти е на сигурно място там.
lesson.before.done = Направи го навик: първо гледай, после ходи.

# ---- Chapter 10: the opening ------------------------------------------------------------------------------------
lesson.opening.what = Дебютът е началото на партията. Помагат няколко прости правила.
lesson.opening.goals = {@}Контролирай центъра, {@2}развий конете и офицерите и {@3}направи рокада рано.
lesson.opening.centre = Четирите полета в {@}средата са центърът.
lesson.opening.pawn.ask = Постави пешка в центъра: две полета напред.
lesson.opening.pawn.one = Не е зле, но две полета държат повече от центъра.
lesson.opening.pawn.knight = Конете идват скоро. Първо пешка в центъра.
lesson.opening.pawn.wrong = Използвай пешката пред царя или пред дамата.
lesson.opening.pawn.ok = Добре! Пешката ти държи място в центъра.
lesson.opening.queen = Не изкарвай дамата рано: фигурите ми ще я гонят.
lesson.opening.knight.ask = Изкарай кон към центъра.
lesson.opening.rim = Конят по края стига до малко полета. Скочи към центъра.
lesson.opening.bishop = Развиваш, добре! Но този път кон.
lesson.opening.knight.ok = Добре! Оттам конят ти наблюдава центъра.
lesson.opening.later = Няколко хода по-късно: конят ти и {@}офицерът са навън.
lesson.opening.twice = Не мести една и съща фигура два пъти без добра причина.
lesson.opening.castle.ask = Пътят е чист. Направи рокада и скрий царя си.
lesson.opening.castle.wrong = Царят ти е готов. Направи рокада сега, докато пътят е чист.
lesson.opening.castle.ok = Рокада! Царят ти е в безопасност, а топът влиза в играта.
lesson.opening.done = Център, фигури, рокада: това е добро начало на всяка партия.

# ---- Chapter 11: review (no teaching: the coach only asks) ---------------------------------------------------------
lesson.review.start = Бързо повторение, този път в друг ред. Няма да обяснявам: ти ми показваш.
lesson.review.promo.ask = Произведи тази пешка.
lesson.review.promo.ok = Добре: нова дама и шах!
lesson.review.check.ask = Царят ти е под шах. Измъкни се.
lesson.review.check.ok = Няма шах. Добре.
lesson.review.castle.ask = Направи рокада от страната, където е позволена.
lesson.review.castle.other = Това не е рокада. Направи рокада от страната, където е позволена.
lesson.review.castle.ok = Рокада, от безопасната страна!
lesson.review.ep.ask = Вземи пешката ми ан пасан.
lesson.review.ep.ok = Ан пасан! Помниш го.
lesson.review.mate.ask = Дай ми мат в един ход.
lesson.review.mate.ok = Мат! Повторението е готово.

# ---- Chapter 12: how our games work (no clock, touch-move, handshake, and how the coach helps) -----------------------
lesson.talk.rules = Вече знаеш всички правила на шаха. Браво!
lesson.talk.real = Нека ти разкажа как ще протичат партиите ни.
lesson.talk.no_clock = С мен няма часовник и няма рейтинг. Мисли колкото ти е нужно.
lesson.talk.touch = Докосната фигура трябва да се премести, затова първо гледай, после докосвай.
lesson.talk.handshake = Партиите започват и завършват с ръкостискане. То означава: „хубава партия и благодаря“.
lesson.talk.polite = Независимо дали печелиш, или губиш, дръж се учтиво и никога не пречи на противника си, докато мисли.
lesson.talk.help = В партиите ни ще ти помагам. Ако някоя твоя фигура е нападната или остане без защита, ще ти кажа.
lesson.talk.help_back = След голяма грешка ще ти покажа защо и ще ти предложа да върнеш хода си.
lesson.talk.help_skip = А ако говоря твърде много, натисни интервал: ще млъкна.
lesson.talk.next = Когато решиш, играй „Първи стъпки“. Ще играя по-меко.
lesson.talk.welcome = Приветствам те в света на шаха! Да си стиснем ръцете.
