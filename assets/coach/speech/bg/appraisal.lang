# Coach speech (Bulgarian): the appraisal after the game (src/coach/appraisal.cpp).
# Same keys and variants as assets/coach/speech/en/appraisal.lang (its header documents every placeholder).
#
# Always positive, never blaming. The coach says "ти"; the player's gender is unknown: no
# l-participle and no adjective about the player ("ти спечели", "печелеше", "играеш все по-добре",
# "вече можеш да играеш на ниво ..." instead of "готов"). A 2nd person aorist that looks like an
# imperative ("спечели", "намери", "направи") gets "ти" or another verb ("откри").
# Forms from common.lang: "{acc:percent}" = "85%" (spoken "осемдесет и пет процента"), "{n:capture}" =
# "3 вземания" (pawns included), "{m:check}" = "2 шаха", "{n:best_move}" = "5 най-добри хода",
# "{m:m}" = a bare masculine number ("два" хода). Move numbers: "на ход {n}", "до ход {crit_no}".
# Never "с" before a number or a percentage (it becomes "със" before "седем", "сто"...): a colon instead.
# {opening} is the citation name, always after a colon ("Дебют: {opening}."), so that no article or
# preposition has to agree with it.

# ---- Names used inside the lines ------------------------------------------------------------------
# Phases: the masculine nouns with the FULL article (дебютът, мителшпилът, ендшпилът). The lines use
# {text} only as a subject, after "беше" or after a colon, never after a preposition or as an object.
appraisal.phase.opening = дебютът
appraisal.phase.middlegame = мителшпилът
appraisal.phase.endgame = ендшпилът
# Draw reasons, said right after "Реми" or "завърши реми" ("Реми по взаимно съгласие.").
appraisal.reason.stalemate = поради пат
appraisal.reason.material = поради недостатъчен материал за мат
appraisal.reason.repetition = чрез повторение на позицията
appraisal.reason.fifty = по правилото на петдесетте хода
appraisal.reason.agreement = по взаимно съгласие
appraisal.reason.other = по правилата
# The coach level names (coach.level.<n>.name of assets/i18n/bg.lang), quoted in the lines: ниво „{level}“.
appraisal.level.l1 = Първи стъпки
appraisal.level.l2 = Начинаещ
appraisal.level.l3 = Напредващ
appraisal.level.l4 = Клубен играч
appraisal.level.l5 = Силен клубен играч
appraisal.level.l6 = Експерт
# What to practise: a phrase in lower case, no full stop, always said after a colon ("Един съвет: ...",
# "Тема: ..."): a verbal noun ("оглеждане", "търсене") or a short noun phrase.
theme.general = оглеждане на цялата дъска, преди да играеш
theme.mate_allowed = проверка дали царят ти е в безопасност преди всеки ход
theme.mate_missed = търсене на мат, като започваш с шаховете
theme.stalemate = оставяне на свободно поле за царя ми, когато печелиш
theme.fork = внимание към двойните удари
theme.discovered = внимание към скритите атаки зад фигурите ми
theme.skewer = ценните фигури да не стоят на една линия
theme.pin = предвиждане на свръзките, преди да възникнат
theme.trapped = оставяне на път за отстъпление на фигурите ти
theme.back_rank = малко въздух за царя ти
theme.hanging = защитата на фигурите ти
theme.exchange = броене на нападащите и защитаващите фигури преди размяна
theme.missed_capture = търсене преди всичко на фигури, които можеш да вземеш даром
theme.missed_fork = търсене на собствени двойни удари
theme.promotion = надпреварата на пешките и правилото на квадрата
theme.king_safety = сигурността на царя ти зад пешките му
theme.bad_trade = избор кои фигури да разменяш
theme.opening = развитие на фигурите и ранна рокада
theme.endgame = използване на царя и придвижване на проходните пешки
theme.positional = подобряване на най-лошата ти фигура
theme.material = проверка какво могат да спечелят следващите ми ходове, преди да играеш

