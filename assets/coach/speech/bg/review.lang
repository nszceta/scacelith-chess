ex.retake.b3 = Ако вземеш обратно с {move}, {reply} взема {your:obj}.
ex.retake.b3.2 = Обратното вземане {move} не става: {reply} взема {your:obj}.
ex.retake.b4 = {move} се опровергава с {reply}, който взема {your:obj}.
ex.retake.b4.2 = А ако {move}, тогава {reply} взема {your:obj}.
ex.retake.b5 = Обратното вземане {move} се натъква на {reply} и {your} пада.
ex.retake.b5.2 = {move} се опровергава с {reply}: {your} пада.
ex.retake.b6 = {move}? {reply} взема {your:obj}.
ex.retake.b6.2 = {move} не минава: {reply} взема {your:obj}.
# The player would promote: the coach points at the square instead of moving ({sq} is pointed at).
demo.promote = А тук, на {sq}, ще получиш нова дама.
demo.promote.2 = След това {your} стига до {sq} и става дама.

# ---- 1. Mate allowed ---------------------------------------------------------------------------
# b1 ({my} is pointed at): mate in one.
ex.mate_allowed.b1 = Внимавай: {my} може да отиде на {sq} и това е мат.
ex.mate_allowed.b1.2 = Сега {my} може да отиде на {sq}. Това ще бъде мат!
ex.mate_allowed.b1.3 = Внимавай! Ако {my} отиде на {sq}, това е мат.
# b2 ({your} = the king, pointed at).
ex.mate_allowed.b2 = Този ход ми позволява да дам мат на {your:obj} в {m:move}.
ex.mate_allowed.b2.2 = Сега мога да дам мат на {your:obj} в {m:move}. Гледай.
ex.mate_allowed.b2.3 = Внимавай! {your} е в опасност: мат в {m:move}.
# b3 b4 b6 ({line} is pointed at).
ex.mate_allowed.b3 = Това позволява мат в {m:move}: {line:nomate}.
ex.mate_allowed.b3.2 = След това имам мат в {m:move}: {line:nomate}.
ex.mate_allowed.b3.3 = Царят ти получава мат: {line:nomate}.
ex.mate_allowed.b4 = {move} позволява форсиран мат: {line:nomate}.
ex.mate_allowed.b4.2 = Този ход води до мат в {m:move}: {line:nomate}.
ex.mate_allowed.b4.3 = След {move} следва мат: {line:nomate}.
ex.mate_allowed.b5 = {move} позволява форсиран мат в {m:move}.
ex.mate_allowed.b5.2 = Това води до мат в {m:move}.
ex.mate_allowed.b5.3 = Сега има форсиран мат в {m:move}.
# Level 6: "{m:mv}" is the bare number in writing ("Мат в 3"), "три хода" in the voice.
ex.mate_allowed.b6 = Мат в {m:mv}: {line:nomate}.
ex.mate_allowed.b6.2 = {line:nomate}, мат.
ex.mate_allowed.b6.3 = Мат след {line:nomate}.
# After the one-move demonstration ({your} = the king).
ex.mate_allowed.tail.b1 = Виж: {your} няма поле, където да избяга.
ex.mate_allowed.tail.b1.2 = Виждаш ли? {your} е под удар и не може да избяга.
ex.mate_allowed.tail.b1.3 = {your} няма къде да отиде. Това е мат.
# The name of the mating pattern (levels 2-4); {text} is one of the name.pattern keys below.
ex.mate_allowed.pattern = Тази матова картина се нарича {text}.
ex.mate_allowed.pattern.2 = Запомни тази картина: това е {text}.
ex.mate_allowed.tip.b3 = Преди всеки ход проверявай дали царят ти е още в безопасност.
ex.mate_allowed.tip.b3.2 = Винаги се питай: след моя ход може ли царят ми да получи мат?

# Noun phrases without an article (Bulgarian has no indefinite article), said after "нарича" / "е".
name.pattern.back_rank = мат на задната линия
name.pattern.smothered = задушен мат
name.pattern.support = мат с подкрепена дама
name.pattern.ladder = линеен мат
name.pattern.epaulette = еполетен мат

# ---- 2. Mate missed ({best} is pointed at; b1 also points at {my}, the coach's king) ------------
ex.mate_missed.b1 = С {best:nomate} можеше да дадеш мат на {my:obj}!
ex.mate_missed.b1.2 = {best:nomate} беше мат! {my} нямаше да може да избяга.
ex.mate_missed.b1.3 = Виж! {best:nomate} щеше да даде мат на {my:obj}.
ex.mate_missed.b2 = Имаше мат в {m:move}, който започваше с {best:nomate}.
ex.mate_missed.b2.2 = {best:nomate} даваше мат в {m:move}!
ex.mate_missed.b2.3 = Можеше да ми дадеш мат с {best:nomate}.
ex.mate_missed.b3 = Пропусна мат в {m:move}: {best:nomate}.
ex.mate_missed.b3.2 = {best:nomate} дава мат в {m:move}: {line:nomate}.
ex.mate_missed.b3.3 = Имаше мат в {m:move}: първият ход е {best:nomate}.
ex.mate_missed.b4 = Пропуснат мат: {line:nomate}, с първи ход {best:nomate}.
ex.mate_missed.b4.2 = {best:nomate} форсираше мат в {m:move}.
ex.mate_missed.b4.3 = Имаше мат в {m:move} с {best:nomate}.
ex.mate_missed.b5 = {best:nomate} дава мат в {m:move}: {line:nomate}.
ex.mate_missed.b5.2 = Пропуснат мат в {m:move}: първият ход е {best:nomate}.
ex.mate_missed.b5.3 = Имаше форсиран мат: {best:nomate}.
ex.mate_missed.b6 = {best:nomate} дава мат: {line:nomate}.
ex.mate_missed.b6.2 = Мат в {m:mv} с {best:nomate}.
ex.mate_missed.b6.3 = {best:nomate}, мат в {m:mv}.
