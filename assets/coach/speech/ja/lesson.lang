# Coach speech (Japanese): the rules lesson (level 0, src/coach/lesson.cpp).
# Same keys and variants as assets/coach/speech/en/lesson.lang.
#
# Placeholders: {your} / {my} = a piece of the player / of the coach ("あなたのルーク", "私のナイト");
# {your:bare} = the piece name alone, used when the owner is clear ("{your:bare}を使いましょう");
# {sq}, {sq2}, {to}, {esc} = squares; {move} = a move. {@}, {@2}, {@3} are invisible marks: the coach
# points at something while saying the word right after the mark. A ".spoken" key is what the voice
# says instead: Latin letters, digits and counters in kana ("ふたマス", "さんてん", "いってで").
# Rules the lines follow: files = ファイル, ranks = ランク ("第2ランク"), back rank = バックランク;
# "{sq}へ" / "{sq}の", never "{sq}に" (rank 2 is spoken "に").

# ---- Chapter titles (said inside "{chapter}の続きから始めましょう。") ------------------------------------
lesson.title.welcome = チェス盤
lesson.title.pieces = 駒の動き方
lesson.title.safety = 安全な取り方と危ない取り方
lesson.title.check = チェック
lesson.title.mate = チェックメイト
lesson.title.castling = キャスリング
lesson.title.en_passant = アンパッサン
lesson.title.promotion = プロモーション
lesson.title.draws = ステイルメイトと引き分け
lesson.title.before_move = 指す前に
lesson.title.opening = オープニング
lesson.title.etiquette = 実戦のレーティング、時計、マナー

# ---- Lines every exercise uses ------------------------------------------------------------------------
