# Coach speech (Slovenian): the appraisal after the game (src/coach/appraisal.cpp).
# Same keys and variants as assets/coach/speech/en/appraisal.lang (its header documents every placeholder).
#
# Always positive, never blaming. The coach says "ti" and is male ("zmagal sem", "premagan sem"). The
# player's gender is unknown: no "si zmagal", "si našel", "si imel", "pripravljen si", "boljši si".
# Instead: nouns ("Zmaga je tvoja"), impersonal forms ("uspelo ti je", "ti je šlo", "je bilo mogoče"),
# the dual "midva" ("remizirala sva", "igrava"), the indeclinable "kos si" (you are up to it), or a
# noun subject for a move ("poteza {crit_best} bi ohranila", "{n:ord} poteza, {move}, je pridobila").
# Forms from common.lang: move numbers are ordinals, "v {n:ord_loc} potezi" = "v 21. potezi" (spoken
# "v enaindvajseti potezi"), "{n:ord} poteza" = "21. poteza", "do {crit_no:ord_gen} poteze";
# "{acc:percent}" = "85 %" (spoken "petinosemdeset odstotkov"); "{n:piece_acc}" = "eno figuro";
# "{n:capture}" = "tri jemanja"; "{n:best_move}" = "pet najboljših potez"; "{moves:move_loc}" =
# "v 32 potezah"; "{text:loc}" = a phase in the locative ("v središčnici", common.lang).
# Counts that can be 0 ({n} {m} {k} of the numbers section) never take _gen / _loc (no "ničih").
# A move placeholder is never declined: "namesto poteze {crit_move}", "boljša kot {crit_move}".
# {level}: the level name in »...« after a case of "stopnja" ("na stopnji »Začetnik«"), never declined.
# {opening:def}: the opening's lower-case name, always after a colon; "{opening}" alone as a line.

# ---- Names used inside the lines ------------------------------------------------------------------
# Phases: feminine nominatives, so a word agreeing with {text} is always feminine ("{text} ti je šla
# najbolje"); their case forms ("v {text:loc}") are in common.lang (appraisal.phase.<phase>.<case>).
appraisal.phase.opening = otvoritev
appraisal.phase.middlegame = središčnica
appraisal.phase.endgame = končnica
# Draw reasons, said right after "Remi" / "z remijem", with no comma ("Remi po dogovoru.").
appraisal.reason.stalemate = zaradi pata
appraisal.reason.material = zaradi nezadostnega materiala
appraisal.reason.repetition = zaradi ponovitve pozicije
appraisal.reason.fifty = po pravilu petdesetih potez
appraisal.reason.agreement = po dogovoru
appraisal.reason.other = po pravilih
# The coach level names (coach.level.<n>.name of assets/i18n/sl.lang).
