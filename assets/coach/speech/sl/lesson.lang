# Coach speech (Slovenian): the rules lesson (level 0, src/coach/lesson.cpp).
# Same keys and variants as assets/coach/speech/en/lesson.lang.
#
# Placeholders: {your} / {my} = a piece of the player / of the coach ("tvoja trdnjava", "moj skakač"),
# with the forms of common.lang ({my:acc}, {my:gen}, {my:dat}, {my:loc}, {my:cl_acc}, {my:poss},
# {your:refl_acc}, {your:refl_with}, {your:ag} ...); {sq}, {sq2}, {to}, {esc} = squares, always after
# the noun "polje" when a case would show ("na polje {sq}", "s polja {sq}"); {move} = a move.
# {@}, {@2}, {@3} are invisible marks: the coach points at something while saying the word right after
# the mark. A ".spoken" key is what the voice says instead (here: letters said by their Slovenian names,
# "ha" for h, "el" for L).
# Rules the lines follow: no past tense, future, conditional or adjective agreeing with the player;
# "svoj" when the player acts with their own piece ("Vzemi {my:acc} s svojo trdnjavo",
# {your:refl_acc}). Files = linije, ranks = vrste, back rank = zadnja vrsta, kingside / queenside
# castling = kratka / dolga rokada.

# ---- Chapter titles (said inside "Nadaljujva s poglavjem: {chapter}.") -------------------------------
# Lower-case nominatives (see event.lesson.* in events.lang).
lesson.title.welcome = šahovnica
lesson.title.pieces = kako se premikajo figure
lesson.title.safety = varno in tvegano jemanje
lesson.title.check = šah
lesson.title.mate = mat
lesson.title.castling = rokada
lesson.title.en_passant = jemanje en passant
# Said "an pasan", as the French (the voice read "en pasant"); every line with en passant does the same.
lesson.title.en_passant.spoken = jemanje an pasan
lesson.title.promotion = promocija
lesson.title.draws = pat in remi
lesson.title.before_move = pred potezo
lesson.title.opening = otvoritev
lesson.title.etiquette = rating, ura in olika v pravih partijah

