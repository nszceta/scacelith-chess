# Coach speech (Slovenian): the review of the player's moves (src/coach/review.cpp, review_explain.cpp).
# Same keys and variants as assets/coach/speech/en/review.lang (its header documents every placeholder).
#
# The coach says "ti"; he is male ("nisem pričakoval", "jaz bi igral"). The player's gender is unknown:
# no past tense, future or conditional with the player as subject ("si vzel", "bi lahko vzel"), and no
# adjective about the player. Used instead: the present ("izgubiš", "imaš {pts:point_acc} manj"), the
# imperative, impersonal turns ("ušla ti je priložnost", "bilo je mogoče vzeti", "uspelo ti je najti")
# and noun subjects ("zmaga je tvoja", "poteza {best} bi dobila ...").
# A move placeholder has no gender: as the subject of a past or conditional it gets the noun "poteza"
# ("Poteza {best} je bila boljša"), or the neuter impersonal of Slovenian annotation ("Boljše je bilo
# {best}"). Prepositions s / z never stand before {move}/{best}/{reply}: "s potezo {best}".
# Pieces: case forms of sl/common.lang ({your:acc}, {my:gen}, {your:with} = "s tvojim ..."), "svoj"
# forms (refl_*) when the player or the coach owning the piece is the subject, clitics ({your:cl_acc}
# = ga / jo) after the piece has been named, agreement endings (vezan{your:ag}, vred{your:ag_en}).
# Counts: "mat v {m:move_loc}" (written "v 3 potezah"), "Mat v {m:mv}" for the terse levels (written
# "Mat v 3", spoken "mat v treh potezah"), lost points "imaš {pts:point_acc} manj".

# ---- Announcements (either side's move) -------------------------------------------------------
# The player gives check (levels 1-2: say what it means).
ann.check.human.b1 = Šah! Moj kralj je napaden.
ann.check.human.b1.2 = Šah! Napadaš mojega kralja.
ann.check.human.b1.3 = To je šah! Moj kralj se mora rešiti iz šaha.
ann.check.human = Šah.
ann.check.human.2 = Šah!
ann.check.human.3 = In to je šah.
# The coach gives check.
ann.check.coach = Šah!
ann.check.coach.2 = Šah.
ann.check.coach.3 = In šah!
# Once per game at levels 1-2, right after the coach's first check ({your} = the player's king).
ann.check.coach.first = To pomeni, da je {your} pod napadom. Moraš {your:cl_acc} rešiti iz šaha.
ann.check.coach.first.2 = Šah pomeni, da je {your} pod napadom. Umakni {your:cl_acc}, postavi kaj vmes ali vzemi mojo figuro.
ann.double_check.coach = Dvojni šah! Dve moji figuri hkrati napadata tvojega kralja, zato se mora umakniti.
ann.double_check.coach.2 = To je dvojni šah: zdaj ti pomaga samo poteza s kraljem.
ann.double_check.human = Dvojni šah! Dve tvoji figuri hkrati napadata mojega kralja, zato se mora umakniti.
ann.double_check.human.2 = Dvojni šah! Zdaj me lahko reši samo poteza s kraljem.
# The player checkmates the coach.
ann.mate.human.b1 = Mat! Zmaga je tvoja! Moj kralj ne more pobegniti.
ann.mate.human.b1.2 = To je mat! Bravo, partija je tvoja!
ann.mate.human.b1.3 = Mat! Moj kralj je ujet. Čestitam!
ann.mate.human = Mat. Lepo odigrano.
ann.mate.human.2 = To je mat. Čestitam.
ann.mate.human.3 = Mat! Lepo izpeljano.
# The coach checkmates the player.
ann.mate.coach.b1 = To je mat. Tvoj kralj nima izhoda.
ann.mate.coach.b1.2 = Mat. Tvoj kralj je napaden in ne more pobegniti.
ann.mate.coach.b1.3 = Bojim se, da je to mat. Tvoj kralj ne more uiti.
ann.mate.coach = Mat.
ann.mate.coach.2 = In to je mat.
ann.mate.coach.3 = Mat, žal.

