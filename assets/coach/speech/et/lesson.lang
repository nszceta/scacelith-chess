# Coach speech (Estonian): the rules lesson (level 0, src/coach/lesson.cpp).
# Same keys and variants as assets/coach/speech/en/lesson.lang.
#
# Placeholders: {your} / {my} = a piece of the player / of the coach ("sinu vanker", "minu ratsu"),
# with the case forms of common.lang ({my:gen}, {my:part}, {my:ter}, {your:own_part}, {your:own_com}
# ...): "oma" (own_) when the player is the subject of the clause, also of an imperative ("Kasuta oma
# vankrit"). {sq}, {sq2}, {to}, {esc} = squares, never with a case ending: "väljale {sq}", "väljal
# {sq}", "väljalt {sq}". {move} = a move. {@}, {@2}, {@3} are invisible marks: the coach points at
# something while saying the word right after the mark. A ".spoken" key is what the voice says
# instead (here: letters spelled with their Estonian names, "aa", "haa", "ell").

# ---- Chapter titles (said inside "Jätkame teemaga „{chapter}“.") ------------------------------------
# Nominative, lower case (see event.lesson.* in events.lang).
lesson.title.welcome = malelaud
lesson.title.pieces = kuidas malendid käivad
lesson.title.safety = ohutu ja ohtlik löömine
lesson.title.check = tuli
lesson.title.mate = matt
lesson.title.castling = vangerdus
lesson.title.en_passant = möödaminnes löömine
lesson.title.promotion = muundumine
lesson.title.draws = patt ja viik
lesson.title.before_move = vaatamine enne käiku
lesson.title.opening = avamäng
lesson.title.etiquette = päris partiid: reiting, kell ja head kombed

