ex.better.b4 = {best} oli tugevam.
ex.better.b4.2 = {best} oli õige käik.
ex.better.b4.3 = Parem oli {best}.
ex.better.b5 = {best} ideega {line}.
ex.better.b5.2 = Õige oli {best}: {line}.
ex.better.b5.3 = Parem oli {best}, millele järgneb {line}.
ex.better.b6 = {best}: {eval}.
ex.better.b6.2 = Selle asemel {best}, {eval}.
ex.better.b6.3 = Käigu {best} hinnang oli {eval}.

