ex.pin.b3 = {your} jääb seotuks ({t1} on selle taga) ja ma võidan selle.
ex.pin.b3.2 = Pärast seda on {your} seotud: selle taga on {t1}.
ex.pin.b3.3 = {your:gen} sidumine maksab materjali: selle taga on {t1}.
ex.pin.b4 = {reply} seob ja võidab materjali.
ex.pin.b4.2 = {move} jookseb sidumise {reply} otsa.
ex.pin.b4.3 = Pärast käiku {reply} langeb seotud malend.
ex.pin.b5 = {move} lubab sidumist {reply}.
ex.pin.b5.2 = {reply} seob ja malend läheb kaotsi.
ex.pin.b6 = {reply} seob.
ex.pin.b6.2 = {reply}, sidumine.
