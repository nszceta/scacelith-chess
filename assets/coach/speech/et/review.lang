name.pattern.support = kaitstud lipuga matt
name.pattern.ladder = redelimatt
name.pattern.epaulette = epoletimatt

# ---- 2. Mate missed ({best} is pointed at; b1 also points at {my}, the coach's king) ------------
ex.mate_missed.b1 = Käiguga {best:nomate} oleksid saanud {my:all} matti panna!
ex.mate_missed.b1.2 = {best:nomate} oli matt! {my} poleks pääsenud.
ex.mate_missed.b1.3 = Vaata! Käik {best:nomate} oleks pannud {my:all} matti.
ex.mate_missed.b2 = Sul oli matt {m:move_com}, alates käigust {best:nomate}.
ex.mate_missed.b2.2 = {best:nomate} oli matt {m:move_com}!
ex.mate_missed.b2.3 = Oleksid võinud mulle käiguga {best:nomate} matti panna.
ex.mate_missed.b3 = Sa lasid käest mati {m:move_com}: {best:nomate}.
ex.mate_missed.b3.2 = {best:nomate} paneb matti {m:move_com}: {line:nomate}.
ex.mate_missed.b3.3 = Oli olemas matt {m:move_com}, alates käigust {best:nomate}.
