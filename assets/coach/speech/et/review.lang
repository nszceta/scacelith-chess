ex.mate_delayed.b6 = {best:nomate} paneb matti {m:move_com}.
ex.mate_delayed.b6.2 = Kiirem: {best:nomate}, matt {m:move_com}.

# ---- 3. Stalemate ({my} = the coach's king, pointed at) ----------------------------------------
# Stalemate = "patt"; "panna patti" (to stalemate), "jääb patti" (gets stalemated).
ex.stalemate.b1 = Oh ei! {my} ei saa käia ega ole tule all. See on patt: viik.
ex.stalemate.b1.2 = Vaata: {my:ade} pole ühtegi ohutut välja, aga ta pole tule all. See on viik!
ex.stalemate.b1.3 = See on patt. {my} ei saa käia, seega lõpeb partii viigiga.
ex.stalemate.b2 = Patt! {my:ade} pole ühtegi lubatud käiku ja tuld ei ole. Viik.
ex.stalemate.b2.2 = Oh ei, patt: {my} on kinni, aga mitte tule all.
ex.stalemate.b2.3 = See on viik pati tõttu. {my} ei saa käia.
ex.stalemate.b3 = See on patt: {my:ade} pole ühtegi lubatud käiku. Sul oli võiduseis!
ex.stalemate.b3.2 = Patt! {my} on kinni ja võidetud partii muutub viigiks.
ex.stalemate.b3.3 = {my:ade} pole käike ja tuld pole: patt.
ex.stalemate.b4 = Patt: {my:ade} pole ühtegi lubatud käiku. Sellega läheb võit käest.
ex.stalemate.b4.2 = {move} paneb {my:all} patti. Viik võiduseisust.
ex.stalemate.b4.3 = See on patt; {my} on täiesti kinni.
ex.stalemate.b5 = {move} paneb {my:all} patti. Võit on käest läinud.
ex.stalemate.b5.2 = Patt: {my:ade} pole välju.
ex.stalemate.b5.3 = See on patt, {my} on kinni.
ex.stalemate.b6 = Patt. {my:ade} pole käike.
ex.stalemate.b6.2 = {move}, patt: {my} on kinni.
ex.stalemate.b6.3 = Patt; {my} ei saa käia.
ex.stalemate.tip.b1 = Kui sul on võiduseis, jäta minu kuningale alati väli, kuhu käia.
ex.stalemate.tip.b1.2 = Pea meeles: kui oled eespool, jäta minu kuningale ruumi.
# The coach can reach stalemate on purpose along the line.
ex.stalemate_trick.b1 = Ettevaatust! Ma võin oma malendid ära anda ja siis pole {my:ade} käike: patt.
ex.stalemate_trick.b1.2 = Ettevaatust: {my} on peaaegu kinni. Ma võin viigi välja mängida.
ex.stalemate_trick.b2 = Ettevaatust: ma võin ohverdada ja {my} jääks patti.
ex.stalemate_trick.b2.2 = {my:ade} pole peaaegu ühtegi välja. Ma saan pati forsseerida!
ex.stalemate_trick.b3 = See laseb mul patiga pääseda: {my:ade} saavad käigud otsa.
ex.stalemate_trick.b3.2 = Ettevaatust: pärast jätku {line} on {my} patis.
ex.stalemate_trick.b4 = {move} lubab patilõksu: {line} ja {my} ei saa käia.
ex.stalemate_trick.b4.2 = Nüüd saab {my} patti peitu pugeda: {line}.
ex.stalemate_trick.b5 = {move} lubab patti: {line}; {my} on kinni.
ex.stalemate_trick.b5.2 = Patilõks: {line} ja {my:ade} pole käike.
ex.stalemate_trick.b6 = {line}, patt: {my} on kinni.
ex.stalemate_trick.b6.2 = Pärast jätku {line} patt; {my} on kinni.

# ---- 4. Fork (b1 b2: {my} {t1} {t2} pointed at; b3-b5: {reply} {t1} {t2}; b6: {reply}) ----------
# "kahvel" + allative of the targets ("kahvel kuningale ja vankrile"); "ründab" + partitive.
ex.fork.b1 = {my} võib minna väljale {sq} ja rünnata {t1:part} ja {t2:part}.
ex.fork.b1.2 = {my} läheb väljale {sq} ja ründab kahte malendit: {t1:part} ja {t2:part}.
ex.fork.b1.3 = Jälgi {my:part}: väljalt {sq} ründab ta korraga {t1:part} ja {t2:part}.
ex.fork.b2 = Kahvel! {my} väljal {sq} ründab korraga {t1:part} ja {t2:part}.
ex.fork.b2.2 = Pärast sinu käiku saab {my} väljalt {sq} teha kahvli {t1:all} ja {t2:all}.
ex.fork.b2.3 = {my} läheb väljale {sq}: kahekordne rünnak {t1:all} ja {t2:all}.
ex.fork.b3 = {move} lubab käiku {reply}: kahvel {t1:all} ja {t2:all}.
ex.fork.b3.2 = Pärast käiku {reply} ründan ma korraga {t1:part} ja {t2:part}.
