ex.verdict.blunder.b1.2 = Ettevaatust! See käik võib sulle kalliks maksma minna.
ex.verdict.blunder.b1.3 = Oi, oota. Selle käiguga on üks probleem.
ex.verdict.blunder.b2 = Hmm, selle käiguga on probleem.
ex.verdict.blunder.b2.2 = See on suur viga.
ex.verdict.blunder.b2.3 = Ettevaatust, see käik maksab sulle midagi.
ex.verdict.blunder.b3 = See on jäme viga.
ex.verdict.blunder.b3.2 = {move} on tõeline viga.
ex.verdict.blunder.b3.3 = Oi-oi, {move} on suur viga.
ex.verdict.blunder.b4 = {move} on jäme viga.
ex.verdict.blunder.b4.2 = {move} on tõsine viga.
ex.verdict.blunder.b4.3 = Kahjuks on see jäme viga.
ex.verdict.blunder.b5 = {move} on tõsine viga.
ex.verdict.blunder.b5.2 = {move} on jäme viga.
ex.verdict.blunder.b5.3 = {move} on kulukas viga.
ex.verdict.blunder.b6 = {move} on raske viga.
ex.verdict.blunder.b6.2 = {move} on jäme viga.
ex.verdict.blunder.b6.3 = {move}? Jäme viga.
# A blunder that leaves the coach's threat standing (levels 1-2: the threat the engine found after the
# coach's last move is what the reply carries out).
ex.verdict.ignored.b1 = Oi! Sa ei vastanud minu ähvardusele.
ex.verdict.ignored.b1.2 = Ettevaatust! Minu ähvardus oli alles.
ex.verdict.ignored.b1.3 = Oi, oota. Sa unustasid minu ähvarduse.
ex.verdict.ignored.b2 = Hmm, minu ähvardus oli ju alles.
ex.verdict.ignored.b2.2 = Sa jätsid minu ähvardusele vastamata.
ex.verdict.ignored.b2.3 = Ettevaatust, sa ei vastanud minu ähvardusele.
ex.verdict.mistake.b3 = See pole hea käik.
ex.verdict.mistake.b3.2 = Hmm, käiguga {move} on probleem.
ex.verdict.mistake.b3.3 = See on viga.
ex.verdict.mistake.b4 = {move} on viga.
ex.verdict.mistake.b4.2 = {move} pole hea.
ex.verdict.mistake.b4.3 = See on viga.
ex.verdict.mistake.b5 = {move} on selge viga.
ex.verdict.mistake.b5.2 = {move} on viga.
ex.verdict.mistake.b5.3 = {move} ei ole hea.
ex.verdict.mistake.b6 = {move} on viga.
ex.verdict.mistake.b6.2 = {move}? Viga.
ex.verdict.mistake.b6.3 = Mitte {move}.
# A dubious move (an inaccuracy; a costly move with nothing concrete to show while still better):
# only the better move is named ({best} is pointed at), never a scenario.
ex.verdict.inaccuracy.b3 = Pole paha, aga {best} oli veidi parem.
ex.verdict.inaccuracy.b3.2 = {best} oli natuke täpsem.
ex.verdict.inaccuracy.b3.3 = Väike libastus: {best} oli siin parem.
ex.verdict.inaccuracy.b4 = Ebatäpne: {best} oli täpsem.
ex.verdict.inaccuracy.b4.2 = Väike ebatäpsus. {best} oli veidi parem.
ex.verdict.inaccuracy.b4.3 = Mitte päris parim: {best} oli täpsem.
ex.verdict.inaccuracy.b5 = {move} on ebatäpne; {best} oli tugevam.
ex.verdict.inaccuracy.b5.2 = Veidi ebatäpne. Mina oleksin käinud {best}.
ex.verdict.inaccuracy.b5.3 = {best} oli täpsem kui {move}.
ex.verdict.inaccuracy.b6 = {move} on ebatäpne; {best}.
ex.verdict.inaccuracy.b6.2 = Ebatäpne. {best}.
ex.verdict.inaccuracy.b6.3 = {best} oli parem.
# Level 6, an inaccuracy at the bottom of its class (deeper searches often clear it): a hedged word.
ex.verdict.inaccuracy.maybe = {best} oli ehk veidi täpsem.
ex.verdict.inaccuracy.maybe.2 = Mina oleksin ehk käinud {best}.
# A dubious move that loses material (levels 3-6): the remark alone, never "a bit better" (at level 6
# under 6 points, the hedged word above unless a piece is lost).
ex.verdict.dubious = See käik näib kahtlane.
ex.verdict.dubious.2 = See käik tundub kahtlane.
# Something good was missed (levels 1-2).
ex.verdict.missed.b1 = Oi, oota! Sul jäi midagi head märkamata.
ex.verdict.missed.b1.2 = Vaata uuesti! Oli midagi paremat.
ex.verdict.missed.b1.3 = Oota, sul oli seal võimalus!
ex.verdict.missed.b2 = Sa lasid siin võimaluse käest.
ex.verdict.missed.b2.2 = Hmm, oli midagi paremat.
ex.verdict.missed.b2.3 = Oota, sul oli seal suurepärane käik.

