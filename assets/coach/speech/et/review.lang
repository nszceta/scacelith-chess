ex.fork.b4.2 = {reply} ründab korraga {t1:part} ja {t2:part}.
ex.fork.b4.3 = {move} lubab kahvlit {reply} {t1:all} ja {t2:all}.
ex.fork.b5 = {move} jookseb kahvli {reply} otsa, mis ründab {t1:part} ja {t2:part}.
ex.fork.b5.2 = {reply} teeb kahvli {t1:all} ja {t2:all}.
ex.fork.b5.3 = Pärast käiku {reply} on {t1} ja {t2} mõlemad rünnaku all.
ex.fork.b6 = {reply} on kahvel.
ex.fork.b6.2 = {move} lubab kahvlit {reply}.
ex.fork.b6.3 = {reply}, kahvel.
# Once the fork stands (level 1; in the middle of the demonstration, or where it stops).
ex.fork.tail.b1 = Sa saad päästa ainult ühe neist: {t1:gen} või {t2:gen}.
ex.fork.tail.b1.2 = Nüüd ründan ma korraga kahte malendit: {t1:part} ja {t2:part}. See on kahvel!
ex.fork.tail.b1.3 = Näed? {t1} ja {t2} on mõlemad rünnaku all. Üks neist langeb.
