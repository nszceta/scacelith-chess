# Coach speech (Estonian): the review of the player's moves (src/coach/review.cpp, review_explain.cpp).
# Same keys and variants as assets/coach/speech/en/review.lang (its header documents every placeholder).
#
# Register: the coach says "sina" (sa, sinu, singular imperatives) and "mina" for himself. Estonian has
# no grammatical gender: nothing agrees with the sex of the player or of the coach.
# Pieces carry their possessive; forms from common.lang: {your:part} "sinu ratsut", {your:gen},
# {your:all}, {your:ade} ("{your:ade} oli parem käik" = "your knight had a better move"), {your:com},
# {your:ter}, {your:abe}; own_* ("oma ...") whenever the owner is the subject of the clause, also the
# implied subject of an imperative: "Vaata {your:own_part}", "Ma viin {my:own_gen} väljale {sq}".
# A pronoun for a piece is "see / seda / selle" (or "ta" where the piece acts).
# Squares, moves and lines never take an ending: "väljale {sq}", "väljal {sq}", "pärast käiku
# {reply}", "pärast jätku {line}", "käiguga {best}", "alates käigust {best:nomate}".
# Counts: {pts:point_obj} after "kaotama / võitma" ("oled kaotanud ühe punkti"), {pts:point_gen}
# before "võrra" ("oled kolme punkti võrra taga"), {n:point_gen} väärt ("viie punkti väärt"),
# {m:move_com} for mates ("matt kahe käiguga"), {n:attacker} {n2:defender_gen} vastu, {n:time}.
# Pin: "seotud", and the piece behind is named ("selle taga on {t1}") rather than a preposition.
# Mate pattern names (name.pattern.*) are in the nominative; one line quotes them: „{text}“.
# Levels 1-2: short sentences; levels 5-6: terse.

# ---- Announcements (either side's move) -------------------------------------------------------
# The player gives check (levels 1-2: say what it means).
ann.check.human.b1 = Tuli! Minu kuningas on rünnaku all.
ann.check.human.b1.2 = Tuli! Sa ründad minu kuningat.
ann.check.human.b1.3 = See on tuli! Minu kuningas peab tule alt pääsema.
ann.check.human = Tuli.
ann.check.human.2 = Tuli!
ann.check.human.3 = Ja see on tuli.
# The coach gives check.
ann.check.coach = Tuli!
ann.check.coach.2 = Tuli.
ann.check.coach.3 = Ja tuli!
# Once per game at levels 1-2, right after the coach's first check.
ann.check.coach.first = See tähendab, et {your} on rünnaku all. Sa pead ta tule alt päästma.
ann.check.coach.first.2 = Tuli tähendab, et {your} on rünnaku all. Liiguta seda, pane midagi vahele või löö minu malend.
ann.double_check.coach = Kahekordne tuli! Kaks minu malendit ründavad korraga sinu kuningat, nii et kuningas peab liikuma.
ann.double_check.coach.2 = See on kahekordne tuli: nüüd aitab sind ainult kuningakäik.
ann.double_check.human = Kahekordne tuli! Kaks sinu malendit ründavad korraga minu kuningat, nii et kuningas peab liikuma.
ann.double_check.human.2 = Kahekordne tuli! Nüüd päästab mind ainult kuningakäik.
# The player checkmates the coach.
ann.mate.human.b1 = Matt! Sa võitsid! Minu kuningas ei pääse kuhugi.
ann.mate.human.b1.2 = See on matt! Tubli, sa võitsid partii!
ann.mate.human.b1.3 = Matt! Minu kuningas on lõksus. Palju õnne!
ann.mate.human = Matt. Hästi mängitud.
ann.mate.human.2 = See on matt. Palju õnne.
ann.mate.human.3 = Matt! Ilusti tehtud.
# The coach checkmates the player.
ann.mate.coach.b1 = See on matt. Sinu kuningal pole pääsu.
ann.mate.coach.b1.2 = Matt. Sinu kuningas on rünnaku all ega pääse minema.
ann.mate.coach.b1.3 = Kahjuks on see matt. Sinu kuningas ei saa enam põgeneda.
ann.mate.coach = Matt.
ann.mate.coach.2 = Ja ongi matt.
ann.mate.coach.3 = Kahjuks matt.

