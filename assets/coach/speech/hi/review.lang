# ---- The coach's own threats (levels 1-2, before the player moves) ------------------------------
# A mate threat ({sq} = where it would mate, pointed at at level 1; {my} = the piece).
threat.mate.b1 = सावधान! मैं {sq} पर मात की धमकी दे रहा हूँ।
threat.mate.b1.2 = ध्यान दो: {my} {sq} पर जाना चाहता है। वह शह और मात होगी।
threat.mate.b1.3 = {sq} को देखो। अगर मैं वहाँ पहुँच गया, तो शह और मात है!
threat.mate.b2 = सावधान, मैं मात की धमकी दे रहा हूँ।
threat.mate.b2.2 = ध्यान दो: {sq} पर मात का ख़तरा है।
threat.mate.b2.3 = ध्यान से देखो: मैं मात की धमकी दे रहा हूँ।
threat.mate.b3 = सावधान, मैं {sq} पर मात की धमकी दे रहा हूँ।
threat.mate.b3.2 = मात की धमकी है: {my} {sq} पर जाना चाहता है।
threat.mate.b3.3 = सावधान: मैं शह और मात की धमकी दे रहा हूँ।
# A threat on a piece ({my} = my attacker, pointed at at level 1; {your} = the target, pointed at).
threat.piece.b1 = देखो: {my} {your:par} हमला कर रहा है।
threat.piece.b1.2 = सावधान! {your:par} {my:ka} हमला है।
threat.piece.b1.3 = ध्यान दो, {my} {your:ko} काटना चाहता है।
threat.piece.b2 = {your:refl_ka} ध्यान रखो।
threat.piece.b2.2 = {your:par} हमला है।
threat.piece.b2.3 = {your:refl_par} नज़र रखो।
threat.piece.b3 = {my} {your:par} हमला कर रहा है, और उसे काटने से मुझे मटीरियल मिलेगा।
threat.piece.b3.2 = {your} ख़तरे में है: {my} {your:ko} काटने की धमकी दे रहा है।
threat.piece.b3.3 = सावधान: मेरी पिछली चाल {your:par} हमला करती है।
# A fork the coach's move sets up (level 2): {my} on {sq} attacks {t1} and {t2}.
threat.fork.b2 = {sq} पर {my} एक साथ {t1:obl} और {t2:obl} पर हमला कर रहा है। यह फ़ोर्क है!
threat.fork.b2.2 = सावधान, यह फ़ोर्क है: {my} {t1:obl} और {t2:obl} पर हमला कर रहा है।
threat.fork.b2.3 = {my:ka} {t1:obl} और {t2:obl} पर फ़ोर्क है। दोनों को आसानी से नहीं बचाया जा सकता।
# A pin (level 2): {my} on {sq} holds {your} in front of {t1}, the piece behind it.
threat.pin.b2 = {sq} पर {my} {your:ko} {t1:ke} सामने पिन कर रहा है। अगर वह हटे, तो मैं {t1:ko} काट लूँगा।
threat.pin.b2.2 = सावधान: {your} {my:se} पिन है। अगर वह हटे, तो {t1} गया।
threat.pin.b2.3 = {your} पिन है: अगर वह हटे, तो {my} {t1:ko} काट लेगा।
# Only one move is good (level 3).
threat.only.b3 = यह निर्णायक स्थिति है: सिर्फ़ एक चाल सच में अच्छी है। आराम से सोचो।
threat.only.b3.2 = सावधान, यहाँ सिर्फ़ एक अच्छी चाल है। पहले सब कुछ देखो।
threat.only.b3.3 = धीरे: इस स्थिति में ज़्यादातर चालें ग़लत पड़ती हैं।
threat.punish.b1 = मेरी पिछली चाल ग़लती थी। क्या तुम्हें इसका फ़ायदा उठाने का रास्ता दिखता है?
threat.punish.b1.2 = हम्म, लगता है मुझसे ग़लती हो गई। क्या तुम्हें वह दिखती है?

# ---- Takebacks ------------------------------------------------------------------------------------
# After the takeback is accepted, a hint (levels 1-2).
tb.hint.b1 = इस बार {your:refl_ke} बारे में सोचो।
tb.hint.b1.2 = {your:refl_par} नज़र रखो।
tb.hint.king.b1 = {your:refl_ki} सुरक्षा के बारे में सोचो।
tb.hint.king.b1.2 = पहले {your:refl_ko} देखो। क्या वह सुरक्षित है?
tb.hint.missed.b1 = ऐसे मोहरे ढूँढो जो मुफ़्त में काटे जा सकें।
tb.hint.missed.b1.2 = ध्यान से देखो: क्या कुछ काटा जा सकता है?
tb.hint.mate_missed.b1 = मेरे राजा को देखो। क्या उसे मात दी जा सकती है?
