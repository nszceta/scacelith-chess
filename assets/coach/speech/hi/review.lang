ex.verdict.blunder.b1.2 = सावधान! यह चाल तुम्हें महँगी पड़ सकती है।
ex.verdict.blunder.b1.3 = अरे, रुको। इस चाल में एक समस्या है।
ex.verdict.blunder.b2 = हम्म, इस चाल में एक समस्या है।
ex.verdict.blunder.b2.2 = यह बड़ी ग़लती है।
ex.verdict.blunder.b2.3 = सावधान, इस चाल से तुम्हारा कुछ नुक़सान होता है।
ex.verdict.blunder.b3 = यह ब्लंडर है।
ex.verdict.blunder.b3.2 = {move}, यह सचमुच एक ग़लती है।
ex.verdict.blunder.b3.3 = उफ़! {move}, यह बड़ी ग़लती है।
ex.verdict.blunder.b4 = {move}, यह ब्लंडर है।
ex.verdict.blunder.b4.2 = {move}, यह गंभीर ग़लती है।
ex.verdict.blunder.b4.3 = अफ़सोस, यह ब्लंडर है।
ex.verdict.blunder.b5 = {move}, यह गंभीर ग़लती है।
ex.verdict.blunder.b5.2 = {move}, यह ब्लंडर है।
ex.verdict.blunder.b5.3 = {move}, यह महँगी ग़लती है।
