ex.verdict.inaccuracy.b5 = {move}, यह सटीक नहीं है। ज़्यादा मज़बूत चाल थी: {best}।
ex.verdict.inaccuracy.b5.2 = थोड़ी-सी चूक। मैं यह चाल खेलता: {best}।
ex.verdict.inaccuracy.b5.3 = {move}, इससे ज़्यादा सटीक चाल थी: {best}।
ex.verdict.inaccuracy.b6 = {move}: चूक; {best}।
