demo.move.2 = {move}।
demo.move.3 = फिर {move}।
# Levels 1-3, the coach's moves.
demo.my.move = {my} {sq} पर जाता है।
demo.my.move.2 = मैं {my:refl_ko} {sq} पर ले जाता हूँ।
demo.my.move.3 = फिर {my} {sq} पर जाता है।
demo.my.take = मैं {your} काट लेता हूँ।
demo.my.take.2 = {my} {your:ko} काटता है।
demo.my.take.3 = और मैं {your:ko} काट लेता हूँ।
demo.my.check = {my} {sq} पर जाता है। शह।
demo.my.check.2 = शह: {my} {sq} पर।
demo.my.check.3 = {my} {sq} पर, शह!
demo.my.mate = {my} {sq} पर जाता है। शह और मात।
demo.my.mate.2 = और {my} {sq} पर: शह और मात।
demo.my.mate.3 = {my} {sq} पर। यह शह और मात है।
# Levels 1-3, the coach's in-between move while a bigger piece of the player's ({t1}) is attacked.
demo.my.first.take = पहले {my} {your:ko} काटता है। {t1} इंतज़ार कर सकता है।
demo.my.first.take.2 = {my} पहले {your:ko} काटता है। {t1} तो वहीं रहेगा।
demo.my.first.check = {my} {your:ko} काटता है, और यह शह है! {t1} इंतज़ार कर सकता है।
demo.my.first.check.2 = पहले {my} शह देते हुए {your:ko} काटता है। {t1} तो वहीं रहेगा।
demo.my.first.check_move = पहले {my:se} {sq} पर शह। {t1} इंतज़ार कर सकता है।
demo.my.first.check_move.2 = {my} {sq} पर जाता है: पहले शह! {t1} तो वहीं रहेगा।
demo.my.first.move = पहले {my} {sq} पर जाता है। {t1} इंतज़ार कर सकता है।
demo.my.first.move.2 = पहले {my} {sq} पर। {t1} तो वहीं रहेगा।
# The piece that moves was attacked itself: it takes something before it can be taken.
demo.my.first.attacked = {my:par} हमला है, इसलिए वह पहले {your:ko} काटता है।
demo.my.first.attacked.2 = {my:par} हमला है: वह पहले {your:ko} झपट लेता है।
# Levels 4-6, the same in-between move.
demo.first = पहले {move}: {t1} इंतज़ार कर सकता है।
demo.first.2 = पहले {move}। {t1} तो वहीं रहेगा।
# After the rewind when no takeback is offered: the coach's real move comes next.
demo.play_on = अब मैं अपनी चाल चलता हूँ।
demo.play_on.2 = यह रही मेरी असली चाल।
demo.play_on.3 = और अब मैं सच में अपनी चाल चलता हूँ।
# Levels 1-3, the player's moves (what they would play): no verb with तुम as its subject.
demo.your.move = तुम्हारी चाल: {your} {sq} पर।
demo.your.move.2 = मान लो, तुम {your:refl_ko} {sq} पर ले जाओ।
demo.your.move.3 = फिर {your} {sq} पर जाता है।
demo.your.take = तब तुम्हारी ओर से {my} कटता है।
demo.your.take.2 = {your} {my:ko} काटता है।
demo.your.take.3 = फिर {my} कट जाता है।
demo.your.back = तुम्हारा जवाब: वापस काटना।
demo.your.back.2 = तुम्हारी ओर से {sq} पर वापस काटा जाता है।
demo.your.back.3 = और फिर तुम्हारी ओर से भी वापस काटा जाता है।
demo.your.king = तुम्हारे राजा को हटना होगा।
demo.your.king.2 = राजा को हटना होगा, {sq} पर।
demo.your.king.3 = तुम्हारा राजा भागकर {sq} पर जाता है।
# Levels 4-6 (and 1-3 when the whole line is too long): the demonstration stops where the problem
# stands ({t1} {t2} = the pieces that fall; {reply} = the mating move).
ex.point.piece = अब {t1:ko} बचाया नहीं जा सकता।
ex.point.piece.2 = और {t1} हाथ से गया।
ex.point.piece.3 = इसके बाद {t1} कटेगा।
ex.point.two = {t1:obl} और {t2:obl} दोनों पर हमला है: इनमें से एक कटेगा।
ex.point.two.2 = अब मैं {t1:obl} और {t2:obl} पर हमला करता हूँ। दोनों को बचाया नहीं जा सकता।
ex.point.mate = और अब {reply:nomate}: शह और मात।
ex.point.mate.2 = इसके बाद {reply:nomate}, और यह शह और मात है।
# Levels 1-3, at the end of a whole sequence shown on the board: what it cost.
ex.result.b1 = देखा? अब तुम्हें {pts:point_obl} का नुक़सान हो गया।
ex.result.b1.2 = ऐसे {pts:point_obl} का नुक़सान होता है।
ex.result.b2 = आख़िर में तुम्हें {pts:point_obl} का नुक़सान हुआ।
ex.result.b2.2 = अब तुम {pts:point} पीछे हो।
ex.result.b3 = इसकी क़ीमत: {pts:point}।
ex.result.b3.2 = आख़िर में तुम {pts:point} पीछे हो।
# The same when the player, to move, can still take something back ({pts} counts that capture).
ex.result_back.b1 = कुछ वापस काटा जा सकता है, पर फिर भी तुम {pts:point} पीछे हो।
ex.result_back.b1.2 = थोड़ा वापस जीता जा सकता है, पर फिर भी {pts:point_obl} का नुक़सान है।
ex.result_back.b2 = कुछ वापस मिल सकता है, पर फिर भी तुम {pts:point} पीछे हो।
ex.result_back.b2.2 = वापस काटने के बाद भी {pts:point_obl} का नुक़सान है।
ex.result_back.b3 = वापस काटने के बाद भी तुम {pts:point} पीछे हो।
ex.result_back.b3.2 = कुछ वापस मिलता है, पर फिर भी {pts:point_obl} का नुक़सान होता है।
# Why the player cannot take back where the sequence stops: the take-back ({move}, by {your2}) runs
# into a capture of the coach's ({reply}, by {my}) that takes {your}.
ex.retake.b1 = अगर {your2} वापस काटे, तो {my} {your:ko} काट लेगा।
ex.retake.b1.2 = {your2:refl_se} वापस काटना ठीक नहीं: तब {my} {your:ko} काट लेगा।
ex.retake.b2 = अगर {your2} वापस काटे, तो {my} {your:ko} काट लेगा।
ex.retake.b2.2 = {your2:refl_se} वापस काटना काम नहीं करता: {my} {your:ko} काट लेता है।
ex.retake.b3 = अगर तुम वापस काटो, {move}, तो {reply}, और {your} कट जाता है।
ex.retake.b3.2 = वापस काटना, {move}, काम नहीं करता: {reply}, और {your} कट जाता है।
ex.retake.b4 = {move}? इसका जवाब {reply}, और {your} कट जाता है।
ex.retake.b4.2 = और अगर {move}, तो {reply}, और {your} कट जाता है।
ex.retake.b5 = वापस काटने पर, {move}, जवाब है {reply}, और {your} कट जाता है।
ex.retake.b5.2 = {move}, पर {reply}: {your} कट जाता है।
ex.retake.b6 = {move}? {reply}, और {your} गया।
ex.retake.b6.2 = {move}: नाकाम। {reply}, और {your} कटता है।
# The player would promote: the coach points at the square instead of moving ({sq} is pointed at).
demo.promote = और यहाँ, {sq} पर, तुम्हें नया वज़ीर मिल जाता।
demo.promote.2 = फिर {your} {sq} पर पहुँचकर वज़ीर बन जाता है।

