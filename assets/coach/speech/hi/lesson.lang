# Coach speech (Hindi): the rules lesson (level 0, src/coach/lesson.cpp).
# Same keys and variants as assets/coach/speech/en/lesson.lang.
#
# Placeholders: {your} / {my} = a piece of the player / of the coach ("तुम्हारा हाथी", "मेरा घोड़ा"), with the
# forms of common.lang ({my:ko} "मेरे घोड़े को", {my:obl} + तक, {my:ke} + बगल में, {my:ki} + तरफ़ ...). When the
# player acts with their own piece (an imperative), Hindi says "अपना": {your:refl_ka} इस्तेमाल करो,
# {your:refl_se} मात दो. {sq}, {sq2}, {to}, {esc} = squares ("{sq} पर"); {move} = a move. {@}, {@2}, {@3} are
# invisible marks: the coach points at something while saying the word right after the mark.
# A ".spoken" key is what the voice says instead (here: Latin letters said as their Hindi letter names, and
# "Elo" as "एलो"). Files = फ़ाइल, ranks = रैंक, back rank = पिछली रैंक; checkmate = "शह और मात".
# The player's gender is unknown: no verb agrees with "तुम" except the imperative, the subjunctive and "हो".

# ---- Chapter titles (said inside "चलो, पाठ आगे बढ़ाते हैं: {chapter}।") ---------------------------------
lesson.title.welcome = शतरंज का बोर्ड
lesson.title.pieces_lines = हाथी, ऊँट और वज़ीर कैसे चलते हैं
lesson.title.pieces_steps = राजा, घोड़ा और प्यादा कैसे चलते हैं
lesson.title.values_setup = मोहरों की क़ीमत और पहली चालें
lesson.title.safety = कब काटना सुरक्षित है
lesson.title.check = शह
lesson.title.mate = शह और मात
lesson.title.castling = कैसलिंग
lesson.title.en_passant = आँ पासाँ
lesson.title.promotion = प्रमोशन
lesson.title.draws = स्टेलमेट और ड्रॉ
lesson.title.before_move = चलने से पहले
lesson.title.opening = ओपनिंग
lesson.title.review = एक छोटा दोहराव
lesson.title.etiquette = हमारी बाज़ियाँ कैसे चलती हैं

# ---- Lines every exercise uses ------------------------------------------------------------------------
# After the coach demonstrated the solution.
lesson.now_you = अब तुम कोशिश करो।
lesson.now_you.2 = अब तुम्हारी बारी।
lesson.now_you.3 = अब तुम।
# Another wrong move after the demonstration.
lesson.almost = लगभग! वही चाल चलो, जो मैंने दिखाई।
lesson.almost.2 = पूरी तरह सही नहीं। वह चाल आज़माओ, जो मैंने करके दिखाई थी।
lesson.almost.3 = बहुत क़रीब! याद करो, मैंने अभी क्या दिखाया।
# A wrong move without a line of its own.
lesson.try_again = यह नहीं। फिर से कोशिश करो।
lesson.try_again.2 = यह चाल नहीं। एक बार और कोशिश करो।
lesson.try_again.3 = चलो, एक बार और कोशिश करते हैं।
lesson.use_your = {your:refl_ka} इस्तेमाल करो।
lesson.use_your.2 = {your:refl_se} कोशिश करो।
lesson.watch = देखो।
lesson.like_this = ऐसे।
lesson.and_back = और वापस।
# A check that is not checkmate (the coach then shows the escape).
lesson.check_escape = शह, लेकिन मेरा राजा बचकर {esc} पर चला जाता है।
lesson.check_takes = शह, लेकिन मेरा राजा बस {your:ko} काट लेता है।
lesson.check_block = शह, लेकिन मैं बीच में कोई मोहरा रख सकता हूँ।
lesson.stalemate = स्टेलमेट! मेरा राजा चल नहीं सकता, और उस पर शह भी नहीं है। ड्रॉ, जबकि बाज़ी तुम्हारे हाथ में थी!

# ---- Why a move is not allowed (the coach points at the piece or square in question) ----------------
# {sq} = the square in question, {my} = the coach's piece that attacks, pins, blocks or gives
# check, {your} = the piece the player tried to move.
why.KingIntoCheck = {sq} पर नहीं: {my} उस खाने पर हमला कर रहा है। राजा कभी ख़तरे में नहीं जाता।
why.PathBlocked = {@}रास्ते में कुछ है: घोड़े के सिवा कोई मोहरा कूद नहीं सकता।
why.WrongGeometry = {your} ऐसे नहीं चलता।
why.MustAnswerCheck = तुम {@}शह में हो: पहले उससे बचना ज़रूरी है।
why.CastlingThroughCheck = तुम्हारा राजा {sq} से होकर गुज़रता, और {my} उस खाने पर हमला कर रहा है।
why.CastlingNoRights = यह राजा या हाथी पहले ही चल चुका है: कैसलिंग नहीं हो सकती।
why.CastlingBlocked = कैसलिंग के लिए राजा और हाथी के बीच के खाने ख़ाली होने चाहिए।
why.CastlingOutOfCheck = शह में रहते हुए कैसलिंग नहीं की जा सकती।
why.PawnForwardBlocked = प्यादे सीधे आगे नहीं काट सकते: आगे का रास्ता {@}बंद है।
why.LeavesKingInCheck = {your} पिन है: उसे हटाने पर तुम्हारा राजा {my:ke} निशाने पर आ जाएगा।
why.OwnPieceOnTarget = अपने ही मोहरे वाले खाने पर चाल नहीं चली जा सकती।
why.PawnCaptureNeedsVictim = प्यादा तिरछा सिर्फ़ काटने के लिए चलता है।
why.EnPassantExpired = आँ पासाँ सिर्फ़ प्यादे के दो खाने चलने के ठीक बाद हो सकता है।
why.NotYourTurn = रुको: अभी मेरी बारी है।

# ---- Chapter 0: welcome and the board -------------------------------------------------------------------
lesson.welcome.hello = नमस्ते! मैं तुम्हारा कोच हूँ। चलो, शतरंज के नियम साथ मिलकर सीखते हैं, एक-एक छोटा क़दम करके।
lesson.welcome.board = यह शतरंज का बोर्ड है: चौंसठ खाने, हल्के और गहरे, आठ-आठ खानों की आठ पंक्तियाँ।
lesson.welcome.light = तुम्हारी {@}दाईं ओर के कोने का खाना हमेशा हल्के रंग का होता है। याद रखो: दाईं ओर हल्का।
lesson.welcome.files = खड़ी पंक्तियों को फ़ाइल कहते हैं। इन्हें अक्षरों से पहचाना जाता है, {@}a से {@2}h तक।
lesson.welcome.files.spoken = खड़ी पंक्तियों को फ़ाइल कहते हैं। इन्हें अक्षरों से पहचाना जाता है, {@}ए से {@2}एच तक।
lesson.welcome.ranks = आड़ी पंक्तियों को रैंक कहते हैं। इन्हें अंकों से पहचाना जाता है, {@}एक से {@2}आठ तक, तुम्हारी तरफ़ से शुरू करके।
lesson.welcome.square = हर खाने का नाम पहले उसके अक्षर और फिर उसके अंक से बनता है। यह खाना {sq} है।
lesson.welcome.square2 = और यह {sq} है।
lesson.welcome.kings = ये दोनों राजा हैं। तुम्हारा {sq} पर है, मेरा {sq2} पर।
lesson.welcome.ask = तुम्हारी बारी: अपने राजा को एक खाना आगे, {sq} पर ले जाओ।
lesson.welcome.wrong = यह {to} है। हमें {sq} चाहिए: अक्षर e, अंक दो।
lesson.welcome.wrong.spoken = यह {to} है। हमें {sq} चाहिए: अक्षर ई, अंक दो।
lesson.welcome.ok = बिल्कुल सही। तुम्हारा राजा {sq} पर है।

# ---- Chapter 1: how the pieces move and capture -----------------------------------------------------------
# Rook
lesson.rook.intro = यह {your} है। यह फ़ाइलों और रैंकों पर सीधी रेखा में, जितनी दूर चाहे, चलता है।
lesson.rook.lines = फ़ाइल पर ऊपर, {@}या रैंक के साथ-साथ।
lesson.rook.capture = काटने के लिए मोहरा किसी {@}विरोधी मोहरे के खाने पर जाता है, और वह विरोधी मोहरा बोर्ड से बाहर हो जाता है।
lesson.rook.ask = अपने हाथी से {my:ko} काटो!
lesson.rook.short = दिशा सही है! फ़ाइल पर ऊपर बढ़ते जाओ, सीधे {my:obl} तक।
lesson.rook.rank = यह तो रैंक पर चलना हुआ। {my} फ़ाइल पर ऊपर है।
lesson.rook.king = यह तुम्हारा राजा है। कोने में खड़े {your:refl_ka} इस्तेमाल करो।
lesson.rook.ok = कट गया! {my} बोर्ड से बाहर हो जाता है।
# Pieces don't jump
lesson.jump.blocked = मोहरे दूसरे मोहरों के ऊपर से नहीं कूद सकते। {sq} पर खड़ा तुम्हारा प्यादा हाथी का रास्ता रोक रहा है।
lesson.jump.all = ऊँट और वज़ीर के लिए भी यही नियम है: वे भी मोहरों के ऊपर से नहीं कूद सकते।
# Bishop
lesson.bishop.intro = यह {your} है। यह तिरछा, जितनी दूर चाहे, चलता है।
lesson.bishop.colour = ऊँट हमेशा एक ही रंग के खानों पर रहता है।
lesson.bishop.ask = {my} तुम्हारे ऊँट के विकर्ण पर खड़ा है। {my:pron_ko} काटो!
lesson.bishop.short = विकर्ण सही है! और आगे जाओ, {my:obl} तक।
lesson.bishop.other = यह दूसरा विकर्ण है। {my:ki} तरफ़ देखो।
lesson.bishop.ok = शानदार। ऊँटों को लंबे विकर्ण बहुत पसंद हैं।
# Queen
lesson.queen.intro = यह {your} है, सबसे ताक़तवर मोहरा। यह हाथी और ऊँट, दोनों की तरह चलता है।
lesson.queen.ask = {my:ko} ढूँढो और अपने वज़ीर से उसे काटो।
lesson.queen.wrong = तुम्हारा वज़ीर एक ही चाल में, विकर्ण पर चलकर, {my:obl} तक पहुँच सकता है।
lesson.queen.ok = शाबाश! अपने वज़ीर को सुरक्षित रखो: वह बहुत क़ीमती है।
# King
lesson.king.intro = राजा किसी भी दिशा में सिर्फ़ एक खाना चलता है।
lesson.king.important = राजा सबसे ज़रूरी मोहरा है। अगर वह फँस जाए, तो बाज़ी हाथ से चली जाती है।
lesson.king.ask = राजा भी काट सकता है। {my:ko} काटो!
lesson.king.wrong = तुम्हारा राजा {my:ke} ठीक बगल में है। उसके खाने पर जाकर उसे काटो।
lesson.king.ok = बढ़िया! राजा धीमा है, पर पास से ताक़तवर है।
# Knight
lesson.knight.intro = यह {your} है। यह L के आकार में चलता है: दो खाने सीधे, फिर एक बगल में।
lesson.knight.intro.spoken = यह {your} है। यह एल के आकार में चलता है: दो खाने सीधे, फिर एक बगल में।
lesson.knight.l = {@}ऐसे। घोड़ा हमेशा दूसरे रंग के खाने पर पहुँचता है।
lesson.knight.jump = घोड़ा अकेला ऐसा मोहरा है, जो दूसरे मोहरों के ऊपर से कूद सकता है।
lesson.knight.ask = अपने घोड़े से {my:ko} काटो!
lesson.knight.wrong = यह घोड़े की सही चाल है, पर यह {my:obl} तक नहीं पहुँचती। कोई दूसरा L आज़माओ।
lesson.knight.wrong.spoken = यह घोड़े की सही चाल है, पर यह {my:obl} तक नहीं पहुँचती। कोई दूसरा एल आज़माओ।
lesson.knight.ok = शानदार छलाँग!
# Pawn: moving
lesson.pawn.intro = अब {your}। यह सीधा आगे चलता है, एक बार में एक खाना, और कभी पीछे नहीं जाता।
lesson.pawn.first = अपनी पहली चाल में प्यादा एक या दो खाने चल सकता है।
lesson.pawn.ask = अपने प्यादे को दो खाने आगे बढ़ाओ।
lesson.pawn.one = यह एक खाना हुआ: यह भी नियम से सही है, पर इस बार दो खाने आगे बढ़ाओ।
lesson.pawn.use = प्यादे का इस्तेमाल करो।
lesson.pawn.ok = बढ़िया।
# Pawn: capturing
lesson.pawncap.blocked = मेरा प्यादा तुम्हारे प्यादे का रास्ता रोक रहा है। प्यादे सीधे आगे नहीं काट सकते।
lesson.pawncap.diagonal = लेकिन प्यादा तिरछा काटता है, एक खाना आगे।
lesson.pawncap.ask = अपने प्यादे से {my:ko} काटो।
lesson.pawncap.use = {your:refl_ka} इस्तेमाल करो: वह तिरछा आगे की ओर काटता है।
lesson.pawncap.ok = हाँ! चलना सीधा, काटना तिरछा।
# Values, set-up and the first moves
lesson.values.pawn = हर मोहरे की अंकों में एक क़ीमत होती है। प्यादे की क़ीमत एक अंक है।
lesson.values.pieces = घोड़ा या {@}ऊँट, तीन। {@2}हाथी, पाँच। {@3}वज़ीर, नौ।
lesson.values.king = राजा अनमोल है: उसे कभी नहीं दिया जा सकता।
lesson.values.trade = अपना बड़ा मोहरा देकर छोटा मोहरा मत लो, जब तक कि खोने से ज़्यादा तुम्हें मिल न रहा हो।
# Practice: two pieces nothing defends ({sq} = the queen's square, {sq2} = the pawn's, {my} = the queen)
lesson.values.two = तुम्हारा घोड़ा मेरे दो मोहरों पर हमला कर रहा है: {sq} और {sq2} पर। किसी का भी बचाव नहीं हो रहा।
lesson.values.ask = जिसकी क़ीमत ज़्यादा है, उसे काटो!
lesson.values.small = वह प्यादा है, उसकी क़ीमत एक है। {my} भी मुफ़्त था, और उसकी क़ीमत नौ है।
lesson.values.look = देखो, तुम्हारा घोड़ा किन पर हमला कर रहा है, और जिसकी क़ीमत ज़्यादा है, उसे काटो।
lesson.values.ok = हाँ! वज़ीर की क़ीमत नौ है। जब दो मोहरे मुफ़्त हों, तो बड़ा वाला काटो।
lesson.setup.corners = हर बाज़ी ऐसे शुरू होती है: {@}कोनों में हाथी, फिर {@2}घोड़े, फिर {@3}ऊँट।
lesson.setup.queen = वज़ीर अपने ही रंग के खाने पर खड़ा होता है: तुम्हारा वज़ीर हल्के रंग के खाने पर है।
lesson.setup.king = राजा उसके बगल में खड़ा होता है। पहली चाल हमेशा सफ़ेद चलता है।
lesson.first.ask = बाज़ी शुरू करो: अपने राजा के आगे वाले प्यादे को दो खाने बढ़ाकर {sq} पर ले जाओ।
lesson.first.wrong = यह भी नियम से सही चाल है! पर अभी, ज़रा अपने राजा के आगे वाला प्यादा {sq} पर ले जाओ।
lesson.first.ok = पहली चाल बढ़िया है: इससे तुम्हारे वज़ीर और ऊँट के लिए रास्ते खुल जाते हैं।
lesson.first.reply = मैं भी वैसा ही जवाब देता हूँ। अब एक घोड़ा बाहर निकालो: {sq} से {sq2} पर कूदो।
lesson.first.knight_wrong = घोड़े प्यादों के ऊपर से कूदते हैं। {sq} से {sq2} पर कोशिश करो।
lesson.first.knight_ok = बिल्कुल सही। घोड़े और ऊँट जल्दी बाहर आते हैं।

# ---- Chapter 2: safe and unsafe captures ---------------------------------------------------------------------
lesson.safety.defended = किसी मोहरे का बचाव तब होता है, जब उसका कोई साथी मोहरा वापस काट सके।
lesson.safety.pawn = मेरा {@}प्यादा {my:ka} बचाव करता है।
lesson.safety.free = लेकिन {my:ka} कोई रक्षक नहीं है। तुम्हारा वज़ीर दोनों मोहरों पर हमला कर रहा है।
lesson.safety.ask = असुरक्षित मोहरे को काटो!
lesson.safety.watch = देखो, क्या होता है।
lesson.safety.gave = तुमने नौ अंकों का अपना वज़ीर, मेरे तीन अंकों के घोड़े के बदले दे दिया।
lesson.safety.other = दूसरा मोहरा आज़माओ।
lesson.safety.look = वह मोहरा ढूँढो, जिसका बचाव कोई नहीं कर रहा।
lesson.safety.ok = शानदार! हमेशा ख़ुद से पूछो: क्या उस मोहरे का बचाव हो रहा है?
# A defended pawn: the queen must not take it ({sq}, {sq2} = the two pawns)
lesson.safety.pawns = तुम्हारा वज़ीर मेरे दो प्यादों पर हमला कर रहा है: {sq} और {sq2} पर।
lesson.safety.pawns_ask = उस प्यादे को काटो, जिसे काटना सुरक्षित है।
lesson.safety.gave_pawn = तुमने नौ अंक का अपना वज़ीर, एक अंक के प्यादे के बदले दे दिया।
lesson.safety.pawns_other = प्यादे का भी बचाव हो सकता है। दूसरा प्यादा आज़माओ।
lesson.safety.pawns_ok = सही! बचाव वाले प्यादे के लिए कभी अपने वज़ीर को ख़तरे में मत डालो।
# The other way round: a small piece may take a big defended one ({my} = the queen)
lesson.safety.small = अब दूसरी तरफ़ से देखो। {my:ka} बचाव हो रहा है, पर तुम्हारा प्यादा {my:par} हमला कर रहा है।
lesson.safety.small_count = अगर तुम उसे काटो, तो मेरा {@}प्यादा तुम्हारे प्यादे को वापस काट लेगा। एक अंक जाएगा और नौ अंक मिलेंगे।
lesson.safety.small_ask = सही मोहरे से मेरे वज़ीर को काटो!
lesson.safety.small_other = उसे अपने प्यादे से काटो: सबसे सस्ते मोहरे से, जो काट सकता है।
lesson.safety.small_look = तुम्हारा प्यादा मेरे वज़ीर पर हमला कर रहा है। उसी से उसे काटो।
lesson.safety.small_ok = हाँ! छोटा मोहरा बड़े मोहरे को काट सकता है, बचाव वाले को भी: एक अंक जाता है और नौ अंक मिलते हैं।
lesson.safety.count = हर बार काटने से पहले गिनो: क्या मिलेगा, और बदले में क्या वापस जा सकता है।

# ---- Chapter 3: check and getting out of check -----------------------------------------------------------------
lesson.danger.rank = पूरी दूसरी रैंक मेरे हाथी के नियंत्रण में है।
lesson.danger.rule = राजा कभी ऐसे खाने पर नहीं जा सकता, जहाँ उसे काटा जा सके।
lesson.danger.ask = अपने राजा को किसी सुरक्षित खाने पर ले जाओ।
lesson.danger.ok = सही। वहाँ तुम्हारा राजा सुरक्षित है।
lesson.check.what = मेरा हाथी तुम्हारे राजा पर हमला कर रहा है। इसे शह कहते हैं।
lesson.check.must = जब तुम शह में हो, तो तुम्हें तुरंत शह से बचना होगा।
lesson.check.ways = इसके तीन तरीक़े हैं: {@}राजा को हटाना, {@2}हमले को बीच में रोकना, या {@3}हमलावर को काटना।
lesson.check.ask = यहाँ अपने राजा को शह से बाहर निकालो।
lesson.check.file = {to} अब भी {@}मेरे हाथी की फ़ाइल पर है। उस रेखा से हट जाओ।
lesson.check.ok = बढ़िया: अब तुम शह में नहीं हो।
lesson.block.again = फिर से शह! इस बार तुम्हारे राजा के पास कोई ख़ाली खाना नहीं है।
lesson.block.ask = तो हमले को रोको: रास्ते में कोई मोहरा रखो।
lesson.block.queen = हमला रुक गया! लेकिन मेरा हाथी तुम्हारे वज़ीर को काट सकता है। किसी सस्ते मोहरे से रोको।
lesson.block.queen_ok = यह भी चलता है। याद रखो: सबसे सस्ते मोहरे से रोको।
lesson.block.ok = बिल्कुल सही। सबसे कम क़ीमत वाले मोहरे से रोको।
lesson.capture.check = मेरा वज़ीर तुम्हारे राजा के ठीक बगल से शह देता है।
lesson.capture.ask = हमलावर को काटो!
lesson.capture.king_ok = हाँ! मेरे वज़ीर का कोई रक्षक नहीं था, इसलिए तुम्हारा राजा उसे काट सका।
lesson.capture.knight_ok = हाँ! तुम्हारे घोड़े ने हमलावर को हटा दिया।
lesson.check.open.ask = फिर शह! इस बार जिस तरीक़े से चाहो, शह से बचो।
lesson.check.open.king = तुमने राजा को हटा दिया। कोई मोहरा बीच में भी आ सकता था, या तुम्हारा घोड़ा मेरा हाथी काट सकता था।
lesson.check.open.block = तुमने हमले को रोक दिया। तुम्हारा राजा हटकर भी बच सकता था, या तुम्हारा घोड़ा मेरा हाथी काट सकता था।
lesson.check.open.take = तुमने मेरा हाथी काट लिया, जो शह दे रहा था। राजा हटाना या हमला रोकना भी चलता।
lesson.check.open.hint = तीन तरीक़े: {@}राजा को हटाओ, {@2}फ़ाइल पर हमला रोको, या {@3}अपने घोड़े से मेरा हाथी काटो।

# ---- Chapter 4: checkmate ------------------------------------------------------------------------------------
lesson.mate1.what = शह और मात: राजा शह में है, और उसके बचने का कोई रास्ता नहीं। इससे बाज़ी जीती जाती है।
lesson.mate1.stuck = मेरा राजा {@}अपने ही प्यादों के पीछे फँसा है।
lesson.mate1.ask = मुझे एक चाल में मात दो!
lesson.mate1.wrong = बहुत क़रीब! मेरी पिछली रैंक पर शह दो, जहाँ से मेरा राजा भाग नहीं सकता।
lesson.mate1.ok = शह और मात! इसे पिछली रैंक पर मात कहते हैं। इसे याद रखो!
lesson.mate1.king = तुम्हारा राजा जहाँ है, ठीक है। शह देने के लिए हाथी का इस्तेमाल करो।
lesson.mate1.why = देखा? हाथी मेरी {@}पूरी पिछली रैंक को ढक लेता है, और मेरे {@2}अपने प्यादे राजा के आगे के खाने भर देते हैं।
lesson.mate2.ask = तुम्हारा राजा और वज़ीर मिलकर काम करते हैं। मुझे एक चाल में मात दो।
lesson.mate2.wrong = ऐसी शह ढूँढो, जिसके बाद मेरे राजा के पास एक भी खाना न बचे।
lesson.mate2.ok = शह और मात! तुम्हारा राजा वज़ीर की रक्षा करता है, इसलिए मेरा राजा उसे काट नहीं सकता।
lesson.mate2.ok_rank = पिछली रैंक पर शह और मात! तुम्हारा राजा मेरे राजा के आगे के हर खाने पर पहरा देता है।
lesson.mate2.king = तुम्हारा राजा मेरे राजा के पास के खानों पर पहरा दे रहा है। उसे वहीं रहने दो और वज़ीर का इस्तेमाल करो।
lesson.mate2.half = इससे {sq} पर नज़र रहती है, पर मेरा राजा अब भी {sq2} पर जा सकता है।
lesson.mate2.why = देखा? तुम्हारा वज़ीर {sq} और {sq2} को ढकता है, और तुम्हारा राजा मेरे राजा के आगे के खानों को। मेरे राजा के पास निकलने का रास्ता नहीं।
lesson.mate3.edge = सातवीं रैंक पर खड़ा तुम्हारा हाथी मेरे राजा को किनारे पर रोके रखता है।
lesson.mate3.ask = अब {your:refl_se} मात दो।
lesson.mate3.free = शह, लेकिन अब सातवीं रैंक ख़ाली है, और मेरा राजा निकल भागता है।
lesson.mate3.takes = मेरा राजा बस तुम्हारे हाथी को काट लेता है।
lesson.mate3.hint = पिछली रैंक पर उस हाथी से शह दो, जो सातवीं रैंक पर पहरा नहीं दे रहा।
lesson.mate3.ok = शह और मात! दोनों हाथियों ने सीढ़ी की तरह काम किया।
lesson.mate3.why = देखा? एक हाथी {@}सातवीं रैंक को काट देता है, और दूसरा {@2}पिछली रैंक पर शह देता है। मेरे राजा के पास निकलने का रास्ता नहीं।
lesson.mate4.look = शह हमेशा मात नहीं होती। देखते हैं, क्या होता है।
lesson.mate4.ask = अपने हाथी से मेरे राजा को शह दो।
lesson.mate4.king = तुम्हारा राजा वहीं रहने दो। शह देने के लिए हाथी का इस्तेमाल करो।
lesson.mate4.wrong = यह शह नहीं है। तुम्हारा हाथी पिछली रैंक से मेरे राजा पर हमला कर सकता है।
lesson.mate4.ok = हाँ, यह शह है! पर क्या यह मात है? देखो।
lesson.mate4.after = {sq} पर मेरे प्यादे ने मेरे राजा को जगह दे दी। शह पर ख़ुश होने से पहले गिनो कि मेरे राजा के पास अब भी कितने खाने हैं।
lesson.mate5.ask = तुम्हारे हाथी की दो चालें शह देती हैं, और उनमें से सिर्फ़ एक मात है। मेरे राजा के खाने गिनो, फिर चुनो।
lesson.mate5.king = तुम्हारा राजा {sq} और {sq2} को पहले ही ढक रहा है। उसे वहीं रहने दो और हाथी चलो।
lesson.mate5.wrong = यह शह नहीं है। ऐसी हाथी की चाल ढूँढो, जो मेरे राजा पर हमला करे।
lesson.mate5.hint = तुम्हारा राजा {sq} और {sq2} को ढकता है। हाथी की कौन-सी शह {sq3} को भी छीन लेती है?
lesson.mate5.why = देखा? हाथी {sq} को ढकता है, तुम्हारा राजा बाक़ी दो खानों को, और मेरा राजा फँस गया।
lesson.mate5.ok = शह और मात! तुमने मेरे राजा के खाने गिने: एक भी नहीं बचा था।

# ---- Chapter 5: castling ---------------------------------------------------------------------------------------
# Kingside / queenside castling = छोटी / लंबी कैसलिंग, "on the king's side" = राजा की ओर (the glossary's terms).
lesson.castle.what = कैसलिंग एक ख़ास चाल है, जो तुम्हारे राजा को सुरक्षित रखती है। राजा और हाथी एक साथ चलते हैं।
lesson.castle.how = {@}राजा किसी हाथी की ओर दो खाने चलता है, और {@2}हाथी कूदकर राजा की दूसरी तरफ़ आ जाता है।
lesson.castle.ask = हमेशा पहले राजा को छुओ। अब तुम: राजा की ओर कैसलिंग करो।
lesson.castle.rook = इससे सिर्फ़ हाथी चलता है। कैसलिंग के लिए अपने राजा को उसकी ओर दो खाने चलाओ।
lesson.castle.long = यह लंबी कैसलिंग है, यह भी नियम से सही है! इस बार पास वाले हाथी की ओर कैसलिंग करो।
lesson.castle.one = एक खाना तो राजा की सामान्य चाल है। कैसलिंग में राजा दो खाने चलता है।
lesson.castle.other = कैसलिंग के लिए अपने राजा को {sq} पर खड़े हाथी की ओर दो खाने चलाओ।
lesson.castle.ok = कैसलिंग हो गई! तुम्हारा राजा सुरक्षित कोने में पहुँच गया, और तुम्हारा हाथी खेलने के लिए तैयार है।
lesson.castle2.moved = अगर तुम्हारा राजा या वह हाथी पहले चल चुका हो, तो कैसलिंग नहीं हो सकती।
lesson.castle2.attacked = शह में रहते हुए भी नहीं, और तब भी नहीं, जब तुम्हारा राजा किसी ऐसे खाने से गुज़रे या उस पर पहुँचे, जिस पर हमला हो।
lesson.castle2.bishop = मेरा ऊँट {sq} पर हमला कर रहा है। इसलिए अभी इस तरफ़ कैसलिंग मना है।
lesson.castle2.ask = दूसरी तरफ़ कैसलिंग करो।
lesson.castle2.other = अपने दूसरे हाथी की ओर, यानी वज़ीर की तरफ़, कैसलिंग करो।
lesson.castle2.ok = सही! लंबी कैसलिंग से तुम्हारा राजा {sq} पर पहुँचता है।

# En passant starts with the double step
lesson.ep0.rule = आँ पासाँ की शुरुआत दो खानों की चाल से होती है। दो खाने सिर्फ़ वही प्यादा चल सकता है, जो {@}अब भी अपनी जगह पर है। जो प्यादा {@2}चल चुका है, वह एक-एक खाना चलता है।
lesson.ep0.ask = अपना कोई प्यादा दो खाने आगे बढ़ाओ।
lesson.ep0.moved = वह प्यादा पहले ही चल चुका है, इसलिए एक ही खाना चल सकता है। जो प्यादा अब भी अपनी जगह पर है, उसे चलो।
lesson.ep0.ok = सही: दो खाने सिर्फ़ अपने शुरुआती खाने वाला प्यादा चल सकता है।

# ---- Chapter 6: en passant ------------------------------------------------------------------------------------
lesson.ep.what = प्यादे के काटने का एक ख़ास तरीक़ा है, जिसे आँ पासाँ कहते हैं। इसका मतलब है “गुज़रते हुए”।
lesson.ep.watch = मेरे प्यादे को देखो: यह दो खाने चलकर ठीक तुम्हारे प्यादे के बगल में आ जाता है।
lesson.ep.how = तुम्हारा प्यादा इसे ऐसे काट सकता है, मानो यह सिर्फ़ एक खाना चला हो: {sq} पर जाकर।
lesson.ep.now = लेकिन सिर्फ़ अभी, इसी चाल में। आँ पासाँ से काटो!
lesson.ep.gone = मौक़ा निकल गया: आँ पासाँ सिर्फ़ तुरंत ही हो सकता है। चलो, फिर से कोशिश करते हैं।
lesson.ep.ok = आँ पासाँ! {sq} पर खड़ा मेरा प्यादा बोर्ड से बाहर हो गया।
# Practice: two pawns beside the player's; only the one that just moved two squares can be taken
lesson.ep2.old = {sq} पर खड़ा मेरा प्यादा काफ़ी समय से तुम्हारे प्यादे के बगल में है। उसे आँ पासाँ से काटने में अब देर हो चुकी है।
lesson.ep2.watch = अब मेरा दूसरा प्यादा देखो।
lesson.ep2.ask = मेरे दो प्यादे तुम्हारे प्यादे के बगल में हैं, पर दो खाने अभी सिर्फ़ एक चला है। उसे आँ पासाँ से काटो!
lesson.ep2.push = इससे तुम्हारा प्यादा बस आगे बढ़ा। जो प्यादा अभी दो खाने चला है, उसे काटो।
lesson.ep2.wrong = वह प्यादा ढूँढो, जिसने अभी दो खानों की चाल चली है, और उसे आँ पासाँ से काटो।
lesson.ep2.hint = {sq} पर खड़ा मेरा प्यादा अभी दो खाने चला है। उसे {sq2} पर जाकर आँ पासाँ से काटो।
lesson.ep2.ok = आँ पासाँ! {sq} पर खड़ा मेरा प्यादा नहीं कट सकता था: उसका मौक़ा निकल चुका था।

# ---- Chapter 7: promotion -------------------------------------------------------------------------------------
lesson.promo.what = जब प्यादा आख़िरी रैंक पर पहुँचता है, तो उसका प्रमोशन होता है: वह वज़ीर, हाथी, ऊँट या घोड़ा बन जाता है।
lesson.promo.ask = लगभग हमेशा वज़ीर चुनो। अब अपने प्यादे का प्रमोशन करो!
lesson.promo.under = यह भी नियम से सही है! पर वज़ीर ज़्यादा ताक़तवर है। चलो, वज़ीर चुनते हैं।
lesson.promo.under_ok = ठीक है। वैसे ज़्यादातर खिलाड़ी वज़ीर ही चुनते हैं।
lesson.promo.push = अपने प्यादे को आख़िरी रैंक तक, {sq} पर ले जाओ।
lesson.promo.ok = नया वज़ीर! एक साथ दो वज़ीर भी हो सकते हैं।
lesson.promo2.ask = प्यादा तिरछा काटते हुए भी प्रमोशन ले सकता है। मेरा हाथी काटो और वज़ीर बनाओ!
lesson.promo2.push = इससे भी प्रमोशन होता है, पर मेरा हाथी {sq} की रक्षा करता है। देखो।
lesson.promo2.lost = मेरे हाथी ने तुम्हारा नया मोहरा काट लिया। पहले मेरा हाथी काटो।
lesson.promo2.wrong = इससे मेरा हाथी नहीं कटता। तुम्हारा प्यादा तिरछा, {sq} पर, काटता है।
lesson.promo2.hint = अपने प्यादे से मेरा हाथी काटो, {sq} पर जाकर: वह काटते हुए ही प्रमोशन ले लेता है।
lesson.promo2.ok = काटा भी और प्रमोशन भी! प्यादा एक ही चाल में दोनों कर सकता है।

# ---- Chapter 8: stalemate and draws -----------------------------------------------------------------------------
lesson.stale.what = मेरी बारी है। मेरे राजा पर शह नहीं है, लेकिन उसके आस-पास के {@}हर खाने पर हमला है।
lesson.stale.draw = मेरे पास एक भी वैध चाल नहीं है। यह स्टेलमेट है, और बाज़ी ड्रॉ हो जाती है।
lesson.stale2.ask = जब बाज़ी तुम्हारे हाथ में हो, तो स्टेलमेट से सावधान रहो। मुझे एक चाल में मात दो, स्टेलमेट के बिना!
lesson.stale2.wrong = ऐसी शह ढूँढो, जिसके बाद मेरे राजा के पास कोई खाना न बचे। सावधान: कोई शांत चाल मुझे स्टेलमेट कर सकती है।
lesson.stale2.king = तुम्हारा राजा {sq} और {sq2} को पहले ही ढक रहा है। उसे वहीं रहने दो और वज़ीर का इस्तेमाल करो।
lesson.stale2.hint = तुम्हारा राजा {sq} और {sq2} को ढकता है। पिछली रैंक पर शह दो, तो मेरे राजा के पास जाने को कोई खाना नहीं रहेगा।
lesson.stale2.why = देखा? मेरे राजा पर {@}हमला है और कोई खाना ख़ाली नहीं: यही मात है। शह न होती, तो यह स्टेलमेट होता।
lesson.stale2.ok = शह और मात! विरोधी राजा के लिए हमेशा कोई चाल छोड़ो, जब तक कि उसी चाल से मात न हो रही हो।
lesson.draws.kings = दूसरी तरह के ड्रॉ: जब कोई भी मात न दे सके, जैसे बोर्ड पर सिर्फ़ दो राजा बचे हों, तो बाज़ी ड्रॉ होती है।
lesson.draws.agree = खिलाड़ी आपसी सहमति से भी ड्रॉ कर सकते हैं।
lesson.draws.repeat = एक ही स्थिति तीन बार दोहराई जाए, या पचास चालों तक न कोई मोहरा कटे, न कोई प्यादा चले, तब भी ड्रॉ हो सकता है।

# ---- Chapter 9: before you move (the safety habit) ---------------------------------------------------------------
lesson.before.habit = हर चाल से पहले रुको और देखो। मज़बूत खिलाड़ी हर बार ऐसा करते हैं।
lesson.before.last = पहला सवाल: मेरी पिछली चाल ने क्या किया? देखो।
lesson.before.threat = {my} {your:ko} निशाना बना रहा है। यह ख़तरा है।
lesson.before.safe = बस हट जाना काफ़ी नहीं है। नया खाना भी सुरक्षित होना चाहिए।
lesson.before.dodge.ask = अपने घोड़े को किसी सुरक्षित खाने पर ले जाओ।
lesson.before.dodge.still = तुम्हारे घोड़े पर अब भी हमला है। देखो।
lesson.before.dodge.hint = मेरे प्यादे {sq} और {sq2} की रक्षा करते हैं। कोई दूसरा खाना चुनो।
lesson.before.dodge.ok = सुरक्षित! तुमने ख़तरा देखा, और खाने को भी जाँचा।
# A wrong move onto a guarded square ({my} guards {to}); the coach then takes the piece.
lesson.before.unsafe = {to} पर नहीं: {my} उस खाने की रक्षा करता है। देखो।
# Said after the coach took the piece, before the move is taken back.
lesson.before.lost = {your} गया। पहले देखो, फिर चलो।
lesson.before.again = फिर से, पहले मेरी चाल। देखो।
lesson.before.free.ask = मेरी पिछली चाल देखो। क्या तुम कुछ मुफ़्त में काट सकते हो?
lesson.before.free.missed = {my:ko} फिर से देखो। उसे कौन काट सकता है?
lesson.before.free.hint = {my:ka} कोई रक्षक नहीं है। तुम्हारा {@}प्यादा उसे काट सकता है।
lesson.before.free.ok = हाँ! मेरा ऊँट मुफ़्त था। हमेशा मेरी पिछली चाल देखो।
lesson.before.check.ask = मुझे शह दो, ऐसे खाने से जिसे मैं काट न सकूँ।
lesson.before.check.wrong = यह शह नहीं है। किसी सुरक्षित खाने से शह ढूँढो।
lesson.before.check.hint = {my} {sq} की रक्षा करता है। सुरक्षित खाने से शह दो।
lesson.before.check.ok = बढ़िया शह! तुम्हारा वज़ीर वहाँ सुरक्षित है।
lesson.before.done = इसे आदत बना लो: पहले देखो, फिर चलो।

# ---- Chapter 10: the opening ------------------------------------------------------------------------------------
lesson.opening.what = ओपनिंग बाज़ी की शुरुआत है। कुछ आसान नियम काम आते हैं।
lesson.opening.goals = {@}केंद्र पर क़ब्ज़ा करो, {@2}घोड़े और ऊँट बाहर निकालो, और {@3}जल्दी कैसलिंग करो।
lesson.opening.centre = {@}बीच के चार खाने केंद्र कहलाते हैं।
lesson.opening.pawn.ask = केंद्र में एक प्यादा रखो: दो खाने आगे।
lesson.opening.pawn.one = बुरा नहीं, पर दो खाने केंद्र पर ज़्यादा क़ब्ज़ा देते हैं।
lesson.opening.pawn.knight = घोड़े जल्दी आएँगे। पहले, केंद्र में एक प्यादा।
lesson.opening.pawn.wrong = अपने राजा या अपने वज़ीर के सामने वाला प्यादा चलो।
lesson.opening.pawn.ok = बढ़िया! तुम्हारा प्यादा केंद्र में जगह लेता है।
lesson.opening.queen = अपना वज़ीर जल्दी बाहर मत निकालो: मेरे मोहरे उसे भगाएँगे।
lesson.opening.knight.ask = केंद्र की ओर एक घोड़ा बाहर निकालो।
lesson.opening.rim = किनारे का घोड़ा बहुत कम खानों तक पहुँचता है। केंद्र की ओर कूदो।
lesson.opening.bishop = मोहरे निकालना अच्छा है! पर इस बार, घोड़ा।
lesson.opening.knight.ok = बढ़िया! वहाँ से तुम्हारा घोड़ा केंद्र पर नज़र रखता है।
lesson.opening.later = कुछ चालों के बाद: तुम्हारा घोड़ा और {@}ऊँट बाहर हैं।
lesson.opening.twice = बिना अच्छी वजह एक ही मोहरे को दो बार मत चलो।
lesson.opening.castle.ask = रास्ता साफ़ है। अपने राजा को सुरक्षित करने के लिए कैसलिंग करो।
lesson.opening.castle.wrong = तुम्हारा राजा तैयार है। अभी कैसलिंग करो, जब तक रास्ता साफ़ है।
lesson.opening.castle.ok = कैसलिंग हो गई! तुम्हारा राजा सुरक्षित है, और हाथी खेल में आ गया।
lesson.opening.done = केंद्र, मोहरे, कैसलिंग: हर बाज़ी की यह अच्छी शुरुआत है।

# ---- Chapter 11: review (no teaching: the coach only asks) ----
lesson.review.start = छोटा-सा दोहराव, इस बार दूसरे क्रम में। मैं समझाऊँगा नहीं: तुम करके दिखाओ।
lesson.review.promo.ask = इस प्यादे का प्रमोशन करो।
lesson.review.promo.ok = बढ़िया: नया वज़ीर, और शह भी!
lesson.review.check.ask = तुम्हारा राजा शह में है। उससे बाहर निकलो।
lesson.review.check.ok = शह से बाहर। बढ़िया।
lesson.review.castle.ask = अपने राजा की कैसलिंग करो, उस तरफ़, जहाँ इसकी इजाज़त है।
lesson.review.castle.other = यह कैसलिंग नहीं है। उस तरफ़ कैसलिंग करो, जहाँ इसकी इजाज़त है।
lesson.review.castle.ok = कैसलिंग हो गई, सुरक्षित तरफ़!
lesson.review.ep.ask = मेरा प्यादा आँ पासाँ से काटो।
lesson.review.ep.ok = आँ पासाँ! तुम्हें याद रहा।
lesson.review.mate.ask = मुझे एक चाल में मात दो।
lesson.review.mate.ok = शह और मात! दोहराव पूरा।

# ---- Chapter 12: how our games work ------------------------------------
lesson.talk.rules = अब तुम्हें शतरंज के सारे नियम पता हैं। शाबाश!
lesson.talk.real = अब मैं तुम्हें बताता हूँ कि हमारी बाज़ियाँ कैसे चलेंगी।
lesson.talk.no_clock = मेरे साथ न घड़ी है, न रेटिंग। सोचने के लिए जितना चाहे, उतना समय लो।
lesson.talk.touch = जिस मोहरे को छुओ, उसे चलना पड़ता है। इसलिए पहले देखो, फिर छुओ।
lesson.talk.handshake = बाज़ी की शुरुआत और अंत हाथ मिलाकर होता है। इसका मतलब है: अच्छी बाज़ी, और धन्यवाद।
lesson.talk.polite = जीत हो या हार, विनम्र रहो, और जब प्रतिद्वंद्वी सोच रहा हो, तब उसे कभी परेशान मत करो।
lesson.talk.help = हमारी बाज़ियों में मैं तुम्हारी मदद करूँगा। अगर तुम्हारा कोई मोहरा हमले में हो या बिना रक्षा के रह जाए, तो मैं बता दूँगा।
lesson.talk.help_back = बड़ी ग़लती के बाद मैं दिखाऊँगा कि क्यों, और तुम्हारी चाल वापस लेने का मौक़ा दूँगा।
# The key keeps its printed name (as in assets/i18n/hi.lang); the voice says it in Devanagari.
lesson.talk.help_skip = और अगर मैं ज़्यादा बोलूँ, तो Space दबा दो: मैं रुक जाऊँगा।
lesson.talk.help_skip.spoken = और अगर मैं ज़्यादा बोलूँ, तो स्पेस दबा दो: मैं रुक जाऊँगा।
# "पहले क़दम" = coach.level.1.name of assets/i18n/hi.lang.
lesson.talk.next = जब तुम तैयार हो, तो “पहले क़दम” खेलो। मैं नरमी से खेलूँगा।
lesson.talk.welcome = शतरंज की दुनिया में स्वागत है! आओ, हाथ मिलाएँ।
