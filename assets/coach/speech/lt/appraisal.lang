# Coach speech (Lithuanian): the appraisal after the game (src/coach/appraisal.cpp).
# Same keys and variants as assets/coach/speech/en/appraisal.lang (its header documents every placeholder).
#
# Always positive, never blaming. The coach says "tu"; the player's gender is unknown: finite verbs only
# ("laimėjai", "radai", "nusipelnei"), never "tu pasiruošęs", "esi laimėjęs", "vertas"; "you were
# winning" = "turėjai laimėtą poziciją" / "pozicija buvo laimėta".
# Forms from common.lang:
#   move numbers are ordinals: "{n:nth_move_loc}" = "21-ajame ėjime" (at move 21), "{n:nth_move}" =
#   "21-asis ėjimas" (Move 21: ...), "{crit_no:nth_move_gen}" = "iki 21-ojo ėjimo" (until move 21);
#   "{moves:move_acc}" = "per 34 ėjimus"; "{pts:point_gen} vertės medžiagos" = "3 taškų vertės medžiagos";
#   "{n:time_acc}" = "3 kartus"; "{n:best_move}" = "5 geriausi ėjimai"; "{n:capture}" = "5 kirtimai"
#   (pawns included, from level 3; "figūra" loosely at levels 1-2, as English "pieces");
#   "{m:check_acc}" = "2 šachus"; "{m:acc}" = a bare number in the accusative ("pataisei du");
#   accuracy: "{acc:percent}" = "85 %" (spoken "aštuoniasdešimt penki procentai"),
#   "{acc:percent_gen} tikslumu" = "85 % tikslumu" (spoken "...penkių procentų tikslumu");
#   "{text:loc}" = the phase in the locative ("debiute", "mitelšpilyje", "endšpilyje").
# {opening} is the citation name, alone or after a colon or a dash (it cannot inflect).
# {level} is the coach page's level name, always in „...“ after "lygis" ("lygiu „Pradedantysis“").

# ---- Names used inside the lines ------------------------------------------------------------------
# Phases: the nominatives common.lang declines (appraisal.phase.<phase>.gen ... .loc); all masculine.
