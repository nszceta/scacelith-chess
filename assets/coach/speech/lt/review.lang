ex.rewind.b4 = Grįžtame prie partijos.
ex.rewind.b4.2 = Atgal.
ex.rewind.b4.3 = Grįžkime.

# ---- Takeback offer (the player answers yes or no) ---------------------------------------------
ex.offer.b1 = Ar nori pabandyti kitą ėjimą?
