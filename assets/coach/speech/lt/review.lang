ex.point.piece = Dabar {t1:gen} jau nebeišgelbėti.
ex.point.piece.2 = Ir {t1} žūva.
ex.point.piece.3 = Kitu ėjimu krinta {t1}.
ex.point.two = {t1} ir {t2} abu puolami: vienas iš jų kris.
