# ---- Tips: principles, never a fault claim (levels 1-3) ----------------------------------------
tip.early_queen.b1 = {your} išėjo labai anksti. Pirmiau išvesk žirgus ir rikius.
tip.early_queen.b1.2 = Atsargiai su {your:refl_ins} taip anksti: mano figūros gali {your:pron_acc} vaikyti po visą lentą.
tip.early_queen.b1.3 = Smagu žaisti {your:refl_ins}, bet pirmiau išvesk lengvąsias figūras.
tip.early_queen.b2 = Kai taip anksti eini {your:refl_ins}, galiu {your:pron_acc} pulti ir laimėti laiko.
tip.early_queen.b2.2 = {your} jau išėjo? Pirmiau žirgai ir rikiai!
tip.early_queen.b3 = Ankstyvas {your:gen} išėjimas leidžia man laimėti tempą, {your:pron_acc} puolant.
tip.early_queen.b3.2 = Taip anksti {your:acc} lengva vaikyti. Pirmiau išvystyk figūras.
tip.queen_grab.b1 = {your} kirto tolimą pėstininką, ir dabar {your:pron} gali patekti į bėdą.
tip.queen_grab.b1.2 = Pėstininkų gaudymas {your:ins} kainuoja laiko. Pirmiau išvystyk figūras!
tip.queen_grab.b2 = {your} išėjo gaudyti pėstininkų į lentos kraštą. Tai kainuoja daug laiko.
tip.queen_grab.b2.2 = Gerai pagalvok, ar verta siųsti {your:refl_acc} gaudyti tolimų pėstininkų.
tip.queen_grab.b3 = Taip anksti gaudyti pėstininkus {your:refl_ins} – laiko švaistymas.
tip.queen_grab.b3.2 = {your} dabar toli nuo namų; mano figūrų vystymas pasakys savo.
tip.queen_grab.b4 = {your} pasiima pėstininką, bet praranda per daug laiko.
tip.queen_grab.b4.2 = Pėstininko gaudymas {your:ins} lentos pakraštyje kainuoja tempą.
tip.same_piece.b1 = Ėjai {your:refl_ins} du kartus. Stenkis kiekvienu ėjimu išvesti naują figūrą.
tip.same_piece.b1.2 = Vėl {your}? Išvesk ir kitas savo figūras.
tip.same_piece.b1.3 = Kiekvienu ėjimu stenkis išvesti naują figūrą, o ne vėl {your:refl_acc}.
tip.same_piece.b2 = Du kartus eiti {your:refl_ins} debiute – laiko praradimas.
tip.same_piece.b2.2 = {your} vėl pajudėjo, o kitos tavo figūros vis dar namie.
tip.same_piece.b3 = Du ėjimai {your:ins} stabdo figūrų vystymą.
tip.same_piece.b3.2 = Dar vienas ėjimas {your:ins}; likusi tavo armija laukia.
tip.castle.b1 = {your} vis dar centre. Rokiruotė {your:acc} apsaugotų.
tip.castle.b1.2 = Laikas rokiruotis! Kampe {your} saugesn{your:agr_is_e}.
tip.castle.b1.3 = Pagalvok apie rokiruotę. {your} be priedangos.
tip.castle.b2 = {your} vis dar centre. Greičiau rokiruokis!
tip.castle.b2.2 = Rokiruotė saugiai paslėptų {your:acc}.
tip.castle.b3 = Centras atsiveria: {your:dat} metas slėptis rokiruote.
tip.castle.b3.2 = {your} vis dar centre; rokiruotis jau buvo laikas.
tip.knight_rim.b1 = {your} lentos krašte mažai ką veikia. Žirgai mėgsta centrą.
tip.knight_rim.b1.2 = Žirgas krašte – prastas žirgas! Ten {your} kontroliuoja mažiau langelių.
