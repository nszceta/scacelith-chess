lesson.rook.lines = Aukštyn vertikale {@}arba išilgai horizontalės.
lesson.rook.capture = Kirsdama figūra stoja į {@}priešininko figūros langelį, o ši palieka lentą.
lesson.rook.ask = Kirsk {my:acc} bokštu!
lesson.rook.short = Kryptis teisinga! Eik toliau vertikale aukštyn, iki pat {my:gen}.
lesson.rook.rank = Tai ėjimas horizontale. {my} stovi aukščiau, toje pačioje vertikalėje.
lesson.rook.king = Tai tavo karalius. Eik {your:bare_ins}: {your:pron} stovi kampe.
lesson.rook.ok = Nukirsta! {my} palieka lentą.
# Pieces don't jump
lesson.jump.blocked = Figūros negali peršokti per kitas. Tavo pėstininkas langelyje {sq} užstoja bokštui kelią.
lesson.jump.knight = Peršokti gali tik žirgas. Su juo netrukus susipažinsime.
# Bishop
lesson.bishop.intro = Tai {your}. {your:pron} eina įstrižainėmis bet kokiu atstumu.
lesson.bishop.colour = Rikis visada lieka tos pačios spalvos langeliuose.
lesson.bishop.ask = {my} stovi toje įstrižainėje. Kirsk {my:pron_acc}!
