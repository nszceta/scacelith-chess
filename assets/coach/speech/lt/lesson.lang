lesson.castle.one = Vienu langeliu – paprastas karaliaus ėjimas. Per rokiruotę karalius paeina du.
lesson.castle.other = Rokiruotei paeik karaliumi du langelius link bokšto, stovinčio langelyje {sq}.
lesson.castle.ok = Rokiruotė atlikta! Tavo karalius saugiai paslėptas, o bokštas pasiruošęs žaisti.
lesson.castle2.moved = Rokiruotis negalima, jei tavo karalius ar tas bokštas jau ėjo.
lesson.castle2.attacked = Taip pat negalima, kai tau šachas, ar jei karalius pereitų per puolamą langelį arba atsidurtų jame.
lesson.castle2.bishop = Mano rikis puola langelį {sq}. Todėl rokiruotis šiame flange dabar negalima.
lesson.castle2.ask = Rokiruokis kitame flange.
lesson.castle2.other = Rokiruokis kito savo bokšto link, valdovės flange.
lesson.castle2.ok = Teisingai! Po ilgosios rokiruotės tavo karalius atsiduria langelyje {sq}.
lesson.ep0.rule = Kirtimas prasilenkiant prasideda nuo dvigubo žingsnio. Du langelius gali paeiti tik pėstininkas, {@}dar stovintis savo vietoje. Tas, kuris {@2}jau ėjo, eina po vieną.
lesson.ep0.ask = Paeik vienu pėstininku du langelius.
lesson.ep0.moved = Tas pėstininkas jau ėjo, todėl gali paeiti tik vieną langelį. Eik pėstininku, kuris dar stovi savo vietoje.
lesson.ep0.ok = Teisingai: du langelius gali paeiti tik pėstininkas pradinėje padėtyje.

# ---- Chapter 6: en passant ------------------------------------------------------------------------------------
lesson.ep.what = Vienas ypatingas pėstininko kirtimas vadinamas kirtimu prasilenkiant, prancūziškai – en passant.
lesson.ep.what.spoken = Vienas ypatingas pėstininko kirtimas vadinamas kirtimu prasilenkiant, prancūziškai – an pasan.
lesson.ep.watch = Stebėk mano pėstininką: jis paeina du langelius ir atsiduria greta tavojo.
lesson.ep.how = Tavo pėstininkas gali jį kirsti taip, lyg mano pėstininkas būtų paėjęs tik vieną langelį: į {sq}.
lesson.ep.now = Bet tik dabar, šiuo ėjimu. Kirsk prasilenkiant!
lesson.ep.gone = Proga praleista: kirsti prasilenkiant galima tik iškart. Pabandykime dar kartą.
lesson.ep.ok = Kirtimas prasilenkiant! Mano pėstininkas langelyje {sq} nuimamas nuo lentos.
lesson.ep2.old = Mano pėstininkas langelyje {sq} jau kurį laiką stovi šalia tavojo. Kirsti jį prasilenkiant jau per vėlu.
lesson.ep2.watch = Dabar stebėk kitą mano pėstininką.
lesson.ep2.ask = Du mano pėstininkai stovi greta tavojo, bet tik vienas ką tik paėjo du langelius. Kirsk jį prasilenkiant!
lesson.ep2.push = Taip tik pastūmei savo pėstininką. Kirsk pėstininką, kuris ką tik paėjo du langelius.
lesson.ep2.wrong = Ieškok pėstininko, kuris ką tik padarė dvigubą žingsnį, ir kirsk jį prasilenkiant.
lesson.ep2.hint = Mano pėstininkas langelyje {sq} ką tik paėjo du langelius. Kirsk jį prasilenkiant, į {sq2}.
lesson.ep2.ok = Kirtimas prasilenkiant! Mano pėstininko langelyje {sq} kirsti nebuvo galima: jo proga praėjo.

# ---- Chapter 7: promotion -------------------------------------------------------------------------------------
lesson.promo.what = Kai pėstininkas pasiekia paskutinę horizontalę, jis virsta valdove, bokštu, rikiu arba žirgu.
lesson.promo.ask = Beveik visada rinkis valdovę. Dabar atlik pėstininko virsmą!
lesson.promo.under = Taip galima! Bet valdovė stipresnė. Rinkimės valdovę.
lesson.promo.under_ok = Gerai. Vis dėlto dauguma žaidėjų renkasi valdovę.
lesson.promo.push = Stumk pėstininką į paskutinę horizontalę, į {sq}.
lesson.promo.ok = Nauja valdovė! Gali turėti net dvi valdoves vienu metu.
lesson.promo2.ask = Pėstininkas gali virsti ir kirsdamas įstrižai. Nukirsk mano bokštą ir gauk valdovę!
lesson.promo2.push = Tai irgi virsmas, bet mano bokštas saugo {sq}. Žiūrėk.
lesson.promo2.lost = Mano bokštas nukirto tavo naują figūrą. Pirma nukirsk bokštą.
lesson.promo2.wrong = Tai nekerta mano bokšto. Tavo pėstininkas kerta įstrižai, į {sq}.
lesson.promo2.hint = Nukirsk mano bokštą pėstininku, į {sq}: kirsdamas jis virsta.
lesson.promo2.ok = Nukirsta ir virsta! Pėstininkas vienu ėjimu gali padaryti abu.

# ---- Chapter 8: stalemate and draws -----------------------------------------------------------------------------
lesson.stale.what = Mano ėjimas. Mano karaliui nėra šacho, bet {@}visi langeliai aplink jį puolami.
lesson.stale.draw = Neturiu nė vieno leistino ėjimo. Tai patas, ir partija baigiasi lygiosiomis.
lesson.stale2.ask = Kai laimi, saugokis pato. Paskelbk man matą vienu ėjimu, be pato!
lesson.stale2.wrong = Rask šachą, po kurio mano karaliui neliks nė vieno langelio. Atsargiai: ramus ėjimas gali duoti man patą.
lesson.stale2.king = Tavo karalius jau kontroliuoja {sq} ir {sq2}. Palik jį ir eik valdove.
lesson.stale2.hint = Tavo karalius kontroliuoja {sq} ir {sq2}. Paskelbk šachą išilgai paskutinės horizontalės, ir mano karalius nebeturės kur eiti.
lesson.stale2.why = Matai? Mano karaliui paskelbtas šachas {@}ir nėra laisvo langelio: tai matas. Be šacho būtų patas.
lesson.stale2.ok = Matas! Visada palik priešininko karaliui ėjimą, nebent skelbi matą.
lesson.draws.kings = Kitos lygiosios: kai niekas negali paskelbti mato, pavyzdžiui, kai lentoje lieka tik du karaliai, partija baigiasi lygiosiomis.
lesson.draws.agree = Žaidėjai taip pat gali susitarti dėl lygiųjų.
lesson.draws.repeat = Lygiosios galimos ir tada, kai ta pati pozicija pasikartoja tris kartus arba kai penkiasdešimt ėjimų nebuvo nei kirtimų, nei pėstininkų ėjimų.

# ---- Chapter 9: before you move (the safety habit) ---------------------------------------------------------------
lesson.before.habit = Prieš kiekvieną ėjimą sustok ir pažiūrėk. Stiprūs žaidėjai taip daro kaskart.
lesson.before.last = Pirmas klausimas: ką padarė mano paskutinis ėjimas? Žiūrėk.
lesson.before.threat = {my} puola {your:acc}. Tai grėsmė.
lesson.before.safe = Atsitraukti nepakanka. Naujas langelis taip pat turi būti saugus.
lesson.before.dodge.ask = Perkelk savo žirgą į saugų langelį.
lesson.before.dodge.still = Tavo žirgas vis dar puolamas. Žiūrėk.
lesson.before.dodge.hint = Mano pėstininkai gina langelius {sq} ir {sq2}. Pasirink kitą langelį.
lesson.before.dodge.ok = Saugu! Pamatei grėsmę ir patikrinai langelį.
# A wrong move onto a guarded square ({my} guards {to}); the coach then takes the piece.
lesson.before.unsafe = Ne į {to}: {my} gina tą langelį. Žiūrėk.
# Said after the coach took the piece, before the move is taken back.
lesson.before.lost = Praradai {your:acc}. Pirma pažiūrėk, paskui eik.
lesson.before.again = Dar kartą, pirmas mano ėjimas. Žiūrėk.
lesson.before.free.ask = Pažiūrėk į mano paskutinį ėjimą. Gali ką nors kirsti veltui?
lesson.before.free.missed = Dar kartą pažiūrėk į {my:acc}. Kas gali {my:pron_acc} kirsti?
lesson.before.free.hint = {my} neturi gynėjo. Tavo {@}pėstininkas gali {my:pron_acc} kirsti.
lesson.before.free.ok = Taip! Mano rikis buvo laisvas. Visada žiūrėk į mano paskutinį ėjimą.
lesson.before.check.ask = Skelbk man šachą iš langelio, kurio negaliu kirsti.
lesson.before.check.wrong = Tai ne šachas. Rask šachą iš saugaus langelio.
lesson.before.check.hint = {my} gina langelį {sq}. Skelbk šachą iš saugaus langelio.
lesson.before.check.ok = Geras šachas! Tavo valdovė ten saugi.
lesson.before.done = Įprask: pirma pažiūrėk, paskui eik.

# ---- Chapter 10: the opening ------------------------------------------------------------------------------------
lesson.opening.what = Debiutas – partijos pradžia. Padeda kelios paprastos taisyklės.
lesson.opening.goals = {@}Užimk centrą, {@2}išvesk žirgus ir rikius ir {@3}anksti rokiruokis.
lesson.opening.centre = Keturi langeliai {@}viduryje yra centras.
lesson.opening.pawn.ask = Pastatyk pėstininką į centrą: du langeliai į priekį.
lesson.opening.pawn.one = Neblogai, bet du langeliai užima daugiau centro.
lesson.opening.pawn.knight = Žirgai ateis netrukus. Pirma pėstininkas į centrą.
lesson.opening.pawn.wrong = Eik pėstininku prieš karalių arba prieš valdovę.
lesson.opening.pawn.ok = Gerai! Tavo pėstininkas užima erdvę centre.
lesson.opening.queen = Valdovės neišvesk anksti: mano figūros ją vaikytų.
lesson.opening.knight.ask = Išvesk žirgą link centro.
lesson.opening.rim = Žirgas krašte pasiekia mažai langelių. Šok link centro.
lesson.opening.bishop = Figūrų išvedimas – gerai! Bet šį kartą žirgas.
lesson.opening.knight.ok = Gerai! Iš ten tavo žirgas stebi centrą.
lesson.opening.later = Po kelių ėjimų: tavo žirgas ir {@}rikis jau išvesti.
lesson.opening.twice = Be gero pagrindo neik ta pačia figūra du kartus.
lesson.opening.castle.ask = Kelias laisvas. Rokiruokis: karalius bus saugus.
lesson.opening.castle.wrong = Karalius gali rokiruotis. Rokiruokis dabar, kol kelias laisvas.
lesson.opening.castle.ok = Rokiruota! Tavo karalius saugus, o bokštas įsijungia į žaidimą.
lesson.opening.done = Centras, figūros, rokiruotė – tai geras kiekvienos partijos startas.
lesson.review.start = Trumpa apžvalga, šįkart kita tvarka. Nieko nepaaiškinsiu: tu man parodyk.
lesson.review.promo.ask = Paversk šį pėstininką.
lesson.review.promo.ok = Gerai: nauja valdovė ir šachas!
lesson.review.check.ask = Tau šachas. Apsigink nuo jo.
lesson.review.check.ok = Šachas pašalintas. Gerai.
lesson.review.castle.ask = Atlik rokiruotę tame flange, kur ji leidžiama.
lesson.review.castle.other = Tai ne rokiruotė. Rokiruokis tame flange, kur tai leidžiama.
lesson.review.castle.ok = Rokiruota saugiame flange!
lesson.review.ep.ask = Kirsk mano pėstininką prasilenkiant.
lesson.review.ep.ok = Kirtimas prasilenkiant! Prisiminei.
lesson.review.mate.ask = Paskelbk man matą vienu ėjimu.
lesson.review.mate.ok = Matas! Apžvalga baigta.

# ---- Chapter 11: how our games work (no clock or rating, touch-move, help, manners) ------------------------------------
lesson.talk.rules = Dabar žinai visas šachmatų taisykles. Šaunu!
lesson.talk.real = Papasakosiu, kaip vyks mūsų partijos.
lesson.talk.no_clock = Su manimi nėra nei laikrodžio, nei reitingo. Galvok tiek, kiek reikia.
lesson.talk.touch = Paliestą figūrą privaloma eiti, todėl pirma pažiūrėk, paskui liesk.
lesson.talk.handshake = Partijos prasideda ir baigiasi rankos paspaudimu. Tai reiškia: gera partija, ačiū.
lesson.talk.polite = Laimi ar pralaimi, visada elkis mandagiai ir niekada netrukdyk varžovui galvoti.
lesson.talk.help = Mūsų partijose tau padėsiu. Jei tavo figūra puolama arba neapginta, pasakysiu.
lesson.talk.help_back = Po didelės klaidos parodysiu, kodėl, ir pasiūlysiu atšaukti tavo ėjimą.
lesson.talk.help_skip = O jei kalbu per daug, paspausk tarpo klavišą: nutilsiu.
lesson.talk.next = Kai norėsi, žaisk lygį „Pirmieji žingsniai“. Žaisiu švelniai.
lesson.talk.welcome = Sveikinu šachmatų pasaulyje! Paspauskime rankas.
