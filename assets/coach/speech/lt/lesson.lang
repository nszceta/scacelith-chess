# Coach speech (Lithuanian): the rules lesson (level 0, src/coach/lesson.cpp).
# Same keys and variants as assets/coach/speech/en/lesson.lang.
#
# Placeholders: {your} / {my} = a piece of the player / of the coach ("tavo bokštas", "mano žirgas"),
# with the case forms of common.lang ({my:acc}, {my:gen}, {my:pron_acc}, {your:bare_ins},
# {your:refl_ins} ...); {sq}, {sq2}, {to}, {esc} = squares, never inflected ("į {sq}", "langelyje
# {sq}"); {move} = a move. {@}, {@2}, {@3} are invisible marks: the coach points at something while
# saying the word right after the mark. A ".spoken" key is what the voice says instead (here: letters
# said by their Lithuanian names, "aa", "haa" (long, as in file.*.spoken), "el", and the French
# "en passant" said "an pasan").
# Rules the lines follow: no adjective, participle or half-participle about the player ("norėdamas",
# "būk mandagus" -> "Rokiruotei paeik...", "elkis mandagiai"); "savo" when the player acts with
# their own piece ({your:refl_ins}); files = vertikalės, ranks = horizontalės, back rank = paskutinė
# horizontalė; kingside / queenside = karaliaus / valdovės flangas.

# ---- Chapter titles (said inside "Tęskime pamoką: {chapter}.") ----------------------------------------
# Nominative, lower case (see event.lesson.* in events.lang).
lesson.title.welcome = šachmatų lenta
lesson.title.pieces_lines = kaip eina bokštas, rikis ir valdovė
lesson.title.pieces_steps = kaip eina karalius, žirgas ir pėstininkas
lesson.title.values_setup = figūrų vertė ir pirmieji ėjimai
lesson.title.safety = saugūs ir nesaugūs kirtimai
lesson.title.check = šachas
lesson.title.mate = matas
lesson.title.castling = rokiruotė
lesson.title.en_passant = kirtimas prasilenkiant
lesson.title.promotion = pėstininko virsmas
lesson.title.draws = patas ir lygiosios
lesson.title.before_move = prieš ėjimą
lesson.title.opening = debiutas
lesson.title.review = trumpa apžvalga
lesson.title.etiquette = kaip vyksta mūsų partijos

