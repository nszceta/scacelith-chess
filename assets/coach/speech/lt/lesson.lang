# Coach speech (Lithuanian): the rules lesson (level 0, src/coach/lesson.cpp).
# Same keys and variants as assets/coach/speech/en/lesson.lang.
#
# Placeholders: {your} / {my} = a piece of the player / of the coach ("tavo bokštas", "mano žirgas"),
# with the case forms of common.lang ({my:acc}, {my:gen}, {my:pron_acc}, {your:bare_ins},
# {your:refl_ins} ...); {sq}, {sq2}, {to}, {esc} = squares, never inflected ("į {sq}", "langelyje
# {sq}"); {move} = a move. {@}, {@2}, {@3} are invisible marks: the coach points at something while
# saying the word right after the mark. A ".spoken" key is what the voice says instead (here: letters
# said by their Lithuanian names, "aa", "haa" (long, as in file.*.spoken), "el", and the French
# "en passant" said "an pasan").
# Rules the lines follow: no adjective, participle or half-participle about the player ("norėdamas",
# "būk mandagus" -> "Rokiruotei paeik...", "elkis mandagiai"); "savo" when the player acts with
# their own piece ({your:refl_ins}); files = vertikalės, ranks = horizontalės, back rank = paskutinė
# horizontalė; kingside / queenside = karaliaus / valdovės flangas.

# ---- Chapter titles (said inside "Tęskime pamoką: {chapter}.") ----------------------------------------
# Nominative, lower case (see event.lesson.* in events.lang).
lesson.title.welcome = šachmatų lenta
lesson.title.pieces = kaip eina figūros
lesson.title.safety = saugūs ir nesaugūs kirtimai
lesson.title.check = šachas
lesson.title.mate = matas
lesson.title.castling = rokiruotė
lesson.title.en_passant = kirtimas prasilenkiant
lesson.title.promotion = pėstininko virsmas
lesson.title.draws = patas ir lygiosios
lesson.title.before_move = prieš ėjimą
lesson.title.opening = debiutas
lesson.title.etiquette = reitingas, laikrodis ir etiketas tikrose partijose

# ---- Lines every exercise uses ------------------------------------------------------------------------
# After the coach demonstrated the solution.
lesson.now_you = Dabar pabandyk tu.
lesson.now_you.2 = Dabar tavo eilė.
lesson.now_you.3 = Dabar tu.
# Another wrong move after the demonstration.
lesson.almost = Beveik! Padaryk ėjimą, kurį parodžiau.
lesson.almost.2 = Ne visai. Pabandyk ėjimą iš mano pavyzdžio.
lesson.almost.3 = Arti. Prisimink mano ką tik parodytą ėjimą.
# A wrong move without a line of its own.
lesson.try_again = Ne tai. Bandyk dar kartą.
lesson.try_again.2 = Ne šis ėjimas. Mėgink dar.
lesson.try_again.3 = Pabandykime dar kartą.
lesson.use_your = Eik {your:bare_ins}.
lesson.use_your.2 = Pabandyk {your:refl_ins}.
lesson.watch = Žiūrėk.
lesson.like_this = Štai taip.
lesson.and_back = Ir atgal.
# A check that is not checkmate (the coach then shows the escape).
lesson.check_escape = Šachas, bet mano karalius pabėga į {esc}.
lesson.check_takes = Šachas, bet mano karalius tiesiog kerta {your:acc}.
lesson.check_block = Šachas, bet galiu užsidengti kita figūra.
lesson.stalemate = Patas! Mano karalius negali pajudėti, ir jam nėra šacho. Lygiosios, nors tavo pozicija buvo laimėta!

# ---- Why a move is not allowed (the coach points at the piece or square in question) ----------------
# {sq} = the square in question, {my} = the coach's piece that attacks, pins, blocks or gives
# check, {your} = the piece the player tried to move.
why.KingIntoCheck = Ne į {sq}: tą langelį puola {my}. Karalius niekada neina į pavojų.
why.PathBlocked = Kažkas užstoja {@}kelią: peršokti per figūras gali tik žirgas.
why.WrongGeometry = {your} taip neina.
why.MustAnswerCheck = Tau {@}šachas: pirmiausia turi nuo jo apsiginti.
why.CastlingThroughCheck = Tavo karalius pereitų per {sq}, o tą langelį puola {my}.
why.CastlingNoRights = Karalius arba šis bokštas jau ėjo, todėl rokiruotis negalima.
why.CastlingBlocked = Rokiruotei reikia, kad langeliai tarp karaliaus ir bokšto būtų tušti.
why.CastlingOutOfCheck = Kai tau šachas, rokiruotis negalima.
why.PawnForwardBlocked = Pėstininkai nekerta tiesiai į priekį: tas langelis {@}užimtas.
# The pinned piece takes its ending: surištas / surišta.
why.LeavesKingInCheck = {your} surišt{your:agr_as_a}: jei {your:pron} pasitrauktų, {my} pultų tavo karalių.
why.OwnPieceOnTarget = Negali eiti į langelį, kuriame stovi tavo figūra.
why.PawnCaptureNeedsVictim = Įstrižai pėstininkas eina tik kirsdamas.
why.EnPassantExpired = Kirsti prasilenkiant galima tik iškart po to, kai pėstininkas paėjo du langelius.
why.NotYourTurn = Palauk: dabar mano ėjimas.

