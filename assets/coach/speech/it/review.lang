# ---- The coach's own threats (levels 1-2, before the player moves) ------------------------------
# A mate threat ({sq} = where it would mate, pointed at at level 1; {my} = the piece).
threat.mate.b1 = Attenzione! Minaccio scacco matto in {sq}.
threat.mate.b1.2 = Occhio: {my} vuole andare in {sq}. Sarebbe scacco matto.
threat.mate.b1.3 = Guarda la casa {sq}. Se ci arrivo, è scacco matto!
threat.mate.b2 = Attenzione, minaccio matto.
threat.mate.b2.2 = Occhio: c’è una minaccia di matto in {sq}.
threat.mate.b2.3 = Guarda bene: sto minacciando scacco matto.
threat.mate.b3 = Attenzione, minaccio matto in {sq}.
threat.mate.b3.2 = C’è una minaccia di matto: {my} vuole andare in {sq}.
threat.mate.b3.3 = Occhio: minaccio scacco matto.
# A threat on a piece ({my} = my attacker, pointed at at level 1; {your} = the target, pointed at).
threat.piece.b1 = Guarda: {my} sta attaccando {your}.
threat.piece.b1.2 = Attenzione! {your} è attaccat{your:o} {my:da}.
threat.piece.b1.3 = Occhio, {my} vuole prendere {your}.
