ex.better.b3.2 = {best} era la mossa migliore.
ex.better.b3.3 = Invece {best} era una buona mossa.
ex.better.b4 = {best} era più forte.
ex.better.b4.2 = {best} era la mossa giusta.
ex.better.b4.3 = Era meglio giocare {best}.
ex.better.b5 = {best}, con l’idea {line}.
ex.better.b5.2 = La mossa era {best}: {line}.
ex.better.b5.3 = Era meglio {best}, e poi {line}.
ex.better.b6 = {best}: {eval}.
ex.better.b6.2 = Piuttosto {best}, {eval}.
ex.better.b6.3 = Con {best}, {eval}.

