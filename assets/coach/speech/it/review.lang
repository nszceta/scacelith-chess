# ---- Demonstration narration: one short line per move shown on the board ------------------------
# Levels 4-6: just the move.
demo.move = {move}.
demo.move.2 = {move}.
demo.move.3 = Poi {move}.
# Levels 1-3, the coach's moves.
demo.my.move = {my} va in {sq}.
demo.my.move.2 = Porto {my} in {sq}.
demo.my.move.3 = Poi {my} va in {sq}.
demo.my.take = Prendo {your}.
demo.my.take.2 = {my} prende {your}.
demo.my.take.3 = E catturo {your}.
demo.my.check = {my} va in {sq}. Scacco.
demo.my.check.2 = Scacco, {my:con} in {sq}.
demo.my.check.3 = {my} in {sq}, scacco!
demo.my.mate = {my} va in {sq}. Scacco matto.
demo.my.mate.2 = E {my} in {sq} è scacco matto.
demo.my.mate.3 = {my} in {sq}. È scacco matto.
# Levels 1-3, the coach's in-between move: a capture, a check or a quiet move played first while a
# bigger piece of the player's ({t1}) is attacked; the next move of the coach's takes it.
demo.my.first.take = Prima {my} prende {your}. {t1} può aspettare.
demo.my.first.take.2 = {my} prende prima {your}. {t1} resterà lì.
demo.my.first.check = {my} prende {your}, ed è scacco! {t1} può aspettare.
demo.my.first.check.2 = Prima {my} prende {your}, con scacco. {t1} resterà lì.
demo.my.first.check_move = Prima, scacco {my:con} in {sq}. {t1} può aspettare.
demo.my.first.check_move.2 = {my} va in {sq}: prima lo scacco! {t1} resterà lì.
demo.my.first.move = Prima {my} va in {sq}. {t1} può aspettare.
demo.my.first.move.2 = Prima {my} in {sq}. {t1} resterà lì.
# The piece that moves was attacked itself: it takes something before it can be taken.
demo.my.first.attacked = {my} è attaccat{my:o}, quindi prima prende {your}.
demo.my.first.attacked.2 = {my} è sotto attacco: prima si prende {your}.
# Levels 4-6, the same in-between move.
demo.first = Prima {move}: {t1} può aspettare.
demo.first.2 = Intanto {move}. {t1} resterà lì.
# After the rewind when no takeback is offered: the coach's real move comes next.
demo.play_on = Ora gioco la mia mossa.
demo.play_on.2 = Ecco la mia vera mossa.
demo.play_on.3 = E ora la mia mossa, quella vera.
# Levels 1-3, the player's moves (what they would play).
demo.your.move = Tu porteresti {your} in {sq}.
demo.your.move.2 = Mettiamo che porti {your} in {sq}.
demo.your.move.3 = Poi {your} va in {sq}.
demo.your.take = Tu prenderesti {my}.
demo.your.take.2 = Prendi {my} {your:con}.
demo.your.take.3 = Poi catturi {my}.
demo.your.back = Riprendi.
demo.your.back.2 = Riprendi in {sq}.
demo.your.back.3 = E tu riprendi.
demo.your.king = Il tuo re deve muoversi.
demo.your.king.2 = Il re deve spostarsi, in {sq}.
demo.your.king.3 = Il tuo re scappa in {sq}.
# Levels 4-6 (and 1-3 when the whole line is too long): the demonstration stops where the problem
# stands, and the coach points at what comes next ({t1} {t2} = the pieces that fall, pointed at;
# {reply} = the mating move, traced; the pieces where they stand at that moment).
ex.point.piece = Ora {t1} non si può più salvare.
ex.point.piece.2 = E {t1} è pers{t1:o}.
ex.point.piece.3 = Poi cade {t1}.
ex.point.two = Sia {t1} sia {t2} sono sotto attacco: uno dei due pezzi cade.
ex.point.two.2 = Ora attacco {t1} e {t2}. Non puoi salvare entrambi i pezzi.
ex.point.mate = E ora {reply:nomate} è scacco matto.
ex.point.mate.2 = Poi arriva {reply:nomate}, ed è scacco matto.
# Levels 1-3, at the end of a whole sequence shown on the board: what it cost ({pts} from before the
# move, every capture of the sequence counted).
ex.result.b1 = Vedi? Ora hai perso {pts:point}.
