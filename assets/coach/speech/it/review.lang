# Coach speech (Italian): the review of the player's moves (src/coach/review.cpp, review_explain.cpp).
# Same keys and variants as assets/coach/speech/en/review.lang (its header documents every placeholder).
#
# Notes for Italian:
# - The coach says "tu" and is male. The player's gender is unknown: nothing agrees with the player
#   (avere tenses, nouns, impersonal phrasing: "hai perso", "sei sotto di {pts:point}", "stavi
#   vincendo", "occhio", "attenzione"; never "attento", "bravo", "sei stato", "ti sei preso").
# - Pieces ({your} {your2} {my} {my2} {t1} {t2}) carry their article and possessive ("il tuo
#   cavallo", "la mia torre"): never il / tuo / di / a / da / in / su right before them, ask for the
#   form (common.lang): {your:a} "al tuo re", {your:di}, {my:da}, {t1:su}, {your:con}; {your:lo}
#   "lo / la" (also joined: "prender{your:lo}" = "prenderlo"; before a vowel write "l’" yourself),
#   {your:gli} "gli / le", {t1:lui} "lui / lei", {your:o} the -o / -a ending ("inchiodat{your:o}").
#   {t1} and {t2} may differ in gender: never one adjective or pronoun for both ("sia {t1} sia {t2}
#   sono sotto attacco", "uno dei due pezzi").
# - Moves ({move} {best} {reply}) may be spoken as "arrocco corto": no adjective that agrees with
#   them ("{best} era più forte", "era meglio {best}", "{best} era una mossa più precisa"), no article.
# - Squares: "in {sq}", "da {sq}", "la casa {sq}"; never an article glued to {sq}.
# - Terms: forchetta ("fa forchetta {t1:su} e {t2:su}"), inchiodatura, infilata, attacco di scoperta,
#   in presa / indifeso, matto del corridoio, ultima traversa, casa di fuga, regola del quadrato,
#   andare a donna, ritirare la mossa; "vincere {t1}" = to win a piece, "guadagnare materiale".
# - Counts: {pts:point} "3 punti", {m:move} "2 mosse", {n:time} "3 volte", {n:square} "3 case",
#   {n:attacker}, {n2:defender}; a bare mate count is "matto in {m:f}" ("matto in una").

# ---- Announcements (either side's move) -------------------------------------------------------
# The player gives check (levels 1-2: say what it means).
ann.check.human.b1 = Scacco! Il mio re è sotto attacco.
ann.check.human.b1.2 = Scacco! Stai attaccando il mio re.
ann.check.human.b1.3 = È scacco! Ora il mio re deve salvarsi.
ann.check.human = Scacco.
ann.check.human.2 = Scacco!
ann.check.human.3 = Ed è scacco.
# The coach gives check.
ann.check.coach = Scacco!
ann.check.coach.2 = Scacco.
ann.check.coach.3 = E scacco!
# Once per game at levels 1-2, right after the coach's first check ({your} = the player's king).
ann.check.coach.first = Vuol dire che {your} è sotto attacco. Devi far{your:lo} uscire dallo scacco.
ann.check.coach.first.2 = Scacco vuol dire che {your} è sotto attacco. Sposta{your:lo}, copri lo scacco o prendi il mio pezzo.
ann.double_check.coach = Scacco doppio! Due miei pezzi attaccano insieme il tuo re, quindi deve muoversi.
ann.double_check.coach.2 = È uno scacco doppio: ora ti salva solo una mossa di re.
ann.double_check.human = Scacco doppio! Due tuoi pezzi attaccano insieme il mio re, quindi deve muoversi.
ann.double_check.human.2 = Uno scacco doppio! Ora mi salva solo una mossa di re.
# The player checkmates the coach.
ann.mate.human.b1 = Scacco matto! Hai vinto! Il mio re non può scappare.
ann.mate.human.b1.2 = È scacco matto! Complimenti, hai vinto la partita!
ann.mate.human.b1.3 = Scacco matto! Il mio re è in trappola. Congratulazioni!
ann.mate.human = Scacco matto. Ben giocato.
ann.mate.human.2 = È matto. Complimenti.
ann.mate.human.3 = Scacco matto! Ben fatto.
# The coach checkmates the player.
ann.mate.coach.b1 = È scacco matto. Il tuo re non ha più via di scampo.
ann.mate.coach.b1.2 = Scacco matto. Il tuo re è sotto attacco e non può scappare.
ann.mate.coach.b1.3 = Purtroppo è scacco matto. Il tuo re non può fuggire.
ann.mate.coach = Scacco matto.
ann.mate.coach.2 = Ed è matto.
ann.mate.coach.3 = Scacco matto, purtroppo.

