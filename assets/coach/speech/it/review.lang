ex.verdict.blunder.b1.2 = Attenzione! Questa mossa può costarti caro.
ex.verdict.blunder.b1.3 = Oh, aspetta. Questa mossa ha un problema.
ex.verdict.blunder.b2 = Mmm, questa mossa ha un problema.
ex.verdict.blunder.b2.2 = Questo è un grosso errore.
ex.verdict.blunder.b2.3 = Attenzione, questa mossa ti costa qualcosa.
ex.verdict.blunder.b3 = Questo è un errore grave.
ex.verdict.blunder.b3.2 = {move} è un vero errore.
ex.verdict.blunder.b3.3 = Ahi, {move} è un grosso errore.
ex.verdict.blunder.b4 = {move} è un errore grave.
ex.verdict.blunder.b4.2 = {move} è un errore serio.
ex.verdict.blunder.b4.3 = Temo che sia un errore grave.
ex.verdict.blunder.b5 = {move} è un errore serio.
ex.verdict.blunder.b5.2 = {move} è un errore grave.
ex.verdict.blunder.b5.3 = {move} è un errore che costa caro.
ex.verdict.blunder.b6 = {move} è un errore pesante.
ex.verdict.blunder.b6.2 = {move} è un errore grave.
ex.verdict.blunder.b6.3 = {move}? Un errore grave.
# A blunder that leaves the coach's threat standing (levels 1-2: the threat the engine found after the
# coach's last move is what the reply carries out).
ex.verdict.ignored.b1 = Ops! Non hai risposto alla mia minaccia.
ex.verdict.ignored.b1.2 = Attenzione! La mia minaccia c’era ancora.
ex.verdict.ignored.b1.3 = Oh, aspetta. Hai dimenticato la mia minaccia.
ex.verdict.ignored.b2 = Mmm, la mia minaccia c’era ancora.
ex.verdict.ignored.b2.2 = Hai lasciato la mia minaccia senza risposta.
ex.verdict.ignored.b2.3 = Attenzione, non hai risposto alla mia minaccia.
ex.verdict.mistake.b3 = Questa non è una buona mossa.
ex.verdict.mistake.b3.2 = Mmm, {move} ha un problema.
ex.verdict.mistake.b3.3 = Questo è un errore.
ex.verdict.mistake.b4 = {move} è un errore.
ex.verdict.mistake.b4.2 = {move} non va bene.
ex.verdict.mistake.b4.3 = È un errore.
ex.verdict.mistake.b5 = {move} è un errore evidente.
ex.verdict.mistake.b5.2 = {move} è un errore.
ex.verdict.mistake.b5.3 = {move} non è una buona mossa.
ex.verdict.mistake.b6 = {move} è un errore.
ex.verdict.mistake.b6.2 = {move}? Un errore.
ex.verdict.mistake.b6.3 = {move}, no.
# A dubious move (an inaccuracy; a costly move with nothing concrete to show while still better):
# only the better move is named ({best} is pointed at), never a scenario.
ex.verdict.inaccuracy.b3 = Non male, ma {best} era un po’ meglio.
ex.verdict.inaccuracy.b3.2 = {best} era una mossa un po’ più precisa.
ex.verdict.inaccuracy.b3.3 = Una piccola svista: qui era meglio {best}.
ex.verdict.inaccuracy.b4 = Mossa imprecisa: era più preciso giocare {best}.
ex.verdict.inaccuracy.b4.2 = Una piccola imprecisione. {best} era un po’ meglio.
ex.verdict.inaccuracy.b4.3 = Non proprio la migliore: la più precisa era {best}.
ex.verdict.inaccuracy.b5 = {move} è un’imprecisione; {best} era più forte.
ex.verdict.inaccuracy.b5.2 = Una lieve imprecisione. Io avrei giocato {best}.
ex.verdict.inaccuracy.b5.3 = La mossa {best} era più precisa di {move}.
ex.verdict.inaccuracy.b6 = {move} è un’imprecisione; {best}.
ex.verdict.inaccuracy.b6.2 = Imprecisione. {best}.
ex.verdict.inaccuracy.b6.3 = {best} era meglio.
# Level 6, an inaccuracy at the bottom of its class (deeper searches often clear it): a hedged word.
ex.verdict.inaccuracy.maybe = Forse {best} era una mossa un po’ più precisa.
ex.verdict.inaccuracy.maybe.2 = Forse avrei giocato {best}.
# A dubious move that loses material (levels 3-6): the remark alone, never "a bit better" (at level 6
# under 6 points, the hedged word above unless a piece is lost).
ex.verdict.dubious = Questa mossa sembra dubbia.
ex.verdict.dubious.2 = Questa mossa mi pare dubbia.
# Something good was missed (levels 1-2).
ex.verdict.missed.b1 = Oh, aspetta! Ti è sfuggito qualcosa di buono.
ex.verdict.missed.b1.2 = Guarda di nuovo! C’era qualcosa di meglio.
ex.verdict.missed.b1.3 = Un momento, lì avevi un’occasione!
ex.verdict.missed.b2 = Lì hai perso un’occasione.
ex.verdict.missed.b2.2 = Mmm, c’era qualcosa di meglio.
ex.verdict.missed.b2.3 = Aspetta, lì avevi un’ottima mossa.

