# Coach speech (Italian): the rules lesson (level 0, src/coach/lesson.cpp).
# Same keys and variants as assets/coach/speech/en/lesson.lang.
#
# Placeholders: {your} / {my} = a piece of the player / of the coach with its article and possessive
# ("la tua torre", "il mio cavallo"), with the forms of common.lang ({your:con} "con il tuo...",
# {my:a} "al mio...", {my:lo} "lo" / "la", {your:o} the ending that agrees with the piece);
# {sq}, {sq2}, {to}, {esc} = squares ("in {sq}", "la casa {sq}": never an article right before
# them); {move} = a move. {@}, {@2}, {@3} are invisible marks: the coach points at something while
# saying the word right after the mark. A ".spoken" key is what the voice says instead (here: file
# letters spelled for the voice).
# The player's gender is unknown: no adjective or participle agrees with the player ("occhio allo
# stallo", "comportati con educazione", never "attento", "educato"). "muovere" with avere ("ha già
# mosso") keeps the castling lines free of agreement with the king or rook.

# ---- Chapter titles (said inside "Continuiamo con {chapter}.": with their article) ---------------------
lesson.title.welcome = la scacchiera
lesson.title.pieces_lines = il movimento di torre, alfiere e donna
lesson.title.pieces_steps = il movimento di re, cavallo e pedone
lesson.title.values_setup = il valore dei pezzi e le prime mosse
lesson.title.safety = le catture sicure e quelle rischiose
lesson.title.check = lo scacco
lesson.title.mate = lo scacco matto
lesson.title.castling = l’arrocco
lesson.title.en_passant = la presa en passant
lesson.title.promotion = la promozione
lesson.title.draws = lo stallo e la patta
lesson.title.before_move = il controllo prima di muovere
lesson.title.opening = l’apertura
lesson.title.review = un breve ripasso
lesson.title.etiquette = le regole delle nostre partite

# ---- Lines every exercise uses ------------------------------------------------------------------------
# After the coach demonstrated the solution.
lesson.now_you = Ora prova tu.
lesson.now_you.2 = Adesso tocca a te.
lesson.now_you.3 = Ora tu.
# Another wrong move after the demonstration.
lesson.almost = Quasi! Gioca la mossa che ti ho mostrato.
lesson.almost.2 = Non proprio. Prova la mossa della mia dimostrazione.
lesson.almost.3 = Ci sei quasi. Ricorda quello che ti ho appena mostrato.
# A wrong move without a line of its own.
lesson.try_again = Non è questa. Riprova.
lesson.try_again.2 = Non questa. Fai un altro tentativo.
lesson.try_again.3 = Proviamo ancora una volta.
lesson.use_your = Usa {your}.
lesson.use_your.2 = Prova {your:con}.
lesson.watch = Guarda.
lesson.like_this = Così.
lesson.and_back = E torniamo indietro.
# A check that is not checkmate (the coach then shows the escape).
lesson.check_escape = Scacco, ma il mio re scappa in {esc}.
lesson.check_takes = Scacco, ma il mio re prende semplicemente {your}.
lesson.check_block = Scacco, ma posso mettere un pezzo in mezzo.
lesson.stalemate = Stallo! Il mio re non può muoversi e non è sotto scacco. È patta, anche se stavi vincendo!

# ---- Why a move is not allowed (the coach points at the piece or square in question) ----------------
# {sq} = the square in question, {my} = the coach's piece that attacks, pins, blocks or gives
# check, {your} = the piece the player tried to move.
why.KingIntoCheck = Non in {sq}: {my} attacca quella casa. Il re non va mai incontro al pericolo.
why.PathBlocked = C’è qualcosa in {@}mezzo: i pezzi non possono saltare, tranne il cavallo.
why.WrongGeometry = {your} non si muove così.
why.MustAnswerCheck = Sei sotto {@}scacco: prima devi pararlo.
why.CastlingThroughCheck = Il tuo re passerebbe per la casa {sq}, e {my} la attacca.
why.CastlingNoRights = Quel re o quella torre ha già mosso: niente arrocco.
why.CastlingBlocked = Per arroccare, le case tra il re e la torre devono essere libere.
why.CastlingOutOfCheck = Non puoi arroccare quando sei sotto scacco.
why.PawnForwardBlocked = Un pedone non può catturare dritto davanti a sé: quella casa è {@}bloccata.
why.LeavesKingInCheck = {your} è inchiodat{your:o}: se {your:lo} muovi, esponi il tuo re {my:a}.
why.OwnPieceOnTarget = Non puoi andare su una casa occupata da un tuo pezzo.
why.PawnCaptureNeedsVictim = Un pedone si muove in diagonale solo per catturare.
why.EnPassantExpired = La presa en passant è possibile solo subito dopo il doppio passo del pedone.
why.NotYourTurn = Aspetta: tocca a me.

# ---- Chapter 0: welcome and the board -------------------------------------------------------------------
lesson.welcome.hello = Ciao! Sono il tuo allenatore. Impariamo insieme le regole degli scacchi, un piccolo passo alla volta.
lesson.welcome.board = Questa è la scacchiera: sessantaquattro case, chiare e scure, otto righe da otto.
lesson.welcome.light = La casa d’angolo alla tua {@}destra è sempre una casa chiara. Ricorda: chiara a destra.
# Italian has no separate everyday word for "column": the line says "vertical lines are called files".
lesson.welcome.files = Le righe verticali si chiamano colonne. Hanno una lettera, dalla {@}a alla {@2}h.
# Spoken: the letter a melts into "dalla" (heard "dalla lacca" 6 times in 6); a pause after it lets it
# through (heard 2 times in 3).
lesson.welcome.files.spoken = Le righe verticali si chiamano colonne. Hanno una lettera, dalla {@}a, fino all’{@2}acca.
lesson.welcome.ranks = Le righe orizzontali si chiamano traverse. Hanno un numero, da {@}uno a {@2}otto, a partire dal tuo lato.
lesson.welcome.square = Ogni casa si indica con la sua lettera e poi con il suo numero. Questa è la casa {sq}.
lesson.welcome.square2 = E questa è {sq}.
lesson.welcome.kings = Questi sono i due re. Il tuo è in {sq}, il mio in {sq2}.
lesson.welcome.ask = Tocca a te: muovi il tuo re di una casa in avanti, in {sq}.
lesson.welcome.wrong = Questa è la casa {to}. Cerchiamo la casa {sq}: lettera e, numero due.
lesson.welcome.ok = Perfetto. Il tuo re è in {sq}.

# ---- Chapter 1: how the pieces move and capture -----------------------------------------------------------
# Rook
lesson.rook.intro = Ecco {your}. Si muove in linea retta, lungo colonne e traverse, di quante case vuole.
lesson.rook.lines = Su per la colonna, {@}oppure lungo la traversa.
lesson.rook.capture = Per catturare, un pezzo va sulla casa di un pezzo {@}avversario, che esce dalla scacchiera.
lesson.rook.ask = Cattura {my} con la tua torre!
lesson.rook.short = Direzione giusta! Continua a salire lungo la colonna, fino {my:a}.
lesson.rook.rank = Così vai lungo la traversa. {my} è più su, sulla colonna.
lesson.rook.king = Quello è il tuo re. Usa {your}, nell’angolo.
lesson.rook.ok = Cattura riuscita! {my} esce dalla scacchiera.
# Pieces don't jump
lesson.jump.blocked = I pezzi non possono saltare sopra gli altri. Il tuo pedone in {sq} sbarra la strada alla torre.
lesson.jump.all = Vale lo stesso per l’alfiere e per la donna: nemmeno loro possono saltare sopra i pezzi.
# Bishop
lesson.bishop.intro = Ecco {your}. Si muove in diagonale, di quante case vuole.
lesson.bishop.colour = Un alfiere resta sempre su case dello stesso colore.
lesson.bishop.ask = {my} è sulla diagonale del tuo alfiere. Cattura{my:lo}!
lesson.bishop.short = Diagonale giusta! Vai più avanti, fino {my:a}.
lesson.bishop.other = Quella è l’altra diagonale. Guarda verso {my}.
lesson.bishop.ok = Ottimo. Gli alfieri adorano le lunghe diagonali.
# Queen
lesson.queen.intro = Ecco {your}, il pezzo più forte. Si muove come una torre e un alfiere messi insieme.
lesson.queen.ask = Trova {my} e cattura{my:lo} con la tua donna.
lesson.queen.wrong = La tua donna può raggiungere {my} in una sola mossa, lungo una diagonale.
lesson.queen.ok = Ben fatto! Tieni al sicuro la tua donna: vale moltissimo.
# King
lesson.king.intro = Il re si muove di una sola casa, in qualsiasi direzione.
lesson.king.important = Il re è il pezzo più importante. Se resta in trappola, la partita è persa.
lesson.king.ask = Anche il re può catturare. Prendi {my}!
lesson.king.wrong = Il tuo re è proprio accanto {my:a}. Spostati sulla sua casa per catturar{my:lo}.
lesson.king.ok = Bene! Il re è lento, ma da vicino è forte.
# Knight
lesson.knight.intro = Ecco {your}. Si muove a L: due case dritto, poi una di lato.
lesson.knight.intro.spoken = Ecco {your}. Si muove a elle: due case dritto, poi una di lato.
lesson.knight.l = {@}Così. Finisce sempre su una casa dell’altro colore.
lesson.knight.jump = Il cavallo è l’unico pezzo che può saltare sopra gli altri.
lesson.knight.ask = Cattura {my} con il tuo cavallo!
lesson.knight.wrong = È una vera mossa di cavallo, ma non raggiunge {my}. Prova un’altra L.
lesson.knight.wrong.spoken = È una vera mossa di cavallo, ma non raggiunge {my}. Prova un’altra elle.
lesson.knight.ok = Gran bel salto!
# Pawn: moving
lesson.pawn.intro = Ora passiamo {your:a}. Va dritto in avanti, una casa alla volta, e non torna mai indietro.
lesson.pawn.first = Alla sua prima mossa, un pedone può avanzare di una o di due case.
lesson.pawn.ask = Muovi il tuo pedone di due case in avanti.
lesson.pawn.one = Questa è una casa sola: è una mossa legale, ma stavolta avanza di due.
lesson.pawn.use = Usa il pedone.
lesson.pawn.ok = Bene.
# Pawn: capturing
lesson.pawncap.blocked = Il mio pedone blocca il tuo. I pedoni non possono catturare dritto davanti a sé.
lesson.pawncap.diagonal = Però un pedone cattura in diagonale, una casa in avanti.
lesson.pawncap.ask = Cattura {my} con il tuo pedone.
lesson.pawncap.use = Usa {your}: cattura in diagonale, in avanti.
lesson.pawncap.ok = Sì! Dritto per muovere, in diagonale per catturare.
# Values, set-up and the first moves
lesson.values.pawn = Ogni pezzo ha un valore in punti. Un pedone vale uno.
lesson.values.pieces = Un cavallo o un {@}alfiere, tre. Una {@2}torre, cinque. La {@3}donna, nove.
lesson.values.king = Il re non ha prezzo: non puoi mai darlo via.
lesson.values.trade = Non cambiare un pezzo più grande con uno più piccolo, a meno di guadagnare più di quanto perdi.
lesson.values.two = Il tuo cavallo attacca due miei pezzi, in {sq} e in {sq2}. Nessuno dei due è difeso.
lesson.values.ask = Prendi quello che vale di più!
lesson.values.small = Quello è un pedone, vale uno. Anche {my} era in presa, e vale nove.
lesson.values.look = Guarda che cosa attacca il tuo cavallo e prendi il pezzo che vale di più.
lesson.values.ok = Sì! Una donna vale nove. Quando due pezzi sono liberi, prendi il più grande.
lesson.setup.corners = Ogni partita comincia così: le torri negli {@}angoli, poi i {@2}cavalli, poi gli {@3}alfieri.
lesson.setup.queen = La donna sta sul suo colore: la tua donna è su una casa chiara.
lesson.setup.king = Il re le sta accanto. Il Bianco muove sempre per primo.
lesson.first.ask = Comincia la partita: muovi di due case il pedone davanti al tuo re, in {sq}.
lesson.first.wrong = Anche questa è una mossa legale! Per ora, però, gioca il pedone del tuo re in {sq}, per favore.
lesson.first.ok = Un’ottima prima mossa: apre delle linee alla tua donna e al tuo alfiere.
lesson.first.reply = Rispondo allo stesso modo. Ora fai uscire un cavallo: salta da {sq} a {sq2}.
lesson.first.knight_wrong = I cavalli saltano sopra i pedoni. Prova da {sq} a {sq2}.
lesson.first.knight_ok = Perfetto. Cavalli e alfieri escono presto.

# ---- Chapter 2: safe and unsafe captures ---------------------------------------------------------------------
lesson.safety.defended = Un pezzo è difeso quando un pezzo amico può riprendere.
lesson.safety.pawn = Il mio {@}pedone difende {my}.
lesson.safety.free = Ma {my} non ha difensori. La tua donna attacca entrambi i pezzi.
lesson.safety.ask = Cattura il pezzo indifeso!
lesson.safety.watch = Guarda cosa succede.
lesson.safety.gave = Hai dato la tua donna, che vale nove, per il mio cavallo, che vale tre.
lesson.safety.other = Prova con l’altro pezzo.
lesson.safety.look = Cerca il pezzo che nessuno difende.
lesson.safety.ok = Ottimo! Chiediti sempre: quel pezzo è difeso?
lesson.safety.pawns = La tua donna attacca due miei pedoni: quello in {sq} e quello in {sq2}.
lesson.safety.pawns_ask = Cattura il pedone che puoi prendere senza rischi.
lesson.safety.gave_pawn = Hai dato la tua donna, che vale nove, per un pedone, che vale uno.
lesson.safety.pawns_other = Anche un pedone può essere difeso. Prova con l’altro pedone.
lesson.safety.pawns_ok = Giusto! Non rischiare mai la donna per un pedone difeso.
lesson.safety.small = Ora al contrario. {my} è difes{my:o}, ma il tuo pedone la attacca.
lesson.safety.small_count = Se la prendi, il mio {@}pedone riprende il tuo. Dai un punto e ne vinci nove.
lesson.safety.small_ask = Cattura la mia donna con il pezzo giusto!
lesson.safety.small_other = Prendila invece con il tuo pedone: il pezzo che costa meno tra quelli che possono.
lesson.safety.small_look = Il tuo pedone attacca la mia donna. Catturala con quello.
lesson.safety.small_ok = Sì! Un pezzo piccolo può prendere uno grande, anche se difeso: perdi un punto e ne vinci nove.
lesson.safety.count = Prima di ogni cattura, conta quanto vinci e quanto potresti riperdere.

# ---- Chapter 3: check and getting out of check -----------------------------------------------------------------
lesson.danger.rank = La mia torre controlla tutta la seconda traversa.
lesson.danger.rule = Il re non può mai andare su una casa dove potrebbe essere catturato.
lesson.danger.ask = Porta il tuo re su una casa sicura.
lesson.danger.ok = Giusto. Lì il tuo re è al sicuro.
lesson.check.what = La mia torre attacca il tuo re. Questo si chiama scacco.
lesson.check.must = Quando sei sotto scacco, devi uscirne subito.
lesson.check.ways = Ci sono tre modi: {@}muovere il re, {@2}bloccare l’attacco o {@3}catturare l’attaccante.
lesson.check.ask = Qui, porta il tuo re fuori dallo scacco.
lesson.check.file = La casa {to} è ancora sulla colonna della {@}mia torre. Togliti da quella linea.
lesson.check.ok = Bene: non sei più sotto scacco.
lesson.block.again = Di nuovo scacco! Stavolta il tuo re non ha case libere.
lesson.block.ask = Allora blocca l’attacco: metti un pezzo in mezzo.
lesson.block.queen = Così blocchi! Ma la mia torre potrebbe prendere la tua donna. Blocca con un pezzo che vale meno.
lesson.block.queen_ok = Funziona. Ma ricorda: si blocca con il pezzo che vale meno.
lesson.block.ok = Perfetto. Blocca con il pezzo di minor valore.
lesson.capture.check = La mia donna dà scacco, proprio accanto al tuo re.
lesson.capture.ask = Cattura l’attaccante!
lesson.capture.king_ok = Sì! La mia donna non era difesa, quindi il tuo re poteva prenderla.
lesson.capture.knight_ok = Sì! Il tuo cavallo ha eliminato l’attaccante.
lesson.check.open.ask = Di nuovo scacco! Stavolta esci come preferisci.
lesson.check.open.king = Hai spostato il re. Si poteva anche bloccare con un pezzo, oppure il tuo cavallo poteva prendere la mia torre.
lesson.check.open.block = Hai bloccato l’attacco. Il tuo re poteva anche spostarsi, oppure il tuo cavallo poteva prendere la mia torre.
lesson.check.open.take = Hai preso la mia torre, il pezzo che dava scacco. Andava bene anche spostare il re o bloccare.
lesson.check.open.hint = Tre modi: {@}muovere il re, {@2}bloccare sulla colonna o {@3}catturare la mia torre con il cavallo.

# ---- Chapter 4: checkmate ------------------------------------------------------------------------------------
lesson.mate1.what = Scacco matto: il re è sotto scacco e non ha via di scampo. Così si vince la partita.
lesson.mate1.stuck = Il mio re è bloccato dietro i {@}propri pedoni.
lesson.mate1.ask = Dammi scacco matto in una mossa!
lesson.mate1.wrong = Ci sei quasi! Dai scacco sulla mia ultima traversa, dove il mio re non può scappare.
lesson.mate1.ok = Scacco matto! Questo è il matto del corridoio. Ricordalo!
lesson.mate1.king = Il tuo re sta bene dov’è. Dai scacco con la torre.
lesson.mate1.why = Visto? La torre controlla {@}tutta la mia ultima traversa, e i miei {@2}pedoni riempiono le case davanti al mio re.
lesson.mate2.ask = Il tuo re e la tua donna lavorano in squadra. Dammi scacco matto in una mossa.
lesson.mate2.wrong = Trova uno scacco che non lasci al mio re nessuna casa.
lesson.mate2.ok = Scacco matto! Il tuo re protegge la donna, quindi il mio non può prenderla.
lesson.mate2.ok_rank = Scacco matto sull’ultima traversa! Il tuo re controlla tutte le case davanti al mio.
lesson.mate2.king = Il tuo re protegge le case accanto al mio. Lascialo lì e usa la donna.
lesson.mate2.half = Quella controlla la casa {sq}, ma il mio re può ancora andare in {sq2}.
lesson.mate2.why = Visto? La tua donna controlla le case {sq} e {sq2}, e il tuo re controlla le case davanti al mio. Il mio re non ha scampo.
lesson.mate3.edge = La tua torre sulla settima traversa tiene il mio re sul bordo.
lesson.mate3.ask = Ora usa {your} per dare scacco matto.
lesson.mate3.free = Scacco, ma ora la settima traversa è libera e il mio re scappa.
lesson.mate3.takes = Il mio re prende semplicemente la tua torre.
lesson.mate3.hint = Dai scacco sull’ultima traversa con la torre che non controlla la settima.
lesson.mate3.ok = Scacco matto! Le due torri hanno lavorato come una scala.
lesson.mate3.why = Visto? Una torre taglia la {@}settima traversa e l’altra dà scacco sull’{@2}ultima traversa. Il mio re non ha scampo.
lesson.mate4.look = Scacco non sempre vuol dire scacco matto. Vediamo che cosa succede.
lesson.mate4.ask = Dai scacco al mio re con la torre.
lesson.mate4.king = Il tuo re resta dov’è. Dai scacco con la torre.
lesson.mate4.wrong = Questo non è scacco. La tua torre può attaccare il mio re dall’ultima traversa.
lesson.mate4.ok = Sì, è scacco! Ma è scacco matto? Guarda.
lesson.mate4.after = Il mio pedone in {sq} ha lasciato spazio al mio re. Prima di festeggiare uno scacco, conta le case che il mio re può ancora usare.
lesson.mate5.ask = Due mosse di torre danno scacco, e solo una è scacco matto. Conta le case del mio re, poi scegli.
lesson.mate5.king = Il tuo re controlla già le case {sq} e {sq2}. Lascialo lì e muovi la torre.
lesson.mate5.wrong = Questo non è scacco. Cerca una mossa di torre che attacchi il mio re.
lesson.mate5.hint = Il tuo re controlla le case {sq} e {sq2}. Quale scacco di torre toglie anche la casa {sq3}?
lesson.mate5.why = Visto? La torre controlla la casa {sq}, il tuo re controlla le altre due e il mio re è bloccato.
lesson.mate5.ok = Scacco matto! Hai contato le case del mio re: non ne restava nessuna.

# ---- Chapter 5: castling ---------------------------------------------------------------------------------------
lesson.castle.what = L’arrocco è una mossa speciale che mette al sicuro il tuo re. Re e torre si muovono insieme.
lesson.castle.how = Il {@}re si sposta di due case verso una torre, e la {@2}torre salta dall’altra parte del re.
lesson.castle.ask = Tocca sempre prima il re. Ora tu: arrocca sull’ala di re.
lesson.castle.rook = Così muovi solo la torre. Per arroccare, sposta il re di due case verso la torre.
lesson.castle.long = Questo è l’arrocco lungo: è legale anche questo! Stavolta arrocca verso la torre più vicina.
lesson.castle.one = Una casa sola è una normale mossa di re. Per arroccare, il re si sposta di due case.
lesson.castle.other = Per arroccare, sposta il re di due case verso la torre in {sq}.
lesson.castle.ok = Arrocco fatto! Il tuo re è al riparo e la tua torre è pronta a entrare in gioco.
lesson.castle2.moved = Non puoi arroccare se il tuo re o quella torre hanno già mosso.
lesson.castle2.attacked = Né quando sei sotto scacco, né se il tuo re attraversa una casa attaccata o ci finisce sopra.
lesson.castle2.bishop = Il mio alfiere attacca la casa {sq}. Quindi, per ora, l’arrocco da questo lato è vietato.
lesson.castle2.ask = Arrocca dall’altro lato.
lesson.castle2.other = Arrocca verso l’altra torre, sull’ala di donna.
lesson.castle2.ok = Esatto! Con l’arrocco lungo il tuo re va in {sq}.
lesson.ep0.rule = L’en passant comincia con il doppio passo. Solo un pedone {@}ancora a casa può avanzare di due case. Un pedone che {@2}ha già mosso va avanti di una alla volta.
lesson.ep0.ask = Muovi uno dei tuoi pedoni di due case.
lesson.ep0.moved = Quel pedone ha già mosso, quindi può avanzare di una sola casa. Usa un pedone ancora a casa.
lesson.ep0.ok = Giusto: solo un pedone sulla sua casa di partenza può avanzare di due.

# ---- Chapter 6: en passant ------------------------------------------------------------------------------------
lesson.ep.what = C’è una cattura speciale del pedone che si chiama en passant. Vuol dire «di passaggio».
lesson.ep.watch = Guarda il mio pedone: avanza di due case e finisce proprio accanto al tuo.
lesson.ep.how = Il tuo pedone può catturarlo come se fosse avanzato di una sola casa: in {sq}.
lesson.ep.now = Ma solo adesso, a questa mossa. Cattura en passant!
lesson.ep.gone = L’occasione è sfumata: l’en passant si può fare solo subito. Riproviamo.
lesson.ep.ok = En passant! Il mio pedone in {sq} esce dalla scacchiera.
lesson.ep2.old = Il mio pedone in {sq} sta accanto al tuo da un po’. È troppo tardi per catturarlo en passant.
lesson.ep2.watch = Ora guarda il mio altro pedone.
lesson.ep2.ask = Due miei pedoni stanno accanto al tuo, ma solo uno ha appena avanzato di due case. Catturalo en passant!
lesson.ep2.push = Così fai solo avanzare il tuo pedone. Cattura il pedone che ha appena avanzato di due case.
lesson.ep2.wrong = Cerca il pedone che ha appena fatto il doppio passo e catturalo en passant.
lesson.ep2.hint = Il mio pedone in {sq} ha appena avanzato di due case. Catturalo en passant, in {sq2}.
lesson.ep2.ok = En passant! Il mio pedone in {sq} non si poteva prendere: la sua occasione era finita.

# ---- Chapter 7: promotion -------------------------------------------------------------------------------------
lesson.promo.what = Quando un pedone raggiunge l’ultima traversa, viene promosso: diventa donna, torre, alfiere o cavallo.
lesson.promo.ask = Quasi sempre si sceglie la donna. Ora promuovi il tuo pedone!
lesson.promo.under = Si può fare! Ma la donna è più forte. Scegliamo la donna.
lesson.promo.under_ok = Va bene. Però quasi tutti i giocatori scelgono la donna.
lesson.promo.push = Spingi il tuo pedone fino all’ultima traversa, in {sq}.
lesson.promo.ok = Una nuova donna! Puoi avere perfino due donne contemporaneamente.
lesson.promo2.ask = Un pedone può promuovere anche catturando, in diagonale. Prendi la mia torre e fai una donna!
lesson.promo2.push = Promuove anche così, ma la mia torre controlla la casa {sq}. Guarda.
lesson.promo2.lost = La mia torre ha preso il tuo nuovo pezzo. Prima cattura la mia torre.
lesson.promo2.wrong = Questo non cattura la mia torre. Il tuo pedone prende in diagonale, in {sq}.
lesson.promo2.hint = Prendi la mia torre con il pedone, andando in {sq}: promuove mentre cattura.
lesson.promo2.ok = Catturato e promosso! Un pedone può fare entrambe le cose in una mossa.

# ---- Chapter 8: stalemate and draws -----------------------------------------------------------------------------
lesson.stale.what = Tocca a me. Il mio re non è sotto scacco, ma {@}tutte le case intorno a lui sono attaccate.
lesson.stale.draw = Non ho mosse legali. Questo è stallo, e la partita è patta.
lesson.stale2.ask = Quando stai vincendo, occhio allo stallo. Dammi scacco matto in una mossa, senza stallo!
lesson.stale2.wrong = Trova uno scacco che non lasci al mio re nessuna casa. Attenzione: una mossa tranquilla può darmi stallo.
lesson.stale2.king = Il tuo re controlla già le case {sq} e {sq2}. Lascialo lì e usa la donna.
lesson.stale2.hint = Il tuo re controlla le case {sq} e {sq2}. Dammi scacco sull’ultima traversa e il mio re non ha dove andare.
lesson.stale2.why = Visto? Il mio re è sotto {@}scacco e non ha case libere: è scacco matto. Senza lo scacco sarebbe stallo.
lesson.stale2.ok = Scacco matto! Lascia sempre una mossa al re avversario, a meno che tu non gli stia dando matto.
lesson.draws.kings = Altre patte: quando nessuno può dare scacco matto, come con due re soli, la partita è patta.
lesson.draws.agree = I giocatori possono anche accordarsi per la patta.
lesson.draws.repeat = Anche ripetere tre volte la stessa posizione, o fare cinquanta mosse senza catture né mosse di pedone, permette la patta.

# ---- Chapter 9: before you move (the safety habit) ----------------------------------------
lesson.before.habit = Prima di ogni mossa, fermati e guarda. I giocatori forti lo fanno sempre.
lesson.before.last = Prima domanda: che cosa ha fatto la mia ultima mossa? Guarda.
lesson.before.threat = {my} attacca {your}. È una minaccia.
lesson.before.safe = Allontanarsi non basta. Anche la nuova casa deve essere sicura.
lesson.before.dodge.ask = Porta il tuo cavallo su una casa sicura.
lesson.before.dodge.still = Il tuo cavallo è ancora attaccato. Guarda.
lesson.before.dodge.hint = I miei pedoni proteggono {sq} e {sq2}. Scegli un’altra casa.
lesson.before.dodge.ok = Sicura! Hai visto la minaccia e hai controllato la casa.
# A wrong move onto a guarded square ({my} guards {to}); the coach then takes the piece.
lesson.before.unsafe = Non su {to}: {my} protegge quella casa. Guarda.
# Said after the coach took the piece, before the move is taken back.
lesson.before.lost = Hai perso {your}. Prima guarda, poi muovi.
lesson.before.again = Ancora una volta, prima muovo io. Guarda.
lesson.before.free.ask = Guarda la mia ultima mossa. Puoi catturare qualcosa gratis?
lesson.before.free.missed = Guarda ancora {my}. Chi può catturar{my:lo}?
lesson.before.free.hint = {my} non ha difensori. Il tuo {@}pedone può catturar{my:lo}.
lesson.before.free.ok = Sì! Il mio alfiere era libero. Guarda sempre la mia ultima mossa.
lesson.before.check.ask = Dammi scacco da una casa dove non posso catturarti.
lesson.before.check.wrong = Non è scacco. Trova uno scacco da una casa sicura.
lesson.before.check.hint = {my} protegge {sq}. Dai scacco da una casa sicura.
lesson.before.check.ok = Bello scacco! La tua donna è al sicuro lì.
lesson.before.done = Fanne un’abitudine: prima guarda, poi muovi.

# ---- Chapter 10: the opening ------------------------------------------------------------
lesson.opening.what = L’apertura è l’inizio della partita. Poche regole semplici aiutano.
lesson.opening.goals = {@}Prendi il centro, {@2}sviluppa cavalli e alfieri e {@3}arrocca presto.
lesson.opening.centre = Le quattro case nel {@}mezzo formano il centro.
lesson.opening.pawn.ask = Metti un pedone al centro: due case avanti.
lesson.opening.pawn.one = Non male, ma due case prendono più centro.
lesson.opening.pawn.knight = I cavalli arriveranno presto. Prima, un pedone al centro.
lesson.opening.pawn.wrong = Usa il pedone davanti al tuo re o alla tua donna.
lesson.opening.pawn.ok = Bene! Il tuo pedone prende spazio al centro.
lesson.opening.queen = Non portare fuori la donna troppo presto: i miei pezzi la inseguirebbero.
lesson.opening.knight.ask = Sviluppa un cavallo, verso il centro.
lesson.opening.rim = Un cavallo sul bordo raggiunge poche case. Salta verso il centro.
lesson.opening.bishop = Sviluppare è giusto! Ma stavolta, un cavallo.
lesson.opening.knight.ok = Bene! Da lì il tuo cavallo controlla il centro.
lesson.opening.later = Qualche mossa dopo: il tuo cavallo e il tuo {@}alfiere sono in gioco.
lesson.opening.twice = Non muovere due volte lo stesso pezzo senza un buon motivo.
lesson.opening.castle.ask = La via è libera. Arrocca per mettere il re al sicuro.
lesson.opening.castle.wrong = Il tuo re è pronto. Arrocca adesso, finché la via è libera.
lesson.opening.castle.ok = Arrocco fatto! Il tuo re è al sicuro e la torre entra in gioco.
lesson.opening.done = Centro, pezzi, arrocco: è un buon inizio per ogni partita.
lesson.review.start = Breve ripasso, in un ordine diverso stavolta. Non spiego: me lo mostri tu.
lesson.review.promo.ask = Promuovi questo pedone.
lesson.review.promo.ok = Bene: una nuova donna, e con scacco!
lesson.review.check.ask = Il tuo re è sotto scacco. Esci dallo scacco.
lesson.review.check.ok = Fuori dallo scacco. Bene.
lesson.review.castle.ask = Arrocca, sul lato dove è permesso.
lesson.review.castle.other = Quello non è arrocco. Arrocca sul lato dove è permesso.
lesson.review.castle.ok = Arroccato, dal lato sicuro!
lesson.review.ep.ask = Cattura il mio pedone en passant.
lesson.review.ep.ok = En passant! Te lo sei ricordato.
lesson.review.mate.ask = Dammi scacco matto in una mossa.
lesson.review.mate.ok = Scacco matto! Ripasso finito.

# ---- Chapter 11: real games (rating, clock, touch-move, scoresheet, manners) ------------------------------------
lesson.talk.rules = Ora conosci tutte le regole degli scacchi. Ben fatto!
lesson.talk.real = Ti spiego come funzioneranno le nostre partite.
lesson.talk.no_clock = Con me non ci sono né orologio né punteggio. Prenditi tutto il tempo che ti serve per pensare.
lesson.talk.touch = Un pezzo che tocchi va mosso: quindi prima guarda, poi tocca.
# "Acconcio" is the Italian word (FSI) for "j'adoube".
# {move:letters} shows the Italian scoresheet letters ("Cf3"), which is what this line teaches.
lesson.talk.handshake = Le partite cominciano e finiscono con una stretta di mano. Vuol dire: bella partita, e grazie.
lesson.talk.polite = Che tu vinca o che tu perda, comportati sempre con educazione e non disturbare mai l’avversario mentre pensa.
lesson.talk.help = Nelle nostre partite ti aiuterò. Se un tuo pezzo è attaccato o rimasto senza protezione, te lo dirò.
lesson.talk.help_back = Dopo un grosso errore ti mostrerò il perché e ti proporrò di ritirare la mossa.
lesson.talk.help_skip = E se parlo troppo, premi Spazio: mi fermo.
lesson.talk.next = Quando vuoi, gioca «Primi passi». Ci andrò piano.
lesson.talk.welcome = Ti do il benvenuto nel mondo degli scacchi! Stringiamoci la mano.
