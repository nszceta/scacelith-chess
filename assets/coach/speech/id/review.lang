# Coach speech (Indonesian): the review of the player's moves (src/coach/review.cpp, review_explain.cpp).
# Same keys and variants as assets/coach/speech/en/review.lang (its header documents every placeholder).
#
# Register: the coach says "kamu" and "aku", possessive suffixes "-mu" / "-ku" on plain nouns
# ("langkahmu", "rajaku", "buahku"); conversational standard Indonesian ("tidak", "saja", "sudah").
# Indonesian has no gender, no cases and no tense agreement: nothing agrees with the player.
# Pieces ({your} {my} {your2} {my2} {t1} {t2}) already carry their owner ("kudamu", "gajahku"): never
# add "-mu", "-ku", "-nya" or "milik" to them. "It" for a piece: "ia", "-nya" on the verb
# ("memakannya"), or {your:bare} (the noun alone). {your:milik} only for a stressed contrast.
# Squares and moves stand alone: "ke {sq}", "di {sq}", "petak {sq}", "langkah {move}"; nothing glued.
# Counted numbers: {m:move} "2 langkah", {pts:point} "3 poin", {n:time} "3 kali", {n2:piece}
# "2 buah catur"; with a single plural form, "{n} penyerang" / "{n2} pelindung" are written directly.
# "Mate in N" = "mat dalam {m:move}" (the eval wording of common.lang); otherwise "skakmat".
# Past moments are marked with "tadi" where the sentence needs it ("Tadi kamu punya ...").

# ---- Announcements (either side's move) -------------------------------------------------------
# The player gives check (levels 1-2: say what it means).
ann.check.human.b1 = Skak! Rajaku diserang.
ann.check.human.b1.2 = Skak! Kamu menyerang rajaku.
ann.check.human.b1.3 = Itu skak! Rajaku harus lolos dari skak.
ann.check.human = Skak.
ann.check.human.2 = Skak!
ann.check.human.3 = Dan itu skak.
# The coach gives check.
ann.check.coach = Skak!
ann.check.coach.2 = Skak.
ann.check.coach.3 = Dan skak!
# Once per game at levels 1-2, right after the coach's first check ({your} = the player's king).
ann.check.coach.first = Artinya, {your} sedang diserang. Kamu harus membebaskannya dari skak.
ann.check.coach.first.2 = Skak artinya {your} sedang diserang. Pindahkan {your:bare}, halangi skaknya, atau makan buahku.
ann.double_check.coach = Skak ganda! Dua buahku menyerang rajamu sekaligus, jadi rajamu harus pindah.
ann.double_check.coach.2 = Itu skak ganda: sekarang hanya langkah raja yang bisa menolongmu.
ann.double_check.human = Skak ganda! Dua buahmu menyerang rajaku sekaligus, jadi rajaku harus pindah.
ann.double_check.human.2 = Skak ganda! Sekarang hanya langkah raja yang bisa menyelamatkanku.
# The player checkmates the coach.
ann.mate.human.b1 = Skakmat! Kamu menang! Rajaku tidak bisa lolos.
ann.mate.human.b1.2 = Itu skakmat! Hebat, kamu memenangkan permainan ini!
ann.mate.human.b1.3 = Skakmat! Rajaku terjebak. Selamat!
ann.mate.human = Skakmat. Permainanmu bagus.
ann.mate.human.2 = Itu skakmat. Selamat.
ann.mate.human.3 = Skakmat! Bagus sekali.
# The coach checkmates the player.
ann.mate.coach.b1 = Itu skakmat. Rajamu tidak punya jalan keluar.
ann.mate.coach.b1.2 = Skakmat. Rajamu diserang dan tidak bisa lolos.
ann.mate.coach.b1.3 = Sayang sekali, itu skakmat. Rajamu tidak bisa menghindar.
ann.mate.coach = Skakmat.
ann.mate.coach.2 = Dan itu skakmat.
ann.mate.coach.3 = Skakmat, sayang sekali.

