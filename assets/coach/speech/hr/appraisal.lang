# Coach speech (Croatian): the appraisal after the game (src/coach/appraisal.cpp).
# Same keys and variants as assets/coach/speech/en/appraisal.lang (its header documents every placeholder).
#
# Always positive, never blaming. The coach says "ti"; the player's gender is unknown: no second-person
# past tense or conditional ("pobijedio si", "pronašao si", "mogao si") and no adjective agreeing with
# the player ("spreman"). Instead: nouns ("Pobjeda je tvoja"), impersonal forms ("uspjelo ti je",
# "moglo se", "nije ti promaknuo"), "we" ("vratili smo", "igrali smo"), the coach's own first person
# ("izgubio sam od tebe"), or the move as the subject (masculine, "potez" understood).
# Forms from common.lang: move numbers are ordinals, "u {n:ord_loc} potezu" = "u 21. potezu" (spoken
# "u dvadeset prvom potezu"), "{n:ord} potez" = "21. potez", "do {crit_no:ord_gen} poteza";
# "{acc:percent}" = "85 %" (spoken "osamdeset pet posto"); "{n:piece_acc}" = "jednu figuru";
# "{m:check}" = "dva šaha"; "{n:capture}" = "tri uzimanja"; "{n:best_move}" = "pet najboljih poteza";
# "{text:loc}" = a phase in the locative ("u središnjici", appraisal.phase.*.loc in common.lang).
# Counts given after a colon as plain numbers ("Uzetih figura: {n:f}") keep them out of agreement;
# {n:f} / {n:neut} say "jedna" / "jedno" for a feminine / neuter noun.
# {level} is a level name, always said in „...“ after a case form of "razina": "razinu „Početnik“".
# {opening} is the opening's citation name, always after a colon so it never needs a case.

# ---- Names used inside the lines ------------------------------------------------------------------
# Phases: nominatives ("otvaranje" n, "središnjica" f, "završnica" f); the lines use them where no
# agreement depends on them, and their case forms ("u {text:loc}") are in common.lang.
appraisal.phase.opening = otvaranje
appraisal.phase.middlegame = središnjica
appraisal.phase.endgame = završnica
# Draw reasons, said right after "Remi" / "završila remijem", no comma ("Remi dogovorom.", as the UI says).
appraisal.reason.stalemate = zbog pata
appraisal.reason.material = jer nitko nije mogao dati mat
appraisal.reason.repetition = zbog ponavljanja pozicije
appraisal.reason.fifty = po pravilu pedeset poteza
appraisal.reason.agreement = dogovorom
appraisal.reason.other = po pravilima
# The coach level names (coach.level.<n>.name of assets/i18n/hr.lang).
appraisal.level.l1 = Prvi koraci
appraisal.level.l2 = Početnik
appraisal.level.l3 = Napredni početnik
appraisal.level.l4 = Klupski igrač
appraisal.level.l5 = Jak klupski igrač
appraisal.level.l6 = Stručnjak
