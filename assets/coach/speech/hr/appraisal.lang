theme.skewer = ne držati vrijedne figure na istom pravcu
theme.pin = uočavati vezanja prije nego što nastanu
theme.trapped = ostavljati svojim figurama put za bijeg
theme.back_rank = otvoriti svom kralju polje za bijeg
theme.hanging = držati svoje figure pod zaštitom
theme.exchange = prije zamjene prebrojiti napadače i branitelje
