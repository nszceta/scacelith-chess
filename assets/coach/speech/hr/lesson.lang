lesson.now_you.2 = Sad si ti na redu.
lesson.now_you.3 = Sad ti.
# Another wrong move after the demonstration.
lesson.almost = Skoro! Odigraj potez koji sam ti pokazao.
lesson.almost.2 = Ne baš. Pokušaj s potezom iz mog primjera.
lesson.almost.3 = Blizu si. Sjeti se što sam ti upravo pokazao.
# A wrong move without a line of its own.
lesson.try_again = Nije to. Pokušaj ponovno.
lesson.try_again.2 = Ne taj potez. Probaj opet.
lesson.try_again.3 = Pokušajmo još jednom.
lesson.use_your = Igraj {your:refl_ins}.
lesson.use_your.2 = Pokušaj {your:refl_ins}.
lesson.watch = Gledaj.
lesson.like_this = Ovako.
lesson.and_back = I natrag.
# A check that is not checkmate (the coach then shows the escape).
lesson.check_escape = Šah, ali moj kralj bježi na {esc}.
lesson.check_takes = Šah, ali moj kralj jednostavno uzima {your:acc}.
lesson.check_block = Šah, ali mogu staviti figuru između.
lesson.stalemate = Pat! Moj kralj se ne može pomaknuti, a nije u šahu. Remi, iako je pozicija bila dobivena!

# ---- Why a move is not allowed (the coach points at the piece or square in question) ----------------
# {sq} = the square in question, {my} = the coach's piece that attacks, pins, blocks or gives
# check, {your} = the piece the player tried to move.
why.KingIntoCheck = Ne na {sq}: {my} napada to polje. Kralj nikad ne ide u opasnost.
why.PathBlocked = Nešto ti stoji na {@}putu: figure ne mogu preskakati, osim skakača.
why.WrongGeometry = {your} se tako ne kreće.
why.MustAnswerCheck = Kralj ti je u {@}šahu: najprije se moraš obraniti od njega.
why.CastlingThroughCheck = Tvoj kralj prešao bi preko polja {sq}, a {my} ga napada.
why.CastlingNoRights = Taj se kralj ili top već pomaknuo: rokada nije moguća.
why.CastlingBlocked = Za rokadu polja između kralja i topa moraju biti prazna.
why.CastlingOutOfCheck = Ne možeš rokirati dok si u šahu.
why.PawnForwardBlocked = Pješak ne uzima ravno naprijed: to je polje {@}zauzeto.
why.LeavesKingInCheck = {your} je vezan{your:ag}: ako {your:pron_acc} pomakneš, izložit ćeš svog kralja napadu {my:gen}.
why.OwnPieceOnTarget = Ne možeš stati na vlastitu figuru.
why.PawnCaptureNeedsVictim = Pješak ide dijagonalno samo kad uzima.
why.EnPassantExpired = Uzimanje u prolazu dopušteno je samo odmah nakon što pješak prijeđe dva polja.
why.NotYourTurn = Čekaj: sad sam ja na potezu.

# ---- Chapter 0: welcome and the board -------------------------------------------------------------------
