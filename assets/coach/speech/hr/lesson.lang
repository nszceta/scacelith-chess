# Coach speech (Croatian): the rules lesson (level 0, src/coach/lesson.cpp).
# Same keys and variants as assets/coach/speech/en/lesson.lang.
#
# Placeholders: {your} / {my} = a piece of the player / of the coach ("tvoj top", "moj skakač"), with
# the forms of common.lang ({my:acc}, {my:gen}, {my:dat}, {my:pron_acc}, {my:poss}, {your:refl_ins},
# {your:bare_ins}, {your:ag} ...); {sq}, {sq2}, {to}, {esc} = squares ("na {sq}", "polje {sq}",
# never an ending on them); {move} = a move. {@}, {@2}, {@3} are invisible marks: the coach points at
# something while saying the word right after the mark. A ".spoken" key is what the voice says
# instead (here: letters said by their Croatian names, "ha" for h, "el" for L).
# Rules the lines follow: no second-person past tense or conditional and no adjective agreeing with
# the player; "svoj" when the player acts with their own piece ("Uzmi {my:acc} svojim topom",
# {your:refl_ins}); "Igraj {your:bare_ins}" = "Igraj topom". Files = linije, ranks = redovi, back
# rank = zadnji red, kingside / queenside castling = mala / velika rokada.

# ---- Chapter titles (said inside "Nastavljamo lekciju: {chapter}.") ------------------------------------
# Lower-case nominatives (see event.lesson.* in events.lang).
lesson.title.welcome = šahovska ploča
lesson.title.pieces = kako se kreću figure
lesson.title.safety = sigurna i nesigurna uzimanja
lesson.title.check = šah
lesson.title.mate = mat
lesson.title.castling = rokada
lesson.title.en_passant = uzimanje u prolazu
lesson.title.promotion = promocija pješaka
lesson.title.draws = pat i remi
lesson.title.before_move = prije poteza
lesson.title.opening = otvaranje
lesson.title.etiquette = rejting, sat i ponašanje u pravim partijama

# ---- Lines every exercise uses ------------------------------------------------------------------------
# After the coach demonstrated the solution.
