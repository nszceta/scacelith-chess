ex.mate_missed.b5 = {best:nomate} daje mat u {m:move_loc}: {line:nomate}.
ex.mate_missed.b5.2 = Propušten mat u {m:move_loc}, koji počinje potezom {best:nomate}.
ex.mate_missed.b5.3 = Postojao je forsirani mat: {best:nomate}.
ex.mate_missed.b6 = {best:nomate} daje mat: {line:nomate}.
ex.mate_missed.b6.2 = Mat u {m:mv}: {best:nomate}.
ex.mate_missed.b6.3 = {best:nomate}, mat u {m:mv}.
# Both moves mate, the played one much later (levels 5-6).
ex.mate_delayed.b5 = Brže je bilo {best:nomate}: mat u {m:move_loc}.
