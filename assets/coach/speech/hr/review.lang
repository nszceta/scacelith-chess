ex.fork.b6 = {reply} daje vilicu.
ex.fork.b6.2 = {move} dopušta {reply}, vilicu.
ex.fork.b6.3 = {reply}, s vilicom.
# Once the fork stands (level 1; in the middle of the demonstration, or where it stops).
