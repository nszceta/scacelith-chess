ex.mate_allowed.tip.b3.2 = Uvijek se pitaj: može li moj kralj dobiti mat nakon mog poteza?

# Nominative noun phrases (after "zove se" and "to je").
name.pattern.back_rank = mat na zadnjem redu
name.pattern.smothered = ugušeni mat
name.pattern.support = mat zaštićenom damom
name.pattern.ladder = mat ljestvama
name.pattern.epaulette = epoletni mat

# ---- 2. Mate missed ({best} is pointed at; b1 also points at {my}, the coach's king) ------------
ex.mate_missed.b1 = Potezom {best:nomate} mogao se dati mat {my:dat}!
