ex.mate_delayed.b6 = {best:nomate} daje mat u {m:mv}.
ex.mate_delayed.b6.2 = Brže: {best:nomate}, mat u {m:mv}.

# ---- 3. Stalemate ({my} = the coach's king, pointed at) ----------------------------------------
ex.stalemate.b1 = Oh, ne! {my} se ne može maknuti, a nije u šahu. To je pat: remi.
ex.stalemate.b1.2 = Gledaj: {my} nema nijednog sigurnog polja, ali nije u šahu. To je remi!
ex.stalemate.b1.3 = To je pat. {my} se ne može maknuti, pa je partija remi.
ex.stalemate.b2 = Pat! {my} nema nijednog pravilnog poteza, a nije u šahu. Remi.
ex.stalemate.b2.2 = Oh, ne, pat: {my} je zaglavljen{my:ag}, ali nije u šahu.
ex.stalemate.b2.3 = Pat, dakle remi. {my} se ne može maknuti.
ex.stalemate.b3 = To je pat: {my} nema nijednog pravilnog poteza. A pozicija je bila dobivena!
ex.stalemate.b3.2 = Pat! {my} je zaglavljen{my:ag}, i dobivena partija postaje remi.
ex.stalemate.b3.3 = {my} nema poteza, a nije u šahu: pat.
ex.stalemate.b4 = Pat: {my} nema nijednog pravilnog poteza. Time propada pobjeda.
ex.stalemate.b4.2 = Potez {move} dovodi {my:acc} u pat. Remi iz dobivene pozicije.
ex.stalemate.b4.3 = To je pat; {my} je zatvoren{my:ag}.
ex.stalemate.b5 = {move} dovodi {my:acc} u pat. Pobjede više nema.
ex.stalemate.b5.2 = Pat: {my} nema polja.
ex.stalemate.b5.3 = To je pat, {my} je zaglavljen{my:ag}.
ex.stalemate.b6 = Pat. {my} nema poteza.
ex.stalemate.b6.2 = {move}, pat: {my} je zatvoren{my:ag}.
ex.stalemate.b6.3 = Pat; {my} se ne može maknuti.
ex.stalemate.tip.b1 = Kad dobivaš, uvijek ostavi mom kralju polje na koje se može maknuti.
ex.stalemate.tip.b1.2 = Zapamti: kad si u prednosti, daj mom kralju malo prostora.
# The coach can reach stalemate on purpose along the line.
ex.stalemate_trick.b1 = Pazi! Mogu ti dati svoje figure, i onda {my} nema poteza: pat.
ex.stalemate_trick.b1.2 = Pazi: {my} je gotovo zaglavljen{my:ag}. Mogu izvući remi.
ex.stalemate_trick.b2 = Pazi: mogu žrtvovati figuru, i {my} bi bi{my:pt} u patu.
ex.stalemate_trick.b2.2 = {my} gotovo nema polja. Mogu iznuditi pat!
ex.stalemate_trick.b3 = Ovo mi omogućuje spas patom: {my} ostaje bez poteza.
ex.stalemate_trick.b3.2 = Pazi: nakon {line} je {my} u patu.
ex.stalemate_trick.b4 = {move} dopušta zamku s patom: {line}, i {my} se ne može maknuti.
ex.stalemate_trick.b4.2 = Sad se {my} može skriti u pat: {line}.
ex.stalemate_trick.b5 = {move} dopušta pat: {line}; {my} je zatvoren{my:ag}.
ex.stalemate_trick.b5.2 = Zamka s patom: {line}, i {my} nema poteza.
ex.stalemate_trick.b6 = {line}, pat: {my} je zatvoren{my:ag}.
ex.stalemate_trick.b6.2 = Pat nakon {line}; {my} je zaglavljen{my:ag}.

# ---- 4. Fork (b1 b2: {my} {t1} {t2} pointed at; b3-b5: {reply} {t1} {t2}; b6: {reply}) ----------
