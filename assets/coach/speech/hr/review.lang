ex.mate_allowed.tail.b1.3 = {your} nema kamo pobjeći. To je mat.
# The name of the mating pattern (levels 2-4); {text} is one of the name.pattern keys below.
ex.mate_allowed.pattern = Ta se matna slika zove {text}.
ex.mate_allowed.pattern.2 = Zapamti ovaj mat: to je {text}.
