# Coach speech (Greek): the review of the player's moves (src/coach/review.cpp, review_explain.cpp).
# Same keys and variants as assets/coach/speech/en/review.lang (its header documents every placeholder).
#
# Register: the coach says "εσύ"; he is male. The player's gender is unknown: no adjective or participle
# about the player ("Κέρδιζες!", "προηγείσαι", "υστερείς κατά..." instead of "κερδισμένος").
# Pieces ({your} {my} {your2} {my2} {t1} {t2}) carry their article and owner ("ο ίππος σου"); forms from
# common.lang: acc (object, after με / από / για / προς), gen, se ("επιτίθεται {t1:se}" = "στον ..."),
# pron_acc / pron_acc_short (weak object pronoun), pron_gen ("πίσω {t1:pron_gen}"), os / o / os_st
# (endings of καρφωμέν-, παγιδευμέν-, ακάλυπτ-, εκτεθειμέν-, μόν-, ανοιχτ-, ενεργ-).
# Moves: "το {move}" / "το {best}" (the commentators' neuter), "η συνέχεια {line}" or "{line}" alone.
# Counts: {m:move} "2 κινήσεις", {pts:point} "3 μονάδες", {n:time} "3 φορές", {n:piece} "3 κομμάτια",
# {n:square}; {m:f} = a feminine number with "κινήσεις" understood ("ματ σε τρεις").
# Typography: the Greek question mark ";" ends a sentence for the program (catalog.cpp), so a piece
# placeholder after it is capitalised. The English ";" is the ano teleia "·" here (no capital after it).
# A line of a skewer or a pin is "ευθεία" (any line); "γραμμή" is a rank. Recapturing is "ξαναπαίρνω";
# "παίρνω πίσω" is only the takeback.
# Levels 1-2: short, warm sentences; levels 5-6: terse.

# ---- Announcements (either side's move) -------------------------------------------------------
# The player gives check (levels 1-2: say what it means).
ann.check.human.b1 = Σαχ! Ο βασιλιάς μου δέχεται επίθεση.
ann.check.human.b1.2 = Σαχ! Επιτίθεσαι στον βασιλιά μου.
ann.check.human.b1.3 = Αυτό είναι σαχ! Ο βασιλιάς μου πρέπει να ξεφύγει.
ann.check.human = Σαχ.
ann.check.human.2 = Σαχ!
ann.check.human.3 = Κι αυτό είναι σαχ.
# The coach gives check.
ann.check.coach = Σαχ!
ann.check.coach.2 = Σαχ.
ann.check.coach.3 = Και σαχ!
# Once per game at levels 1-2, right after the coach's first check ({your} = the player's king).
ann.check.coach.first = Αυτό σημαίνει ότι {your} δέχεται επίθεση. Πρέπει να {your:pron_acc_short} βγάλεις από το σαχ.
ann.check.coach.first.2 = Σαχ σημαίνει ότι {your} δέχεται επίθεση. Μετακίνησέ {your:pron_acc}, κλείσε τον δρόμο ή πάρε το κομμάτι μου.
ann.double_check.coach = Διπλό σαχ! Δύο κομμάτια μου επιτίθενται ταυτόχρονα στον βασιλιά σου, άρα πρέπει να κινηθεί.
ann.double_check.coach.2 = Αυτό είναι διπλό σαχ: τώρα σε βοηθά μόνο μια κίνηση του βασιλιά.
ann.double_check.human = Διπλό σαχ! Δύο κομμάτια σου επιτίθενται ταυτόχρονα στον βασιλιά μου, άρα πρέπει να κινηθεί.
ann.double_check.human.2 = Διπλό σαχ! Τώρα μόνο μια κίνηση του βασιλιά μπορεί να με σώσει.
# The player checkmates the coach.
ann.mate.human.b1 = Σαχ ματ! Κέρδισες! Ο βασιλιάς μου δεν μπορεί να ξεφύγει.
ann.mate.human.b1.2 = Αυτό είναι ματ! Μπράβο, κέρδισες την παρτίδα!
ann.mate.human.b1.3 = Σαχ ματ! Ο βασιλιάς μου παγιδεύτηκε. Συγχαρητήρια!
ann.mate.human = Σαχ ματ. Καλά έπαιξες.
ann.mate.human.2 = Αυτό είναι ματ. Συγχαρητήρια.
ann.mate.human.3 = Σαχ ματ! Πολύ ωραία.
# The coach checkmates the player.
ann.mate.coach.b1 = Αυτό είναι ματ. Ο βασιλιάς σου δεν έχει διέξοδο.
ann.mate.coach.b1.2 = Σαχ ματ. Ο βασιλιάς σου δέχεται επίθεση και δεν μπορεί να ξεφύγει.
ann.mate.coach.b1.3 = Φοβάμαι πως αυτό είναι ματ. Ο βασιλιάς σου δεν μπορεί να γλιτώσει.
ann.mate.coach = Σαχ ματ.
ann.mate.coach.2 = Και αυτό είναι ματ.
ann.mate.coach.3 = Σαχ ματ, δυστυχώς.

# ---- Verdicts (the first sentence about a bad move) --------------------------------------------
ex.verdict.blunder.b1 = Ωχ! Αυτή η κίνηση χαρίζει κάτι.
ex.verdict.blunder.b1.2 = Προσοχή! Αυτή η κίνηση μπορεί να σου κοστίσει.
ex.verdict.blunder.b1.3 = Ωπ, μισό λεπτό. Αυτή η κίνηση έχει ένα πρόβλημα.
ex.verdict.blunder.b2 = Χμ, αυτή η κίνηση έχει ένα πρόβλημα.
ex.verdict.blunder.b2.2 = Αυτό είναι μεγάλο λάθος.
ex.verdict.blunder.b2.3 = Προσοχή, αυτή η κίνηση σου κοστίζει κάτι.
ex.verdict.blunder.b3 = Αυτό είναι σοβαρό λάθος.
ex.verdict.blunder.b3.2 = Η κίνηση {move} είναι πραγματικό λάθος.
ex.verdict.blunder.b3.3 = Αχ, η κίνηση {move} είναι μεγάλο λάθος.
ex.verdict.blunder.b4 = Το {move} είναι σοβαρό λάθος.
ex.verdict.blunder.b4.2 = Το {move} είναι σοβαρό σφάλμα.
ex.verdict.blunder.b4.3 = Φοβάμαι πως αυτό είναι σοβαρό λάθος.
ex.verdict.blunder.b5 = Το {move} είναι σοβαρό σφάλμα.
ex.verdict.blunder.b5.2 = Το {move} είναι σοβαρό λάθος.
ex.verdict.blunder.b5.3 = Το {move} είναι λάθος που κοστίζει ακριβά.
ex.verdict.blunder.b6 = Το {move} είναι σοβαρό σφάλμα.
ex.verdict.blunder.b6.2 = Το {move} είναι σοβαρό λάθος.
ex.verdict.blunder.b6.3 = {move}; Σοβαρό λάθος.
# A blunder that leaves the coach's threat standing (levels 1-2: the threat the engine found after the
# coach's last move is what the reply carries out).
ex.verdict.ignored.b1 = Ωχ! Δεν απάντησες στην απειλή μου.
ex.verdict.ignored.b1.2 = Προσοχή! Η απειλή μου ήταν ακόμα εκεί.
ex.verdict.ignored.b1.3 = Ωπ, μισό λεπτό. Ξέχασες την απειλή μου.
ex.verdict.ignored.b2 = Χμ, η απειλή μου ήταν ακόμα εκεί.
ex.verdict.ignored.b2.2 = Άφησες την απειλή μου χωρίς απάντηση.
ex.verdict.ignored.b2.3 = Προσοχή, δεν απάντησες στην απειλή μου.
ex.verdict.mistake.b3 = Αυτή δεν είναι καλή κίνηση.
ex.verdict.mistake.b3.2 = Χμ, η κίνηση {move} έχει ένα πρόβλημα.
ex.verdict.mistake.b3.3 = Αυτό είναι λάθος.
ex.verdict.mistake.b4 = Το {move} είναι λάθος.
ex.verdict.mistake.b4.2 = Το {move} δεν είναι καλό.
ex.verdict.mistake.b4.3 = Αυτό είναι λάθος.
ex.verdict.mistake.b5 = Το {move} είναι καθαρό λάθος.
ex.verdict.mistake.b5.2 = Το {move} είναι λάθος.
ex.verdict.mistake.b5.3 = Το {move} δεν είναι καλό.
ex.verdict.mistake.b6 = Το {move} είναι λάθος.
ex.verdict.mistake.b6.2 = {move}; Λάθος.
ex.verdict.mistake.b6.3 = Όχι το {move}.
# A dubious move (an inaccuracy; a costly move with nothing concrete to show while still better):
# only the better move is named ({best} is pointed at), never a scenario.
ex.verdict.inaccuracy.b3 = Όχι άσχημα, αλλά το {best} ήταν λίγο καλύτερο.
ex.verdict.inaccuracy.b3.2 = Το {best} ήταν λίγο πιο ακριβές.
ex.verdict.inaccuracy.b3.3 = Μια μικρή αστοχία: εδώ το {best} ήταν καλύτερο.
ex.verdict.inaccuracy.b4 = Ανακρίβεια: το {best} ήταν πιο ακριβές.
ex.verdict.inaccuracy.b4.2 = Μια μικρή ανακρίβεια. Το {best} ήταν λίγο καλύτερο.
ex.verdict.inaccuracy.b4.3 = Όχι ακριβώς η καλύτερη κίνηση: το {best} ήταν πιο ακριβές.
ex.verdict.inaccuracy.b5 = Το {move} δεν είναι ακριβές· το {best} ήταν ισχυρότερο.
ex.verdict.inaccuracy.b5.2 = Μικρή ανακρίβεια. Εγώ θα έπαιζα το {best}.
ex.verdict.inaccuracy.b5.3 = Το {best} ήταν πιο ακριβές από το {move}.
ex.verdict.inaccuracy.b6 = Το {move} είναι ανακριβές· {best}.
ex.verdict.inaccuracy.b6.2 = Ανακρίβεια. {best}.
ex.verdict.inaccuracy.b6.3 = Το {best} ήταν καλύτερο.
# Level 6, an inaccuracy at the bottom of its class (deeper searches often clear it): a hedged word.
ex.verdict.inaccuracy.maybe = Το {best} ίσως ήταν λίγο πιο ακριβές.
ex.verdict.inaccuracy.maybe.2 = Εγώ ίσως να έπαιζα το {best}.
# A dubious move that loses material (levels 3-6): the remark alone, never "a bit better" (at level 6
# under 6 points, the hedged word above unless a piece is lost).
ex.verdict.dubious = Αυτή η κίνηση μοιάζει αμφίβολη.
ex.verdict.dubious.2 = Αυτή η κίνηση φαίνεται αμφίβολη.
# Something good was missed (levels 1-2).
ex.verdict.missed.b1 = Μισό λεπτό! Σου ξέφυγε κάτι καλό.
ex.verdict.missed.b1.2 = Κοίτα ξανά! Υπήρχε κάτι καλύτερο.
ex.verdict.missed.b1.3 = Περίμενε, εκεί είχες μια ευκαιρία!
ex.verdict.missed.b2 = Εκεί έχασες μια ευκαιρία.
ex.verdict.missed.b2.2 = Χμ, υπήρχε κάτι καλύτερο.
ex.verdict.missed.b2.3 = Περίμενε, εκεί είχες μια εξαιρετική κίνηση.

