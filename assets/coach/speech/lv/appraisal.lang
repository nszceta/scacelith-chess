# Coach speech (Latvian): the appraisal after the game (src/coach/appraisal.cpp).
# Same keys and variants as assets/coach/speech/en/appraisal.lang (its header documents every placeholder).
#
# Always positive, never blaming. The coach says "tu"; the player's gender is unknown: finite verbs
# ("tu uzvarēji", "tu atradi", "tu paņēmi"), conditionals ("saglabātu") and impersonal phrases
# ("Labi nospēlēts", "Labi atrasts") only, never "tu esi uzvarējis", "esi gatavs".
# Forms from common.lang: move numbers are ordinals, "{n:ord_loc} gājienā" = "21. gājienā" (at move 21),
# "līdz {crit_no:ord_dat} gājienam" (until move 21), "{n:ord} gājiens" (move 21); "{acc:percent}" =
# "85%" (spoken "astoņdesmit pieci procenti"), "{acc:percent_gen} precizitāte" = "85% precizitāte"
# (spoken "astoņdesmit piecu procentu"); "{n:time_acc}" = "trīs reizes"; "{text:loc}" = a phase in
# the locative ("atklātnē", appraisal.phase.*.loc in common.lang); "{my:adj}" = the ending -s / -a.
# {level} is a level name in its nominative, inside „...” after a noun in the case ("līmenī „{level}”").
# {opening:def} is the opening's nominative, used only where Latvian needs a nominative (after a colon
# or as the subject / predicate).

# ---- Names used inside the lines ------------------------------------------------------------------
# Phases (glossary: they MUST stay "atklātne", "vidusspēle", "galotne", feminine; common.lang adds
# their gen / dat / acc / loc forms).
appraisal.phase.opening = atklātne
appraisal.phase.middlegame = vidusspēle
appraisal.phase.endgame = galotne
