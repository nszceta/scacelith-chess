# ---- Demonstration narration: one short line per move shown on the board ------------------------
# Levels 4-6: just the move.
demo.move = {move}.
demo.move.2 = {move}.
demo.move.3 = Tad {move}.
# Levels 1-3, the coach's moves.
demo.my.move = {my} iet uz {sq}.
demo.my.move.2 = Es pārvietoju {my:refl_acc} uz {sq}.
demo.my.move.3 = Tad {my} iet uz {sq}.
demo.my.take = Es paņemu {your:acc}.
demo.my.take.2 = {my} ņem {your:acc}.
demo.my.take.3 = Un es ņemu {your:acc}.
demo.my.check = {my} iet uz {sq}. Šahs.
demo.my.check.2 = Šahs ar {my:acc} uz {sq}.
demo.my.check.3 = {my} uz {sq}, šahs!
demo.my.mate = {my} iet uz {sq}. Mats.
demo.my.mate.2 = Un {my} uz {sq} ir mats.
demo.my.mate.3 = {my} uz {sq}. Tas ir mats.
# Levels 1-3, the coach's in-between move: a capture, a check or a quiet move played first while a
# bigger piece of the player's ({t1}) is attacked; the next move of the coach's takes it.
demo.my.first.take = Vispirms {my} ņem {your:acc}. {t1} var pagaidīt.
demo.my.first.take.2 = {my} vispirms ņem {your:acc}. {t1} niekur nepazudīs.
demo.my.first.check = {my} ņem {your:acc}, un tas ir šahs! {t1} var pagaidīt.
demo.my.first.check.2 = Vispirms {my} ar šahu ņem {your:acc}. {t1} niekur nepazudīs.
demo.my.first.check_move = Vispirms šahs ar {my:acc} uz {sq}. {t1} var pagaidīt.
demo.my.first.check_move.2 = {my} iet uz {sq}: vispirms šahs! {t1} niekur nepazudīs.
demo.my.first.move = Vispirms {my} iet uz {sq}. {t1} var pagaidīt.
demo.my.first.move.2 = Vispirms {my} uz {sq}. {t1} niekur nepazudīs.
# The piece that moves was attacked itself: it takes something before it can be taken.
demo.my.first.attacked = {my} ir apdraudēt{my:adj}, tāpēc {my:pron} vispirms ņem {your:acc}.
demo.my.first.attacked.2 = {my} ir apdraudēt{my:adj}: {my:pron} vispirms paķer {your:acc}.
# Levels 4-6, the same in-between move.
demo.first = Vispirms {move}: {t1} var pagaidīt.
demo.first.2 = Vispirms {move}. {t1} niekur nepazudīs.
# After the rewind when no takeback is offered: the coach's real move comes next.
demo.play_on = Tagad es izdarīšu savu gājienu.
demo.play_on.2 = Lūk, mans īstais gājiens.
demo.play_on.3 = Un tagad mans gājiens pa īstam.
# Levels 1-3, the player's moves (what they would play).
demo.your.move = Tu pārvietotu {your:refl_acc} uz {sq}.
demo.your.move.2 = Pieņemsim, ka tu pārvieto {your:refl_acc} uz {sq}.
demo.your.move.3 = Tad {your} iet uz {sq}.
demo.your.take = Tu paņemtu {my:acc}.
demo.your.take.2 = Tu ņem {my:acc} ar {your:refl_acc}.
demo.your.take.3 = Tad tu paņem {my:acc}.
demo.your.back = Tu ņem atpakaļ.
demo.your.back.2 = Tu ņem atpakaļ uz {sq}.
demo.your.back.3 = Un tu atbildi ar ņemšanu.
demo.your.king = Tavam karalim jāiet prom.
demo.your.king.2 = Karalim jāatkāpjas uz {sq}.
demo.your.king.3 = Tavs karalis bēg uz {sq}.
# Levels 4-6 (and 1-3 when the whole line is too long): the demonstration stops where the problem
# stands, and the coach points at what comes next ({t1} {t2} = the pieces that fall, pointed at;
# {reply} = the mating move, traced; the pieces where they stand at that moment).
ex.point.piece = Tagad {t1:acc} vairs nevar izglābt.
ex.point.piece.2 = Un {t1} ir zaudēt{t1:adj}.
ex.point.piece.3 = Tālāk krīt {t1}.
ex.point.two = Uzbrukums gan {t1:dat}, gan {t2:dat}: viena figūra kritīs.
ex.point.two.2 = Tagad es uzbrūku {t1:dat} un {t2:dat}. Abas figūras tu nevari izglābt.
