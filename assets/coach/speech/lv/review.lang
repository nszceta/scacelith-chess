threat.fork.b2.3 = {my} uzbrūk gan {t1:dat}, gan {t2:dat}. Glābt abus nebūs viegli.
# A pin the coach's move sets up (level 2).
threat.pin.b2 = {my} uz {sq} piesien {your:acc} pie {t1:gen}. Ja {your:pron} aiziet, es paņemu {t1:acc}.
threat.pin.b2.2 = Uzmanies: {my} piesien {your:acc}. Ja {your:pron} kustas, es paņemu {t1:acc}.
threat.pin.b2.3 = {your} ir piesiet{your:adj}: ja {your:pron} aiziet, {my} paņem {t1:acc}.
# Level 3: the position has one good move only (the engine's two best moves are far apart).
threat.only.b3 = Šī ir kritiska pozīcija: tikai viens gājiens ir patiešām labs. Nesteidzies.
threat.only.b3.2 = Uzmanies, šeit ir tikai viens labs gājiens. Vispirms apskati visu.
threat.only.b3.3 = Palēnini: šajā pozīcijā lielākā daļa gājienu ir kļūdaini.
threat.punish.b1 = Mans pēdējais gājiens bija kļūda. Vai vari mani sodīt?
threat.punish.b1.2 = Hmm, šķiet, es kļūdījos. Vai vari atrast manu kļūdu?

# ---- Takebacks ------------------------------------------------------------------------------------
# After the takeback is accepted, a hint (levels 1-2).
tb.hint.b1 = Šoreiz padomā par {your:refl_acc}.
tb.hint.b1.2 = Uzmani {your:refl_acc}.
tb.hint.king.b1 = Padomā par {your:refl_gen} drošību.
tb.hint.king.b1.2 = Vispirms paskaties uz {your:refl_acc}. Vai {your:pron} ir drošībā?
tb.hint.missed.b1 = Meklē figūras, ko vari paņemt par velti.
tb.hint.missed.b1.2 = Paskaties vērīgi: vai ir kaut kas, ko vari paņemt?
tb.hint.mate_missed.b1 = Paskaties uz manu karali. Vai vari tam pieteikt matu?
tb.hint.mate_missed.b1.2 = Vispirms izmēģini šahus. Varbūt ir mats!
tb.hint.general.b1 = Nesteidzies un paskaties uz visu galdiņu.
tb.hint.general.b1.2 = Mēģini atrast drošāku gājienu.
tb.hint.b3 = Pārbaudi, kurām tavām figūrām uzbrūk mana atbilde.
tb.hint.b3.2 = Paskaties, kam uzbruktu mana atbilde, pirms izdari gājienu.
# The retry.
tb.fixed.b1 = Daudz labāk!
tb.fixed.b1.2 = Jā, tā ir labāk!
tb.fixed.b1.3 = Labi, tā ir daudz labāk.
tb.fixed = Tā ir labāk.
tb.fixed.2 = Labāk.
tb.fixed.3 = Labs labojums.
# After a good retry of a move taken back for a fault with a named cause (levels 1-3), one line that
# names the habit; {theme} is a phrase from appraisal.lang (theme.*), no full stop.
tb.why.b1 = Atceries nākamajai reizei: {theme}.
tb.why.b1.2 = Labs ieradums: {theme}.
tb.why.b2 = Mācība: {theme}.
tb.why.b2.2 = Kas palīdzēja: {theme}.
tb.why.b3 = Vērts atcerēties: {theme}.
tb.why.b3.2 = Ieradums, ko veidot: {theme}.
tb.same = Atkal tas pats gājiens? Labi, paskatīsimies.
tb.same.2 = Tev patīk šis gājiens. Izspēlēsim to.
# The retry after a hint-only offer is the move the coach had in mind.
tb.found.b1 = Jā! Tieši par šo gājienu es domāju.
tb.found.b1.2 = Tu to atradi! Šis gājiens ir labāks.
tb.found = Tieši šo gājienu es biju iecerējis.
tb.found.2 = Tieši tā, tas ir tas.
# Levels 4-6, once per game: the level's takebacks are used up, so no offer this time (said
# where the offer would have been).
tb.none_left = Diemžēl šajā partijā gājienu atsaukt vairs nevar.
tb.none_left.2 = Šajā partijā tu vairs nevari atsaukt gājienus.

# ---- Trying the critical position again (levels 1-3) --------------------------------------------------
# The end card's "Try that position again": the board is set to the position before the game's biggest
# mistake and the player looks for a better move. {best} is the better move.
retry.task.b1 = Atgriezīsimies pie tā brīža. Vai vari atrast labāku gājienu?
retry.task.b1.2 = Lūk, pozīcija vēlreiz. Vai vari atrast labāku gājienu?
retry.task.b2 = Šī ir pozīcija pirms tavas lielās kļūdas. Atrodi labāku gājienu.
retry.task.b2.2 = Paskatīsimies uz to brīdi vēlreiz. Ko tu spēlētu tā vietā?
retry.task.b3 = Šī ir pozīcija pirms kritiskā gājiena. Atrodi labāko gājienu.
retry.task.b3.2 = Atpakaļ pie kritiskā brīža. Kurš gājiens ir labāks?
retry.again.b1 = Ne šis. Paskaties vēlreiz.
retry.again.b1.2 = Tas vēl nav tas. Mēģini vēlreiz.
retry.again.b2 = Ne šis. Paskaties uz visu galdiņu.
retry.again.b2.2 = Vēl ne. Mēģini citu gājienu.
retry.again.b3 = Ne šis. Paskaties, ko darītu mana atbilde.
retry.again.b3.2 = Vēl joprojām nav tas. Padomā par manu labāko atbildi.
retry.found.b1 = Jā! Tas ir labāks gājiens. Labi darīts!
retry.found.b1.2 = Tu to atradi! Tas ir daudz labāk.
retry.found.b2 = Jā, tas der. Labi darīts.
retry.found.b2.2 = Tā ir ideja. Labs darbs.
retry.found.b3 = Pareizi, tas turas. Labi darīts.
retry.found.b3.2 = Tieši tā. Labs atradums.
retry.reveal.b1 = Lūk, labākais gājiens: {best}. Skaties.
retry.reveal.b1.2 = Parādīšu: labāks bija {best}.
retry.reveal.b2 = Labāks gājiens bija {best}. Skaties.
retry.reveal.b2.2 = Lūk: {best}.
retry.reveal.b3 = Labākais gājiens bija {best}.
retry.reveal.b3.2 = {best} bija gājiens.
