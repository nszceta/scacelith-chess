# ---- Chapter 5: castling ---------------------------------------------------------------------------------------
lesson.castle.what = Rokāde ir īpašs gājiens, kas gādā par tava karaļa drošību. Karalis un tornis pārvietojas kopā.
lesson.castle.how = {@}Karalis paiet divus lauciņus torņa virzienā, un {@2}tornis pārlec pāri karalim uz tā otru pusi.
lesson.castle.ask = Vienmēr vispirms pieskaries karalim. Tagad tu: veic īso rokādi karaļa flangā.
lesson.castle.rook = Tā tu pārvieto tikai torni. Lai veiktu rokādi, pārvieto karali divus lauciņus torņa virzienā.
lesson.castle.long = Tā ir garā rokāde, arī atļauta! Šoreiz veic rokādi uz tuvākā torņa pusi.
lesson.castle.one = Viens lauciņš ir parasts karaļa gājiens. Rokādē karalis paiet divus.
lesson.castle.other = Lai veiktu rokādi, pārvieto karali par diviem lauciņiem pretī tornim, kas stāv uz {sq}.
lesson.castle.ok = Rokāde izdarīta! Tavs karalis ir paslēpts, un tavs tornis ir gatavs spēlei.
lesson.castle2.moved = Rokādi veikt nevar, ja tavs karalis vai šis tornis jau ir gājis.
lesson.castle2.attacked = Arī ne tad, kad tev ir šahs, vai ja tavs karalis šķērsotu apdraudētu lauciņu vai nonāktu uz tāda.
lesson.castle2.bishop = Mans laidnis uzbrūk lauciņam {sq}. Tāpēc rokāde uz šo pusi tagad ir aizliegta.
lesson.castle2.ask = Veic rokādi uz otru pusi.
lesson.castle2.other = Veic rokādi uz sava otra torņa pusi, dāmas flangā.
lesson.castle2.ok = Pareizi! Garā rokāde novieto tavu karali uz {sq}.
lesson.ep0.rule = Ņemšana garāmejot sākas ar dubultsoli. Divus lauciņus drīkst paiet tikai bandinieks, kas {@}vēl stāv savā vietā. Bandinieks, kas {@2}jau ir gājis, iet pa vienam.
lesson.ep0.ask = Pavirzi vienu no saviem bandiniekiem divus lauciņus uz priekšu.
lesson.ep0.moved = Šis bandinieks jau ir gājis, tāpēc var iet tikai vienu lauciņu. Izmanto bandinieku, kas vēl stāv savā vietā.
lesson.ep0.ok = Pareizi: divus lauciņus drīkst paiet tikai bandinieks no sākuma lauciņa.

# ---- Chapter 6: en passant ------------------------------------------------------------------------------------
# The Latvian term "ņemšana garāmejot" already means "taking in passing": the second sentence says
# what it means instead of glossing the French words.
lesson.ep.what = Vienu īpašu bandinieka ņemšanu sauc par ņemšanu garāmejot. Pretinieka bandinieku paņem brīdī, kad tas iet garām.
lesson.ep.watch = Skaties uz manu bandinieku: tas paiet divus lauciņus un nostājas tieši blakus tavējam.
lesson.ep.how = Tavs bandinieks var to paņemt tā, it kā tas būtu pagājis tikai vienu lauciņu: uz {sq}.
lesson.ep.now = Bet tikai tagad, ar šo gājienu. Ņem garāmejot!
lesson.ep.gone = Iespēja ir garām: ņemt garāmejot var tikai uzreiz. Pamēģināsim vēlreiz.
lesson.ep.ok = Ņemšana garāmejot! Mans bandinieks uz {sq} tiek noņemts.
lesson.ep2.old = Mans bandinieks uz {sq} jau kādu laiku stāv blakus tavējam. Ņemt to garāmejot ir par vēlu.
lesson.ep2.watch = Tagad skaties uz manu otru bandinieku.
lesson.ep2.ask = Blakus tavējam stāv divi mani bandinieki, bet tikai viens tikko pavirzījās par diviem lauciņiem. Paņem to garāmejot!
lesson.ep2.push = Tā tu tikai pavirzi savu bandinieku. Paņem bandinieku, kas tikko pavirzījās par diviem lauciņiem.
lesson.ep2.wrong = Meklē bandinieku, kas tikko izdarīja dubultsoli, un paņem to garāmejot.
lesson.ep2.hint = Mans bandinieks uz {sq} tikko pavirzījās par diviem lauciņiem. Paņem to garāmejot, uz {sq2}.
lesson.ep2.ok = Ņemšana garāmejot! Manu bandinieku uz {sq} nevarēja paņemt: iespēja bija zudusi.

# ---- Chapter 7: promotion -------------------------------------------------------------------------------------
lesson.promo.what = Kad bandinieks sasniedz pēdējo horizontāli, tas pārvēršas: kļūst par dāmu, torni, laidni vai zirgu.
lesson.promo.ask = Gandrīz vienmēr izvēlies dāmu. Pārvērt savu bandinieku tagad!
lesson.promo.under = Tā drīkst! Bet dāma ir spēcīgāka. Izvēlēsimies dāmu.
lesson.promo.under_ok = Labi. Tomēr lielākā daļa spēlētāju izvēlas dāmu.
lesson.promo.push = Pavirzi savu bandinieku līdz pēdējai horizontālei, uz {sq}.
lesson.promo.ok = Jauna dāma! Tev var būt pat divas dāmas vienlaikus.
lesson.promo2.ask = Bandinieks var pārvērsties arī ņemot, pa diagonāli. Paņem manu torni un iegūsti dāmu!
lesson.promo2.push = Arī tā pārvēršas, bet mans tornis sargā lauciņu {sq}. Skaties.
lesson.promo2.lost = Mans tornis paņēma tavu jauno figūru. Vispirms paņem manu torni.
lesson.promo2.wrong = Tā manu torni neņem. Tavs bandinieks ņem pa diagonāli, uz {sq}.
lesson.promo2.hint = Paņem manu torni ar savu bandinieku, uz {sq}: ņemot tas pārvēršas.
lesson.promo2.ok = Paņemts un pārvērsts! Bandinieks var izdarīt abus vienā gājienā.

# ---- Chapter 8: stalemate and draws -----------------------------------------------------------------------------
lesson.stale.what = Tagad ir mans gājiens. Manam karalim nav šaha, bet {@}visi lauciņi ap to ir apdraudēti.
lesson.stale.draw = Man nav neviena atļauta gājiena. Tas ir pats, un partija beidzas neizšķirti.
lesson.stale2.ask = Kad tev ir uzvaroša pozīcija, uzmanies no pata. Piesaki man matu vienā gājienā, bez pata!
lesson.stale2.wrong = Atrodi šahu, pēc kura manam karalim nepaliek neviena lauciņa. Uzmanies: kluss gājiens var radīt patu.
lesson.stale2.king = Tavs karalis jau kontrolē lauciņus {sq} un {sq2}. Atstāj to turpat un izmanto dāmu.
lesson.stale2.hint = Tavs karalis kontrolē lauciņus {sq} un {sq2}. Pieteic šahu pa pēdējo horizontāli, un manam karalim nebūs kur iet.
lesson.stale2.why = Redzi? Manam karalim ir {@}šahs un nav neviena brīva lauciņa: tas ir mats. Bez šaha tas būtu pats.
lesson.stale2.ok = Mats! Vienmēr atstāj pretinieka karalim kādu gājienu, ja vien tu nepiesaki matu.
lesson.draws.kings = Citi neizšķirti: kad neviens nevar pieteikt matu, piemēram, ja uz galdiņa palikuši tikai abi karaļi, partija beidzas neizšķirti.
lesson.draws.agree = Spēlētāji var arī vienoties par neizšķirtu.
lesson.draws.repeat = Neizšķirtu var panākt arī tad, ja pozīcija atkārtojas trīs reizes vai ja piecdesmit gājienos nav bijis nevienas ņemšanas un neviena bandinieka gājiena.

# ---- Chapter 9: before you move (the safety habit) ---------------------------------------------------------------
lesson.before.habit = Pirms katra gājiena apstājies un paskaties. Stipri spēlētāji tā dara katru reizi.
lesson.before.last = Pirmais jautājums: ko izdarīja mans pēdējais gājiens? Skaties.
lesson.before.threat = {my} uzbrūk {your:dat}. Tas ir drauds.
lesson.before.safe = Ar aiziešanu nepietiek. Arī jaunajam lauciņam jābūt drošam.
lesson.before.dodge.ask = Pārvieto savu zirgu uz drošu lauciņu.
lesson.before.dodge.still = Tavam zirgam joprojām uzbrūk. Skaties.
lesson.before.dodge.hint = Mani bandinieki sargā lauciņus {sq} un {sq2}. Izvēlies citu lauciņu.
lesson.before.dodge.ok = Droši! Tu pamanīji draudu un pārbaudīji lauciņu.
# A wrong move onto a guarded square ({my} guards {to}); the coach then takes the piece.
lesson.before.unsafe = Nē, ne uz {to}: {my} sargā to lauciņu. Skaties.
# Said after the coach took the piece, before the move is taken back.
lesson.before.lost = Tu zaudēji {your:acc}. Vispirms paskaties, tad ej.
lesson.before.again = Vēlreiz, vispirms mans gājiens. Skaties.
lesson.before.free.ask = Paskaties uz manu pēdējo gājienu. Vai vari kaut ko paņemt par velti?
lesson.before.free.missed = Vēlreiz paskaties uz {my:acc}. Kas var paņemt {my:pron_acc}?
lesson.before.free.hint = {my} nav aizsarga. Tavs {@}bandinieks var paņemt {my:pron_acc}.
lesson.before.free.ok = Jā! Mans laidnis bija brīvs. Vienmēr skaties uz manu pēdējo gājienu.
lesson.before.check.ask = Pieteic man šahu no lauciņa, ko es nevaru ņemt.
lesson.before.check.wrong = Tas nav šahs. Atrodi šahu no droša lauciņa.
lesson.before.check.hint = {my} sargā lauciņu {sq}. Pieteic šahu no droša lauciņa.
lesson.before.check.ok = Labs šahs! Tava dāma tur ir droša.
lesson.before.done = Pieradini: vispirms paskaties, tad ej.

# ---- Chapter 10: the opening ------------------------------------------------------------------------------------
lesson.opening.what = Atklātne ir partijas sākums. Palīdz daži vienkārši noteikumi.
lesson.opening.goals = {@}Ieņem centru, {@2}attīsti zirgus un laidņus un {@3}agri veic rokādi.
lesson.opening.centre = Četri lauciņi {@}vidū ir centrs.
lesson.opening.pawn.ask = Novieto bandinieku centrā: divus lauciņus uz priekšu.
lesson.opening.pawn.one = Nav slikti, bet divi lauciņi ieņem vairāk centra.
lesson.opening.pawn.knight = Zirgi nāks drīz. Vispirms bandinieks centrā.
lesson.opening.pawn.wrong = Ej ar bandinieku, kas stāv pirms karaļa vai pirms dāmas.
lesson.opening.pawn.ok = Labi! Tavs bandinieks ieņem vietu centrā.
lesson.opening.queen = Dāmu neizved par agru: manas figūras to dzītu.
lesson.opening.knight.ask = Izved zirgu uz centra pusi.
lesson.opening.rim = Zirgs malā sasniedz maz lauciņu. Lec uz centra pusi.
lesson.opening.bishop = Attīstība, labi! Bet šoreiz zirgs.
lesson.opening.knight.ok = Labi! No turienes tavs zirgs vēro centru.
lesson.opening.later = Pēc dažiem gājieniem: tavs zirgs un {@}laidnis ir ārā.
lesson.opening.twice = Bez laba iemesla nevirzi to pašu figūru divreiz.
lesson.opening.castle.ask = Ceļš ir brīvs. Veic rokādi un noved karali drošībā.
lesson.opening.castle.wrong = Tavs karalis ir gatavs. Veic rokādi tagad, kamēr ceļš ir brīvs.
lesson.opening.castle.ok = Rokāde veikta! Tavs karalis ir drošībā, un tornis iesaistās spēlē.
lesson.opening.done = Centrs, figūras, rokāde: tas ir labs sākums katrai partijai.

# ---- Review: shown in a different order, no explanations ------------------------------------------
lesson.review.start = Īss atkārtojums, šoreiz citā secībā. Es neskaidroju: tu man parādi.
lesson.review.promo.ask = Pārvērt šo bandinieku.
lesson.review.promo.ok = Labi: jauna dāma un šahs!
lesson.review.check.ask = Tavam karalim ir šahs. Tiec no tā vaļā.
lesson.review.check.ok = Šaha vairs nav. Labi.
lesson.review.castle.ask = Veic rokādi uz to pusi, kur tā ir atļauta.
lesson.review.castle.other = Tā nav rokāde. Veic rokādi uz to pusi, kur tā ir atļauta.
lesson.review.castle.ok = Rokāde izdarīta, drošajā pusē!
lesson.review.ep.ask = Paņem manu bandinieku garāmejot.
lesson.review.ep.ok = Ņemšana garāmejot! Atmiņa nav pievīlusi.
lesson.review.mate.ask = Piesaki man matu vienā gājienā.
lesson.review.mate.ok = Mats! Atkārtojums pabeigts.

# ---- Chapter 11: how our games work ------------------------------------------------------------------------------
lesson.talk.rules = Tagad tu zini visus šaha noteikumus. Labi padarīts!
lesson.talk.real = Ļauj man pastāstīt, kā notiks mūsu partijas.
lesson.talk.no_clock = Ar mani nav ne pulksteņa, ne reitinga. Domā tik ilgi, cik tev vajag.
lesson.talk.touch = Figūra, kurai pieskaries, ir jāpārvieto, tāpēc vispirms paskaties, tad pieskaries.
lesson.talk.handshake = Partijas sākas un beidzas ar rokasspiedienu. Tas nozīmē: laba partija, un paldies.
lesson.talk.polite = Neatkarīgi no rezultāta saglabā pieklājību un nekad netraucē pretiniekam domāt.
lesson.talk.help = Mūsu partijās es tev palīdzēšu. Ja kāda tava figūra tiek apdraudēta vai paliek bez aizsardzības, es to pateikšu.
lesson.talk.help_back = Pēc lielas kļūdas es parādīšu, kāpēc, un piedāvāšu atsaukt tavu gājienu.
lesson.talk.help_skip = Un ja es runāju par daudz, nospied atstarpes taustiņu: es apklusīšu.
lesson.talk.next = Kad gribēsi, spēlē „Pirmie soļi”. Es spēlēšu saudzīgi.
lesson.talk.welcome = Laipni lūdzam šaha pasaulē! Paspiedīsim rokas.
