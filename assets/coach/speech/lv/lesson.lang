lesson.title.safety = Droša un nedroša ņemšana
lesson.title.check = Šahs
lesson.title.mate = Mats
lesson.title.castling = Rokāde
lesson.title.en_passant = Ņemšana garāmejot
lesson.title.promotion = Bandinieka pārvēršana
lesson.title.draws = Pats un neizšķirts
lesson.title.before_move = Pirms gājiena
lesson.title.opening = Atklātne
lesson.title.review = Īss atkārtojums
lesson.title.etiquette = Kā notiek mūsu partijas

