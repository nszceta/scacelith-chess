# Coach speech (Latvian): the rules lesson (level 0, src/coach/lesson.cpp).
# Same keys and variants as assets/coach/speech/en/lesson.lang.
#
# Placeholders: {your} / {my} = a piece of the player / of the coach ("tavs tornis", "mans zirgs"),
# with the forms of common.lang ({my:acc}, {my:dat}, {my:gen}, {your:pron}, {your:pron_acc},
# {your:this}, piesiet{your:adj} ...). When the player acts with their own piece the imperative takes
# "savs": {your:refl_acc} = "savu torni" ("Izmanto savu torni", never "tavu").
# {sq}, {sq2}, {to}, {esc} = squares, after a preposition ("uz {sq}") or the noun "lauciņš"
# ("lauciņam {sq}"), never with an ending; {move} = a move. {@}, {@2}, {@3} are invisible marks:
# the coach points at something while saying the word right after the mark.
# A ".spoken" key is what the voice says instead (here: letters said with their Latvian names).
# The player's gender is unknown: no participle or adjective agrees with the player ("tev bija
# uzvaroša pozīcija", not "tu biji uzvarējis"). Files = vertikāles, ranks = horizontāles, back rank =
# pēdējā horizontāle; to block a check = aizsegties.

# ---- Chapter titles (said inside "Turpināsim ar tēmu „{chapter}”.") ----------------------------------
# Capitalised nominatives: event.lesson.* (events.lang) quotes them after "tēma".
lesson.title.welcome = Šaha galdiņš
lesson.title.pieces = Kā iet figūras
lesson.title.safety = Droša un nedroša ņemšana
lesson.title.check = Šahs
lesson.title.mate = Mats
lesson.title.castling = Rokāde
lesson.title.en_passant = Ņemšana garāmejot
lesson.title.promotion = Bandinieka pārvēršana
lesson.title.draws = Pats un neizšķirts
lesson.title.before_move = Pirms gājiena
lesson.title.opening = Atklātne
lesson.title.etiquette = Īstas partijas: reitings, pulkstenis un pieklājība

