# Coach speech (Vietnamese): the rules lesson (level 0, src/coach/lesson.cpp).
# Same keys and variants as assets/coach/speech/en/lesson.lang.
#
# Placeholders: {your} / {my} = a piece of the player / of the coach ("con Xe của bạn", "con Mã của
# tôi", common.lang); "nó" is "it" for any piece. {sq}, {sq2}, {to}, {esc} = squares, always after
# the noun "ô" ("ô {sq}"); {move} = a move. {@}, {@2}, {@3} are invisible marks: the coach points
# while saying the word right after the mark.
# Pieces written by hand are capitalised (Vua, Hậu, Xe, Tượng, Mã, Tốt). Numbers and ranks are
# written in words ("hàng thứ bảy"), so only the lines with a file letter or the letter L need a
# ".spoken" line (h = "hát", L = "e-lờ", as Vietnamese spells Latin letters; a = "A" in capital, which
# the voice says as a full letter after a vowel, as file.a.spoken does).

# ---- Chapter titles (said inside "Chúng ta tiếp tục với phần {chapter}.") ------------------------------
# Lowercase noun phrases (see event.lesson.* in events.lang).
lesson.title.welcome = bàn cờ
lesson.title.pieces_lines = cách đi của Xe, Tượng và Hậu
lesson.title.pieces_steps = cách đi của Vua, Mã và Tốt
lesson.title.values_setup = giá trị các quân và những nước đi đầu tiên
lesson.title.safety = bắt quân an toàn và không an toàn
lesson.title.check = nước chiếu
lesson.title.mate = chiếu hết
lesson.title.castling = nhập thành
lesson.title.en_passant = bắt tốt qua đường
lesson.title.promotion = phong cấp
lesson.title.draws = hết nước đi và hòa cờ
lesson.title.before_move = trước khi đi quân
lesson.title.opening = khai cuộc
lesson.title.review = ôn tập nhanh
lesson.title.etiquette = cách các ván của chúng ta diễn ra

# ---- Lines every exercise uses ------------------------------------------------------------------------
# After the coach demonstrated the solution.
lesson.now_you = Giờ bạn thử nhé.
lesson.now_you.2 = Bây giờ đến lượt bạn.
lesson.now_you.3 = Đến bạn.
# Another wrong move after the demonstration.
lesson.almost = Suýt nữa thôi! Hãy đi nước mà tôi đã chỉ cho bạn.
lesson.almost.2 = Chưa hẳn. Hãy thử nước đi tôi đã làm mẫu.
lesson.almost.3 = Gần được rồi. Hãy nhớ lại điều tôi vừa chỉ cho bạn.
# A wrong move without a line of its own.
lesson.try_again = Không phải vậy. Thử lại nhé.
lesson.try_again.2 = Không phải nước này. Thử lần nữa nào.
lesson.try_again.3 = Chúng ta thử thêm lần nữa nhé.
lesson.use_your = Hãy dùng {your}.
lesson.use_your.2 = Thử bằng {your} xem.
lesson.watch = Xem này.
lesson.like_this = Như thế này.
lesson.and_back = Và quay lại.
# A check that is not checkmate (the coach then shows the escape).
lesson.check_escape = Chiếu, nhưng Vua của tôi thoát sang ô {esc}.
lesson.check_takes = Chiếu, nhưng Vua của tôi chỉ việc bắt {your}.
lesson.check_block = Chiếu, nhưng tôi có thể đưa một quân vào chặn.
lesson.stalemate = Hết nước đi! Vua của tôi không thể di chuyển, mà cũng không bị chiếu. Ván cờ hòa, dù bạn đang thắng thế!

# ---- Why a move is not allowed (the coach points at the piece or square in question) ----------------
# {sq} = the square in question, {my} = the coach's piece that attacks, pins, blocks or gives
# check, {your} = the piece the player tried to move.
why.KingIntoCheck = Không được đi vào ô {sq}: {my} đang tấn công ô đó. Vua không bao giờ được tự đi vào chỗ nguy hiểm.
why.PathBlocked = Có quân đang chắn {@}đường: các quân cờ không nhảy qua được, trừ con Mã.
why.WrongGeometry = {your} không đi như vậy.
why.MustAnswerCheck = Bạn đang bị {@}chiếu: phải thoát chiếu trước đã.
why.CastlingThroughCheck = Vua của bạn sẽ phải đi qua ô {sq}, mà {my} đang tấn công ô đó.
why.CastlingNoRights = Con Vua hoặc con Xe đó đã di chuyển rồi: không thể nhập thành.
why.CastlingBlocked = Muốn nhập thành, các ô giữa Vua và Xe phải trống.
why.CastlingOutOfCheck = Bạn không thể nhập thành khi đang bị chiếu.
why.PawnForwardBlocked = Tốt không bắt thẳng về phía trước được: ô đó đã bị {@}chặn.
why.LeavesKingInCheck = {your} đang bị ghim: nếu di chuyển nó, Vua của bạn sẽ bị {my} tấn công.
why.OwnPieceOnTarget = Bạn không thể đi vào ô có quân của chính mình.
why.PawnCaptureNeedsVictim = Tốt chỉ đi chéo khi bắt quân.
why.EnPassantExpired = Chỉ được bắt tốt qua đường ngay sau khi con Tốt kia vừa tiến hai ô.
why.NotYourTurn = Chờ đã: đang là lượt của tôi.

# ---- Chapter 0: welcome and the board -------------------------------------------------------------------
lesson.welcome.hello = Xin chào! Tôi là huấn luyện viên của bạn. Chúng ta cùng học luật cờ vua nhé, từng bước nhỏ một.
lesson.welcome.board = Đây là bàn cờ: sáu mươi tư ô sáng và tối, gồm tám hàng, mỗi hàng tám ô.
lesson.welcome.light = Ô ở góc phía tay {@}phải của bạn luôn là ô sáng màu. Hãy nhớ: bên phải là ô sáng.
lesson.welcome.files = Các đường dọc được gọi là cột. Mỗi cột mang một chữ cái, từ {@}a đến {@2}h.
lesson.welcome.files.spoken = Các đường dọc được gọi là cột. Mỗi cột mang một chữ cái, từ {@}A đến {@2}hát.
lesson.welcome.ranks = Các đường ngang được gọi là hàng. Mỗi hàng mang một con số, từ {@}một đến {@2}tám, bắt đầu từ phía bạn.
lesson.welcome.square = Tên của mỗi ô gồm chữ cái trước, con số sau. Ô này là ô {sq}.
lesson.welcome.square2 = Còn ô này là ô {sq}.
lesson.welcome.kings = Đây là hai con Vua. Vua của bạn ở ô {sq}, Vua của tôi ở ô {sq2}.
lesson.welcome.ask = Đến lượt bạn: hãy đi Vua lên phía trước một ô, đến ô {sq}.
lesson.welcome.wrong = Đó là ô {to}. Chúng ta cần ô {sq}: chữ e, số hai.
lesson.welcome.ok = Tuyệt. Vua của bạn đang ở ô {sq}.

# ---- Chapter 1: how the pieces move and capture -----------------------------------------------------------
# Rook
lesson.rook.intro = Đây là {your}. Nó đi theo đường thẳng, dọc theo cột và hàng, xa bao nhiêu tùy ý.
lesson.rook.lines = Đi lên theo cột, {@}hoặc đi ngang theo hàng.
lesson.rook.capture = Để bắt quân, một quân đi vào ô có quân {@}đối phương, và quân đó bị loại khỏi bàn cờ.
lesson.rook.ask = Hãy dùng Xe bắt {my}!
lesson.rook.short = Đúng hướng rồi! Cứ đi tiếp lên theo cột, đến tận {my}.
lesson.rook.rank = Đó là đi ngang theo hàng. {my} ở phía trên, theo cột.
lesson.rook.king = Đó là Vua của bạn. Hãy dùng {your}, ở trong góc.
lesson.rook.ok = Bắt được rồi! {my} bị loại khỏi bàn cờ.
# Pieces don't jump
lesson.jump.blocked = Các quân không thể nhảy qua quân khác. Con Tốt của bạn ở ô {sq} đang chắn đường của Xe.
lesson.jump.all = Tượng và Hậu cũng vậy: chúng không nhảy qua được các quân khác.
# Bishop
lesson.bishop.intro = Đây là {your}. Nó đi theo đường chéo, xa bao nhiêu tùy ý.
lesson.bishop.colour = Tượng luôn ở trên các ô cùng một màu.
lesson.bishop.ask = {my} đang ở trên đường chéo đó. Hãy bắt nó!
lesson.bishop.short = Đúng đường chéo rồi! Đi xa hơn nữa, đến tận {my}.
lesson.bishop.other = Đó là đường chéo kia. Hãy nhìn về phía {my}.
lesson.bishop.ok = Xuất sắc. Tượng rất thích những đường chéo dài.
# Queen
lesson.queen.intro = Đây là {your}, quân mạnh nhất. Nó đi như Xe và Tượng gộp lại.
lesson.queen.ask = Hãy tìm {my} và dùng Hậu bắt nó.
lesson.queen.wrong = Hậu của bạn có thể đến chỗ {my} chỉ trong một nước, theo đường chéo.
lesson.queen.ok = Giỏi lắm! Hãy giữ Hậu an toàn: nó rất có giá trị.
# King
lesson.king.intro = Vua chỉ đi một ô, theo bất kỳ hướng nào.
lesson.king.important = Vua là quân quan trọng nhất. Nếu Vua bị vây không còn lối thoát, ván cờ sẽ thua.
lesson.king.ask = Vua cũng có thể bắt quân. Hãy bắt {my}!
lesson.king.wrong = Vua của bạn đang ở ngay cạnh {my}. Hãy bước sang ô đó để bắt nó.
lesson.king.ok = Tốt lắm! Vua đi chậm, nhưng rất mạnh ở cự ly gần.
# Knight
lesson.knight.intro = Đây là {your}. Nó đi theo hình chữ L: hai ô thẳng, rồi một ô sang bên.
lesson.knight.intro.spoken = Đây là {your}. Nó đi theo hình chữ e-lờ: hai ô thẳng, rồi một ô sang bên.
lesson.knight.l = Như {@}thế này. Nó luôn đáp xuống một ô khác màu.
lesson.knight.jump = Mã là quân duy nhất có thể nhảy qua các quân khác.
lesson.knight.ask = Hãy dùng Mã bắt {my}!
lesson.knight.wrong = Đó đúng là một nước đi của Mã, nhưng không tới được {my}. Thử một hình chữ L khác xem.
lesson.knight.wrong.spoken = Đó đúng là một nước đi của Mã, nhưng không tới được {my}. Thử một hình chữ e-lờ khác xem.
lesson.knight.ok = Cú nhảy tuyệt vời!
# Pawn: moving
lesson.pawn.intro = Bây giờ là {your}. Nó đi thẳng về phía trước, mỗi lần một ô, và không bao giờ đi lùi.
lesson.pawn.first = Ở nước đi đầu tiên của nó, Tốt có thể đi một hoặc hai ô.
lesson.pawn.ask = Hãy đi Tốt lên phía trước hai ô.
lesson.pawn.one = Đó là một ô: hợp lệ, nhưng lần này hãy đi hai ô.
lesson.pawn.use = Hãy dùng con Tốt.
lesson.pawn.ok = Đúng rồi.
# Pawn: capturing
lesson.pawncap.blocked = Tốt của tôi chặn Tốt của bạn. Tốt không thể bắt thẳng về phía trước.
lesson.pawncap.diagonal = Nhưng Tốt bắt quân theo đường chéo, tiến lên một ô.
lesson.pawncap.ask = Hãy dùng Tốt bắt {my}.
lesson.pawncap.use = Hãy dùng {your}: nó bắt chéo về phía trước.
lesson.pawncap.ok = Chính xác! Đi thì đi thẳng, bắt thì bắt chéo.
# Values, set-up and the first moves
lesson.values.pawn = Mỗi quân có một giá trị tính bằng điểm. Một con Tốt đáng một điểm.
lesson.values.pieces = Mã hoặc {@}Tượng: ba điểm. {@2}Xe: năm điểm. {@3}Hậu: chín điểm.
lesson.values.king = Vua là vô giá: bạn không bao giờ được đem nó ra đổi.
lesson.values.trade = Đừng đổi quân lớn lấy quân nhỏ, trừ khi bạn được nhiều hơn mất.
lesson.values.two = Mã của bạn đang tấn công hai quân của tôi: ô {sq} và ô {sq2}. Không quân nào có gì bảo vệ.
lesson.values.ask = Hãy bắt quân có giá trị hơn!
lesson.values.small = Đó là một con Tốt, đáng một điểm. {my} cũng không được bảo vệ, và nó đáng chín điểm.
lesson.values.look = Hãy nhìn Mã của bạn đang tấn công quân nào, rồi bắt quân có giá trị hơn.
lesson.values.ok = Đúng rồi! Hậu đáng chín điểm. Khi có hai quân bị bỏ ngỏ, hãy bắt quân lớn hơn.
lesson.setup.corners = Mọi ván cờ đều bắt đầu như thế này: Xe ở các {@}góc, rồi đến {@2}Mã, rồi đến {@3}Tượng.
lesson.setup.queen = Hậu đứng trên ô cùng màu với mình: Hậu của bạn nằm trên một ô sáng.
lesson.setup.king = Vua đứng cạnh Hậu. Bên Trắng luôn đi trước.
lesson.first.ask = Bắt đầu ván cờ nào: hãy đi con Tốt trước mặt Vua lên hai ô, đến ô {sq}.
lesson.first.wrong = Đó cũng là một nước đi hợp lệ! Nhưng bây giờ, hãy đi con Tốt trước Vua đến ô {sq} nhé.
lesson.first.ok = Một nước đi đầu tiên tuyệt vời: nó mở đường cho Hậu và Tượng của bạn.
lesson.first.reply = Tôi đáp lại y như vậy. Bây giờ hãy ra một con Mã: nhảy từ ô {sq} đến ô {sq2}.
lesson.first.knight_wrong = Mã nhảy qua được các con Tốt. Thử từ ô {sq} đến ô {sq2} xem.
lesson.first.knight_ok = Tuyệt. Mã và Tượng được đưa ra sớm.

# ---- Chapter 2: safe and unsafe captures ---------------------------------------------------------------------
lesson.safety.defended = Một quân được bảo vệ khi có quân phe mình có thể bắt lại.
lesson.safety.pawn = Con {@}Tốt của tôi đang bảo vệ {my}.
lesson.safety.free = Nhưng {my} không có quân nào bảo vệ. Hậu của bạn đang tấn công cả hai quân.
lesson.safety.ask = Hãy bắt quân không được bảo vệ!
lesson.safety.watch = Xem chuyện gì xảy ra nhé.
lesson.safety.gave = Bạn đã đổi Hậu, đáng chín điểm, lấy Mã của tôi, đáng ba điểm.
lesson.safety.other = Thử quân còn lại xem.
lesson.safety.look = Hãy tìm quân không có gì bảo vệ.
lesson.safety.ok = Xuất sắc! Hãy luôn tự hỏi: quân đó có được bảo vệ không?
lesson.safety.pawns = Hậu của bạn đang tấn công hai con Tốt của tôi: ô {sq} và ô {sq2}.
lesson.safety.pawns_ask = Hãy bắt con Tốt mà bạn bắt được một cách an toàn.
lesson.safety.gave_pawn = Bạn đã đổi Hậu, đáng chín điểm, lấy một con Tốt, đáng một điểm.
lesson.safety.pawns_other = Tốt cũng có thể được bảo vệ. Thử con Tốt còn lại xem.
lesson.safety.pawns_ok = Đúng! Đừng bao giờ liều Hậu để bắt một con Tốt có quân bảo vệ.
lesson.safety.small = Giờ thì ngược lại. {my} có quân bảo vệ, nhưng Tốt của bạn đang tấn công nó.
lesson.safety.small_count = Nếu bạn bắt nó, con {@}Tốt của tôi sẽ bắt lại Tốt của bạn. Bạn mất một điểm và được chín điểm.
lesson.safety.small_ask = Hãy bắt Hậu của tôi bằng quân đúng!
lesson.safety.small_other = Hãy bắt nó bằng Tốt của bạn: quân rẻ nhất có thể bắt được.
lesson.safety.small_look = Tốt của bạn đang tấn công Hậu của tôi. Hãy bắt nó bằng con Tốt đó.
lesson.safety.small_ok = Đúng rồi! Quân nhỏ được phép bắt quân lớn, kể cả quân có bảo vệ: bạn mất một điểm và được chín điểm.
lesson.safety.count = Trước mỗi lần bắt quân, hãy đếm xem bạn được gì và có thể mất lại gì.

# ---- Chapter 3: check and getting out of check -----------------------------------------------------------------
lesson.danger.rank = Xe của tôi kiểm soát toàn bộ hàng thứ hai.
lesson.danger.rule = Vua không bao giờ được đi vào một ô mà ở đó nó có thể bị bắt.
lesson.danger.ask = Hãy đưa Vua đến một ô an toàn.
lesson.danger.ok = Đúng rồi. Ở đó Vua của bạn an toàn.
lesson.check.what = Xe của tôi đang tấn công Vua của bạn. Đó gọi là chiếu.
lesson.check.must = Khi bị chiếu, bạn phải thoát chiếu ngay lập tức.
lesson.check.ways = Có ba cách: {@}di chuyển Vua, {@2}chặn đường tấn công, hoặc {@3}bắt quân đang chiếu.
lesson.check.ask = Ở đây, hãy đưa Vua ra khỏi thế bị chiếu.
lesson.check.file = Ô {to} vẫn ở cùng cột với {@}Xe của tôi. Hãy ra khỏi cột đó.
lesson.check.ok = Đúng rồi: bạn đã thoát chiếu.
lesson.block.again = Lại chiếu nữa! Lần này Vua của bạn không còn ô nào để đi.
lesson.block.ask = Vậy hãy chặn đường tấn công: đặt một quân vào giữa.
lesson.block.queen = Chặn được rồi! Nhưng Xe của tôi có thể bắt Hậu của bạn. Hãy chặn bằng một quân ít giá trị hơn.
lesson.block.queen_ok = Cách này được. Hãy nhớ: chặn bằng quân ít giá trị nhất của bạn.
lesson.block.ok = Tuyệt. Hãy chặn bằng quân ít giá trị nhất của bạn.
lesson.capture.check = Hậu của tôi chiếu, ngay sát cạnh Vua của bạn.
lesson.capture.ask = Hãy bắt quân đang chiếu!
lesson.capture.king_ok = Đúng vậy! Hậu của tôi không có quân bảo vệ, nên Vua của bạn bắt được nó.
lesson.capture.knight_ok = Đúng vậy! Mã của bạn đã loại bỏ quân đang chiếu.
lesson.check.open.ask = Lại chiếu nữa! Lần này bạn thoát chiếu bằng cách nào cũng được.
lesson.check.open.king = Bạn đã đi Vua ra chỗ khác. Bạn cũng có thể chặn bằng một quân, hoặc dùng Mã bắt Xe của tôi.
lesson.check.open.block = Bạn đã chặn đường tấn công. Vua của bạn cũng có thể bước sang bên, hoặc Mã của bạn có thể bắt Xe của tôi.
lesson.check.open.take = Bạn đã bắt Xe của tôi, quân đang chiếu. Đi Vua hoặc chặn cũng được.
lesson.check.open.hint = Có ba cách: {@}di chuyển Vua, {@2}chặn trên cột, hoặc {@3}dùng Mã bắt Xe của tôi.

# ---- Chapter 4: checkmate ------------------------------------------------------------------------------------
lesson.mate1.what = Chiếu hết: Vua bị chiếu và không còn đường thoát. Như vậy là thắng ván cờ.
lesson.mate1.stuck = Vua của tôi bị kẹt phía sau {@}các con Tốt của chính mình.
lesson.mate1.ask = Hãy chiếu hết tôi trong một nước!
lesson.mate1.wrong = Gần đúng rồi! Hãy chiếu ở hàng cuối của tôi, nơi Vua của tôi không thể thoát.
lesson.mate1.ok = Chiếu hết! Đó là kiểu chiếu hết ở hàng cuối. Hãy nhớ lấy nhé!
lesson.mate1.king = Vua của bạn đang ở đúng chỗ. Hãy dùng Xe để chiếu.
lesson.mate1.why = Thấy chưa? Xe khống chế {@}toàn bộ hàng cuối của tôi, và {@2}các con Tốt của tôi lấp những ô phía trước Vua.
lesson.mate2.ask = Vua và Hậu của bạn phối hợp với nhau. Hãy chiếu hết tôi trong một nước.
lesson.mate2.wrong = Hãy tìm một nước chiếu khiến Vua của tôi không còn ô nào để đi.
lesson.mate2.ok = Chiếu hết! Vua của bạn bảo vệ Hậu, nên Vua của tôi không bắt được nó.
lesson.mate2.ok_rank = Chiếu hết ở hàng cuối! Vua của bạn kiểm soát mọi ô phía trước Vua của tôi.
lesson.mate2.king = Vua của bạn đang canh các ô cạnh Vua tôi. Hãy để nguyên nó và dùng Hậu.
lesson.mate2.half = Nước đó canh ô {sq}, nhưng Vua của tôi vẫn đi được đến ô {sq2}.
lesson.mate2.why = Thấy chưa? Hậu của bạn khống chế ô {sq} và ô {sq2}, còn Vua của bạn khống chế các ô phía trước Vua tôi. Vua của tôi hết đường thoát.
lesson.mate3.edge = Xe của bạn ở hàng thứ bảy giữ Vua của tôi ở mép bàn cờ.
lesson.mate3.ask = Bây giờ hãy dùng {your} để chiếu hết.
lesson.mate3.free = Chiếu, nhưng giờ hàng thứ bảy đã bỏ trống, và Vua của tôi thoát ra.
lesson.mate3.takes = Vua của tôi chỉ việc bắt Xe của bạn.
lesson.mate3.hint = Hãy chiếu ở hàng cuối bằng con Xe không canh hàng thứ bảy.
lesson.mate3.ok = Chiếu hết! Hai con Xe đã phối hợp như những bậc thang.
lesson.mate3.why = Thấy chưa? Một con Xe chặn {@}hàng thứ bảy, con kia chiếu ở {@2}hàng cuối. Vua của tôi hết đường thoát.
lesson.mate4.look = Chiếu chưa chắc đã là chiếu hết. Hãy xem chuyện gì xảy ra.
lesson.mate4.ask = Hãy chiếu Vua của tôi bằng Xe.
lesson.mate4.king = Vua của bạn cứ ở yên. Hãy dùng Xe để chiếu.
lesson.mate4.wrong = Đó không phải nước chiếu. Xe của bạn có thể tấn công Vua tôi từ hàng cuối.
lesson.mate4.ok = Đúng, chiếu rồi! Nhưng có phải chiếu hết không? Xem nhé.
lesson.mate4.after = Con Tốt của tôi ở ô {sq} đã chừa chỗ cho Vua. Trước khi mừng vì một nước chiếu, hãy đếm các ô Vua tôi còn dùng được.
lesson.mate5.ask = Có hai nước Xe chiếu, nhưng chỉ một nước là chiếu hết. Hãy đếm các ô của Vua tôi rồi chọn.
lesson.mate5.king = Vua của bạn đã khống chế ô {sq} và ô {sq2}. Hãy để nguyên nó và đi Xe.
lesson.mate5.wrong = Đó không phải nước chiếu. Hãy tìm nước Xe tấn công Vua của tôi.
lesson.mate5.hint = Vua của bạn khống chế ô {sq} và ô {sq2}. Nước Xe chiếu nào cũng lấy mất ô {sq3}?
lesson.mate5.why = Thấy chưa? Xe khống chế ô {sq}, Vua của bạn khống chế hai ô còn lại, và Vua của tôi bị kẹt.
lesson.mate5.ok = Chiếu hết! Bạn đã đếm các ô của Vua tôi: không còn ô nào.

# ---- Chapter 5: castling ---------------------------------------------------------------------------------------
lesson.castle.what = Nhập thành là một nước đi đặc biệt giúp Vua được an toàn. Vua và Xe cùng di chuyển.
lesson.castle.how = {@}Vua đi hai ô về phía một con Xe, và {@2}Xe nhảy sang phía bên kia của Vua.
lesson.castle.ask = Luôn chạm vào Vua trước. Giờ đến lượt bạn: hãy nhập thành ở cánh Vua.
lesson.castle.rook = Như vậy chỉ di chuyển Xe thôi. Để nhập thành, hãy đi Vua hai ô về phía Xe.
lesson.castle.long = Đó là nhập thành dài, cũng hợp lệ! Lần này, hãy nhập thành về phía con Xe gần hơn.
lesson.castle.one = Đi một ô là nước đi bình thường của Vua. Khi nhập thành, Vua đi hai ô.
lesson.castle.other = Để nhập thành, hãy đi Vua hai ô về phía con Xe ở ô {sq}.
lesson.castle.ok = Đã nhập thành! Vua của bạn đã được che chắn, và Xe sẵn sàng vào cuộc.
lesson.castle2.moved = Bạn không thể nhập thành nếu Vua hoặc con Xe đó đã từng di chuyển.
lesson.castle2.attacked = Cũng không được nhập thành khi đang bị chiếu, hoặc nếu Vua phải đi qua hay dừng ở một ô bị tấn công.
lesson.castle2.bishop = Tượng của tôi đang tấn công ô {sq}. Vì vậy lúc này không được nhập thành ở cánh này.
lesson.castle2.ask = Hãy nhập thành ở cánh bên kia.
lesson.castle2.other = Hãy nhập thành về phía con Xe còn lại, ở cánh Hậu.
lesson.castle2.ok = Chính xác! Nhập thành dài đưa Vua của bạn đến ô {sq}.
lesson.ep0.rule = Bắt tốt qua đường bắt đầu từ nước đi hai ô. Chỉ con Tốt {@}còn ở vị trí ban đầu mới được đi hai ô. Con Tốt {@2}đã đi rồi thì chỉ đi từng ô một.
lesson.ep0.ask = Hãy đi một con Tốt của bạn lên hai ô.
lesson.ep0.moved = Con Tốt đó đã đi rồi, nên chỉ đi được một ô. Hãy dùng con Tốt còn ở vị trí ban đầu.
lesson.ep0.ok = Đúng: chỉ con Tốt ở ô xuất phát mới được đi hai ô.

# ---- Chapter 6: en passant ------------------------------------------------------------------------------------
# The Vietnamese term "bắt tốt qua đường" already says "in passing": the line explains it in Vietnamese
# instead of quoting the French words.
lesson.ep.what = Tốt có một cách bắt quân đặc biệt gọi là bắt tốt qua đường: bắt con Tốt khi nó vừa đi ngang qua.
lesson.ep.watch = Hãy xem Tốt của tôi: nó đi hai ô và dừng ngay cạnh Tốt của bạn.
lesson.ep.how = Tốt của bạn có thể bắt nó như thể nó chỉ đi một ô: đến ô {sq}.
lesson.ep.now = Nhưng chỉ ngay bây giờ, ở nước này thôi. Hãy bắt tốt qua đường!
lesson.ep.gone = Cơ hội đã qua: chỉ được bắt tốt qua đường ngay lập tức. Chúng ta thử lại nhé.
lesson.ep.ok = Bắt tốt qua đường! Tốt của tôi ở ô {sq} bị loại khỏi bàn cờ.
lesson.ep2.old = Con Tốt của tôi ở ô {sq} đã đứng cạnh Tốt của bạn từ lâu. Giờ bắt tốt qua đường nó thì đã muộn.
lesson.ep2.watch = Giờ hãy xem con Tốt kia của tôi.
lesson.ep2.ask = Hai con Tốt của tôi đứng cạnh Tốt của bạn, nhưng chỉ một con vừa đi hai ô. Hãy bắt con đó qua đường!
lesson.ep2.push = Như thế chỉ là đẩy Tốt của bạn lên. Hãy bắt con Tốt vừa đi hai ô.
lesson.ep2.wrong = Hãy tìm con Tốt vừa đi hai ô, rồi bắt nó qua đường.
lesson.ep2.hint = Con Tốt của tôi ở ô {sq} vừa đi hai ô. Hãy bắt nó qua đường, đến ô {sq2}.
lesson.ep2.ok = Bắt tốt qua đường! Không thể bắt con Tốt của tôi ở ô {sq}: cơ hội đã qua.

# ---- Chapter 7: promotion -------------------------------------------------------------------------------------
lesson.promo.what = Khi Tốt đi đến hàng cuối cùng, nó được phong cấp: nó trở thành Hậu, Xe, Tượng hoặc Mã.
lesson.promo.ask = Hầu như lúc nào cũng nên chọn Hậu. Hãy phong cấp cho Tốt của bạn ngay!
lesson.promo.under = Được phép! Nhưng Hậu mạnh hơn. Chúng ta chọn Hậu nhé.
lesson.promo.under_ok = Cũng được. Nhưng hầu hết người chơi đều chọn Hậu.
lesson.promo.push = Hãy đẩy Tốt lên hàng cuối, đến ô {sq}.
lesson.promo.ok = Một Hậu mới! Bạn thậm chí có thể có hai Hậu cùng lúc.
lesson.promo2.ask = Tốt cũng có thể phong cấp khi bắt quân, theo đường chéo. Hãy bắt Xe của tôi và lên Hậu!
lesson.promo2.push = Cũng phong cấp được, nhưng Xe của tôi canh ô {sq}. Xem nhé.
lesson.promo2.lost = Xe của tôi đã bắt quân mới của bạn. Hãy bắt Xe của tôi trước.
lesson.promo2.wrong = Nước đó không bắt Xe của tôi. Tốt của bạn bắt chéo, ở ô {sq}.
lesson.promo2.hint = Hãy dùng Tốt bắt Xe của tôi, đến ô {sq}: nó vừa bắt vừa phong cấp.
lesson.promo2.ok = Vừa bắt vừa phong cấp! Một con Tốt làm được cả hai trong một nước.

# ---- Chapter 8: stalemate and draws -----------------------------------------------------------------------------
lesson.stale.what = Đến lượt tôi. Vua của tôi không bị chiếu, nhưng {@}mọi ô xung quanh nó đều bị tấn công.
lesson.stale.draw = Tôi không còn nước đi hợp lệ nào. Đó là thế hết nước đi, và ván cờ hòa.
lesson.stale2.ask = Khi đang thắng thế, hãy cẩn thận với thế hết nước đi. Hãy chiếu hết tôi trong một nước, mà không để tôi hết nước đi!
lesson.stale2.wrong = Hãy tìm nước chiếu khiến Vua của tôi không còn ô nào. Cẩn thận: một nước đi lặng có thể làm tôi hết nước đi.
lesson.stale2.king = Vua của bạn đã khống chế ô {sq} và ô {sq2}. Hãy để nguyên nó và dùng Hậu.
lesson.stale2.hint = Vua của bạn khống chế ô {sq} và ô {sq2}. Hãy chiếu tôi dọc hàng cuối, Vua của tôi sẽ không còn đường đi.
lesson.stale2.why = Thấy chưa? Vua của tôi bị {@}chiếu và không còn ô trống: đó là chiếu hết. Nếu không chiếu thì đã là hết nước đi.
lesson.stale2.ok = Chiếu hết! Hãy luôn để Vua đối phương còn một nước để đi, trừ khi bạn đang chiếu hết.
lesson.draws.kings = Các trường hợp hòa khác: khi không bên nào có thể chiếu hết, chẳng hạn chỉ còn hai con Vua, ván cờ hòa.
lesson.draws.agree = Hai người chơi cũng có thể thỏa thuận hòa.
lesson.draws.repeat = Lặp lại một thế cờ ba lần, hoặc năm mươi nước liền không có bắt quân hay đi Tốt, cũng cho phép hòa.

# ---- Chapter 9: before you move (the safety habit) ---------------------------------------------------------------
lesson.before.habit = Trước mỗi nước đi, hãy dừng lại và quan sát. Người chơi giỏi nào cũng làm vậy.
lesson.before.last = Câu hỏi đầu tiên: nước đi vừa rồi của tôi đã làm gì? Xem nhé.
lesson.before.threat = {my} đang tấn công {your}. Đó là một mối đe dọa.
lesson.before.safe = Chỉ tránh đi là chưa đủ. Ô mới cũng phải an toàn.
lesson.before.dodge.ask = Hãy đưa Mã của bạn đến một ô an toàn.
lesson.before.dodge.still = Mã của bạn vẫn đang bị tấn công. Xem nhé.
lesson.before.dodge.hint = Các Tốt của tôi bảo vệ ô {sq} và ô {sq2}. Hãy chọn ô khác.
lesson.before.dodge.ok = An toàn! Bạn đã thấy mối đe dọa, và đã kiểm tra ô đó.
# A wrong move onto a guarded square ({my} guards {to}); the coach then takes the piece.
lesson.before.unsafe = Không phải ô {to}: {my} bảo vệ ô đó. Xem nhé.
# Said after the coach took the piece, before the move is taken back.
lesson.before.lost = {your} mất rồi. Hãy nhìn trước, rồi mới đi.
lesson.before.again = Lại lần nữa, tôi đi trước. Xem nhé.
lesson.before.free.ask = Hãy nhìn nước đi cuối của tôi. Bạn có bắt được quân nào miễn phí không?
lesson.before.free.missed = Hãy nhìn {my} lần nữa. Quân nào bắt được nó?
lesson.before.free.hint = {my} không có quân bảo vệ. Con {@}Tốt của bạn có thể bắt nó.
lesson.before.free.ok = Đúng rồi! Tượng của tôi đã bị bỏ ngỏ. Hãy luôn nhìn nước đi cuối của tôi.
lesson.before.check.ask = Hãy chiếu tôi, từ một ô mà tôi không bắt được.
lesson.before.check.wrong = Đó không phải nước chiếu. Hãy tìm nước chiếu từ một ô an toàn.
lesson.before.check.hint = {my} bảo vệ ô {sq}. Hãy chiếu từ một ô an toàn.
lesson.before.check.ok = Nước chiếu hay! Hậu của bạn an toàn ở đó.
lesson.before.done = Hãy tập thành thói quen: nhìn trước, rồi mới đi.

# ---- Chapter 10: the opening ------------------------------------------------------------------------------------
lesson.opening.what = Khai cuộc là phần đầu của ván cờ. Vài quy tắc đơn giản sẽ giúp bạn.
lesson.opening.goals = {@}Chiếm trung tâm, {@2}đưa Mã và Tượng ra, và {@3}nhập thành sớm.
lesson.opening.centre = Bốn ô ở {@}giữa bàn cờ là trung tâm.
lesson.opening.pawn.ask = Hãy đặt một con Tốt vào trung tâm: đi lên hai ô.
lesson.opening.pawn.one = Không tệ, nhưng đi hai ô chiếm nhiều trung tâm hơn.
lesson.opening.pawn.knight = Mã sẽ ra sớm thôi. Trước tiên, một con Tốt ở trung tâm.
lesson.opening.pawn.wrong = Hãy dùng con Tốt trước Vua hoặc trước Hậu của bạn.
lesson.opening.pawn.ok = Tốt lắm! Con Tốt của bạn chiếm chỗ ở trung tâm.
lesson.opening.queen = Đừng đưa Hậu ra sớm: quân của tôi sẽ đuổi nó.
lesson.opening.knight.ask = Hãy đưa một con Mã ra, về phía trung tâm.
lesson.opening.rim = Mã ở mép bàn chỉ tới được vài ô. Hãy nhảy về phía trung tâm.
lesson.opening.bishop = Phát triển quân là tốt! Nhưng lần này, hãy đưa Mã.
lesson.opening.knight.ok = Tốt lắm! Từ đó Mã của bạn canh giữ trung tâm.
lesson.opening.later = Vài nước sau: Mã và {@}Tượng của bạn đã ra.
lesson.opening.twice = Đừng đi cùng một quân hai lần nếu không có lý do chính đáng.
lesson.opening.castle.ask = Đường đã thông. Hãy nhập thành để Vua an toàn.
lesson.opening.castle.wrong = Vua của bạn sẵn sàng rồi. Hãy nhập thành ngay, khi đường còn thông.
lesson.opening.castle.ok = Đã nhập thành! Vua của bạn an toàn, và Xe tham gia ván cờ.
lesson.opening.done = Trung tâm, quân, nhập thành: đó là khởi đầu tốt cho mọi ván cờ.
lesson.review.start = Ôn tập nhanh, lần này theo thứ tự khác. Tôi sẽ không giải thích: bạn tự chỉ cho tôi.
lesson.review.promo.ask = Hãy phong cấp con Tốt này.
lesson.review.promo.ok = Tốt lắm: một Hậu mới, và còn chiếu nữa!
lesson.review.check.ask = Vua của bạn đang bị chiếu. Hãy thoát chiếu.
lesson.review.check.ok = Đã thoát chiếu. Tốt.
lesson.review.castle.ask = Hãy nhập thành, ở cánh được phép.
lesson.review.castle.other = Đó không phải nhập thành. Hãy nhập thành ở cánh được phép.
lesson.review.castle.ok = Đã nhập thành, ở cánh an toàn!
lesson.review.ep.ask = Hãy bắt tốt qua đường con Tốt của tôi.
lesson.review.ep.ok = Bắt tốt qua đường! Bạn nhớ rồi.
lesson.review.mate.ask = Hãy chiếu hết tôi trong một nước.
lesson.review.mate.ok = Chiếu hết! Ôn tập xong.

# ---- Chapter 11: real games (rating, clock, touch-move, scoresheet, manners) ------------------------------------
lesson.talk.rules = Bây giờ bạn đã biết mọi luật cờ vua. Giỏi lắm!
lesson.talk.real = Để tôi kể cho bạn nghe các ván của chúng ta sẽ diễn ra như thế nào.
lesson.talk.no_clock = Khi chơi với tôi, không có đồng hồ và không tính điểm. Bạn cứ suy nghĩ bao lâu tùy thích.
lesson.talk.touch = Quân nào bạn chạm vào thì phải đi quân đó, nên hãy nhìn trước rồi mới chạm.
lesson.talk.handshake = Ván cờ bắt đầu và kết thúc bằng một cái bắt tay. Nó có nghĩa là: ván cờ hay, và cảm ơn bạn.
lesson.talk.polite = Dù thắng hay thua, hãy luôn lịch sự, và đừng bao giờ làm phiền đối thủ khi họ đang suy nghĩ.
lesson.talk.help = Trong các ván của chúng ta, tôi sẽ giúp bạn. Nếu quân nào của bạn bị tấn công hoặc không được bảo vệ, tôi sẽ báo.
lesson.talk.help_back = Sau một sai lầm lớn, tôi sẽ chỉ cho bạn lý do và đề nghị cho bạn đi lại nước đó.
lesson.talk.help_skip = Và nếu tôi nói nhiều quá, hãy bấm phím cách: tôi sẽ ngừng.
lesson.talk.next = Khi bạn sẵn sàng, hãy chơi “Bước đầu”. Tôi sẽ chơi nhẹ nhàng.
lesson.talk.welcome = Chào mừng bạn đến với cờ vua! Chúng ta bắt tay nhé.
