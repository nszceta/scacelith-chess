# Coach speech (French): the review of the player's moves (src/coach/review.cpp, review_explain.cpp).
# Same keys and variants as assets/coach/speech/en/review.lang (its header documents every placeholder).
#
# Register: the coach says "tu"; the coach is male. The player's gender is unknown: no adjective or
# participle agrees with the player ("tu gagnais", never "tu étais gagnant").
# Pieces ({your} {my} {your2} {my2} {t1} {t2}) carry their possessive ("ton cavalier", "ma tour").
# Grammar forms (common.lang): {x:il} = "il" / "elle", {x:le} = "le" / "la" (before a consonant or
# after a hyphen), {x:e} = the feminine ending of a participle or adjective that agrees with the
# piece ("cloué{your:e}" = "cloué" / "clouée"). Before a vowel, "l'" needs no form.
# Squares: "en {sq}" ("ton fou en e4"), "la case {sq}"; never "de {sq}" or "à {sq}".
# Moves are spoken in words ("cavalier prend en e cinq"): prefer "Il fallait jouer {best}",
# "Mieux valait {best}", "{move}, c'est..." to a long subject.
# Counted numbers: {m:move} "2 coups", {pts:point} "3 points", {n:time} "3 fois",
# {n:attacker} "2 attaquants", {n2:defender} "1 défenseur", {n:square} "3 cases".
# Never "nulle" alone in speech (it sounds like "nul"): "partie nulle", "la nulle".
# Typography: no-break space before : ; ? ! and typographic apostrophes, as the other French files.

# ---- Announcements (either side's move) -------------------------------------------------------
# The player gives check (levels 1-2: say what it means).
ann.check.human.b1 = Échec ! Mon roi est attaqué.
ann.check.human.b1.2 = Échec ! Tu attaques mon roi.
ann.check.human.b1.3 = Et c’est échec ! Mon roi doit s’échapper.
ann.check.human = Échec.
ann.check.human.2 = Échec !
ann.check.human.3 = Et c’est échec.
# The coach gives check.
ann.check.coach = Échec !
ann.check.coach.2 = Échec.
ann.check.coach.3 = Et échec !
# Once per game at levels 1-2, right after the coach's first check ({your} = the player's king).
ann.check.coach.first = Ça veut dire que j’attaque {your}. Tu dois {your:le} mettre à l’abri.
ann.check.coach.first.2 = Échec veut dire que j’attaque {your}. Bouge-{your:le}, bloque l’échec, ou prends ma pièce.
ann.double_check.coach = Échec double ! Deux de mes pièces attaquent ton roi à la fois : il doit bouger.
ann.double_check.coach.2 = C’est un échec double : seul un coup de roi peut te tirer d’affaire.
ann.double_check.human = Échec double ! Deux de tes pièces attaquent mon roi à la fois : il doit bouger.
ann.double_check.human.2 = Un échec double ! Seul un coup de roi peut encore me sauver.
# The player checkmates the coach.
ann.mate.human.b1 = Échec et mat ! Tu as gagné ! Mon roi ne peut pas s’échapper.
ann.mate.human.b1.2 = Échec et mat ! Bravo, tu as gagné la partie !
ann.mate.human.b1.3 = Échec et mat ! Mon roi est pris au piège. Félicitations !
ann.mate.human = Échec et mat. Bien joué.
ann.mate.human.2 = C’est mat. Félicitations.
ann.mate.human.3 = Échec et mat ! Très joli.
# The coach checkmates the player.
ann.mate.coach.b1 = Échec et mat. Ton roi n’a plus aucune issue.
ann.mate.coach.b1.2 = Échec et mat. Ton roi est attaqué et ne peut pas s’échapper.
ann.mate.coach.b1.3 = Hélas, c’est échec et mat. Ton roi ne peut plus s’enfuir.
ann.mate.coach = Échec et mat.
ann.mate.coach.2 = Et c’est mat.
ann.mate.coach.3 = Échec et mat, j’en ai bien peur.

