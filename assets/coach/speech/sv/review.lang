ex.verdict.blunder.b2.2 = Det är ett stort misstag.
ex.verdict.blunder.b2.3 = Se upp, det draget kostar dig något.
ex.verdict.blunder.b3 = Det är en blunder.
ex.verdict.blunder.b3.2 = {move} är ett riktigt misstag.
ex.verdict.blunder.b3.3 = Aj, {move} är ett stort misstag.
ex.verdict.blunder.b4 = {move} är en blunder.
ex.verdict.blunder.b4.2 = {move} är ett allvarligt misstag.
ex.verdict.blunder.b4.3 = Det är tyvärr en blunder.
ex.verdict.blunder.b5 = {move} är ett allvarligt misstag.
ex.verdict.blunder.b5.2 = {move} är en blunder.
ex.verdict.blunder.b5.3 = {move} är ett dyrt misstag.
ex.verdict.blunder.b6 = {move} är ett allvarligt fel.
ex.verdict.blunder.b6.2 = {move} är en blunder.
ex.verdict.blunder.b6.3 = {move}? En blunder.
# A blunder that leaves the coach's threat standing (levels 1-2: the threat the engine found after the
# coach's last move is what the reply carries out).
ex.verdict.ignored.b1 = Hoppsan! Du svarade inte på mitt hot.
ex.verdict.ignored.b1.2 = Akta dig! Mitt hot fanns fortfarande kvar.
ex.verdict.ignored.b1.3 = Oj, vänta. Du glömde bort mitt hot.
ex.verdict.ignored.b2 = Hmm, mitt hot fanns kvar.
ex.verdict.ignored.b2.2 = Du lämnade mitt hot obesvarat.
ex.verdict.ignored.b2.3 = Se upp, du svarade inte på mitt hot.
ex.verdict.mistake.b3 = Det är inget bra drag.
ex.verdict.mistake.b3.2 = Hmm, det finns ett problem med {move}.
ex.verdict.mistake.b3.3 = Det är ett misstag.
ex.verdict.mistake.b4 = {move} är ett misstag.
ex.verdict.mistake.b4.2 = {move} är inte bra.
ex.verdict.mistake.b4.3 = Det är ett misstag.
ex.verdict.mistake.b5 = {move} är ett klart misstag.
ex.verdict.mistake.b5.2 = {move} är ett misstag.
ex.verdict.mistake.b5.3 = {move} är inte bra.
ex.verdict.mistake.b6 = {move} är ett misstag.
ex.verdict.mistake.b6.2 = {move}? Ett misstag.
ex.verdict.mistake.b6.3 = Inte {move}.
# A dubious move (an inaccuracy; a costly move with nothing concrete to show while still better):
# only the better move is named ({best} is pointed at), never a scenario.
ex.verdict.inaccuracy.b3 = Inte dåligt, men {best} var lite bättre.
ex.verdict.inaccuracy.b3.2 = {best} var något mer exakt.
ex.verdict.inaccuracy.b3.3 = Ett litet snedsteg: {best} var bättre här.
ex.verdict.inaccuracy.b4 = Onoggrant: {best} var mer exakt.
ex.verdict.inaccuracy.b4.2 = En liten onoggrannhet. {best} var lite bättre.
ex.verdict.inaccuracy.b4.3 = Inte riktigt det bästa: {best} var noggrannare.
ex.verdict.inaccuracy.b5 = {move} är onoggrant; {best} var starkare.
ex.verdict.inaccuracy.b5.2 = Lite onoggrant. Jag hade spelat {best}.
ex.verdict.inaccuracy.b5.3 = {best} var mer exakt än {move}.
ex.verdict.inaccuracy.b6 = {move} är onoggrant; {best}.
ex.verdict.inaccuracy.b6.2 = Onoggrant. {best}.
ex.verdict.inaccuracy.b6.3 = {best} var bättre.
# Level 6, an inaccuracy at the bottom of its class (deeper searches often clear it): a hedged word.
ex.verdict.inaccuracy.maybe = {best} var kanske lite mer exakt.
ex.verdict.inaccuracy.maybe.2 = Jag hade kanske spelat {best}.
# A dubious move that loses material (levels 3-6): the remark alone, never "a bit better" (at level 6
# under 6 points, the hedged word above unless a piece is lost).
ex.verdict.dubious = Det draget ser tveksamt ut.
ex.verdict.dubious.2 = Det draget verkar tveksamt.
# Something good was missed (levels 1-2).
ex.verdict.missed.b1 = Oj, vänta! Du missade något bra.
ex.verdict.missed.b1.2 = Titta igen! Det fanns något bättre.
ex.verdict.missed.b1.3 = Vänta lite, där hade du en chans!
ex.verdict.missed.b2 = Där missade du en chans.
ex.verdict.missed.b2.2 = Hmm, det fanns något bättre.
ex.verdict.missed.b2.3 = Vänta, där hade du ett riktigt bra drag.

