# Coach speech (Swedish): the review of the player's moves (src/coach/review.cpp, review_explain.cpp).
# Same keys and variants as assets/coach/speech/en/review.lang (its header documents every placeholder).
#
# Register: the coach says "du" to the player and "jag" / "min" / "mitt" of himself. Swedish verbs,
# participles and adjectives never agree with a person's gender, so past tenses are fine ("du missade").
# Pieces ({your} {my} {your2} {my2} {t1} {t2}) carry their possessive ("din springare", "mitt torn").
# Forms of common.lang: {x:den} = den / det, the pronoun pointing back at the piece; {x:def} = the
# definite noun; {x:gen} = "din kungs"; {x:poss} + {x:bare} = "din bundna springare"; the endings of a
# word that agrees with the piece: oskydda{x:d_t} (oskyddad / oskyddat), bund{x:en_et} (bunden /
# bundet), säker{x:t} (säker / säkert), vär{x:d_t} (värd / värt). Words that never change are written
# plain (utsatt, inlåst, hängande, lätt, säkrare, billigare).
# Squares: "på {sq}", "till {sq}", "från {sq}", "rutan {sq}"; nothing is ever glued to a square, a move
# or a number. Two spoken numbers never stand side by side ("rutan {sq} angriper jag {n:time}").
# Counted numbers: {m:move} "3 drag", {pts:point} "2 poäng" (also a piece's value, where English says
# "worth {n}"), {n:time} "3 gånger", {n:square} "3 rutor", {n:attacker} / {n2:defender} (where English
# writes a bare {n} attackers or {n2:piece} defending). A bare {m} ("matt i {m}") or {n2} ("behöver
# {n2}", moves) says the neuter "ett", right for the implied "drag".
# Recapture is always "slå tillbaka"; "ta tillbaka" is only the takeback (noun "återtagning").
# Terms (glossary): blunder, misstag, onoggrannhet, tveksamt drag (dubious), gaffel / gaffla,
# dubbelangrepp, avdragsangrepp / avdrag, spett, bindning / binda / bunden, instängd, hänger / oskyddad,
# baslinjen (back rank; "bakersta raden" to a beginner), luft / flyktruta, bondens kvadrat,
# kapplöpning (race), fribonde, oppositionen, löparparet, bondeslutspel, slagväxling (the exchange
# sequence on a square), patt (sätta patt, stå patt), remi, schackmatt / sätta matt, stå på vinst.
# Praise: brilliant = briljant, great = utmärkt, excellent = mycket bra / exakt.
# Levels 1-2: short main clauses, everyday words; levels 5-6: terse club language.

# ---- Announcements (either side's move) -------------------------------------------------------
# The player gives check (levels 1-2: say what it means).
ann.check.human.b1 = Schack! Min kung är angripen.
ann.check.human.b1.2 = Schack! Du angriper min kung.
ann.check.human.b1.3 = Det är schack! Min kung måste komma ur schack.
ann.check.human = Schack.
ann.check.human.2 = Schack!
ann.check.human.3 = Och det är schack.
# The coach gives check.
ann.check.coach = Schack!
ann.check.coach.2 = Schack.
ann.check.coach.3 = Och schack!
# Once per game at levels 1-2, right after the coach's first check ({your} = the player's king).
ann.check.coach.first = Det betyder att {your} är angrip{your:en_et}. Du måste få {your:den} ur schack.
ann.check.coach.first.2 = Schack betyder att {your} är angrip{your:en_et}. Flytta {your:den}, ställ en pjäs emellan eller slå min pjäs.
ann.double_check.coach = Dubbelschack! Två av mina pjäser angriper din kung samtidigt, så den måste flytta.
ann.double_check.coach.2 = Det är dubbelschack: bara ett kungsdrag hjälper dig nu.
ann.double_check.human = Dubbelschack! Två av dina pjäser angriper min kung samtidigt, så den måste flytta.
ann.double_check.human.2 = Dubbelschack! Bara ett kungsdrag kan rädda mig nu.
# The player checkmates the coach.
ann.mate.human.b1 = Schackmatt! Du vann! Min kung kan inte fly.
ann.mate.human.b1.2 = Det är schackmatt! Bra gjort, du vann partiet!
ann.mate.human.b1.3 = Schackmatt! Min kung är instängd. Grattis!
ann.mate.human = Schackmatt. Bra spelat.
ann.mate.human.2 = Det är matt. Gratulerar.
ann.mate.human.3 = Schackmatt! Snyggt gjort.
# The coach checkmates the player.
ann.mate.coach.b1 = Det är schackmatt. Din kung har ingen väg ut.
ann.mate.coach.b1.2 = Schackmatt. Din kung är angripen och kan inte fly.
ann.mate.coach.b1.3 = Tyvärr är det schackmatt. Din kung kan inte komma undan.
ann.mate.coach = Schackmatt.
ann.mate.coach.2 = Och det är matt.
ann.mate.coach.3 = Schackmatt, tyvärr.

