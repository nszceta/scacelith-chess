# ---- Demonstration narration: one short line per move shown on the board ------------------------
# Levels 4-6: just the move.
demo.move = {move}.
demo.move.2 = {move}.
demo.move.3 = Sedan {move}.
# Levels 1-3, the coach's moves.
demo.my.move = {my} går till {sq}.
demo.my.move.2 = Jag flyttar {my} till {sq}.
demo.my.move.3 = Sedan går {my} till {sq}.
demo.my.take = Jag slår {your}.
demo.my.take.2 = {my} slår {your}.
demo.my.take.3 = Och jag tar {your}.
demo.my.check = {my} går till {sq}. Schack.
demo.my.check.2 = Schack med {my} på {sq}.
demo.my.check.3 = {my} till {sq}, schack!
demo.my.mate = {my} går till {sq}. Schackmatt.
demo.my.mate.2 = Och {my} till {sq} är schackmatt.
demo.my.mate.3 = {my} till {sq}. Det är schackmatt.
# Levels 1-3, the coach's in-between move: a capture, a check or a quiet move played first while a
# bigger piece of the player's ({t1}) is attacked; the next move of the coach's takes it.
demo.my.first.take = Först slår {my} {your}. {t1} kan vänta.
demo.my.first.take.2 = {my} slår {your} först. {t1} står kvar ändå.
demo.my.first.check = {my} slår {your}, och det är schack! {t1} kan vänta.
demo.my.first.check.2 = Först slår {my} {your}, med schack. {t1} står kvar ändå.
demo.my.first.check_move = Först schack med {my} på {sq}. {t1} kan vänta.
demo.my.first.check_move.2 = {my} går till {sq}: schack först! {t1} står kvar ändå.
demo.my.first.move = Först går {my} till {sq}. {t1} kan vänta.
demo.my.first.move.2 = {my} till {sq} först. {t1} står kvar ändå.
# The piece that moves was attacked itself: it takes something before it can be taken.
demo.my.first.attacked = {my} är angrip{my:en_et}, så {my:den} slår {your} först.
demo.my.first.attacked.2 = {my} är hota{my:d_t}: {my:den} passar på att ta {your} först.
# Levels 4-6, the same in-between move.
demo.first = {move} först: {t1} kan vänta.
demo.first.2 = Först {move}. {t1} står kvar ändå.
# After the rewind when no takeback is offered: the coach's real move comes next.
demo.play_on = Nu spelar jag mitt drag.
demo.play_on.2 = Här är mitt riktiga drag.
demo.play_on.3 = Och nu mitt drag på riktigt.
# Levels 1-3, the player's moves (what they would play). "Du skulle" is avoided: it also means
# "you should".
demo.your.move = Då flyttar du {your} till {sq}.
demo.your.move.2 = Säg att du flyttar {your} till {sq}.
demo.your.move.3 = Sedan går {your} till {sq}.
demo.your.take = Då slår du {my}.
demo.your.take.2 = Du slår {my} med {your}.
demo.your.take.3 = Sedan tar du {my}.
demo.your.back = Du slår tillbaka.
demo.your.back.2 = Du slår tillbaka på {sq}.
demo.your.back.3 = Och du slår tillbaka.
demo.your.king = Din kung måste flytta.
demo.your.king.2 = Kungen måste gå undan, till {sq}.
demo.your.king.3 = Din kung flyr till {sq}.
# Levels 4-6 (and 1-3 when the whole line is too long): the demonstration stops where the problem
# stands, and the coach points at what comes next ({t1} {t2} = the pieces that fall, pointed at;
# {reply} = the mating move, traced; the pieces where they stand at that moment).
ex.point.piece = Nu kan {t1} inte räddas.
ex.point.piece.2 = Och {t1} är förlora{t1:d_t}.
