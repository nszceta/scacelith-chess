ex.verdict.dubious = Bu hamle şüpheli görünüyor.
ex.verdict.dubious.2 = Bu hamle bana şüpheli geliyor.
# Something good was missed (levels 1-2).
ex.verdict.missed.b1 = Ah, dur! İyi bir şeyi kaçırdın.
ex.verdict.missed.b1.2 = Tekrar bak! Daha iyi bir şey vardı.
ex.verdict.missed.b1.3 = Dur bakalım, orada bir fırsatın vardı!
ex.verdict.missed.b2 = Orada bir fırsatı kaçırdın.
ex.verdict.missed.b2.2 = Hımm, daha iyi bir şey vardı.
ex.verdict.missed.b2.3 = Dur, orada harika bir hamlen vardı.

