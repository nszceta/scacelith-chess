ex.verdict.blunder.b1.2 = Dikkat! Bu hamle sana pahalıya mal olabilir.
ex.verdict.blunder.b1.3 = Ah, dur. Bu hamlede bir sorun var.
ex.verdict.blunder.b2 = Hımm, bu hamlede bir sorun var.
ex.verdict.blunder.b2.2 = Bu büyük bir hata.
ex.verdict.blunder.b2.3 = Dikkat, bu hamle sana bir şey kaybettiriyor.
ex.verdict.blunder.b3 = Bu büyük bir hata.
ex.verdict.blunder.b3.2 = {move} gerçekten hatalı bir hamle.
ex.verdict.blunder.b3.3 = Of, {move} büyük bir hata.
ex.verdict.blunder.b4 = {move} büyük bir hata.
ex.verdict.blunder.b4.2 = {move} ciddi bir hata.
ex.verdict.blunder.b4.3 = Maalesef bu büyük bir hata.
ex.verdict.blunder.b5 = {move} ciddi bir hata.
ex.verdict.blunder.b5.2 = {move} büyük bir hata.
ex.verdict.blunder.b5.3 = {move} pahalıya mal olan bir hata.
ex.verdict.blunder.b6 = {move} ağır bir hata.
ex.verdict.blunder.b6.2 = {move} büyük bir hata.
ex.verdict.blunder.b6.3 = {move}? Büyük hata.
# A blunder that leaves the coach's threat standing (levels 1-2: the threat the engine found after the
# coach's last move is what the reply carries out).
ex.verdict.ignored.b1 = Hay aksi! Tehdidime cevap vermedin.
ex.verdict.ignored.b1.2 = Dikkat! Tehdidim hâlâ duruyordu.
ex.verdict.ignored.b1.3 = Ah, dur. Tehdidimi unuttun.
ex.verdict.ignored.b2 = Hımm, tehdidim hâlâ duruyordu.
ex.verdict.ignored.b2.2 = Tehdidimi cevapsız bıraktın.
ex.verdict.ignored.b2.3 = Dikkat, tehdidime cevap vermedin.
ex.verdict.mistake.b3 = Bu iyi bir hamle değil.
ex.verdict.mistake.b3.2 = Hımm, {move} hamlesinde bir sorun var.
ex.verdict.mistake.b3.3 = Bu bir hata.
ex.verdict.mistake.b4 = {move} bir hata.
ex.verdict.mistake.b4.2 = {move} iyi değil.
ex.verdict.mistake.b4.3 = Bu bir hata.
ex.verdict.mistake.b5 = {move} açık bir hata.
ex.verdict.mistake.b5.2 = {move} bir hata.
ex.verdict.mistake.b5.3 = {move} iyi değil.
ex.verdict.mistake.b6 = {move} hatalı.
ex.verdict.mistake.b6.2 = {move}? Hata.
ex.verdict.mistake.b6.3 = {move} olmaz.
# A dubious move (an inaccuracy; a costly move with nothing concrete to show while still better):
# only the better move is named ({best} is pointed at), never a scenario.
ex.verdict.inaccuracy.b3 = Fena değil, ama {best} biraz daha iyiydi.
ex.verdict.inaccuracy.b3.2 = {best} biraz daha isabetliydi.
ex.verdict.inaccuracy.b3.3 = Küçük bir kusur: burada {best} daha iyiydi.
ex.verdict.inaccuracy.b4 = Kusurlu bir hamle: {best} daha isabetliydi.
ex.verdict.inaccuracy.b4.2 = Ufak bir kusur. {best} biraz daha iyiydi.
ex.verdict.inaccuracy.b4.3 = Tam en iyisi değil: {best} daha isabetliydi.
ex.verdict.inaccuracy.b5 = {move} kusurlu; {best} daha güçlüydü.
ex.verdict.inaccuracy.b5.2 = Biraz kusurlu. Ben {best} hamlesini oynardım.
ex.verdict.inaccuracy.b5.3 = {best}, {move} hamlesinden daha isabetliydi.
ex.verdict.inaccuracy.b6 = {move} kusurlu; {best}.
ex.verdict.inaccuracy.b6.2 = Kusurlu. {best}.
ex.verdict.inaccuracy.b6.3 = {best} daha iyiydi.
# Level 6, an inaccuracy at the bottom of its class (deeper searches often clear it): a hedged word.
ex.verdict.inaccuracy.maybe = {best} biraz daha isabetli olabilirdi.
ex.verdict.inaccuracy.maybe.2 = Ben {best} hamlesini oynayabilirdim.
# A dubious move that loses material (levels 3-6): the remark alone, never "a bit better" (at level 6
