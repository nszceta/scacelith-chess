# Coach speech (Turkish): events of a coach game and of the rules lesson (greetings, turn-taking,
# takebacks, encouragement, the end of a game, level introductions). src/coach/events.cpp says
# them. Same keys and variants as assets/coach/speech/en/events.lang.
# The coach says "sen" and calls himself "ben"; Turkish has no grammatical gender, so nothing agrees
# with the coach or the player. A sentence after a colon starts in lower case, as in the other
# Turkish coach files. Level names (event.level.*) are coach.level.N.name of assets/i18n/tr.lang.

# ---- Start of a coach game, per level (1 First steps ... 6 Expert) --------------------------------
event.greet.l1 = Merhaba! Dostça bir oyun oynayalım. Taşlarından biri tehlikedeyse sana söylerim.
event.greet.l1.2 = Selam! Seni zorlamadan oynayacağım ve neye dikkat etmen gerektiğini göstereceğim.
event.greet.l1.3 = Hoş geldin! Acele etme: bir taş tehlikeye girince sana söylerim.
event.greet.l1.first = Merhaba! Her hamleden önce sor: taşım güvende mi? Hamlem neye saldırıyor? Rakibim neyi tehdit ediyor? Sana hatırlatırım.
event.greet.l1.first.2 = İlk gerçek oyunun! Her hamleden önce: taşım güvende mi, neye saldırıyor, tehdit ne? Sana hatırlatırım.
event.greet.l2 = Merhaba! Hadi oynayalım. Hamlem bir çatal ya da açmaz hazırlarsa sana söylerim.
event.greet.l2.2 = Selam! Taşlarını oyuna sok ve şahını güvende tut. Oyun boyunca sana yardım ederim.
event.greet.l2.3 = Tahtaya tekrar hoş geldin! Çatallara ve açmazlara dikkat et: oyun kazandırırlar.
event.greet.l3 = Merhaba! Gerçek bir oyun oynayalım. Büyük tehditleri sana bildireceğim ve büyük hataları açıklayacağım.
event.greet.l3.2 = Selam! Taşların için bir plan düşün. Bir hamle bir şeyi kaçırınca sana söylerim.
event.greet.l3.3 = Hadi oynayalım! Yalnızca tek hamlenin işe yaradığı anları ve ters giden hamleleri söylerim.
event.greet.l1.theme = Tekrar hoş geldin! Geçen oyunun ipucu şuydu: {theme}. Bugün de aklında tut.
event.greet.l1.theme.2 = Yeniden merhaba! Geçen oyunun ipucunu hatırla: {theme}. Sana yardım ederim.
event.greet.l2.theme = Tekrar hoş geldin! Geçen oyunun fikri şuydu: {theme}. Bakalım bugün nasıl gidecek.
event.greet.l2.theme.2 = Yeniden merhaba! Geçen oyundan aklında kalsın: {theme}.
event.greet.l3.theme = Tekrar hoş geldin! Geçen oyunun teması şuydu: {theme}. Bugün de aklında tut.
event.greet.l3.theme.2 = Yeniden selam! Geçen oyundan: {theme}. Bakalım bugün nasıl gidecek.
event.greet.l4 = Merhaba! Bu sefer değerlendirme vereceğim ve daha iyi aday hamleleri göstereceğim.
event.greet.l4.2 = Oynayalım. Bir hatadan sonra neyin daha isabetli olduğunu söyleyeceğim.
event.greet.l4.3 = Bir kulüp oyununa hazır mısın? Değerlendirme değiştiğinde yorum yapacağım.
event.greet.l5 = Oynayalım. Yorumlarım kısa olacak.
event.greet.l5.2 = Sen hazırsan ben de hazırım. Yalnızca kısa yorumlar.
event.greet.l5.3 = Bol şans. Yalnızca önemli anlarda konuşacağım.
event.greet.l6 = Bol şans.
event.greet.l6.2 = Oynayalım.
event.greet.l6.3 = Hazırım. Yalnızca kritik anları yorumlayacağım.

# Who starts (said after the greeting).
event.colour.white = Beyaz taşlar sende, yani sen başlıyorsun.
event.colour.white.2 = Beyaz sensin: ilk hamle senden.
event.colour.black = Beyaz bende, o yüzden ben başlıyorum.
event.colour.black.2 = Bu sefer Siyah sensin: ilk hamleyi ben yapıyorum.

# ---- Level introductions (the first game at a level, or when the player changes it) -------------
event.level.l1 = İlk adımlar: seni zorlamadan oynarım. Saldırı altındaki korumasız taşını söylerim, büyük hataları basit sözlerle açıklarım.
event.level.l2 = Başlangıç: biraz daha güçlü oynarım. Çatal, açmaz ve vezirine saldırıyı söylerim; taşlarını çıkarmanı hatırlatırım.
event.level.l3 = Gelişen oyuncu: yalnızca mat ve vezirine saldırı için, bir de tek hamle işe yarıyorsa uyarırım. Hatalarını yine açıklarım.
event.level.l4 = Kulüp oyuncusu: değerlendirmeyi piyon cinsinden veririm ve aday hamleler öneririm.
event.level.l5 = Güçlü kulüp oyuncusu: kısa yorumlar, gerektiğinde daha uzun varyantlar.
event.level.l6 = Uzman: var gücümle oynarım ve yalnızca kritik anları yorumlarım.

# ---- Turn-taking -------------------------------------------------------------------------------------
# After an explanation or a demonstration, when the player may move again.
event.your_move = Senin hamlen.
event.your_move.2 = Sıra sende.
event.your_move.3 = Şimdi sen oyna.
# The player has been thinking for a while (never during the first minute).
event.take_time = Acele etme.
event.take_time.2 = Acele yok: bizim oyunlarımızda saat yok.
# Short filler while the coach is still looking at the position.
event.filler = Hımm.
event.filler.2 = Bakalım.
event.filler.3 = Bir bakayım.

# ---- Takebacks -----------------------------------------------------------------------------------------
# The player took the move back after the coach's offer.
event.takeback.taken = Tamam, hamleyi geri alalım.
event.takeback.taken.2 = İyi fikir. Bir daha bak.
event.takeback.taken.3 = Hamle geri alındı. Yeniden dene.
# The player declined the offer and played on.
event.takeback.declined = Tamam, devam ediyoruz.
event.takeback.declined.2 = Peki, oyun sürüyor.
event.takeback.declined.3 = Karar senin. Devam edelim.
# After an explanation without an offer.
event.play_on = Oynamaya devam edelim.
event.play_on.2 = Devam edelim.
event.play_on.3 = Şimdi oyunumuza dönelim.

# ---- Encouragement -------------------------------------------------------------------------------------
# After the player's mistake has been explained (never mocking; praise the process, not the person).
event.encourage.mistake = Herkes böyle hatalar yapar. Önemli olan onları fark etmek.
event.encourage.mistake.2 = Merak etme. Son hamlemin neye saldırdığına bak, bulursun.
event.encourage.mistake.3 = Bu her oyuncunun başına gelir. Yola devam.
# The player is behind (material or evaluation).
event.encourage.behind = Pes etme: fırsatları kolla ve beni epey uğraştır.
event.encourage.behind.2 = Mücadeleye devam. Böyle pozisyonlar hâlâ tersine dönebilir.
event.encourage.behind.3 = Sakin ol ve zayıf noktalarımı ara.
# The player has played several good moves in a row.
event.encourage.well = Oynamadan önce tehditlerimi kontrol ediyorsun. Çok güzel.
event.encourage.well.2 = Dikkatli, sağlam hamleler. Böyle devam.
event.encourage.well.3 = Bugün iyi düşünüyorsun.

# ---- Draw offers ------------------------------------------------------------------------------------------
event.draw.accepted = Kabul ediyorum. O hâlde berabere.
event.draw.accepted.2 = Anlaştık: oyun berabere.
event.draw.declined = Hayır, teşekkürler; devam edelim.
event.draw.declined.2 = Devam etmeyi tercih ederim.

# ---- End of the game (the coach's closing words, then the handshake) --------------------------------------
event.end.win = İyi oynadın. Tebrikler!
event.end.win.2 = Hak ettin. Bravo!
event.end.win.3 = Tebrikler: beni hakkıyla yendin.
event.end.loss = İyi oyundu. Bir dahaki sefere beni yenersin.
event.end.loss.2 = Oyun için teşekkürler. Her yenilgi sana bir şey öğretir.
event.end.loss.3 = Güzel mücadeleydi. Neler olduğuna bakalım.
event.end.draw = Berabere. İyi oyundu!
event.end.draw.2 = Bu sefer kazanan yok. İyi mücadeleydi.
event.end.draw.3 = Adil bir sonuç. İyi oyundu.
event.end.resigned = Terk ettin. Yine de iyi mücadeleydi.
event.end.resigned.2 = Peki. Oyun için teşekkürler.
event.end.handshake = Hadi tokalaşalım.

# ---- The rules lesson -----------------------------------------------------------------------------------------
# {chapter} = the chapter's title (lesson.title.* in lesson.lang), a nominative noun phrase: never a
# suffix after it; "ile", "konusunda" and the colon keep it unchanged.
event.lesson.resume = Tekrar hoş geldin! Şimdi {chapter} ile devam edelim.
event.lesson.resume.2 = Yeniden merhaba! {chapter} konusunda kalmıştık.
event.lesson.start = {chapter} ile başlayalım.
event.lesson.start.2 = {chapter} ile başlıyoruz.
event.lesson.next = Sıradaki konu: {chapter}.
event.lesson.next.2 = Şimdi sırada {chapter} var.
