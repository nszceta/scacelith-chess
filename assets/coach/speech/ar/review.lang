threat.ask_mate.b2.2 = انظر إلى نقلتي الأخيرة: إنها تهدّد بأمر كبير. هل تراه؟

# ---- The coach's own threats (levels 1-2, before the player moves) ------------------------------
# A mate threat ({sq} = where it would mate, pointed at at level 1; {my} = the piece).
threat.mate.b1 = انتبه! أهدد بكش مات في {sq}.
threat.mate.b1.2 = حذارِ: {my} يريد الذهاب إلى {sq}. سيكون ذلك كش مات.
threat.mate.b1.3 = انظر إلى {sq}. وصولي إليه يعني كش مات!
threat.mate.b2 = انتبه، أهدد بكش مات.
threat.mate.b2.2 = حذارِ: هناك تهديد بكش مات في {sq}.
threat.mate.b2.3 = دقّق النظر: هناك تهديد بالكش مات.
threat.mate.b3 = انتبه، أهدد بكش مات في {sq}.
threat.mate.b3.2 = هناك تهديد بكش مات: {my} يريد الذهاب إلى {sq}.
threat.mate.b3.3 = احذر: أهدد بكش مات.
# A threat on a piece ({my} = my attacker, pointed at at level 1; {your} = the target, pointed at).
threat.piece.b1 = انظر: {my} يهاجم {your}.
threat.piece.b1.2 = انتبه! {your} مهدَّد من {my}.
threat.piece.b1.3 = حذارِ، {my} يريد أخذ {your}.
threat.piece.b2 = انتبه إلى {your}.
threat.piece.b2.2 = {your} تحت الهجوم.
threat.piece.b2.3 = راقب {your}.
threat.piece.b3 = {my} يهاجم {your}، وأخذه سيكسبني مادة.
threat.piece.b3.2 = {your} في خطر: {my} يهدّد بأخذه.
threat.piece.b3.3 = انتبه: نقلتي الأخيرة تهاجم {your}.
threat.fork.b2 = {my} في {sq} يهاجم {t1} و{t2} معًا. هذه شوكة!
threat.fork.b2.2 = احذر، إنها شوكة: {my} يهاجم {t1} و{t2}.
threat.fork.b2.3 = {my} يهاجم {t1} و{t2} في شوكة. لن يسهل إنقاذهما معًا.
threat.pin.b2 = {my} في {sq} يثبّت {your} أمام {t1}. إن تحرك، آخذ {t1}.
threat.pin.b2.2 = انتبه: {your} مثبَّت بواسطة {my}. إن تحرك، يسقط {t1}.
threat.pin.b2.3 = {your} مثبَّت: إن غادر، يأخذ {my} {t1}.
threat.only.b3 = موقف حرج: نقلة واحدة فقط جيدة حقًّا. خذ وقتك.
threat.only.b3.2 = انتبه، هناك نقلة واحدة جيدة هنا. انظر إلى كل شيء أولًا.
threat.only.b3.3 = على مهلك: معظم النقلات تخطئ في هذا الموقف.
threat.punish.b1 = نقلتي الأخيرة كانت خطأً. هل يمكنك معاقبتي عليها؟
threat.punish.b1.2 = أظن أنني ارتكبتُ خطأً. هل يمكنك إيجاده؟

# ---- Takebacks ------------------------------------------------------------------------------------
# After the takeback is accepted, a hint (levels 1-2).
tb.hint.b1 = فكّر في {your} هذه المرة.
tb.hint.b1.2 = راقب {your} جيدًا.
tb.hint.king.b1 = فكّر في سلامة {your}.
tb.hint.king.b1.2 = انظر إلى {your} أولًا. هل هو آمن؟
tb.hint.missed.b1 = ابحث عن قطع يمكنك أخذها مجانًا.
tb.hint.missed.b1.2 = انظر جيدًا: هل هناك ما يمكنك أخذه؟
tb.hint.mate_missed.b1 = انظر إلى ملِكي. هل يمكنك إعطاؤه كش مات؟
tb.hint.mate_missed.b1.2 = جرّب نقلات الكش أولًا. ربما هناك كش مات!
tb.hint.general.b1 = خذ وقتك وانظر إلى الرقعة كلها.
tb.hint.general.b1.2 = حاول إيجاد نقلة أكثر أمانًا.
tb.hint.b3 = تحقّق أيّ قطعك يهاجمها ردّي.
tb.hint.b3.2 = انظر ماذا سيهاجم ردّي قبل أن تلعب.
# The retry.
tb.fixed.b1 = أفضل بكثير!
tb.fixed.b1.2 = نعم، هذا أفضل!
tb.fixed.b1.3 = جيد، هذه النقلة أفضل بكثير.
tb.fixed = هذا أفضل.
tb.fixed.2 = أفضل.
tb.fixed.3 = تصحيح جيد.
tb.why.b1 = تذكّر للمرة القادمة: {theme}.
tb.why.b1.2 = عادة جيدة: {theme}.
tb.why.b2 = الدرس هنا: {theme}.
tb.why.b2.2 = ما ساعد: {theme}.
tb.why.b3 = يستحق التذكّر: {theme}.
tb.why.b3.2 = العادة التي ينبغي بناؤها: {theme}.
tb.same = النقلة نفسها مرة أخرى؟ حسنًا، لنرَ.
tb.same.2 = يبدو أن هذه النقلة تعجبك. لنكمل بها.
tb.found.b1 = نعم! هذه هي النقلة التي في ذهني.
tb.found.b1.2 = أحسنت! هذه هي النقلة الأفضل.
tb.found = هذه هي النقلة التي في ذهني.
tb.found.2 = بالضبط، هذه هي.
# Levels 4-6, once per game: the level's takebacks are used up, so no offer this time (said
# where the offer would have been).
tb.none_left = للأسف، لا مزيد من استرجاع النقلات في هذه المباراة.
tb.none_left.2 = لم يعد بإمكانك استرجاع أي نقلة في هذه المباراة.
retry.task.b1 = لنعد إلى تلك اللحظة. هل تجد نقلة أفضل؟
retry.task.b1.2 = هذه هي الوضعية مجددًا. هل تجد نقلة أفضل؟
retry.task.b2 = هذه هي الوضعية قبل الخطأ الكبير. جد نقلة أفضل.
retry.task.b2.2 = لننظر إلى تلك اللحظة مجددًا. ماذا ستلعب بدلًا منها؟
retry.task.b3 = هذه هي الوضعية قبل النقلة الحاسمة. جد النقلة الأفضل.
retry.task.b3.2 = نعود إلى اللحظة الحاسمة. ما النقلة الأفضل؟
retry.again.b1 = ليست هذه. انظر مرة أخرى.
retry.again.b1.2 = ليست هي بعد. حاول مجددًا.
retry.again.b2 = ليست هذه. انظر إلى الرقعة كلها.
retry.again.b2.2 = ليس بعد. جرّب نقلة أخرى.
retry.again.b3 = ليست هذه. انظر ماذا سيفعل ردّي.
retry.again.b3.2 = ليست هي بعد. فكّر في أفضل ردّ لي.
retry.found.b1 = نعم! هذه هي النقلة الأفضل. أحسنت!
retry.found.b1.2 = هذا هو المطلوب! أفضل بكثير.
retry.found.b2 = نعم، هذه تنجح. أحسنت.
retry.found.b2.2 = هذه هي الفكرة. عمل جيد.
retry.found.b3 = صحيح، هذه تصمد. أحسنت.
retry.found.b3.2 = هذه هي. اختيار جيد.
retry.reveal.b1 = هذه هي النقلة الأفضل: {best}. شاهدها.
retry.reveal.b1.2 = دعني أريك: {best} كانت أفضل.
retry.reveal.b2 = النقلة الأفضل كانت {best}. انظر.
retry.reveal.b2.2 = ها هي: {best}.
retry.reveal.b3 = النقلة الأفضل كانت {best}.
retry.reveal.b3.2 = {best} كانت النقلة.
