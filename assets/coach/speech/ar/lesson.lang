lesson.title.safety = الأخذ الآمن وغير الآمن
lesson.title.check = الكش
lesson.title.mate = الكش مات
lesson.title.castling = التبييت
lesson.title.en_passant = الأخذ بالمرور
lesson.title.promotion = الترقية
lesson.title.draws = الجمود والتعادل
lesson.title.before_move = قبل أن تنقل
lesson.title.opening = الافتتاح
lesson.title.review = مراجعة سريعة
lesson.title.etiquette = سير مبارياتنا

