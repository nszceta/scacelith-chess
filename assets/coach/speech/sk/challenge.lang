# Coach speech (Slovak): the challenges (src/coach/challenge_run.cpp). Same keys and variants as
# assets/coach/speech/en/challenge.lang (its header documents every placeholder).
#
# Placeholders:
#   {n}      a number; "{n:position}" says it with its noun ("6 pozícií", count.position in
#            common.lang), "{n:move}" likewise ("10 ťahov"). The mate distance is an ordinal, as Slovak
#            problem books say it: "mat {n:ord_ins} ťahom" = "mat 2. ťahom", spoken "mat druhým ťahom".
#            A counted noun is never the subject of a verb here (the verb would change with the
#            number): it stands alone, before a colon, or as an object.
#   {move}   one of the coach's moves, played on the board while the line is said; after a
#            preposition or a verb it follows the noun "ťah" ("po ťahu {move}", "ťahom {move}");
#            "{move:nomate}" says a mating move without "mat" (the line says it)
#   {your}   one of the player's pieces; the coach points at it on that word. The player is the
#            subject of these lines, so they use "svoj": {your:refl_acc} = "svoju vežu",
#            {your:refl_loc} = "svojom jazdcovi"
#   {sq}     a square ("pole {sq}"); the coach points at it on that word
# The player always has the white pieces. The coach says "ty" to the player and is male ("odpovedal
# by som"); the player's gender is unknown: no past tense, conditional or adjective about the player.
# The challenge names are exactly those of assets/i18n/sk.lang (challenge.<id>.name). The two names in
# the formal imperative ("Nájdite únik", "Zastavte pešiaka") are quoted as titles after "Výzva", so
# that the coach, who says "ty", does not seem to address the player formally.

# ---- After a game: the challenge made for the theme of the last game ------------------------------
ch.practise = Z tvojej poslednej partie: {theme}. Táto sada je na to vytvorená.
ch.practise.2 = V tvojej poslednej partii bolo na čom pracovať: {theme}. Precvičme si to.
ch.practise.3 = Rada z poslednej partie bola: {theme}. Tu je nejaký tréning.

# ---- The start of a challenge: what it trains ({n:position}: how many positions) ------------------
ch.intro.mate1 = Mat 1. ťahom. {n:position} a v každej dá mat jediný ťah. Preskúmaj všetky šachy.
ch.intro.mate1.spoken = Mat prvým ťahom. {n:position} a v každej dá mat jediný ťah. Preskúmaj všetky šachy.
ch.intro.mate2 = Mat 2. ťahom. {n:position}: tvoj prvý ťah mi nesmie nechať žiadnu obranu, potom dáš mat.
ch.intro.mate2.spoken = Mat druhým ťahom. {n:position}: tvoj prvý ťah mi nesmie nechať žiadnu obranu, potom dáš mat.
ch.intro.mate3 = Mat 3. ťahom. {n:position}. Šachy, brania a hrozby: zakaždým si vypočítaj moju najlepšiu odpoveď.
ch.intro.mate3.spoken = Mat tretím ťahom. {n:position}. Šachy, brania a hrozby: zakaždým si vypočítaj moju najlepšiu odpoveď.
ch.intro.backrank = Maty na poslednom rade. {n:position}: kráľ je zakaždým uväznený za vlastnými pešiakmi.
ch.intro.patterns = Typické maty. {n:position} s klasickými matovými sieťami. Rozpoznaj vzor a potom udri.
ch.intro.hanging = Figúry zadarmo. {n:position}: vždy mám niečo bez ochrany. Nájdi to a vezmi si to.
ch.intro.fork = Vidličky. {n:position}: nájdi ťah, ktorý napadne dve veci naraz.
ch.intro.pin = Väzby. {n:position}: zviaž figúru alebo využi väzbu.
ch.intro.skewer = Napichnutia. {n:position}: napadni cennú figúru a získaj to, čo stojí za ňou.
ch.intro.discovered = Odkryté útoky. {n:position}: odtiahni jednu figúru a uvoľni tým cestu inej.
ch.intro.deflection = Odlákanie a prilákanie. {n:position}: odlákaj obrancu preč alebo ho prilákaj na osudné pole.
ch.intro.intermezzo = Medziťahy. {n:position}: pred samozrejmým ťahom nájdi silnejší.
ch.intro.trapped = Chytené figúry. {n:position}: jedna z mojich figúr nemá kam bezpečne ustúpiť. Získaj ju.
ch.intro.promotion = Premena. {n:position}: partiu rozhodne postúpený pešiak.
ch.intro.quiet = Tiché ťahy. {n:position}: víťazný ťah nie je ani šach, ani branie.
ch.intro.opening = Pasce v otvorení. {n:position} z prvých ťahov skutočných partií. Potrestaj moju chybu.
ch.intro.escape = Výzva „Nájdite únik“. {n:position}: tvoj kráľ je v nebezpečenstve a zachráni ho jediný ťah.
ch.intro.defend = Obranné ťahy. {n:position}: nájdi jediný ťah, ktorý udrží tvoju pozíciu pohromade.
ch.intro.kq = Dáma a kráľ proti kráľovi. {n:position}: daj mat môjmu kráľovi. Pozor na pat.
ch.intro.kr = Veža a kráľ proti kráľovi. {n:position}: daj mat môjmu kráľovi, krok za krokom.
ch.intro.kp = Kráľ a pešiak proti kráľovi. {n:position}: premeň pešiaka na dámu. Cestu mu otváraj kráľom.
ch.intro.kp_hold = Výzva „Zastavte pešiaka“. {n:position}: máš len kráľa. Udrž remízu.
ch.intro.rook = Vežové koncovky. {n:position}: postav most na premenu pešiaka a udrž remízu Philidorovou obranou.
ch.intro.rook.spoken = Vežové koncovky. {n:position}: postav most na premenu pešiaka a udrž remízu Filidorovou obranou.
ch.intro.endgame = Taktika v koncovke. {n:position} s malým počtom figúr a ostrými nápadmi.

# ---- At each position: the task --------------------------------------------------------------------
# A line that ends in checkmate: {n} = the player's moves to the mate ("Mat 2. ťahom").
ch.task.mate = Mat {n:ord_ins} ťahom.
ch.task.mate.2 = Nájdi mat {n:ord_ins} ťahom.
ch.task.hanging = Niečo tu zostalo bez ochrany.
ch.task.hanging.2 = Čo môžeš vziať zadarmo?
ch.task.fork = Nájdi vidličku.
ch.task.fork.2 = Hľadaj vidličku.
ch.task.pin = Kľúčom je tu väzba.
ch.task.skewer = Tu vyhráva napichnutie.
ch.task.discovered = Tu vyhráva odkrytý útok.
ch.task.deflection = Preťaž obrancu alebo ho niekam prilákaj.
ch.task.intermezzo = Hľadaj medziťah.
ch.task.trapped = Jedna z mojich figúr nemôže uniknúť. Získaj ju.
ch.task.promotion = Využi svojho postúpeného pešiaka.
ch.task.quiet = Víťazný ťah je tichý ťah.
ch.task.opening = Potrestaj môj posledný ťah.
ch.task.escape = Zachráň svojho kráľa: funguje len jeden ťah.
ch.task.defend = Nájdi jediný dobrý ťah.
ch.task.endgame = Nájdi najlepší ťah.
ch.task.default = Nájdi najlepší ťah.
# The endgames played out: the coach defends, or tries to win, with its best moves.
ch.task.play.mate = Daj mat môjmu kráľovi. Budem sa brániť, ako najlepšie viem.
ch.task.play.promote = Premeň svojho pešiaka a udrž výhru. Pokúsim sa ti v tom zabrániť.
ch.task.play.hold = Ubráň remízu: musíš vydržať {n:move}. Pokúsim sa vyhrať.

# ---- Setting up ----------------------------------------------------------------------------------
# Before the coach plays the first move into a position (once per challenge).
ch.lead.first = Tieto pozície pochádzajú zo skutočných partií. Zahrám posledný ťah a potom si na ťahu ty.
ch.lead.first.2 = Každá pozícia pochádza zo skutočnej partie: zahrám ťah, ktorý k nej viedol, a potom hráš ty.
ch.next = Ďalšia pozícia.
ch.next.2 = Tu je ďalšia.
ch.next.3 = Ideme na ďalšiu.
ch.last = Posledná pozícia.
ch.last.2 = A teraz posledná.

# ---- The player's move -----------------------------------------------------------------------------
# A right move in the middle of a line (the coach then answers it).
ch.good = Dobre.
ch.good.2 = Áno.
ch.good.3 = Správne.
ch.good.4 = Presne tak.
# The position is solved.
ch.solved = To je ono! Výborne.
ch.solved.2 = Úplne správne.
ch.solved.3 = Veľmi dobre.
ch.solved.mate = Mat! Výborne.
ch.solved.mate.2 = A je to mat. Veľmi dobre.
ch.solved.mate.3 = Mat. Pekne zahrané.
ch.solved.promote = Nová dáma a výhra je istá. Výborne.
ch.solved.hold = Remíza je udržaná. Dobrá obrana!
ch.solved.draw = Na šachovnici je remíza. Dobrá obrana!
# A wrong move: the coach plays its answer {move} while saying the line, then takes both back.
ch.wrong.reply = Tento nie: odpovedal by som ťahom {move}.
ch.wrong.reply.2 = Nie celkom: na to by som zahral {move}.
ch.wrong.reply.3 = Potom by som zahral {move}.
ch.wrong.mate = Pozor: ťahom {move:nomate} by som ti dal mat.
ch.wrong.mate.2 = Opatrne: odpovedal by som ťahom {move:nomate} a bol by to mat.
ch.wrong.mated = Pozor: po ťahu {move} môžem vynútiť mat {m:ord_ins} ťahom.
# A move that still mates, but in more moves than the position asks.
ch.wrong.slower = Aj to vedie k matu, ale trvá to dlhšie. Existuje rýchlejšia cesta.
# A move that mates just as fast, but is not the solution the coach answers.
ch.wrong.other = Aj to vedie k matu, ale ja mám na mysli iný ťah. Pozri sa ešte raz.
# A move that keeps an advantage, but less than the solution.
ch.wrong.weaker = Nie je to zlé, ale existuje niečo silnejšie. Pozri sa ešte raz.
ch.wrong.weaker.2 = Dá sa to hrať, ale ide to aj lepšie.
ch.wrong.stalemate = Pat! Môj kráľ sa nemôže pohnúť, a to je len remíza.
# Play-outs: the win slips away (the coach would hold), or the draw is lost (the coach would win).
ch.wrong.draw = Tento nie: po ťahu {move} dokážem udržať remízu.
ch.wrong.loses = Pozor: po ťahu {move} by som vyhrával ja.
# No answer from the engine: the move is simply not the one.
ch.wrong.plain = To nie je ono.
ch.try_again = Skús to znova.
ch.try_again.2 = Pozri sa na to ešte raz.
ch.try_again.3 = Hľadaj ďalej.

# ---- Hints (only when the player asks for one, or accepts the coach's offer) ------------------------
ch.offer = Chceš nápovedu?
ch.offer.2 = Mám ti napovedať?
ch.no_hint = Dobre. Hľadaj ďalej.
ch.no_hint.2 = V poriadku, nikam sa neponáhľaj.
ch.hint.piece = Pozri sa na {your:refl_acc}.
ch.hint.piece.2 = Premýšľaj o {your:refl_loc}.
ch.hint.square = Pozri sa na pole {sq}.
ch.hint.square.2 = Kľúčové pole je {sq}.
ch.hint.square.3 = Sleduj pole {sq}.
ch.hint.show = Tu je ten ťah. Pozri.
ch.hint.show.2 = Ukážem ti to. Sleduj.
ch.hint.now = Teraz ho zahraj ty.
ch.hint.now.2 = Si na ťahu: zahraj ho.

# ---- The end -----------------------------------------------------------------------------------------
ch.complete = To je celá výzva. Výborne!
ch.complete.2 = Všetky pozície sú vyriešené. Výborne!
