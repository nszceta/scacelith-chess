ex.verdict.dubious = Tento ťah vyzerá pochybne.
ex.verdict.dubious.2 = Tento ťah sa zdá pochybný.
# Something good was missed (levels 1-2).
ex.verdict.missed.b1 = Ó, počkaj! Niečo dobré ti ušlo.
ex.verdict.missed.b1.2 = Pozri sa znova! Bolo tu niečo lepšie.
