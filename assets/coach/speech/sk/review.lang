# Coach speech (Slovak): the review of the player's moves (src/coach/review.cpp, review_explain.cpp).
# Same keys and variants as assets/coach/speech/en/review.lang (its header documents every placeholder).
#
# Register: the coach says "ty" and is male ("nečakal som", "zahral by som"). The player's gender is
# unknown: no second-person past tense or conditional ("prehliadol si", "mohol si"), no adjective about
# the player: present tense, impersonal forms ("ušiel ti mat", "dalo sa vziať", "stačilo {best}") and
# nouns ("Výhra je tvoja", "máš o 3 body menej", "si o 3 body pozadu") instead.
# Pieces carry their possessive; forms from common.lang: acc gen dat loc ins, refl_* ("svoj" when the
# subject owns the piece: "Pozri sa na {your:refl_acc}", "prídeš o {your:refl_acc}"), bare_ins
# ("ťah {your:bare_ins}"), pron_acc / pron_dat (clitics "ho", "mu", second in their clause), npron_*
# (after a preposition: "za {t1:npron_ins}"), poss, and the agreement endings adj, adj_acc, adj_soft,
# adj_short, past, past_ol, past_iel after the piece ("{my} bol{my:past} nekryt{my:adj}").
# A move as subject: "ťah {best}" with a masculine past ("Ťah {best} dával mat"), or the neuter of
# Slovak annotations ("Lepšie bolo {best}"). A move is never followed by "berie" or a clitic (the voice
# says "jazdec berie na é päť"): "po {reply} padne {your}", "{reply} a {your} padne".
# Counted nouns: {m:move}, {pts:point}, {n:time}, {n:square}, {n:attacker} / {n:attacker_acc},
# {n2:defender} / {n2:defender_acc}; "mate in N" is "mat N. ťahom" ({m:ord_ins} ťahom, spoken "mat
# tretím ťahom"). Never "s", "z", "k", "v" right before a move placeholder ("so" / "zo" depend on it).
# Levels 1-2: simple words, at most about 15 words per sentence; levels 5-6: terse.

# ---- Announcements (either side's move) -------------------------------------------------------
# The player gives check (levels 1-2: say what it means).
ann.check.human.b1 = Šach! Môj kráľ je napadnutý.
ann.check.human.b1.2 = Šach! Útočíš na môjho kráľa.
ann.check.human.b1.3 = To je šach! Môj kráľ sa z neho musí dostať.
ann.check.human = Šach.
ann.check.human.2 = Šach!
ann.check.human.3 = A je to šach.
# The coach gives check.
ann.check.coach = Šach!
ann.check.coach.2 = Šach.
ann.check.coach.3 = A šach!
# Once per game at levels 1-2, right after the coach's first check ({your} = the player's king).
ann.check.coach.first = To znamená, že {your} je napadnut{your:adj}. Musíš {your:pron_acc} dostať zo šachu.
ann.check.coach.first.2 = Šach znamená, že {your} je pod útokom. Uhni {your:bare_ins}, zacloň sa alebo vezmi moju figúru.
ann.double_check.coach = Dvojitý šach! Tvojho kráľa napádajú naraz dve moje figúry, takže musí uhnúť.
ann.double_check.coach.2 = To je dvojitý šach: teraz ti pomôže len ťah kráľom.
ann.double_check.human = Dvojitý šach! Môjho kráľa napádajú naraz dve tvoje figúry, takže musí uhnúť.
ann.double_check.human.2 = Dvojitý šach! Teraz ma zachráni len ťah kráľom.
# The player checkmates the coach.
ann.mate.human.b1 = Mat! Výhra je tvoja! Môj kráľ nemá kam ujsť.
ann.mate.human.b1.2 = To je mat! Výborne, partia je tvoja!
ann.mate.human.b1.3 = Mat! Môj kráľ je v pasci. Gratulujem!
ann.mate.human = Mat. Dobre zahrané.
ann.mate.human.2 = To je mat. Gratulujem.
ann.mate.human.3 = Mat! Pekná práca.
# The coach checkmates the player.
ann.mate.coach.b1 = To je mat. Tvoj kráľ nemá kam ujsť.
ann.mate.coach.b1.2 = Mat. Tvoj kráľ je napadnutý a nemôže uniknúť.
ann.mate.coach.b1.3 = Obávam sa, že je to mat. Tvoj kráľ už neujde.
ann.mate.coach = Mat.
ann.mate.coach.2 = A je to mat.
ann.mate.coach.3 = Obávam sa, že je to mat.

