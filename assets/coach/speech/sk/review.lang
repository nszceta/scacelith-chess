ex.verdict.ignored.b1 = Ups! Moja hrozba zostala bez odpovede.
ex.verdict.ignored.b1.2 = Pozor! Moja hrozba tam stále bola.
ex.verdict.ignored.b1.3 = Ó, počkaj. A čo moja hrozba?
ex.verdict.ignored.b2 = Hm, moja hrozba tam stále bola.
ex.verdict.ignored.b2.2 = Moja hrozba zostala bez odpovede.
ex.verdict.ignored.b2.3 = Pozor, na moju hrozbu bolo treba odpovedať.
ex.verdict.mistake.b3 = To nie je dobrý ťah.
ex.verdict.mistake.b3.2 = Hm, {move} má háčik.
ex.verdict.mistake.b3.3 = To je chyba.
ex.verdict.mistake.b4 = {move} je chyba.
ex.verdict.mistake.b4.2 = Ťah {move} nie je dobrý.
ex.verdict.mistake.b4.3 = To je chyba.
ex.verdict.mistake.b5 = {move} je jasná chyba.
ex.verdict.mistake.b5.2 = {move} je chyba.
ex.verdict.mistake.b5.3 = {move} nie je dobrý ťah.
ex.verdict.mistake.b6 = {move} je chyba.
ex.verdict.mistake.b6.2 = {move}? Chyba.
ex.verdict.mistake.b6.3 = Nie {move}.
# A dubious move (an inaccuracy; a costly move with nothing concrete to show while still better):
