ex.verdict.inaccuracy.b3 = Nie je to zlé, ale ťah {best} bol o niečo lepší.
ex.verdict.inaccuracy.b3.2 = Ťah {best} bol o kúsok presnejší.
ex.verdict.inaccuracy.b3.3 = Malé zaváhanie: tu bol lepší ťah {best}.
ex.verdict.inaccuracy.b4 = Nepresné: presnejší bol ťah {best}.
ex.verdict.inaccuracy.b4.2 = Malá nepresnosť. Ťah {best} bol o niečo lepší.
ex.verdict.inaccuracy.b4.3 = Nie celkom najlepšie: presnejší bol ťah {best}.
ex.verdict.inaccuracy.b5 = {move} je nepresný ťah; silnejšie bolo {best}.
ex.verdict.inaccuracy.b5.2 = Trochu nepresné. Ja by som zahral {best}.
ex.verdict.inaccuracy.b5.3 = Ťah {best} bol presnejší ako {move}.
ex.verdict.inaccuracy.b6 = {move} je nepresný ťah; {best}.
ex.verdict.inaccuracy.b6.2 = Nepresné. {best}.
ex.verdict.inaccuracy.b6.3 = Lepšie bolo {best}.
# Level 6, an inaccuracy at the bottom of its class (deeper searches often clear it): a hedged word.
ex.verdict.inaccuracy.maybe = Možno bolo o niečo presnejšie {best}.
ex.verdict.inaccuracy.maybe.2 = Možno by som zahral {best}.
# A dubious move that loses material (levels 3-6): the remark alone, never "a bit better" (at level 6
