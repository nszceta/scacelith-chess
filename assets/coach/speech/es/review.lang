# ---- The coach's own threats (levels 1-2, before the player moves) ------------------------------
# A mate threat ({sq} = where it would mate, pointed at at level 1; {my} = the piece).
threat.mate.b1 = ¡Cuidado! Amenazo jaque mate en {sq}.
threat.mate.b1.2 = Cuidado: {my} quiere ir a {sq}. Eso sería jaque mate.
threat.mate.b1.3 = Mira {sq}. ¡Si llego ahí, es jaque mate!
threat.mate.b2 = Cuidado, amenazo mate.
threat.mate.b2.2 = Cuidado: hay una amenaza de mate en {sq}.
threat.mate.b2.3 = Mira bien: amenazo jaque mate.
threat.mate.b3 = Ojo, amenazo mate en {sq}.
threat.mate.b3.2 = Hay amenaza de mate: {my} quiere ir a {sq}.
threat.mate.b3.3 = Cuidado: amenazo jaque mate.
# A threat on a piece ({my} = my attacker, pointed at at level 1; {your} = the target, pointed at).
threat.piece.b1 = Mira: {my} está atacando a {your}.
threat.piece.b1.2 = ¡Cuidado! {your} está atacad{your:o} por {my}.
threat.piece.b1.3 = Cuidado, {my} quiere capturar {your}.
threat.piece.b2 = Cuidado con {your}.
threat.piece.b2.2 = {your} está amenazad{your:o}.
threat.piece.b2.3 = Vigila {your}.
threat.piece.b3 = {my} ataca a {your}, y capturar{your:lo} ganaría material.
threat.piece.b3.2 = {your} está en peligro: {my} amenaza con capturar{your:lo}.
threat.piece.b3.3 = Cuidado: mi última jugada ataca a {your}.
threat.fork.b2 = {my} en {sq} ataca a {t1} y a {t2} a la vez. ¡Es una horquilla!
threat.fork.b2.2 = Cuidado, es una horquilla: {my} ataca a {t1} y a {t2}.
threat.fork.b2.3 = {my} hace horquilla a {t1} y a {t2}. No es fácil salvar las dos piezas.
threat.pin.b2 = {my} en {sq} clava a {your} contra {t1}. Si se mueve, capturo {t1}.
threat.pin.b2.2 = Cuidado: {your} está clavad{your:o} por {my}. Si se mueve, cae {t1}.
threat.pin.b2.3 = {your} está clavad{your:o}: si se va, {my} captura {t1}.
threat.only.b3 = Esta posición es crítica: solo una jugada es realmente buena. Tómate tu tiempo.
threat.only.b3.2 = Cuidado, aquí solo hay una buena jugada. Mira todo primero.
threat.only.b3.3 = Despacio: casi todas las jugadas salen mal en esta posición.
threat.punish.b1 = Mi última jugada ha sido un error. ¿Sabes aprovecharlo?
threat.punish.b1.2 = Mmm, creo que me he equivocado. ¿Lo encuentras?

