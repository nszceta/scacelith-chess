# Coach speech (Spanish): the review of the player's moves (src/coach/review.cpp, review_explain.cpp).
# Same keys and variants as assets/coach/speech/en/review.lang (its header documents every placeholder).
#
# Notes for Spanish:
# - The coach says "tú"; the player's gender is unknown: no adjective or participle agrees with the
#   player. The coach is male.
# - {your} {my} {t1} {t2} {your2} {my2} already carry "tu" / "mi": never put an article before them.
#   {t1} and {t2} may be anyone's piece of any type.
# - Adjectives and participles agreeing with a piece take the ending "{your:o}" / "{my:o}" ("o" or
#   "a", see common.lang), always AFTER the piece itself: "{your} está atrapad{your:o}". Object
#   pronouns are "{your:lo}" / "{my:lo}" ("lo" / "la"), joined to an infinitive, gerund or
#   imperative ("capturar{my:lo}", "atacándo{your:lo}", "Muéve{your:lo}") or before the verb.
# - "a" before a targeted piece with atacar, amenazar, clavar, dar mate ("ataca a tu dama"); no "a"
#   with capturar, ganar, llevarse, perder ("captura tu dama"), as in the lesson lines.
# - Never two pieces in one adjective ("{t1} y {t2} están atacados"): their genders may differ.
# - Spoken counts use the counted nouns of common.lang ("{m:move}" = "dos jugadas",
#   "{n:attacker}" = "tres atacantes").

# ---- Announcements (either side's move) -------------------------------------------------------
# The player gives check (levels 1-2: say what it means).
ann.check.human.b1 = ¡Jaque! Mi rey está atacado.
ann.check.human.b1.2 = ¡Jaque! Estás atacando a mi rey.
ann.check.human.b1.3 = ¡Es jaque! Mi rey tiene que salir del jaque.
ann.check.human = Jaque.
ann.check.human.2 = ¡Jaque!
ann.check.human.3 = Y es jaque.
# The coach gives check.
ann.check.coach = ¡Jaque!
ann.check.coach.2 = Jaque.
ann.check.coach.3 = ¡Y jaque!
# Once per game at levels 1-2, right after the coach's first check ({your} = the king).
ann.check.coach.first = Eso quiere decir que ataco a {your}. Tienes que sacar{your:lo} del jaque.
ann.check.coach.first.2 = Jaque significa que {your} está atacad{your:o}. Muéve{your:lo}, tapa el jaque o captura mi pieza.
ann.double_check.coach = ¡Jaque doble! Dos de mis piezas atacan a tu rey a la vez, así que tiene que moverse.
ann.double_check.coach.2 = Es un jaque doble: ahora solo te sirve mover el rey.
ann.double_check.human = ¡Jaque doble! Dos de tus piezas atacan a mi rey a la vez, así que tiene que moverse.
ann.double_check.human.2 = ¡Un jaque doble! Ahora solo puedo salvarme moviendo el rey.
# The player checkmates the coach.
ann.mate.human.b1 = ¡Jaque mate! ¡Has ganado! Mi rey no puede escapar.
ann.mate.human.b1.2 = ¡Es jaque mate! ¡Muy bien, has ganado la partida!
ann.mate.human.b1.3 = ¡Jaque mate! Mi rey está atrapado. ¡Enhorabuena!
ann.mate.human = Jaque mate. Bien jugado.
ann.mate.human.2 = Es mate. Enhorabuena.
ann.mate.human.3 = ¡Jaque mate! Muy bien hecho.
# The coach checkmates the player.
ann.mate.coach.b1 = Es jaque mate. Tu rey no tiene escapatoria.
ann.mate.coach.b1.2 = Jaque mate. Tu rey está atacado y no puede escapar.
ann.mate.coach.b1.3 = Me temo que es jaque mate. Tu rey no puede huir.
ann.mate.coach = Jaque mate.
ann.mate.coach.2 = Y es mate.
ann.mate.coach.3 = Jaque mate, me temo.

