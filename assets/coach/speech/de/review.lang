# ---- Demonstration narration: one short line per move shown on the board ------------------------
# Levels 4-6: just the move.
demo.move = {move}.
demo.move.2 = Jetzt {move}.
demo.move.3 = Dann {move}.
# Levels 1-3, the coach's moves.
demo.my.move = {my} zieht nach {sq}.
demo.my.move.2 = Ich ziehe {my:acc} nach {sq}.
demo.my.move.3 = Dann geht {my} nach {sq}.
demo.my.take = Ich schlage {your:acc}.
demo.my.take.2 = {my} schlägt {your:acc}.
demo.my.take.3 = Und ich nehme {your:acc}.
demo.my.check = {my} zieht nach {sq}. Schach.
