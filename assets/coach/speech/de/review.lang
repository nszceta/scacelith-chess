# Coach speech: the review of the player's moves (src/coach/review.cpp, review_explain.cpp). German.
# Every language has exactly the English keys (and the same variants). Read the header of
# en/review.lang for the placeholders.
#
# German notes:
# - The coach says "du". Cases of the piece phrases: {your} / {my} nominative, {your:acc} ("Schlag
#   deinen Springer"), {your:dat} ("mit deiner Dame"); see common.lang.
# - No pronoun refers back to a {your}/{my}/{t1}/{t2} piece (er/sie/ihn depend on the piece): the
#   lines repeat a noun ("die Figur", "der König" when it is always the king) or rephrase.
# - No piece placeholder starts a full sentence after a colon (the program capitalises a piece only
#   after . ! ?): such sentences use a full stop instead.
# - Numbers before a noun use the count forms of common.lang ({m:move_dat} "in drei Zügen",
#   {pts:point_acc} "einen Punkt", {n:time} "dreimal"); move numbers are said as "bei Zug {n}".
# - Level bands b1-b2: simple words, short sentences; b5-b6: terse club language.

# ---- Announcements (either side's move) -------------------------------------------------------
# The player gives check (levels 1-2: say what it means).
ann.check.human.b1 = Schach! Mein König wird angegriffen.
ann.check.human.b1.2 = Schach! Du greifst meinen König an.
ann.check.human.b1.3 = Das ist Schach! Mein König muss da raus.
ann.check.human = Schach.
ann.check.human.2 = Schach!
ann.check.human.3 = Und das ist Schach.
# The coach gives check.
ann.check.coach = Schach!
ann.check.coach.2 = Schach.
ann.check.coach.3 = Und Schach!
# Once per game at levels 1-2, right after the coach's first check ({your} = the king).
ann.check.coach.first = Das heißt, {your} wird angegriffen. Du musst das Schach abwehren.
ann.check.coach.first.2 = Bei Schach wird {your} angegriffen. Weich aus, zieh dazwischen oder schlag meine Figur.
ann.double_check.coach = Doppelschach! Zwei meiner Figuren greifen deinen König zugleich an: Er muss ziehen.
ann.double_check.coach.2 = Das ist ein Doppelschach: Jetzt hilft dir nur ein Königszug.
ann.double_check.human = Doppelschach! Zwei deiner Figuren greifen meinen König zugleich an: Er muss ziehen.
ann.double_check.human.2 = Ein Doppelschach! Jetzt kann mich nur noch ein Königszug retten.
# The player checkmates the coach.
ann.mate.human.b1 = Schachmatt! Du hast gewonnen! Mein König kann nicht entkommen.
ann.mate.human.b1.2 = Das ist Schachmatt! Super, du hast die Partie gewonnen!
ann.mate.human.b1.3 = Schachmatt! Mein König sitzt in der Falle. Glückwunsch!
ann.mate.human = Schachmatt. Gut gespielt.
ann.mate.human.2 = Das ist matt. Glückwunsch.
ann.mate.human.3 = Schachmatt! Schön gemacht.
# The coach checkmates the player.
ann.mate.coach.b1 = Das ist Schachmatt. Dein König hat keinen Ausweg.
ann.mate.coach.b1.2 = Schachmatt. Dein König wird angegriffen und kann nicht entkommen.
ann.mate.coach.b1.3 = Das ist leider Schachmatt. Dein König kann nicht mehr weg.
ann.mate.coach = Schachmatt.
ann.mate.coach.2 = Und das ist matt.
ann.mate.coach.3 = Schachmatt, leider.

# ---- Verdicts (the first sentence about a bad move) --------------------------------------------
ex.verdict.blunder.b1 = Hoppla! Mit diesem Zug gibst du etwas her.
ex.verdict.blunder.b1.2 = Vorsicht! Dieser Zug kann dich etwas kosten.
ex.verdict.blunder.b1.3 = Oh, warte. Dieser Zug hat ein Problem.
ex.verdict.blunder.b2 = Hm, dieser Zug hat ein Problem.
ex.verdict.blunder.b2.2 = Das ist ein großer Fehler.
ex.verdict.blunder.b2.3 = Vorsicht, dieser Zug kostet dich etwas.
ex.verdict.blunder.b3 = Das ist ein grober Fehler.
ex.verdict.blunder.b3.2 = {move} ist ein echter Fehler.
ex.verdict.blunder.b3.3 = Autsch, {move} ist ein großer Fehler.
ex.verdict.blunder.b4 = {move} ist ein grober Fehler.
ex.verdict.blunder.b4.2 = {move} ist ein schwerer Fehler.
ex.verdict.blunder.b4.3 = Das ist leider ein grober Fehler.
ex.verdict.blunder.b5 = {move} ist ein schwerer Fehler.
ex.verdict.blunder.b5.2 = {move} ist ein grober Fehler.
ex.verdict.blunder.b5.3 = {move} ist ein teurer Fehler.
ex.verdict.blunder.b6 = {move} ist ein schwerer Fehler.
ex.verdict.blunder.b6.2 = {move} ist ein grober Fehler.
ex.verdict.blunder.b6.3 = {move}? Ein Patzer.
# A blunder that leaves the coach's threat standing (levels 1-2: the threat the engine found after the
# coach's last move is what the reply carries out).
ex.verdict.ignored.b1 = Hoppla! Du hast nicht auf meine Drohung reagiert.
ex.verdict.ignored.b1.2 = Vorsicht! Meine Drohung war noch da.
ex.verdict.ignored.b1.3 = Oh, warte. Du hast meine Drohung vergessen.
ex.verdict.ignored.b2 = Hm, meine Drohung war noch da.
ex.verdict.ignored.b2.2 = Du hast meine Drohung nicht abgewehrt.
ex.verdict.ignored.b2.3 = Vorsicht, du hast nicht auf meine Drohung reagiert.
ex.verdict.mistake.b3 = Das ist kein guter Zug.
ex.verdict.mistake.b3.2 = Hm, {move} hat ein Problem.
ex.verdict.mistake.b3.3 = Das ist ein Fehler.
ex.verdict.mistake.b4 = {move} ist ein Fehler.
ex.verdict.mistake.b4.2 = {move} ist nicht gut.
ex.verdict.mistake.b4.3 = Das ist ein Fehler.
ex.verdict.mistake.b5 = {move} ist ein klarer Fehler.
ex.verdict.mistake.b5.2 = {move} ist ein Fehler.
ex.verdict.mistake.b5.3 = {move} ist nicht gut.
ex.verdict.mistake.b6 = {move} ist ein Fehler.
ex.verdict.mistake.b6.2 = {move}? Ein Fehler.
ex.verdict.mistake.b6.3 = Nicht {move}.
# A dubious move (an inaccuracy; a costly move with nothing concrete to show while still better):
# only the better move is named ({best} is pointed at), never a scenario.
ex.verdict.inaccuracy.b3 = Nicht schlecht, aber {best} war etwas besser.
ex.verdict.inaccuracy.b3.2 = {best} war etwas genauer.
ex.verdict.inaccuracy.b3.3 = Ein kleiner Ausrutscher: {best} war hier besser.
ex.verdict.inaccuracy.b4 = Ungenau: {best} war präziser.
ex.verdict.inaccuracy.b4.2 = Eine kleine Ungenauigkeit. {best} war etwas besser.
ex.verdict.inaccuracy.b4.3 = Nicht ganz der beste Zug: {best} war genauer.
ex.verdict.inaccuracy.b5 = {move} ist ungenau, {best} war stärker.
ex.verdict.inaccuracy.b5.2 = Etwas ungenau. Ich hätte {best} gespielt.
ex.verdict.inaccuracy.b5.3 = {best} war präziser als {move}.
ex.verdict.inaccuracy.b6 = {move} ist ungenau; {best}.
ex.verdict.inaccuracy.b6.2 = Ungenau. {best}.
ex.verdict.inaccuracy.b6.3 = {best} war besser.
# Level 6, an inaccuracy at the bottom of its class (deeper searches often clear it): a hedged word.
ex.verdict.inaccuracy.maybe = {best} war vielleicht etwas genauer.
ex.verdict.inaccuracy.maybe.2 = Vielleicht hätte ich {best} gespielt.
# A dubious move that loses material (levels 3-6): the remark alone, never "a bit better" (at level 6
# under 6 points, the hedged word above unless a piece is lost).
ex.verdict.dubious = Dieser Zug sieht zweifelhaft aus.
ex.verdict.dubious.2 = Dieser Zug scheint zweifelhaft.
# Something good was missed (levels 1-2).
ex.verdict.missed.b1 = Oh, warte! Du hast etwas Gutes übersehen.
ex.verdict.missed.b1.2 = Schau noch mal hin! Es gab etwas Besseres.
ex.verdict.missed.b1.3 = Moment, da hattest du eine Chance!
ex.verdict.missed.b2 = Da hast du eine Chance verpasst.
ex.verdict.missed.b2.2 = Hm, es gab etwas Besseres.
ex.verdict.missed.b2.3 = Warte, da hattest du einen tollen Zug.

# ---- The better move (levels 3-6; {best} is pointed at) ----------------------------------------
ex.better.b3 = Besser war {best}.
ex.better.b3.2 = {best} war der bessere Zug.
ex.better.b3.3 = Stattdessen war {best} gut.
ex.better.b4 = {best} war stärker.
ex.better.b4.2 = {best} war der richtige Zug.
ex.better.b4.3 = Besser war {best}.
ex.better.b5 = {best}, mit der Idee {line}.
ex.better.b5.2 = Richtig war {best}: {line}.
ex.better.b5.3 = Besser war {best}, gefolgt von {line}.
ex.better.b6 = {best}: {eval}.
ex.better.b6.2 = Stattdessen {best}, {eval}.
ex.better.b6.3 = Besser {best}, Bewertung {eval}.

