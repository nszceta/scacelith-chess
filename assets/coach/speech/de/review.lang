# ---- Die eigenen Drohungen des Trainers (vor dem Zug des Spielers) ----------------------------------------
# Die erste Drohung einer Partie auf Stufe 1-2 wird zuerst erfragt, nichts wird gezeigt.
threat.ask.b1 = Mein letzter Zug enthält eine Drohung. Siehst du, welche deiner Figuren in Gefahr ist?
threat.ask.b1.2 = Schau aufs Brett. Mein letzter Zug greift etwas von dir an. Findest du es?
threat.ask.b1.3 = Halt, bevor du ziehst: Mein letzter Zug ist eine Drohung. Welche deiner Figuren ist in Gefahr?
threat.ask.b2 = Mein letzter Zug enthält eine Drohung. Siehst du, welche?
threat.ask.b2.2 = Schau mal: Was greift mein letzter Zug an?
threat.ask.b2.3 = Ich habe gerade etwas angedroht. Findest du es?
threat.ask_mate.b1 = Mein letzter Zug bedroht deinen König. Siehst du, was ich vorhabe?
threat.ask_mate.b1.2 = Vorsicht: Ich plane etwas Großes. Siehst du, was ich vorhabe?
threat.ask_mate.b1.3 = Schau dir meinen letzten Zug an. Ich drohe etwas Ernstes an. Siehst du es?
threat.ask_mate.b2 = Mein letzter Zug ist eine ernste Drohung. Siehst du, was ich vorhabe?
threat.ask_mate.b2.2 = Schau dir meinen letzten Zug an: Er droht etwas Großes. Siehst du es?
# A mate threat ({sq} = where it would mate, pointed at at level 1; {my} = the piece).
threat.mate.b1 = Vorsicht! Ich drohe Schachmatt auf {sq}.
threat.mate.b1.2 = Pass auf! {my} will nach {sq}. Das wäre Schachmatt.
threat.mate.b1.3 = Schau auf {sq}. Wenn ich dorthin komme, ist es Schachmatt!
threat.mate.b2 = Vorsicht, ich drohe Matt.
threat.mate.b2.2 = Pass auf, auf {sq} droht Matt.
threat.mate.b2.3 = Schau genau hin. Ich drohe Schachmatt.
threat.mate.b3 = Vorsicht, ich drohe Matt auf {sq}.
threat.mate.b3.2 = Es droht Matt: {my} will nach {sq}.
threat.mate.b3.3 = Pass auf: Ich drohe Schachmatt.
# A threat on a piece ({my} = my attacker, pointed at at level 1; {your} = the target, pointed at).
threat.piece.b1 = Schau mal. {my} greift {your:acc} an.
threat.piece.b1.2 = Vorsicht! {your} wird von {my:dat} angegriffen.
threat.piece.b1.3 = Pass auf, {my} will {your:acc} schlagen.
threat.piece.b2 = Vorsicht mit {your:dat}.
threat.piece.b2.2 = {your} wird angegriffen.
threat.piece.b2.3 = Achte auf {your:acc}.
threat.piece.b3 = {my} greift {your:acc} an, und Schlagen würde Material gewinnen.
threat.piece.b3.2 = {your} ist in Gefahr: {my} droht zu schlagen.
threat.piece.b3.3 = Vorsicht: Mein letzter Zug greift {your:acc} an.
# Eine Gabel, die der Zug des Trainers vorbereitet (Stufe 2): {my} auf {sq} greift {t1} und {t2} an.
threat.fork.b2 = {my} auf {sq} greift {t1:acc} und {t2:acc} gleichzeitig an. Das ist eine Gabel!
threat.fork.b2.2 = Vorsicht, das ist eine Gabel. {my} greift {t1:acc} und {t2:acc} an.
threat.fork.b2.3 = {my} greift {t1:acc} und {t2:acc} gleichzeitig an. Beide zu retten ist schwer.
# Eine Fesselung (Stufe 2): {my} auf {sq} hält {your} vor {t1}, der Figur dahinter.
threat.pin.b2 = {my} auf {sq} fesselt {your:acc} an {t1:acc}. Zieht die Figur weg, schlage ich {t1:acc}.
threat.pin.b2.2 = Vorsicht! {your} wird von {my:dat} gefesselt. Zieht die Figur weg, fällt {t1}.
threat.pin.b2.3 = {your} ist gefesselt. Verlässt die Figur ihr Feld, schlägt {my} {t1:acc}.
# Stufe 3: Die Stellung hat nur einen guten Zug (die beiden besten Züge der Engine liegen weit auseinander).
threat.only.b3 = Das ist eine kritische Stellung: Nur ein Zug ist wirklich gut. Lass dir Zeit.
threat.only.b3.2 = Vorsicht, es gibt hier nur einen guten Zug. Sieh dir erst alles an.
threat.only.b3.3 = Langsam: Die meisten Züge gehen in dieser Stellung schief.
threat.punish.b1 = Mein letzter Zug war ein Fehler. Kannst du ihn bestrafen?
threat.punish.b1.2 = Hm, ich glaube, ich habe einen Fehler gemacht. Findest du ihn?

# ---- Takebacks ------------------------------------------------------------------------------------
