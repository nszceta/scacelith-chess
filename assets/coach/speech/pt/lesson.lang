# Coach speech (European Portuguese): the rules lesson (level 0, src/coach/lesson.cpp).
# Same keys and variants as assets/coach/speech/en/lesson.lang.
#
# Placeholders: {your} / {my} = a piece of the player / of the coach, with its article ("a tua torre",
# "o meu cavalo"), and the forms of common.lang: {my:a} "ao meu cavalo / à minha torre", {my:de},
# {your:em}, {my:o} "o / a" (object pronoun: "Captura-{my:o}!"), {your:lo} ("movê-{your:lo}"),
# {your:este} "este / esta" ("{your:este} é {your}." = "Esta é a tua torre."), {my:dele}.
# {sq}, {sq2}, {to}, {esc} = squares ("em {sq}", "para {sq}", "a casa {sq}"); {move} = a move.
# {@}, {@2}, {@3} are invisible marks: the coach points while saying the word right after the mark.
# A ".spoken" key is what the voice says instead (here: file letters said by their Portuguese names,
# and the knight's "L" said as the letter name "éle").

# ---- Chapter titles (said inside "Vamos continuar com {chapter}.": with their article) -------------
lesson.title.welcome = o tabuleiro
lesson.title.pieces_lines = o movimento da torre, do bispo e da dama
lesson.title.pieces_steps = o movimento do rei, do cavalo e do peão
lesson.title.values_setup = o valor das peças e os primeiros lances
lesson.title.safety = as capturas seguras e as arriscadas
lesson.title.check = o xeque
lesson.title.mate = o xeque-mate
lesson.title.castling = o roque
lesson.title.en_passant = a captura en passant
lesson.title.promotion = a promoção
lesson.title.draws = o afogamento e os empates
lesson.title.before_move = a verificação antes de jogar
lesson.title.opening = a abertura
lesson.title.review = uma revisão rápida
lesson.title.etiquette = como funcionam as nossas partidas

# ---- Lines every exercise uses ------------------------------------------------------------------------
# After the coach demonstrated the solution.
lesson.now_you = Agora tenta tu.
lesson.now_you.2 = Agora é a tua vez.
lesson.now_you.3 = Agora tu.
# Another wrong move after the demonstration.
lesson.almost = Quase! Joga o lance que te mostrei.
lesson.almost.2 = Não é bem isso. Experimenta o lance da minha demonstração.
lesson.almost.3 = Estás quase lá. Lembra-te do que te acabei de mostrar.
# A wrong move without a line of its own.
lesson.try_again = Não é isso. Tenta outra vez.
lesson.try_again.2 = Esse não. Experimenta de novo.
lesson.try_again.3 = Vamos tentar mais uma vez.
lesson.use_your = Usa {your}.
lesson.use_your.2 = Experimenta com {your}.
lesson.watch = Repara.
lesson.like_this = Assim.
lesson.and_back = E voltamos atrás.
# A check that is not checkmate (the coach then shows the escape).
lesson.check_escape = Xeque, mas o meu rei foge para {esc}.
lesson.check_takes = Xeque, mas o meu rei limita-se a capturar {your}.
lesson.check_block = Xeque, mas posso pôr uma peça no caminho.
lesson.stalemate = Afogamento! O meu rei não se pode mexer e não está em xeque. É empate, embora estivesses a ganhar!

# ---- Why a move is not allowed (the coach points at the piece or square in question) ----------------
# {sq} = the square in question, {my} = the coach's piece that attacks, pins, blocks or gives
# check, {your} = the piece the player tried to move.
why.KingIntoCheck = Para {sq}, não: {my} ataca essa casa. Um rei nunca se põe em perigo.
why.PathBlocked = Há alguma coisa no {@}caminho: as peças não saltam, exceto o cavalo.
why.WrongGeometry = {your} não se move assim.
why.MustAnswerCheck = Estás em {@}xeque: primeiro tens de resolver isso.
why.CastlingThroughCheck = O teu rei passaria por {sq}, e {my} ataca essa casa.
why.CastlingNoRights = Esse rei ou essa torre já se moveu: o roque deixou de ser possível.
why.CastlingBlocked = Para fazer o roque, as casas entre o rei e a torre têm de estar vazias.
why.CastlingOutOfCheck = Não podes fazer o roque quando estás em xeque.
why.PawnForwardBlocked = Os peões não capturam em frente: essa casa está {@}bloqueada.
why.LeavesKingInCheck = {your} está cravad{your:o}: movê-{your:lo} deixaria o teu rei exposto {my:a}.
why.OwnPieceOnTarget = Não podes ir para uma casa ocupada por uma peça tua.
why.PawnCaptureNeedsVictim = Um peão só anda na diagonal para capturar.
why.EnPassantExpired = A captura en passant só é permitida logo a seguir ao avanço de duas casas do peão.
why.NotYourTurn = Espera: agora é a minha vez.

# ---- Chapter 0: welcome and the board -------------------------------------------------------------------
lesson.welcome.hello = Olá! Sou o teu treinador. Vamos aprender juntos as regras do xadrez, passo a passo.
lesson.welcome.board = Este é o tabuleiro: sessenta e quatro casas, claras e escuras, oito filas de oito casas.
lesson.welcome.light = A casa do canto à tua {@}direita é sempre clara. Lembra-te: clara à direita.
lesson.welcome.files = As linhas verticais chamam-se colunas. Têm letras, do {@}a ao {@2}h.
lesson.welcome.files.spoken = As linhas verticais chamam-se colunas. Têm letras, do {@}á ao {@2}agá.
lesson.welcome.ranks = As linhas horizontais chamam-se filas. Têm números, do {@}um ao {@2}oito, a começar do teu lado.
lesson.welcome.square = Cada casa tem um nome: primeiro a letra, depois o número. Esta é a casa {sq}.
lesson.welcome.square2 = E esta é a casa {sq}.
lesson.welcome.kings = Estes são os dois reis. O teu está em {sq}, o meu está em {sq2}.
lesson.welcome.ask = É a tua vez: avança o teu rei uma casa, para {sq}.
lesson.welcome.wrong = Essa é a casa {to}. Queremos a casa {sq}: a letra e, o número dois.
lesson.welcome.wrong.spoken = Essa é a casa {to}. Queremos a casa {sq}: a letra é, o número dois.
lesson.welcome.ok = Perfeito. O teu rei está em {sq}.

# ---- Chapter 1: how the pieces move and capture -----------------------------------------------------------
# Rook
lesson.rook.intro = {your:este} é {your}. Move-se em linha reta, pelas colunas e pelas filas, até onde quiser.
lesson.rook.lines = Pela coluna acima, {@}ou ao longo da fila.
lesson.rook.capture = Para capturar, uma peça vai para a casa de uma peça {@}adversária, que sai do tabuleiro.
lesson.rook.ask = Captura {my} com a tua torre!
lesson.rook.short = Boa direção! Continua pela coluna acima, até {my:a}.
lesson.rook.rank = Assim vais ao longo da fila. {my} está mais acima, na coluna.
lesson.rook.king = Esse é o teu rei. Usa {your}, no canto.
lesson.rook.ok = Boa captura! {my} sai do tabuleiro.
# Pieces don't jump
lesson.jump.blocked = As peças não podem saltar por cima das outras. O teu peão em {sq} tapa o caminho da torre.
lesson.jump.all = Passa-se o mesmo com o bispo e a dama: também não podem saltar por cima das peças.
# Bishop
lesson.bishop.intro = {your:este} é {your}. Move-se na diagonal, até onde quiser.
lesson.bishop.colour = Um bispo fica sempre em casas da mesma cor.
lesson.bishop.ask = {my} está na diagonal do teu bispo. Captura-{my:o}!
lesson.bishop.short = Diagonal certa! Vai mais longe, até chegares {my:a}.
lesson.bishop.other = Essa é a outra diagonal. Olha na direção {my:de}.
lesson.bishop.ok = Excelente. Os bispos adoram as grandes diagonais.
# Queen
lesson.queen.intro = {your:este} é {your}, a peça mais forte. Move-se como uma torre e um bispo juntos.
lesson.queen.ask = Encontra {my} e captura-{my:o} com a tua dama.
lesson.queen.wrong = A tua dama pode chegar {my:a} num só lance, por uma diagonal.
lesson.queen.ok = Muito bem! Mantém a tua dama em segurança: vale muito.
# King
lesson.king.intro = O rei move-se só uma casa, em qualquer direção.
lesson.king.important = O rei é a peça mais importante. Se ficar encurralado, a partida está perdida.
lesson.king.ask = O rei também pode capturar. Toma {my}!
lesson.king.wrong = O teu rei está mesmo ao lado {my:de}. Entra na casa {my:dele} para {my:o} capturar.
lesson.king.ok = Boa! O rei é lento, mas é forte a curta distância.
# Knight
lesson.knight.intro = {your:este} é {your}. Move-se em L: duas casas a direito, depois uma para o lado.
lesson.knight.intro.spoken = {your:este} é {your}. Move-se em éle: duas casas a direito, depois uma para o lado.
lesson.knight.l = {@}Assim. Vai sempre parar a uma casa da outra cor.
lesson.knight.jump = O cavalo é a única peça que pode saltar por cima das outras.
lesson.knight.ask = Captura {my} com o teu cavalo!
lesson.knight.wrong = É um lance de cavalo válido, mas não chega {my:a}. Experimenta outro L.
lesson.knight.wrong.spoken = É um lance de cavalo válido, mas não chega {my:a}. Experimenta outro éle.
lesson.knight.ok = Belo salto!
# Pawn: moving
lesson.pawn.intro = Agora, {your}. Avança a direito, uma casa de cada vez, e nunca recua.
lesson.pawn.first = No seu primeiro lance, um peão pode avançar uma ou duas casas.
lesson.pawn.ask = Avança o teu peão duas casas.
lesson.pawn.one = Isso é uma casa: é legal, mas desta vez avança duas.
lesson.pawn.use = Usa o peão.
lesson.pawn.ok = Boa.
# Pawn: capturing
lesson.pawncap.blocked = O meu peão bloqueia o teu. Os peões não capturam em frente.
lesson.pawncap.diagonal = Mas um peão captura na diagonal, uma casa para a frente.
lesson.pawncap.ask = Captura {my} com o teu peão.
lesson.pawncap.use = Usa {your}: captura na diagonal, para a frente.
lesson.pawncap.ok = Isso! Em frente para andar, na diagonal para capturar.
# Values, set-up and the first moves
lesson.values.pawn = Cada peça tem um valor em pontos. Um peão vale um.
lesson.values.pieces = Um cavalo ou um {@}bispo, três. Uma {@2}torre, cinco. A {@3}dama, nove.
lesson.values.king = O rei não tem preço: nunca o podes entregar.
lesson.values.trade = Não troques uma peça maior por uma menor, a não ser que ganhes mais do que perdes.
lesson.values.two = O teu cavalo ataca duas das minhas peças, em {sq} e em {sq2}. Nenhuma delas está defendida.
lesson.values.ask = Toma a que vale mais!
lesson.values.small = Isso é um peão, que vale um. {my} também estava livre, e vale nove.
lesson.values.look = Olha para o que o teu cavalo ataca e toma a peça que vale mais.
lesson.values.ok = Sim! Uma dama vale nove. Quando há duas peças livres, toma a maior.
lesson.setup.corners = Todas as partidas começam assim: as torres nos {@}cantos, depois os {@2}cavalos, depois os {@3}bispos.
lesson.setup.queen = A dama fica na casa da sua cor: a tua dama está numa casa clara.
lesson.setup.king = O rei fica ao lado dela. As brancas jogam sempre primeiro.
lesson.first.ask = Começa a partida: avança duas casas o peão que está à frente do teu rei, para {sq}.
lesson.first.wrong = Esse lance também é legal! Mas, por agora, joga o peão do teu rei para {sq}, por favor.
lesson.first.ok = Um ótimo primeiro lance: abre linhas para a tua dama e para o teu bispo.
lesson.first.reply = Respondo da mesma maneira. Agora põe um cavalo em jogo: salta de {sq} para {sq2}.
lesson.first.knight_wrong = Os cavalos saltam por cima dos peões. Experimenta de {sq} para {sq2}.
lesson.first.knight_ok = Perfeito. Os cavalos e os bispos saem cedo.

# ---- Chapter 2: safe and unsafe captures ---------------------------------------------------------------------
lesson.safety.defended = Uma peça está defendida quando uma peça amiga pode retomar.
lesson.safety.pawn = O meu {@}peão defende {my}.
lesson.safety.free = Mas {my} não tem defensor. A tua dama ataca as duas peças.
lesson.safety.ask = Captura a peça indefesa!
lesson.safety.watch = Vê o que acontece.
lesson.safety.gave = Deste a tua dama, que vale nove, pelo meu cavalo, que vale três.
lesson.safety.gave.spoken = Déste a tua dama, que vale nove, pelo meu cavalo, que vale três.
lesson.safety.other = Experimenta a outra peça.
lesson.safety.look = Procura a peça que nada defende.
lesson.safety.ok = Excelente! Pergunta sempre: essa peça está defendida?
lesson.safety.pawns = A tua dama ataca dois dos meus peões: {sq} e {sq2}.
lesson.safety.pawns_ask = Captura o peão que é seguro tomar.
lesson.safety.gave_pawn = Deste a tua dama, que vale nove, por um peão, que vale um.
lesson.safety.gave_pawn.spoken = Déste a tua dama, que vale nove, por um peão, que vale um.
lesson.safety.pawns_other = Até um peão pode estar defendido. Experimenta o outro peão.
lesson.safety.pawns_ok = Certo! Nunca arrisques a dama por um peão defendido.
lesson.safety.small = Agora ao contrário. {my} está defendid{my:o}, mas o teu peão ataca-{my:o}.
lesson.safety.small_count = Se a tomares, o meu {@}peão toma o teu de volta. Dás um ponto e ganhas nove.
lesson.safety.small_ask = Captura a minha dama com a peça certa!
lesson.safety.small_other = Toma-a antes com o teu peão: a peça mais barata que pode.
lesson.safety.small_look = O teu peão ataca a minha dama. Captura-a com ele.
lesson.safety.small_ok = Isso! Uma peça pequena pode tomar uma grande, mesmo defendida: perdes um ponto e ganhas nove.
lesson.safety.count = Antes de cada captura, conta o que ganhas e o que podes perder a seguir.

# ---- Chapter 3: check and getting out of check -----------------------------------------------------------------
lesson.danger.rank = A minha torre controla toda a segunda fila.
lesson.danger.rule = Um rei nunca pode ir para uma casa onde possa ser capturado.
lesson.danger.ask = Leva o teu rei para uma casa segura.
lesson.danger.ok = Certo. Aí, o teu rei está em segurança.
lesson.check.what = A minha torre ataca o teu rei. A isso chama-se xeque.
lesson.check.must = Quando estás em xeque, tens de sair dele imediatamente.
lesson.check.ways = Há três maneiras: {@}mover o rei, {@2}bloquear o ataque ou {@3}capturar a peça atacante.
lesson.check.ask = Aqui, tira o teu rei do xeque.
lesson.check.file = A casa {to} ainda está na coluna da {@}minha torre. Sai dessa linha.
lesson.check.ok = Boa: já não estás em xeque.
lesson.block.again = Xeque outra vez! Desta vez, o teu rei não tem nenhuma casa livre.
lesson.block.ask = Então bloqueia o ataque: põe uma peça no caminho.
lesson.block.queen = Isso bloqueia! Mas a minha torre podia tomar a tua dama. Bloqueia com uma peça de menor valor.
lesson.block.queen_ok = Funciona. Lembra-te: bloqueia com a tua peça de menor valor.
lesson.block.ok = Perfeito. Bloqueia com a peça que vale menos.
lesson.capture.check = A minha dama dá xeque, mesmo ao lado do teu rei.
lesson.capture.ask = Captura a peça atacante!
lesson.capture.king_ok = Isso! A minha dama não tinha defensor, por isso o teu rei podia tomá-la.
lesson.capture.knight_ok = Isso! O teu cavalo eliminou a peça atacante.
lesson.check.open.ask = Xeque outra vez! Desta vez, sai dele como quiseres.
lesson.check.open.king = Afastaste o rei. Também podias ter bloqueado com uma peça, ou o teu cavalo podia ter tomado a minha torre.
lesson.check.open.block = Bloqueaste o ataque. O teu rei também podia ter-se afastado, ou o teu cavalo podia ter tomado a minha torre.
lesson.check.open.take = Tomaste a minha torre, a peça que dava xeque. Mover o rei ou bloquear também resultava.
lesson.check.open.hint = Três maneiras: {@}mover o rei, {@2}bloquear na coluna ou {@3}capturar a minha torre com o teu cavalo.

# ---- Chapter 4: checkmate ------------------------------------------------------------------------------------
lesson.mate1.what = Xeque-mate: o rei está em xeque e não tem como escapar. É assim que se ganha a partida.
lesson.mate1.stuck = O meu rei está preso atrás dos seus {@}próprios peões.
lesson.mate1.ask = Dá-me xeque-mate num lance!
lesson.mate1.wrong = Quase! Dá xeque na minha última fila, onde o meu rei não consegue fugir.
lesson.mate1.ok = Xeque-mate! É o mate da última fila. Não te esqueças dele!
lesson.mate1.king = O teu rei está bem onde está. Usa a torre para dar xeque.
lesson.mate1.why = Vês? A torre cobre {@}toda a minha última fila, e os meus {@2}próprios peões ocupam as casas à frente do meu rei.
lesson.mate2.ask = O teu rei e a tua dama trabalham em equipa. Dá-me xeque-mate num lance.
lesson.mate2.wrong = Encontra um xeque que não deixe nenhuma casa ao meu rei.
lesson.mate2.ok = Xeque-mate! O teu rei protege a dama, por isso o meu não a pode tomar.
lesson.mate2.ok_rank = Xeque-mate na última fila! O teu rei controla todas as casas à frente do meu.
lesson.mate2.king = O teu rei guarda as casas ao lado do meu. Deixa-o ficar e usa a dama.
lesson.mate2.half = Isso vigia {sq}, mas o meu rei ainda pode ir para {sq2}.
lesson.mate2.why = Vês? A tua dama cobre {sq} e {sq2}, e o teu rei cobre as casas à frente do meu. O meu rei não tem saída.
lesson.mate3.edge = A tua torre na sétima fila mantém o meu rei preso à borda do tabuleiro.
lesson.mate3.ask = Agora usa {your} para dar xeque-mate.
lesson.mate3.free = Xeque, mas agora a sétima fila ficou livre, e o meu rei escapa.
lesson.mate3.takes = O meu rei limita-se a tomar a tua torre.
lesson.mate3.hint = Dá xeque na última fila com a torre que não está a guardar a sétima.
lesson.mate3.ok = Xeque-mate! As duas torres trabalharam como uma escada.
lesson.mate3.why = Vês? Uma torre corta a {@}sétima fila, e a outra dá xeque na {@2}última fila. O meu rei não tem saída.
lesson.mate4.look = Xeque nem sempre é xeque-mate. Vamos ver o que acontece.
lesson.mate4.ask = Dá xeque ao meu rei com a tua torre.
lesson.mate4.king = O teu rei fica onde está. Usa a torre para dar xeque.
lesson.mate4.wrong = Isso não é xeque. A tua torre pode atacar o meu rei a partir da última fila.
lesson.mate4.ok = Sim, é xeque! Mas será xeque-mate? Repara.
lesson.mate4.after = O meu peão em {sq} deu espaço ao meu rei. Antes de festejares um xeque, conta as casas que o meu rei ainda pode usar.
lesson.mate5.ask = Dois lances da tua torre dão xeque, e só um é xeque-mate. Conta as casas do meu rei e escolhe.
lesson.mate5.king = O teu rei já cobre {sq} e {sq2}. Deixa-o ficar e mexe a torre.
lesson.mate5.wrong = Isso não é xeque. Procura um lance de torre que ataque o meu rei.
lesson.mate5.hint = O teu rei cobre {sq} e {sq2}. Que xeque de torre tira também {sq3}?
lesson.mate5.why = Vês? A torre cobre {sq}, o teu rei cobre as outras duas casas, e o meu rei fica preso.
lesson.mate5.ok = Xeque-mate! Contaste as casas do meu rei: não sobrou nenhuma.

# ---- Chapter 5: castling ---------------------------------------------------------------------------------------
lesson.castle.what = O roque é um lance especial que põe o teu rei em segurança. O rei e a torre movem-se juntos.
lesson.castle.how = O {@}rei anda duas casas em direção a uma torre, e a {@2}torre salta para o outro lado dele.
lesson.castle.ask = Toca sempre primeiro no rei. Agora tu: faz o roque pequeno, do lado do rei.
lesson.castle.rook = Assim só mexes a torre. Para fazer o roque, move o teu rei duas casas na direção dela.
lesson.castle.long = Isso é o roque grande, também legal! Desta vez, faz o roque para o lado da torre mais próxima.
lesson.castle.one = Uma casa é um lance normal do rei. No roque, o rei anda duas.
lesson.castle.other = Para fazer o roque, move o teu rei duas casas em direção à torre em {sq}.
lesson.castle.ok = Roque feito! O teu rei está abrigado, e a tua torre está pronta para entrar em jogo.
lesson.castle2.moved = Não podes fazer o roque se o teu rei ou essa torre já se tiverem mexido.
lesson.castle2.attacked = Nem quando estás em xeque, nem se o teu rei tiver de atravessar uma casa atacada ou de ir parar a uma.
lesson.castle2.bishop = O meu bispo ataca a casa {sq}. Por isso, agora é proibido fazer o roque deste lado.
lesson.castle2.ask = Faz o roque do outro lado.
lesson.castle2.other = Faz o roque na direção da tua outra torre, do lado da dama.
lesson.castle2.ok = Correto! O roque grande põe o teu rei em {sq}.
lesson.ep0.rule = O en passant começa com o avanço duplo. Só um peão {@}ainda em casa pode andar duas casas. Um peão que {@2}já se mexeu anda uma de cada vez.
lesson.ep0.ask = Avança um dos teus peões duas casas.
lesson.ep0.moved = Esse peão já se mexeu, por isso só pode andar uma casa. Usa o peão que ainda está em casa.
lesson.ep0.ok = Certo: só um peão na sua casa de partida pode andar duas.

# ---- Chapter 6: en passant ------------------------------------------------------------------------------------
lesson.ep.what = Há uma captura especial de peão chamada en passant. Quer dizer «de passagem».
lesson.ep.watch = Olha para o meu peão: avança duas casas e fica mesmo ao lado do teu.
lesson.ep.how = O teu peão pode capturá-lo como se ele só tivesse avançado uma casa: para {sq}.
lesson.ep.now = Mas só agora, neste lance. Captura en passant!
lesson.ep.gone = A oportunidade passou: o en passant só funciona logo a seguir. Vamos tentar outra vez.
lesson.ep.ok = En passant! O meu peão em {sq} sai do tabuleiro.
lesson.ep2.old = O meu peão em {sq} está ao lado do teu há algum tempo. Já é tarde para o capturar en passant.
lesson.ep2.watch = Agora repara no meu outro peão.
lesson.ep2.ask = Dois dos meus peões estão ao lado do teu, mas só um acabou de avançar duas casas. Captura esse en passant!
lesson.ep2.push = Isso só avança o teu peão. Captura o peão que acabou de avançar duas casas.
lesson.ep2.wrong = Procura o peão que acabou de fazer o avanço duplo e captura-o en passant.
lesson.ep2.hint = O meu peão em {sq} acabou de avançar duas casas. Captura-o en passant, para {sq2}.
lesson.ep2.ok = En passant! O meu peão em {sq} não podia ser capturado: a oportunidade tinha passado.

# ---- Chapter 7: promotion -------------------------------------------------------------------------------------
lesson.promo.what = Quando um peão chega à última fila, é promovido: transforma-se em dama, torre, bispo ou cavalo.
lesson.promo.ask = Quase sempre, escolhe-se a dama. Promove agora o teu peão!
lesson.promo.under = É permitido! Mas a dama é mais forte. Vamos escolher a dama.
lesson.promo.under_ok = Está bem. Mas a maioria dos jogadores escolhe a dama.
lesson.promo.push = Avança o teu peão até à última fila, para {sq}.
lesson.promo.ok = Uma dama nova! Podes até ter duas damas ao mesmo tempo.
lesson.promo2.ask = Um peão também pode ser promovido ao capturar, na diagonal. Toma a minha torre e faz uma dama!
lesson.promo2.push = Isso também promove, mas a minha torre guarda {sq}. Repara.
lesson.promo2.lost = A minha torre tomou a tua peça nova. Captura primeiro a minha torre.
lesson.promo2.wrong = Isso não captura a minha torre. O teu peão toma na diagonal, em {sq}.
lesson.promo2.hint = Toma a minha torre com o teu peão, para {sq}: promove ao capturar.
lesson.promo2.ok = Capturou e promoveu! Um peão pode fazer as duas coisas num só lance.

# ---- Chapter 8: stalemate and draws -----------------------------------------------------------------------------
lesson.stale.what = É a minha vez. O meu rei não está em xeque, mas {@}todas as casas à volta dele estão atacadas.
lesson.stale.draw = Não tenho nenhum lance legal. Isso é afogamento, e a partida termina empatada.
lesson.stale2.ask = Quando estás a ganhar, cuidado com o afogamento. Dá-me xeque-mate num lance, sem afogar o meu rei!
lesson.stale2.wrong = Encontra um xeque que não deixe nenhuma casa ao meu rei. Cuidado: um lance tranquilo pode afogar-me.
lesson.stale2.king = O teu rei já cobre {sq} e {sq2}. Deixa-o ficar e usa a dama.
lesson.stale2.hint = O teu rei cobre {sq} e {sq2}. Dá xeque ao longo da última fila, e o meu rei não tem para onde ir.
lesson.stale2.why = Vês? O meu rei está atacado {@}e não tem nenhuma casa livre: é xeque-mate. Sem o xeque, seria afogamento.
lesson.stale2.ok = Xeque-mate! Deixa sempre um lance ao rei adversário, a não ser que lhe estejas a dar mate.
lesson.draws.kings = Outros empates: quando ninguém pode dar xeque-mate, como quando só restam os dois reis, a partida é empate.
lesson.draws.agree = Os jogadores também podem combinar um empate.
lesson.draws.repeat = Repetir a mesma posição três vezes, ou fazer cinquenta lances sem capturas nem lances de peão, também permite o empate.

# ---- Chapter 9: before you move (the safety habit) ----------------------------------------
lesson.before.habit = Antes de cada lance, para e olha. Os bons jogadores fazem-no sempre.
lesson.before.last = Primeira pergunta: o que fez o meu último lance? Olha.
lesson.before.threat = {my} ataca {your}. É uma ameaça.
lesson.before.safe = Afastar-se não chega. A nova casa também tem de ser segura.
lesson.before.dodge.ask = Leva o teu cavalo para uma casa segura.
lesson.before.dodge.still = O teu cavalo continua atacado. Olha.
lesson.before.dodge.hint = Os meus peões protegem {sq} e {sq2}. Escolhe outra casa.
lesson.before.dodge.ok = Segura! Viste a ameaça e verificaste a casa.
# A wrong move onto a guarded square ({my} guards {to}); the coach then takes the piece.
lesson.before.unsafe = {to} não: {my} protege essa casa. Olha.
# Said after the coach took the piece, before the move is taken back.
lesson.before.lost = Perdeste {your}. Primeiro olha, depois joga.
lesson.before.again = Mais uma vez, jogo eu primeiro. Olha.
lesson.before.free.ask = Olha para o meu último lance. Consegues capturar alguma coisa de graça?
lesson.before.free.missed = Olha outra vez para {my}. Quem consegue {my:o} capturar?
lesson.before.free.hint = {my} não tem defesa. O teu {@}peão consegue {my:o} capturar.
lesson.before.free.ok = Sim! O meu bispo estava livre. Olha sempre para o meu último lance.
lesson.before.check.ask = Dá-me xeque a partir de uma casa onde eu não possa capturar.
lesson.before.check.wrong = Isso não é xeque. Encontra um xeque a partir de uma casa segura.
lesson.before.check.hint = {my} protege {sq}. Dá xeque a partir de uma casa segura.
lesson.before.check.ok = Bom xeque! A tua dama está segura aí.
lesson.before.done = Faz disso um hábito: primeiro olha, depois joga.

# ---- Chapter 10: the opening ------------------------------------------------------------
lesson.opening.what = A abertura é o início da partida. Algumas regras simples ajudam.
lesson.opening.goals = {@}Toma o centro, {@2}põe em jogo cavalos e bispos, e {@3}faz o roque cedo.
lesson.opening.centre = As quatro casas do {@}meio são o centro.
lesson.opening.pawn.ask = Põe um peão no centro: duas casas em frente.
lesson.opening.pawn.one = Nada mau, mas duas casas ocupam mais do centro.
lesson.opening.pawn.knight = Os cavalos vêm já a seguir. Primeiro, um peão no centro.
lesson.opening.pawn.wrong = Usa o peão que está à frente do teu rei ou da tua dama.
lesson.opening.pawn.ok = Boa! O teu peão ganha espaço no centro.
lesson.opening.queen = Não ponhas a dama em jogo cedo: as minhas peças iam persegui-la.
lesson.opening.knight.ask = Põe um cavalo em jogo, em direção ao centro.
lesson.opening.rim = Um cavalo na beira alcança poucas casas. Salta em direção ao centro.
lesson.opening.bishop = Desenvolver é bom! Mas desta vez, um cavalo.
lesson.opening.knight.ok = Boa! Dali o teu cavalo vigia o centro.
lesson.opening.later = Alguns lances depois: o teu cavalo e o teu {@}bispo já estão em jogo.
lesson.opening.twice = Não mexas duas vezes na mesma peça sem uma boa razão.
lesson.opening.castle.ask = O caminho está livre. Faz o roque para pôr o rei em segurança.
lesson.opening.castle.wrong = O teu rei está pronto. Faz o roque agora, enquanto o caminho está livre.
lesson.opening.castle.ok = Roque feito! O teu rei está seguro e a torre entra no jogo.
lesson.opening.done = Centro, peças, roque: é um bom começo para qualquer partida.

# ---- Chapter 11: review (no teaching: the coach only asks) ----
lesson.review.start = Revisão rápida, desta vez por outra ordem. Não explico nada: mostras-me tu.
lesson.review.promo.ask = Promove este peão.
lesson.review.promo.ok = Boa: uma dama nova, e com xeque!
lesson.review.check.ask = O teu rei está em xeque. Sai dele.
lesson.review.check.ok = Fora de xeque. Bom.
lesson.review.castle.ask = Faz o roque, do lado em que é permitido.
lesson.review.castle.other = Isso não é roque. Faz o roque do lado em que é permitido.
lesson.review.castle.ok = Roque feito, do lado seguro!
lesson.review.ep.ask = Captura o meu peão en passant.
lesson.review.ep.ok = En passant! Lembraste-te.
lesson.review.mate.ask = Dá-me xeque-mate num lance.
lesson.review.mate.ok = Xeque-mate! Revisão concluída.

# ---- Chapter 12: how our games work (no rating, no clock, touch-move, help, manners) -----------------------------
lesson.talk.rules = Agora já conheces todas as regras do xadrez. Muito bem!
lesson.talk.real = Deixa-me contar-te como vão ser as nossas partidas.
lesson.talk.no_clock = Comigo, não há relógio nem Elo. Leva todo o tempo de que precisares para pensar.
lesson.talk.touch = Uma peça em que tocas tem de ser jogada: por isso, primeiro olha, depois toca.
lesson.talk.handshake = As partidas começam e acabam com um aperto de mão. É uma forma de dizer «boa partida» e de agradecer.
lesson.talk.polite = Ganhes ou percas, mantém a cortesia, e nunca incomodes o adversário enquanto pensa.
lesson.talk.help = Nas nossas partidas, eu ajudo-te. Se uma das tuas peças estiver atacada ou sem proteção, eu digo-te.
lesson.talk.help_back = Depois de um grande erro, mostro-te porquê e ofereço-me para desfazer o teu lance.
lesson.talk.help_skip = E se eu falar demais, carrega na barra de espaço: eu calo-me.
lesson.talk.next = Quando quiseres, joga «Primeiros passos». Vou jogar com calma.
lesson.talk.welcome = Boas-vindas ao xadrez! Vamos dar um aperto de mão.
