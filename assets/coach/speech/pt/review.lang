# ---- Demonstration narration: one short line per move shown on the board ------------------------
# Levels 4-6: just the move.
demo.move = {move}.
demo.move.2 = {move}.
demo.move.3 = Depois, {move}.
# Levels 1-3, the coach's moves.
demo.my.move = {my} vai para {sq}.
demo.my.move.2 = Jogo {my} para {sq}.
demo.my.move.3 = Depois, {my} vai para {sq}.
demo.my.take = Tomo {your}.
demo.my.take.2 = {my} toma {your}.
demo.my.take.3 = E capturo {your}.
demo.my.check = {my} vai para {sq}. Xeque.
demo.my.check.2 = Xeque, com {my} em {sq}.
demo.my.check.3 = {my} para {sq}, xeque!
demo.my.mate = {my} vai para {sq}. Xeque-mate.
demo.my.mate.2 = E {my} para {sq} é xeque-mate.
demo.my.mate.3 = {my} para {sq}. Isso é xeque-mate.
# Levels 1-3, the coach's in-between move: a capture, a check or a quiet move played first while a
# bigger piece of the player's ({t1}) is attacked; the next move of the coach's takes it.
# "{t1} não foge" = "{t1} will still be there" (it is not going anywhere).
demo.my.first.take = Primeiro, {my} toma {your}. {t1} pode esperar.
demo.my.first.take.2 = {my} toma primeiro {your}. {t1} não foge.
demo.my.first.check = {my} toma {your}, e é xeque! {t1} pode esperar.
demo.my.first.check.2 = Primeiro, {my} toma {your}, com xeque. {t1} não foge.
demo.my.first.check_move = Primeiro, xeque com {my} em {sq}. {t1} pode esperar.
demo.my.first.check_move.2 = {my} vai para {sq}: primeiro o xeque! {t1} não foge.
demo.my.first.move = Primeiro, {my} vai para {sq}. {t1} pode esperar.
demo.my.first.move.2 = Primeiro, {my} para {sq}. {t1} não foge.
# The piece that moves was attacked itself: it takes something before it can be taken.
demo.my.first.attacked = {my} está atacad{my:o}, por isso toma primeiro {your}.
demo.my.first.attacked.2 = {my} está sob ataque: primeiro, apanha {your}.
# Levels 4-6, the same in-between move.
demo.first = Primeiro {move}: {t1} pode esperar.
demo.first.2 = Primeiro, {move}. {t1} não foge.
# After the rewind when no takeback is offered: the coach's real move comes next.
demo.play_on = Agora jogo o meu lance.
demo.play_on.2 = Aqui está o meu verdadeiro lance.
demo.play_on.3 = E agora, o meu lance a sério.
# Levels 1-3, the player's moves (what they would play).
demo.your.move = Levarias {your} para {sq}.
demo.your.move.2 = Imagina que jogas {your} para {sq}.
demo.your.move.3 = Depois, {your} vai para {sq}.
demo.your.take = Tomarias {my}.
demo.your.take.2 = Tomas {my} com {your}.
demo.your.take.3 = Depois, capturas {my}.
demo.your.back = Retomas.
demo.your.back.2 = Retomas em {sq}.
demo.your.back.3 = E voltas a capturar.
demo.your.king = O teu rei tem de se mover.
demo.your.king.2 = O rei tem de sair dali, para {sq}.
demo.your.king.3 = O teu rei foge para {sq}.
# Levels 4-6 (and 1-3 when the whole line is too long): the demonstration stops where the problem
# stands, and the coach points at what comes next ({t1} {t2} = the pieces that fall, pointed at;
# {reply} = the mating move, traced; the pieces where they stand at that moment).
ex.point.piece = Agora, já nada pode salvar {t1}.
ex.point.piece.2 = E {t1} está perdid{t1:o}.
ex.point.piece.3 = A seguir, cai {t1}.
ex.point.two = Ataco {t1} e {t2} ao mesmo tempo: uma das duas peças vai cair.
