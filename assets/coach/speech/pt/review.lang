ex.verdict.blunder.b1.2 = Cuidado! Esse lance pode custar-te caro.
ex.verdict.blunder.b1.3 = Oh, espera. Esse lance tem um problema.
ex.verdict.blunder.b2 = Hum, esse lance tem um problema.
ex.verdict.blunder.b2.2 = Isso é um grande erro.
ex.verdict.blunder.b2.3 = Cuidado, esse lance custa-te alguma coisa.
ex.verdict.blunder.b3 = Isso é um erro grave.
ex.verdict.blunder.b3.2 = {move} é um verdadeiro erro.
ex.verdict.blunder.b3.3 = Ai, {move} é um grande erro.
ex.verdict.blunder.b4 = {move} é um erro grave.
ex.verdict.blunder.b4.2 = {move} é um erro sério.
ex.verdict.blunder.b4.3 = Lamento, mas isso é um erro grave.
ex.verdict.blunder.b5 = {move} é um erro sério.
ex.verdict.blunder.b5.2 = {move} é um erro grave.
ex.verdict.blunder.b5.3 = {move} é um erro que sai caro.
ex.verdict.blunder.b6 = {move} é um erro sério.
ex.verdict.blunder.b6.2 = {move} é um erro grave.
ex.verdict.blunder.b6.3 = {move}? Um erro grave.
# A blunder that leaves the coach's threat standing (levels 1-2: the threat the engine found after the
# coach's last move is what the reply carries out).
ex.verdict.ignored.b1 = Ups! Não respondeste à minha ameaça.
ex.verdict.ignored.b1.2 = Cuidado! A minha ameaça ainda lá estava.
ex.verdict.ignored.b1.3 = Oh, espera. Esqueceste-te da minha ameaça.
ex.verdict.ignored.b2 = Hum, a minha ameaça ainda lá estava.
ex.verdict.ignored.b2.2 = Deixaste a minha ameaça sem resposta.
ex.verdict.ignored.b2.3 = Cuidado, não respondeste à minha ameaça.
ex.verdict.mistake.b3 = Esse não é um bom lance.
ex.verdict.mistake.b3.2 = Hum, {move} tem um problema.
ex.verdict.mistake.b3.3 = Isso é um erro.
ex.verdict.mistake.b4 = {move} é um erro.
ex.verdict.mistake.b4.2 = {move} não é bom.
ex.verdict.mistake.b4.3 = Isso é um erro.
ex.verdict.mistake.b5 = {move} é um erro claro.
ex.verdict.mistake.b5.2 = {move} é um erro.
ex.verdict.mistake.b5.3 = {move} não é bom.
ex.verdict.mistake.b6 = {move} é um erro.
ex.verdict.mistake.b6.2 = {move}? Um erro.
ex.verdict.mistake.b6.3 = {move}, não.
# A dubious move (an inaccuracy; a costly move with nothing concrete to show while still better):
# only the better move is named ({best} is pointed at), never a scenario. "Impreciso" alone could be
# heard as said of the player: the lines say "uma imprecisão" or "um lance impreciso".
ex.verdict.inaccuracy.b3 = Nada mau, mas {best} era um pouco melhor.
ex.verdict.inaccuracy.b3.2 = {best} era ligeiramente mais preciso.
ex.verdict.inaccuracy.b3.3 = Um pequeno deslize: aqui, {best} era melhor.
ex.verdict.inaccuracy.b4 = Uma imprecisão: {best} era mais preciso.
ex.verdict.inaccuracy.b4.2 = Uma pequena imprecisão. {best} era um pouco melhor.
ex.verdict.inaccuracy.b4.3 = Não é bem o melhor: {best} era mais exato.
ex.verdict.inaccuracy.b5 = {move} é impreciso; {best} era mais forte.
ex.verdict.inaccuracy.b5.2 = Um lance ligeiramente impreciso. Eu teria jogado {best}.
ex.verdict.inaccuracy.b5.3 = {best} era mais preciso do que {move}.
ex.verdict.inaccuracy.b6 = {move} é impreciso; {best}.
ex.verdict.inaccuracy.b6.2 = Imprecisão. {best}.
ex.verdict.inaccuracy.b6.3 = {best} era melhor.
# Level 6, an inaccuracy at the bottom of its class (deeper searches often clear it): a hedged word.
ex.verdict.inaccuracy.maybe = {best} talvez fosse um pouco mais preciso.
ex.verdict.inaccuracy.maybe.2 = Eu talvez tivesse jogado {best}.
# A dubious move that loses material (levels 3-6): the remark alone, never "a bit better" (at level 6
# under 6 points, the hedged word above unless a piece is lost).
ex.verdict.dubious = Esse lance parece duvidoso.
ex.verdict.dubious.2 = Esse lance parece-me duvidoso.
# Something good was missed (levels 1-2).
ex.verdict.missed.b1 = Oh, espera! Deixaste escapar uma coisa boa.
ex.verdict.missed.b1.2 = Olha outra vez! Havia melhor.
ex.verdict.missed.b1.3 = Espera aí, tinhas ali uma oportunidade!
ex.verdict.missed.b2 = Deixaste escapar uma oportunidade.
ex.verdict.missed.b2.2 = Hum, havia melhor.
ex.verdict.missed.b2.3 = Espera, tinhas ali um grande lance.

# ---- The better move (levels 3-6; {best} is pointed at) ----------------------------------------
# {line} (level 5) holds the moves that follow {best}, not {best} itself.
ex.better.b3 = Era melhor {best}.
ex.better.b3.2 = {best} era um lance melhor.
ex.better.b3.3 = Em vez disso, {best} era bom.
ex.better.b4 = {best} era mais forte.
ex.better.b4.2 = {best} era o lance certo.
ex.better.b4.3 = Era melhor {best}.
ex.better.b5 = {best}, com a ideia {line}.
ex.better.b5.2 = O lance era {best}: {line}.
ex.better.b5.3 = Era melhor {best}, seguido de {line}.
ex.better.b6 = {best}: {eval}.
ex.better.b6.2 = Melhor {best}, {eval}.
ex.better.b6.3 = {best} dava {eval}.

