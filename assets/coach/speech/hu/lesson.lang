lesson.title.pieces_lines = hogyan lépnek a bástya, a futó és a vezér
lesson.title.pieces_steps = hogyan lép a király, a huszár és a gyalog
lesson.title.values_setup = a bábuk értéke és az első lépések
lesson.title.safety = a biztonságos és a veszélyes ütések
lesson.title.check = a sakk
lesson.title.mate = a matt
lesson.title.castling = a sáncolás
lesson.title.en_passant = az en passant ütés
lesson.title.promotion = az átváltozás
lesson.title.draws = a patt és a döntetlen
lesson.title.before_move = a lépés előtti ellenőrzés
lesson.title.opening = a megnyitás
lesson.title.review = egy gyors ismétlés
lesson.title.etiquette = hogyan zajlanak a játszmáink

