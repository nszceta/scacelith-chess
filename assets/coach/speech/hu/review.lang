ex.verdict.blunder.b1.2 = Vigyázz! Ennek a lépésnek ára lehet.
ex.verdict.blunder.b1.3 = Ó, várj csak. Ezzel a lépéssel baj van.
ex.verdict.blunder.b2 = Hmm, ezzel a lépéssel baj van.
ex.verdict.blunder.b2.2 = Ez nagy hiba.
ex.verdict.blunder.b2.3 = Vigyázz, ezzel a lépéssel elveszítesz valamit.
ex.verdict.blunder.b3 = Ez baklövés.
ex.verdict.blunder.b3.2 = {move} igazi hiba.
ex.verdict.blunder.b3.3 = Ajaj, {move} nagy hiba.
ex.verdict.blunder.b4 = {move} baklövés.
ex.verdict.blunder.b4.2 = {move} súlyos hiba.
ex.verdict.blunder.b4.3 = Sajnos ez baklövés.
ex.verdict.blunder.b5 = {move} súlyos hiba.
ex.verdict.blunder.b5.2 = {move} baklövés.
ex.verdict.blunder.b5.3 = {move} drága hiba.
ex.verdict.blunder.b6 = {move} komoly hiba.
ex.verdict.blunder.b6.2 = {move} baklövés.
ex.verdict.blunder.b6.3 = {move}? Baklövés.
# A blunder that leaves the coach's threat standing (levels 1-2: the threat the engine found after the
# coach's last move is what the reply carries out).
ex.verdict.ignored.b1 = Hoppá! Nem válaszoltál a fenyegetésemre.
ex.verdict.ignored.b1.2 = Vigyázz! A fenyegetésem még megvolt.
ex.verdict.ignored.b1.3 = Ó, várj csak. Megfeledkeztél a fenyegetésemről.
ex.verdict.ignored.b2 = Hmm, a fenyegetésem még megvolt.
ex.verdict.ignored.b2.2 = Válasz nélkül hagytad a fenyegetésemet.
ex.verdict.ignored.b2.3 = Vigyázz, nem válaszoltál a fenyegetésemre.
ex.verdict.mistake.b3 = Ez nem jó lépés.
ex.verdict.mistake.b3.2 = Hmm, {move} lépéssel baj van.
ex.verdict.mistake.b3.3 = Ez hiba.
ex.verdict.mistake.b4 = {move} hiba.
ex.verdict.mistake.b4.2 = {move} nem jó.
ex.verdict.mistake.b4.3 = Ez bizony hiba.
ex.verdict.mistake.b5 = {move} egyértelmű hiba.
ex.verdict.mistake.b5.2 = {move} hiba.
ex.verdict.mistake.b5.3 = {move} nem jó.
ex.verdict.mistake.b6 = {move} hiba.
ex.verdict.mistake.b6.2 = {move}? Hiba.
ex.verdict.mistake.b6.3 = {move}? Nem.
# A dubious move (an inaccuracy; a costly move with nothing concrete to show while still better):
# only the better move is named ({best} is pointed at), never a scenario.
ex.verdict.inaccuracy.b3 = Nem rossz, de {best} egy kicsit jobb volt.
ex.verdict.inaccuracy.b3.2 = {best} kicsit pontosabb volt.
ex.verdict.inaccuracy.b3.3 = Apró botlás: itt {best} jobb volt.
ex.verdict.inaccuracy.b4 = Pontatlan: {best} pontosabb volt.
ex.verdict.inaccuracy.b4.2 = Kis pontatlanság. {best} egy kicsit jobb volt.
ex.verdict.inaccuracy.b4.3 = Nem egészen a legjobb: {best} pontosabb volt.
ex.verdict.inaccuracy.b5 = {move} pontatlan; {best} erősebb volt.
ex.verdict.inaccuracy.b5.2 = Kissé pontatlan. Én ezt játszottam volna: {best}.
ex.verdict.inaccuracy.b5.3 = {best} pontosabb volt, mint {move}.
ex.verdict.inaccuracy.b6 = {move} pontatlan; {best}.
ex.verdict.inaccuracy.b6.2 = Pontatlan. {best}.
ex.verdict.inaccuracy.b6.3 = {best} jobb volt.
# Level 6, an inaccuracy at the bottom of its class (deeper searches often clear it): a hedged word.
ex.verdict.inaccuracy.maybe = Talán {best} egy kicsit pontosabb lett volna.
ex.verdict.inaccuracy.maybe.2 = Én talán ezt játszottam volna: {best}.
# A dubious move that loses material (levels 3-6): the remark alone, never "a bit better" (at level 6
# under 6 points, the hedged word above unless a piece is lost).
ex.verdict.dubious = Ez a lépés kétesnek tűnik.
ex.verdict.dubious.2 = Ez a lépés kétesnek látszik.
# Something good was missed (levels 1-2).
ex.verdict.missed.b1 = Ó, várj csak! Kihagytál valami jót.
ex.verdict.missed.b1.2 = Nézd meg újra! Volt jobb is.
ex.verdict.missed.b1.3 = Egy pillanat, itt volt egy lehetőséged!
ex.verdict.missed.b2 = Itt kihagytál egy lehetőséget.
ex.verdict.missed.b2.2 = Hmm, volt ennél jobb is.
ex.verdict.missed.b2.3 = Várj, itt volt egy remek lépésed.

# ---- The better move (levels 3-6; {best} is pointed at) ----------------------------------------
