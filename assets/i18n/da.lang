# Each challenge (assets/coach/challenges/challenges.txt): a name, a one-line description (about 60
# characters) and a paragraph for the column of the selected challenge
challenge.mate1.name = Mat i ét træk
challenge.mate1.desc = Ét træk, og det er skakmat.
challenge.mate1.detail = Se først på alle de træk, der giver skak: et af dem efterlader kongen uden flugtfelt, uden mulighed for at sætte en brik imellem og uden noget at slå.
challenge.mate2.name = Mat i to træk
challenge.mate2.desc = Et træk, der ikke efterlader noget forsvar, og så mat.
challenge.mate2.detail = Det første træk er ofte en skak eller et offer, der tager et felt fra kongen. Træneren forsvarer sig så godt, han kan.
challenge.mate3.name = Mat i tre træk
challenge.mate3.desc = Længere tvingende varianter.
challenge.mate3.detail = Skaktræk, slag og trusler, tre træk dybt. Beregn trænerens bedste svar ved hvert skridt, før du rører en brik.
challenge.backrank.name = Grundrækkemat
challenge.backrank.desc = En konge, der er spærret inde bag sine egne bønder.
challenge.backrank.detail = Når bønderne foran en rokeret konge ikke har flyttet sig, kan et tårn eller en dronning på grundrækken give skakmat. Fjern eller afled forsvarerne først.
challenge.patterns.name = Matmønstre
challenge.patterns.desc = Kvælningsmat, Anastasias mat, arabisk mat og andre klassikere.
challenge.patterns.detail = Berømte matnet, der dukker op igen og igen. Lær at genkende brikkernes opstilling og det afgørende slag.
challenge.hanging.name = Gratis brikker
challenge.hanging.desc = Find det, der står udækket.
challenge.hanging.detail = En brik eller en bonde, som ingen forsvarer, kan simpelthen slås. Tjek, hvad hver af trænerens brikker er dækket af.
challenge.fork.name = Gafler
challenge.fork.desc = Én brik angriber to på én gang.
challenge.fork.detail = Springere, bønder, dronninger og selv konger kan give gaffel. Modstanderen kan kun redde det ene af de to mål.
challenge.pin.name = Bindinger
challenge.pin.desc = En brik, der ikke kan flytte uden at miste det, der står bag den.
challenge.pin.detail = Bind en brik til dens konge eller til en mere værdifuld brik, og angrib den så igen, eller udnyt, at den ikke kan flytte.
challenge.skewer.name = Spid
challenge.skewer.desc = Angrib en værdifuld brik, og vind den, der står bag den.
challenge.skewer.detail = Det omvendte af en binding: den mere værdifulde brik står forrest, må flytte væk og blotter brikken bag sig.
challenge.discovered.name = Afdækkede angreb
challenge.discovered.desc = Flyt én brik for at slippe en anden løs.
challenge.discovered.detail = Når en brik træder ud af en linje, angriber brikken bag den. Med skak eller med dobbeltskak har modstanderen ikke tid til at besvare begge trusler.
challenge.deflection.name = Afledning og tiltrækning
challenge.deflection.desc = Lok en forsvarer væk eller ind på et skæbnesvangert felt.
challenge.deflection.detail = En forsvarer med to opgaver kan ikke klare begge. Angrib den, tilbyd den noget, eller tving en brik ind på det felt, hvor den går tabt.
challenge.intermezzo.name = Mellemtræk
challenge.intermezzo.desc = Slå ikke tilbage med det samme: der er noget stærkere.
challenge.intermezzo.detail = En skak eller en større trussel, der skydes ind før det forventede træk, ændrer alt.
challenge.trapped.name = Fangede brikker
challenge.trapped.desc = En brik uden noget sikkert felt tilbage.
challenge.trapped.detail = Tag de sidste flugtfelter fra en brik, og vind den så.
challenge.promotion.name = Forvandling
challenge.promotion.desc = Før en bonde igennem til sidste række.
challenge.promotion.detail = Fremskudte bønder er meget værd. Ryd vejen, afled de blokerende brikker, og skaf dig en ny dronning.
challenge.quiet.name = Stille træk
challenge.quiet.desc = Det vindende træk er hverken en skak eller et slag.
challenge.quiet.detail = Nogle gange forbereder det stærkeste træk blot en trussel, der ikke kan pareres. Den sværeste slags at få øje på.
challenge.opening.name = Åbningsfælder
challenge.opening.desc = Straf tidlige fejl.
challenge.opening.detail = Stillinger fra de første træk i rigtige partier, hvor ét skødesløst træk straks kan udnyttes.
challenge.escape.name = Find udvejen
challenge.escape.desc = Din konge er i fare: ét træk redder den.
challenge.escape.detail = Alle andre træk taber. Se på alle skaktræk og trusler mod din konge, og find så den eneste udvej.
challenge.defend.name = Forsvarstræk
challenge.defend.desc = Parér truslen uden at tabe materiale.
challenge.defend.detail = Træneren truer med noget. Find det præcise træk, der holder sammen på det hele.
challenge.kq.name = Dronning og konge mod konge
challenge.kq.desc = Sæt mat med dronningen.
challenge.kq.detail = Pres den ensomme konge ud til kanten med din dronning, før din egen konge nærmere, og pas på pat. Træneren forsvarer sig med sine bedste træk.
challenge.kr.name = Tårn og konge mod konge
challenge.kr.desc = Sæt mat med tårnet.
challenge.kr.detail = Tårnet skærer kongen af, række for række; din konge tager oppositionen. Træneren forsvarer sig med sine bedste træk.
challenge.kp.name = Konge og bonde mod konge
challenge.kp.desc = Vind oppositionen, og forvandl bonden.
challenge.kp.detail = Gå foran med din konge, ikke med bonden. Tag oppositionen, og skaf dig en dronning, som træneren ikke kan nå.
challenge.kp_hold.name = Stop bonden
challenge.kp_hold.desc = En ensom konge mod konge og bonde: hold remis.
challenge.kp_hold.detail = Stil dig foran bonden, og bevar oppositionen. Hold stillingen i ti træk.
challenge.rook.name = Tårnslutspil
challenge.rook.desc = Lucenas brobygning og Philidors forsvar.
challenge.rook.detail = De to stillinger, enhver spiller bør kende: hvordan man vinder med en bonde på syvende række, og hvordan man forsvarer sig med tårnet på tredje.
challenge.endgame.name = Slutspilstaktik
challenge.endgame.desc = Få brikker, skarpe idéer.
challenge.endgame.detail = Bondeløb, gennembrud og tårnslutspil fra rigtige partier.
