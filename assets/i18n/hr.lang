coach.level.0.detail = Trener postavlja male pozicije i pokazuje kako se svaka figura kreće i uzima, zatim rokadu, promociju, šah i mat. Svaku zamisao isprobavate na ploči vlastitom rukom.
coach.level.1.name = Prvi koraci
coach.level.1.desc = Što je napadnuto, a što ostaje nebranjeno.
coach.level.1.detail = Trener igra blago i govori jednostavno: koje su vaše figure napadnute, koje su ostale bez zaštite i kako ih sačuvati.
coach.level.2.name = Početnik
coach.level.2.desc = Jednostavna taktika, razvoj, sigurnost kralja.
coach.level.2.detail = Vilice i vezanja zovu se svojim imenima. Trener govori o razvoju figura i o tome kako zaštititi kralja.
coach.level.3.name = Napredni početnik
coach.level.3.desc = Planovi, pješačka struktura, jedini potezi.
coach.level.3.detail = Trener objašnjava planove i pješačke strukture te upozorava kad poziciju drži samo jedan potez.
coach.level.4.name = Klupski igrač
coach.level.4.desc = Potezi kandidati, procjena u pješacima.
coach.level.4.detail = Trener odvaguje poteze kandidate i daje procjenu u pješacima, kao što bi to činio klupski trener.
coach.level.5.name = Jak klupski igrač
coach.level.5.desc = Sažete varijante, pozicijski pojmovi.
coach.level.5.detail = Kratke primjedbe, konkretne varijante i rječnik pozicijske igre.
coach.level.6.name = Stručnjak
coach.level.6.desc = Škrte primjedbe, duboke varijante, brojčane procjene.
coach.level.6.detail = Malo riječi, kao među jakim igračima: varijante duboke nekoliko poteza i brojčane procjene.
coach.note.clock = Bez sata: uzmite onoliko vremena koliko vam treba.
coach.note.takeback = Nakon grube pogreške trener pokazuje što je pošlo po zlu i nudi vraćanje poteza.
coach.note.lesson = Igrate bijelima; trener postavlja svaku vježbu na ploču.
coach.note.unrated = Partije s trenerom nisu za rejting.
coach.note.fallible = Trener nije nepogrešiv: ponekad može pogrešno procijeniti potez.
coach.colour = Vaša boja
coach.colour.help = Boja kojom igrate protiv trenera. Naizmjence: bijelima, zatim crnima, od partije do partije. Lekcija o pravilima uvijek se igra bijelima.
coach.colour.alternate = Naizmjence
coach.take_time = Podsjetnik „Ne žurite“
coach.take_time.help = Nakon minute razmišljanja trener vam kaže da nema žurbe. Samo razine od 1 do 3.
# Shown when the coach's voice cannot be heard: its model is not downloaded, or Options > Audio > Coach voice is off.
coach.no_voice = Trenerov glas nije instaliran ili je isključen (Postavke > Zvuk): njegove će riječi biti ispisane na zaslonu.
# At the table
coach.speaker = TRENER
coach.skip = Preskoči
coach.offer.title = VRATITI POTEZ?
coach.offer.text = Trener nudi vraćanje vašeg posljednjeg poteza kako biste potražili bolji.
coach.offer.hint = Backspace vraća potez. Dodir figure znači nastavak igre.
coach.offer.accept = Vrati potez
coach.offer.decline = Nastavi igru
# Levels 4-6: the coach's takeback offers the player may still accept this game (bottom corner
# of the screen, and on the takeback card)
coach.takebacks_left = Preostala vraćanja poteza: {0}
coach.pause.take_back = Vrati moj potez
coach.pause.take_back.help = Vraća vaš posljednji potez i trenerov odgovor ako je već odigran.
coach.confirm.resign = Želite li predati ovu partiju? Trener će biti proglašen pobjednikom.
coach.confirm.resign_draw = Želite li predati ovu partiju? Trener više ne može dati mat: partija će završiti remijem.
coach.confirm.leave = Želite li se vratiti u glavni izbornik? Ova partija s trenerom bit će napuštena.
# Game over card of a coach game, and the end of the lesson on the rules
coach.gameover.again = Igraj ponovno
coach.gameover.unrated = Ova partija s trenerom nije za rejting.
coach.lesson.done = BRAVO
coach.lesson.done.line = Sada znate pravila šaha.
coach.lesson.next = Prva partija

# ---- Coach challenges (src/ui/ui_coach.cpp; the coach's spoken lines are in assets/coach/speech/<lang>/challenge.lang)
# The tabs of the Coach page: games with the coach, and short sets of positions to solve
coach.tab.training = Trening
coach.tab.challenges = Izazovi
# Group headings of the list (capitals: section headings)
challenge.group.mates = MATOVI
challenge.group.tactics = TAKTIKA
challenge.group.defence = OBRANA
challenge.group.endgames = ZAVRŠNICE
# Each challenge (assets/coach/challenges/challenges.txt): a name, a one-line description (about 60
# characters) and a paragraph for the column of the selected challenge
challenge.mate1.name = Mat u jednom potezu
challenge.mate1.desc = Jedan potez – i mat.
challenge.mate1.detail = Najprije pogledajte svaki šah: jedan od njih kralju ne ostavlja ni slobodno polje ni pokrivanje ni uzimanje.
challenge.mate2.name = Mat u dva poteza
challenge.mate2.desc = Potez nakon kojeg nema obrane, zatim mat.
challenge.mate2.detail = Prvi je potez često šah ili žrtva koja kralju oduzima polje. Trener se brani najbolje što može.
challenge.mate3.name = Mat u tri poteza
challenge.mate3.desc = Dulje forsirane varijante.
challenge.mate3.detail = Šahovi, uzimanja i prijetnje, tri poteza u dubinu. Prije nego što dodirnete figuru, izračunajte trenerov najbolji odgovor u svakom koraku.
challenge.backrank.name = Matovi na zadnjem redu
challenge.backrank.desc = Kralj zarobljen iza vlastitih pješaka.
challenge.backrank.detail = Kad se pješaci ispred rokiranog kralja nisu pomaknuli, top ili dama na zadnjem redu mogu dati mat. Najprije uklonite ili odvucite branitelje.
challenge.patterns.name = Matne slike
challenge.patterns.desc = Ugušeni mat, Anastazijin mat, arapski mat i drugi klasici.
challenge.patterns.detail = Slavne matne mreže koje se uvijek iznova vraćaju. Naučite prepoznati raspored figura i završni udarac.
challenge.hanging.name = Nebranjene figure
challenge.hanging.desc = Uočite ono što je ostalo nebranjeno.
challenge.hanging.detail = Figura ili pješak koje nitko ne brani mogu se jednostavno uzeti. Provjerite što brani svaku trenerovu figuru.
challenge.fork.name = Vilice
challenge.fork.desc = Jedna figura napada dvije odjednom.
challenge.fork.detail = Vilicu mogu napraviti skakači, pješaci, dame, pa čak i kraljevi. Protivnik može spasiti samo jednu od dviju napadnutih figura.
challenge.pin.name = Vezanja
challenge.pin.desc = Figura koja se ne može pomaknuti, a da se ne izgubi ono iza nje.
challenge.pin.detail = Vežite figuru za njezina kralja ili za vrjedniju figuru, zatim je ponovno napadnite ili iskoristite to što se ne može pomaknuti.
challenge.skewer.name = Ražnjevi
challenge.skewer.desc = Napadnite vrijednu figuru i osvojite onu iza nje.
challenge.skewer.detail = Obrnuto od vezanja: vrjednija figura stoji ispred, mora se skloniti i otkriva figuru iza sebe.
challenge.discovered.name = Otkriveni napadi
challenge.discovered.desc = Pomaknite jednu figuru da biste oslobodili drugu.
challenge.discovered.detail = Kad se figura makne s puta, napada figura iza nje. Uz šah ili dvostruki šah protivnik nema vremena odgovoriti na obje prijetnje.
challenge.deflection.name = Odvlačenje i mamljenje
challenge.deflection.desc = Odvucite branitelja ili ga namamite na kobno polje.
challenge.deflection.detail = Branitelj koji ima dva zadatka ne može obaviti oba. Napadnite ga, ponudite mu nešto ili natjerajte figuru na polje na kojem će biti izgubljena.
challenge.intermezzo.name = Međupotezi
challenge.intermezzo.desc = Ne uzimajte odmah natrag: postoji nešto jače.
challenge.intermezzo.detail = Šah ili veća prijetnja umetnuta prije očekivanog poteza mijenja sve.
challenge.trapped.name = Zarobljene figure
challenge.trapped.desc = Figura kojoj nije ostalo nijedno sigurno polje.
challenge.trapped.detail = Oduzmite figuri posljednja polja za bijeg, a zatim je osvojite.
challenge.promotion.name = Promocija
challenge.promotion.desc = Progurajte pješaka do zadnjeg reda.
challenge.promotion.detail = Odmakli pješaci vrijede mnogo. Raščistite put, odvucite figure koje ga blokiraju i stvorite novu damu.
challenge.quiet.name = Tihi potezi
challenge.quiet.desc = Pobjednički potez nije ni šah ni uzimanje.
challenge.quiet.detail = Ponekad najjači potez samo priprema prijetnju koja se ne može odbiti. Takve je poteze najteže uočiti.
challenge.opening.name = Zamke u otvaranju
challenge.opening.desc = Kaznite rane pogreške.
challenge.opening.detail = Pozicije iz prvih poteza stvarnih partija, u kojima se jedan nepažljiv potez može odmah iskoristiti.
challenge.escape.name = Pronađite izlaz
challenge.escape.desc = Vaš je kralj u opasnosti: spašava ga jedan potez.
challenge.escape.detail = Svaki drugi potez gubi. Pogledajte sve šahove i prijetnje vašem kralju, zatim pronađite jedini izlaz.
challenge.defend.name = Obrambeni potezi
challenge.defend.desc = Odbijte prijetnju bez gubitka materijala.
challenge.defend.detail = Trener nečim prijeti. Pronađite precizan potez koji sve drži na okupu.
challenge.kq.name = Dama i kralj protiv kralja
challenge.kq.desc = Mat damom.
challenge.kq.detail = Damom potisnite usamljenog kralja na rub, približite vlastitog kralja i čuvajte se pata. Trener se brani najboljim potezima.
challenge.kr.name = Top i kralj protiv kralja
challenge.kr.desc = Mat topom.
challenge.kr.detail = Top odsijeca kralja, red po red; vaš kralj zauzima opoziciju. Trener se brani najboljim potezima.
challenge.kp.name = Kralj i pješak protiv kralja
challenge.kp.desc = Osvojite opoziciju i promovirajte pješaka.
challenge.kp.detail = Neka vodi kralj, a ne pješak. Zauzmite opoziciju i stvorite damu koju trener ne može uhvatiti.
challenge.kp_hold.name = Zaustavite pješaka
challenge.kp_hold.desc = Usamljeni kralj protiv kralja i pješaka: zadržite remi.
challenge.kp_hold.detail = Stanite ispred pješaka i zadržite opoziciju. Izdržite deset poteza.
challenge.rook.name = Topovske završnice
challenge.rook.desc = Lucenin most i Philidorova obrana.
challenge.rook.detail = Dvije pozicije koje bi svaki igrač trebao znati: kako dobiti s pješakom na sedmom redu i kako se braniti topom na trećem.
challenge.endgame.name = Taktika u završnici
challenge.endgame.desc = Malo figura, oštre ideje.
challenge.endgame.detail = Utrke pješaka, proboji i topovske završnice iz stvarnih partija.
# The column of the selected challenge. {0} = the number of positions in the set
coach.challenge.positions = {0} pozicija|{0} pozicije|{0} pozicija
coach.challenge.done = Završeno
coach.challenge.start = Započni
coach.challenge.note.white = Igrate bijelima; trener postavlja svaku poziciju na ploču.
coach.challenge.note.hint = Ne ide? Pritisnite H za savjet. Nakon nekoliko pokušaja trener će vam ga ponuditi.
coach.challenge.note.unsaved = Izazovi nisu za rejting i ne spremaju se; kvačica označava završene izazove.
# At the table: the band at the top, after the challenge's name. {0} = the position being solved, {1} = the number of positions
coach.challenge.progress = {0} / {1}
# The card at the end of a challenge
coach.challenge.complete = IZAZOV ZAVRŠEN
coach.challenge.complete.line = Sve su pozicije riješene.
coach.challenge.next = Sljedeći izazov
coach.challenge.again = Ponovno
# The coach's offer of a hint (a card like the takeback offer), and the key cap of the hint at the bottom of the screen
coach.hint.title = SAVJET?
coach.hint.text = Trener vam nudi savjet.
coach.hint.hint = Tipka H daje savjet. Dodir figure znači nastavak traženja.
coach.hint.accept = Savjet
coach.hint.decline = Ne, hvala
