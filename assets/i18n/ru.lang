# ---- Coach voice download (src/ui/ui_model_download.cpp, src/game/coach_model.cpp) --------------------
# Supertonic 3, Supertone, Hugging Face, GitHub and OpenRAIL-M are names: never translated.
# Options > Audio
options.coach_voice = Голос тренера
options.coach_voice.help = В режиме «Тренер» тренер говорит вслух. Модель его голоса скачивается, когда она впервые нужна (около 399 МБ). Выкл.: слова тренера только показываются на экране.
options.voice_update = Модель голоса
options.voice_update.help = Тренер пока говорит со старой 8-битной версией своей модели голоса. Обновление скачивает официальную версию Supertonic 3 от Supertone, а сначала удаляет старые файлы.
options.voice_update.button = Обновить ({0} МБ)
options.voice_update.running = Идёт скачивание.
options.voice_quality = Качество голоса
options.voice_quality.help = Число шагов уточнения при синтезе речи тренера для каждой фразы: от «Низкое» (4) до «Максимум» (9); по умолчанию «Среднее» (5). Более высокое качество даёт чуть более чистый голос, но требует больше вычислений: тренер начинает говорить немного позже. Настраивается после установки голосовой модели, когда голос тренера включён.
options.voice_quality.low = Низкое
options.voice_quality.medium = Среднее
options.voice_quality.high = Высокое
options.voice_quality.very_high = Отличное
options.voice_quality.ultra = Ультра
options.voice_quality.max = Максимум
# The prompt. {0} = the size in megabytes ("398.7")
coach.download.title = Голос тренера
