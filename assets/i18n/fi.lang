challenge.group.tactics = TAKTIIKKA
challenge.group.defence = PUOLUSTUS
challenge.group.endgames = LOPPUPELIT
# Each challenge (assets/coach/challenges/challenges.txt): a name, a one-line description (about 60
# characters) and a paragraph for the column of the selected challenge
challenge.mate1.name = Matti yhdellä siirrolla
challenge.mate1.desc = Yksi siirto, ja se on matti.
challenge.mate1.detail = Katso ensin jokainen shakki: yksi niistä ei jätä kuninkaalle pakoruutua eikä mahdollisuutta torjua shakkia väliin asettamalla tai lyömällä.
challenge.mate2.name = Matti kahdella siirrolla
challenge.mate2.desc = Siirto, johon ei ole puolustusta, sitten matti.
challenge.mate2.detail = Ensimmäinen siirto on usein shakki tai uhraus, joka vie kuninkaalta ruudun. Valmentaja puolustautuu parhaansa mukaan.
challenge.mate3.name = Matti kolmella siirrolla
challenge.mate3.desc = Pidempiä pakottavia muunnelmia.
challenge.mate3.detail = Shakkeja, lyöntejä ja uhkia kolmen siirron syvyydeltä. Laske valmentajan paras vastaus jokaisessa vaiheessa ennen kuin kosket nappulaan.
challenge.backrank.name = Takarivimatit
challenge.backrank.desc = Kuningas jumissa omien sotilaidensa takana.
challenge.backrank.detail = Kun linnoittautuneen kuninkaan edessä olevat sotilaat eivät ole liikkuneet, torni tai kuningatar viimeisellä rivillä voi tehdä matin. Poista tai harhauta puolustajat ensin.
challenge.patterns.name = Mattikuviot
challenge.patterns.desc = Klassikot: tukehtumismatti, Anastasian ja arabialainen matti…
challenge.patterns.detail = Kuuluisia mattiverkkoja, jotka toistuvat yhä uudelleen. Opi tunnistamaan nappuloiden asetelma ja ratkaiseva isku.
challenge.hanging.name = Ilmaiset nappulat
challenge.hanging.desc = Huomaa, mikä on jäänyt suojatta.
challenge.hanging.detail = Nappulan tai sotilaan, jota kukaan ei puolusta, voi yksinkertaisesti lyödä. Tarkista, mikä suojaa kutakin valmentajan nappulaa.
challenge.fork.name = Haarukat
challenge.fork.desc = Yksi nappula uhkaa kahta samanaikaisesti.
challenge.fork.detail = Ratsut, sotilaat, kuningattaret ja jopa kuninkaat voivat haarukoida. Vastustaja voi pelastaa vain toisen kohteista.
challenge.pin.name = Kiinnitykset
challenge.pin.desc = Nappula, joka ei voi liikkua menettämättä takanaan olevaa.
challenge.pin.detail = Kiinnitä nappula kuninkaaseensa tai arvokkaampaan nappulaan ja hyökkää sen kimppuun uudelleen, tai hyödynnä sitä, ettei se voi liikkua.
challenge.skewer.name = Vartaat
challenge.skewer.desc = Uhkaa arvokasta nappulaa ja voita sen takana oleva.
challenge.skewer.detail = Kuin kiinnitys toisin päin: arvokkaampi nappula on edessä, sen on väistettävä, ja se paljastaa takanaan olevan nappulan.
challenge.discovered.name = Paljastetut hyökkäykset
challenge.discovered.desc = Siirrä yhtä nappulaa ja vapauta toinen.
challenge.discovered.detail = Kun nappula siirtyy pois linjalta, sen takana oleva nappula hyökkää. Jos siirto antaa shakin tai kaksoisshakin, vastustajalla ei ole aikaa torjua molempia uhkia.
challenge.deflection.name = Harhautus ja houkutus
challenge.deflection.desc = Houkuttele puolustaja pois tai kohtalokkaaseen ruutuun.
challenge.deflection.detail = Puolustaja, jolla on kaksi tehtävää, ei pysty hoitamaan molempia. Hyökkää sen kimppuun, tarjoa sille jotakin tai pakota nappula ruutuun, jossa se menetetään.
challenge.intermezzo.name = Välisiirrot
challenge.intermezzo.desc = Älä lyö heti takaisin: tarjolla on jotain vahvempaa.
challenge.intermezzo.detail = Ennen odotettua siirtoa väliin tehty shakki tai suurempi uhka muuttaa kaiken.
challenge.trapped.name = Ansaan jääneet nappulat
challenge.trapped.desc = Nappula, jolla ei ole enää turvallista ruutua.
challenge.trapped.detail = Vie nappulalta sen viimeiset pakoruudut ja voita se.
challenge.promotion.name = Korotus
challenge.promotion.desc = Vie sotilas läpi viimeiselle riville.
challenge.promotion.detail = Pitkälle edenneet sotilaat ovat arvokkaita. Raivaa tie, harhauta tukkijat ja tee uusi kuningatar.
challenge.quiet.name = Hiljaiset siirrot
challenge.quiet.desc = Voittava siirto ei ole shakki eikä lyönti.
challenge.quiet.detail = Joskus vahvin siirto vain valmistelee uhan, jota ei voi torjua. Kaikkein vaikeimmin huomattava siirtotyyppi.
challenge.opening.name = Avausansat
challenge.opening.desc = Rankaise varhaisista virheistä.
challenge.opening.detail = Asemia oikeiden pelien ensimmäisistä siirroista, joissa yhtä huolimatonta siirtoa voi hyödyntää heti.
challenge.escape.name = Löydä pelastus
challenge.escape.desc = Kuninkaasi on vaarassa: yksi siirto pelastaa sen.
challenge.escape.detail = Kaikki muut siirrot häviävät. Katso kaikki kuninkaaseesi kohdistuvat shakit ja uhat ja löydä ainoa pelastava siirto.
challenge.defend.name = Puolustussiirrot
challenge.defend.desc = Torju uhka menettämättä materiaalia.
challenge.defend.detail = Valmentaja uhkaa jotakin. Löydä täsmällinen siirto, joka pitää kaiken koossa.
challenge.kq.name = Kuningatar ja kuningas kuningasta vastaan
challenge.kq.desc = Matti kuningattarella.
challenge.kq.detail = Aja yksinäinen kuningas laidalle kuningattarellasi, tuo oma kuninkaasi lähemmäs ja varo pattia. Valmentaja puolustautuu parhailla mahdollisilla siirroilla.
challenge.kr.name = Torni ja kuningas kuningasta vastaan
challenge.kr.desc = Matti tornilla.
challenge.kr.detail = Torni katkaisee kuninkaan tien rivi riviltä; kuninkaasi ottaa opposition. Valmentaja puolustautuu parhailla mahdollisilla siirroilla.
challenge.kp.name = Kuningas ja sotilas kuningasta vastaan
challenge.kp.desc = Voita oppositio ja korota.
challenge.kp.detail = Kuljeta kuningasta sotilaan edellä. Ota oppositio ja tee kuningatar, jota valmentaja ei ehdi pysäyttää.
challenge.kp_hold.name = Pysäytä sotilas
challenge.kp_hold.desc = Yksinäinen kuningas kuningasta ja sotilasta vastaan: pidä tasapeli.
challenge.kp_hold.detail = Asetu sotilaan eteen ja pidä oppositio. Pidä puolustus kymmenen siirron ajan.
challenge.rook.name = Torniloppupelit
challenge.rook.desc = Lucenan sillanrakennus ja Philidorin puolustus.
challenge.rook.detail = Kaksi asemaa, jotka jokaisen pelaajan pitäisi tuntea: miten voitetaan sotilaalla seitsemännellä rivillä ja miten puolustetaan tornilla kolmannella rivillä.
challenge.endgame.name = Loppupelin taktiikka
challenge.endgame.desc = Vähän nappuloita, teräviä ideoita.
challenge.endgame.detail = Sotilaiden kilpajuoksuja, läpimurtoja ja torniloppupelejä oikeista peleistä.
# The column of the selected challenge. {0} = the number of positions in the set
coach.challenge.positions = {0} asema|{0} asemaa
coach.challenge.done = Suoritettu
coach.challenge.start = Aloita
coach.challenge.note.white = Pelaat valkeilla; valmentaja asettaa jokaisen aseman laudalle.
coach.challenge.note.hint = Jumissa? Paina H, niin saat vihjeen. Muutaman yrityksen jälkeen valmentaja tarjoaa vihjettä itse.
coach.challenge.note.unsaved = Haasteita ei pisteytetä eikä tallenneta; valintamerkki näyttää ne, jotka olet suorittanut.
# At the table: the band at the top, after the challenge's name. {0} = the position being solved, {1} = the number of positions
coach.challenge.progress = {0} / {1}
# The card at the end of a challenge
coach.challenge.complete = HAASTE SUORITETTU
coach.challenge.complete.line = Ratkaisit jokaisen aseman.
coach.challenge.next = Seuraava haaste
coach.challenge.again = Uudelleen
