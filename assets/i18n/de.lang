options.language = Sprache
options.language.help = Sprache der Menüs und Meldungen. Die Änderung gilt sofort.
options.language.not_adapted = Diese Sprache ist noch nicht vollständig angepasst: Die Stimme des Trainers spricht manche Wörter vielleicht falsch aus, und manche Texte klingen womöglich noch ungewohnt.
options.display_mode = Anzeigemodus
options.display_mode.help = Vollbild: ein randloses Fenster über den ganzen Bildschirm, in der Desktop-Auflösung. Fenster: ein Fenster in der Größe darunter.
options.fullscreen = Vollbild
options.windowed = Fenster
options.window_size = Fenstergröße
options.window_size.help = Größe des Fensters im Fenstermodus. Das Vollbild nutzt immer die Desktop-Auflösung.
options.vsync = V-Sync
options.vsync.help = Synchronisiert die Bilder mit dem Monitor, um Bildrisse zu vermeiden.
options.render_scale = Renderskalierung
options.render_scale.help = Interne Auflösung des 3D-Bildes. Niedriger ist schneller, höher ist schärfer.

options.quality = Qualität
options.quality.very_low = Sehr niedrig
options.quality.low = Niedrig
options.quality.medium = Mittel
options.quality.high = Hoch
options.quality.ultra = Ultra
options.quality.custom = Benutzerdefiniert
options.quality.help = Stellt alle Optionen darunter auf einmal ein: „Sehr niedrig“ schaltet alle Effekte aus, „Ultra“ setzt sie alle auf das Maximum. Wird eine Option einzeln geändert, steht die Qualität auf „Benutzerdefiniert“. Auf einer schwächeren Grafikkarte hilft es außerdem viel, die Renderskalierung (Reiter Anzeige) zu senken.
options.shadows = Schatten
options.shadows.help = Detailgrad der Sonnenschatten und Weichheit ihrer Kanten. Niedrig: einfache Kanten, schnell gezeichnet.
options.reflections = Spiegelungen
options.reflections.help = Boden, Tisch und Brett spiegeln den Saal (er wird für jede Fläche noch einmal gezeichnet: eine der anspruchsvollsten Optionen); ab „Mittel“ spiegeln auch die glänzenden Figuren und Gegenstände ihre Umgebung.
options.ambient_occlusion = Umgebungsverdeckung
options.ambient_occlusion.help = Weiche Schattierung, wo Gegenstände sich berühren, und in Vertiefungen, wo weniger Licht hinkommt.
options.indirect_light = Indirektes Licht
options.indirect_light.help = Tageslicht, das von Wänden, Boden und Decke zurückgeworfen wird. Niedrig: stattdessen ein gleichmäßiges Umgebungslicht. Wirkt sich vor allem auf die Ladezeit aus.
options.volumetric_light = Lichtstrahlen
options.volumetric_light.help = Sonnenstrahlen in der staubigen Luft des Saals und die Staubkörnchen, die darin glitzern.
options.tessellation = Tessellation
options.tessellation.help = Glatte Konturen an den Rundungen der Figuren aus der Nähe.
options.tessellation.unavailable = Nicht verfügbar: Dieser Grafiktreiber unterstützt keine Tessellation.
options.antialiasing = Kantenglättung
options.antialiasing.help = Glättet gezackte Kanten und flimmernde Glanzlichter. Aus: schärfer, aber gezackt, und manche Effekte wirken körnig.
options.depth_of_field = Tiefenschärfe
options.depth_of_field.help = Zeichnet weich, was weit vor oder hinter dem liegt, was Sie ansehen, wie ein Kameraobjektiv.
options.motion_blur = Bewegungsunschärfe
options.motion_blur.help = Verwischt schnelle Bewegungen der Kamera und der Arme, wie eine Filmkamera.
options.bloom = Bloom
options.bloom.help = Ein sanftes Leuchten um die hellsten Glanzlichter, wie bei einem Kameraobjektiv.
options.brightness = Helligkeit
options.brightness.neutral = Neutral
options.brightness.value = {0} EV
options.brightness.help = Belichtungskorrektur der Kamera. Die Kalibrierung beim ersten Start stellt sie so ein, dass die dunkelsten Schatten gerade noch sichtbar sind.

options.master_volume = Gesamtlautstärke
options.effects = Effekte
options.ambience = Atmosphäre
options.ambience.help = Das Murmeln des Saals: Kaminfeuer, ferne Schritte, die alte Uhr.
options.ambience_volume = Lautstärke der Atmosphäre
options.voice_volume = Lautstärke der Stimme
options.voice_volume.help = Lautstärke der Stimme des Trainers im Trainer-Modus.
options.subtitles = Untertitel
options.subtitles.auto = Automatisch
options.subtitles.help = Die Worte des Trainers, unten im Bild eingeblendet. Automatisch: angezeigt, wenn der Trainer nicht die Sprache der Menüs spricht (bei chinesischen Menüs spricht er Englisch). Immer angezeigt, wenn seine Stimme nicht installiert ist.

options.legal_moves = Legale Züge zeigen
options.legal_moves.help = Hebt die Felder hervor, die eine berührte Figur erreichen kann. Ohne diese Hilfe zeigt nichts an, ob ein Zug regelgemäß ist: Der Schiedsrichter ahndet einen regelwidrigen Zug, sobald Sie die Uhr drücken.
options.coordinates = Brettkoordinaten
options.auto_press = Uhr automatisch drücken
options.auto_press.help = Ihr Roboter drückt die Uhr von selbst, sobald Ihr Zug auf dem Brett steht. In Online-Partien entscheidet der Server, in einer Direktpartie der Spieler, der sie hostet.
options.thinking_time = Realistische Bedenkzeit
options.thinking_time.help = Ihr Gegner lässt sich Zeit wie ein menschlicher Spieler, statt sofort zu ziehen.
options.ignore_head = Kopfbewegungen des Gegners ignorieren
options.ignore_head.help = In Online- und Direktpartien schaut der gegnerische Roboter dorthin, wohin sein Spieler schaut. Ein: Er bewegt den Kopf von selbst, wie gegen Stockfish.
options.mouse_sensitivity = Mausempfindlichkeit
options.invert_look = Vertikale Achse umkehren
options.handover = Spielerwechsel
options.handover.cut = Harter Schnitt
options.handover.flight = Kameraflug, {0} s
options.handover.help = Zwei Spieler an einem PC: wie die Sicht nach jedem Zug von den Augen des einen Spielers zu denen des anderen wechselt. Der harte Schnitt vermeidet die Kamerabewegung.
options.game_cursor = Spielzeiger
options.game_cursor.help = Am Tisch zeichnet das Spiel einen eigenen Zeiger, der zeigt, was ein Klick bewirkt. Aus: der gewohnte Systempfeil.

