# Each challenge (assets/coach/challenges/challenges.txt): a name, a one-line description (about 60
# characters) and a paragraph for the column of the selected challenge
challenge.mate1.name = Ματ σε μία
challenge.mate1.desc = Μία κίνηση, και είναι ματ.
challenge.mate1.detail = Εξετάστε πρώτα κάθε σαχ: ένα από αυτά δεν αφήνει στον βασιλιά ούτε τετράγωνο διαφυγής, ούτε παρεμβολή, ούτε αιχμαλωσία.
challenge.mate2.name = Ματ σε δύο
challenge.mate2.desc = Μια κίνηση που δεν αφήνει άμυνα, και μετά ματ.
challenge.mate2.detail = Η πρώτη κίνηση είναι συχνά ένα σαχ ή μια θυσία που αφαιρεί ένα τετράγωνο από τον βασιλιά. Ο προπονητής αμύνεται όσο καλύτερα μπορεί.
challenge.mate3.name = Ματ σε τρεις
challenge.mate3.desc = Μεγαλύτερες αναγκαστικές συνέχειες.
challenge.mate3.detail = Σαχ, αιχμαλωσίες και απειλές, τρεις κινήσεις σε βάθος. Υπολογίστε την καλύτερη απάντηση του προπονητή σε κάθε βήμα πριν αγγίξετε κομμάτι.
challenge.backrank.name = Ματ στην τελευταία γραμμή
challenge.backrank.desc = Ένας βασιλιάς παγιδευμένος πίσω από τα δικά του πιόνια.
challenge.backrank.detail = Όταν τα πιόνια μπροστά από έναν βασιλιά που έχει κάνει ροκέ δεν έχουν κινηθεί, ένας πύργος ή μια βασίλισσα στην τελευταία γραμμή μπορεί να δώσει ματ. Απομακρύνετε ή αποσπάστε πρώτα τους υπερασπιστές.
challenge.patterns.name = Μοτίβα ματ
challenge.patterns.desc = Πνιγμένο ματ, ματ της Αναστασίας, αραβικό ματ και άλλα κλασικά.
challenge.patterns.detail = Διάσημα δίχτυα ματ που εμφανίζονται ξανά και ξανά. Μάθετε να αναγνωρίζετε τη διάταξη των κομματιών και το τελικό χτύπημα.
challenge.hanging.name = Ακάλυπτα κομμάτια
challenge.hanging.desc = Εντοπίστε ό,τι έχει μείνει απροστάτευτο.
challenge.hanging.detail = Ένα κομμάτι ή ένα πιόνι που δεν το προστατεύει κανείς μπορεί απλώς να αιχμαλωτιστεί. Ελέγξτε από τι προστατεύεται κάθε κομμάτι του προπονητή.
challenge.fork.name = Πιρούνια
challenge.fork.desc = Ένα κομμάτι επιτίθεται σε δύο ταυτόχρονα.
challenge.fork.detail = Ίπποι, πιόνια, βασίλισσες, ακόμη και βασιλιάδες μπορούν να κάνουν πιρούνι. Ο αντίπαλος μπορεί να σώσει μόνο τον έναν από τους δύο στόχους.
challenge.pin.name = Καρφώματα
challenge.pin.desc = Ένα κομμάτι που δεν μπορεί να κινηθεί χωρίς να χαθεί ό,τι βρίσκεται πίσω του.
challenge.pin.detail = Καρφώστε ένα κομμάτι στον βασιλιά του ή σε ένα πιο πολύτιμο κομμάτι και μετά επιτεθείτε ξανά σε αυτό ή εκμεταλλευτείτε το ότι δεν μπορεί να κινηθεί.
challenge.skewer.name = Σουβλίσματα
challenge.skewer.desc = Επιτεθείτε σε ένα πολύτιμο κομμάτι και κερδίστε εκείνο που βρίσκεται πίσω του.
challenge.skewer.detail = Το αντίστροφο του καρφώματος: το πιο πολύτιμο κομμάτι βρίσκεται μπροστά, πρέπει να φύγει και αποκαλύπτει το κομμάτι πίσω του.
challenge.discovered.name = Αποκαλυπτόμενες επιθέσεις
challenge.discovered.desc = Κινήστε ένα κομμάτι για να εξαπολύσετε ένα άλλο.
challenge.discovered.detail = Όταν ένα κομμάτι παραμερίζει, το κομμάτι που βρίσκεται πίσω του επιτίθεται. Με σαχ ή με διπλό σαχ, ο αντίπαλος δεν έχει χρόνο να απαντήσει και στις δύο απειλές.
challenge.deflection.name = Εκτροπή και προσέλκυση
challenge.deflection.desc = Απομακρύνετε έναν υπερασπιστή ή παρασύρετέ τον σε μοιραίο τετράγωνο.
challenge.deflection.detail = Ένας υπερασπιστής με δύο αποστολές δεν μπορεί να εκτελέσει και τις δύο. Επιτεθείτε σε αυτόν, προσφέρετέ του κάτι ή αναγκάστε ένα κομμάτι να πάει στο τετράγωνο όπου θα χαθεί.
challenge.intermezzo.name = Ενδιάμεσες κινήσεις
challenge.intermezzo.desc = Μην ξαναπάρετε αμέσως: υπάρχει κάτι πιο δυνατό.
challenge.intermezzo.detail = Πριν από την αναμενόμενη κίνηση, ένα ενδιάμεσο σαχ ή μια μεγαλύτερη απειλή αλλάζει τα πάντα.
challenge.trapped.name = Παγιδευμένα κομμάτια
challenge.trapped.desc = Ένα κομμάτι χωρίς κανένα ασφαλές τετράγωνο.
challenge.trapped.detail = Αφαιρέστε από ένα κομμάτι τα τελευταία τετράγωνα διαφυγής του και μετά κερδίστε το.
challenge.promotion.name = Προαγωγή
challenge.promotion.desc = Οδηγήστε ένα πιόνι ως την τελευταία γραμμή.
challenge.promotion.detail = Τα προχωρημένα πιόνια αξίζουν πολύ. Ανοίξτε τον δρόμο, απομακρύνετε τα κομμάτια που τα εμποδίζουν και φτιάξτε νέα βασίλισσα.
challenge.quiet.name = Ήσυχες κινήσεις
challenge.quiet.desc = Η κίνηση που κερδίζει δεν είναι ούτε σαχ ούτε αιχμαλωσία.
challenge.quiet.detail = Μερικές φορές η πιο δυνατή κίνηση απλώς προετοιμάζει μια απειλή που δεν μπορεί να αποκρουστεί. Το πιο δύσκολο είδος για να το δει κανείς.
challenge.opening.name = Παγίδες στο άνοιγμα
challenge.opening.desc = Τιμωρήστε τα πρόωρα λάθη.
challenge.opening.detail = Θέσεις από τις πρώτες κινήσεις πραγματικών παρτίδων, όπου μία απρόσεκτη κίνηση μπορεί να τιμωρηθεί αμέσως.
challenge.escape.name = Βρείτε τη διαφυγή
challenge.escape.desc = Ο βασιλιάς σας κινδυνεύει: μία κίνηση τον σώζει.
challenge.escape.detail = Κάθε άλλη κίνηση χάνει. Εξετάστε όλα τα σαχ και τις απειλές κατά του βασιλιά σας και βρείτε τη μόνη διέξοδο.
challenge.defend.name = Αμυντικές κινήσεις
challenge.defend.desc = Αποκρούστε την απειλή χωρίς να χάσετε υλικό.
challenge.defend.detail = Ο προπονητής απειλεί κάτι. Βρείτε την ακριβή κίνηση που κρατά τα πάντα στη θέση τους.
challenge.kq.name = Βασίλισσα και βασιλιάς εναντίον βασιλιά
challenge.kq.desc = Ματ με τη βασίλισσα.
challenge.kq.detail = Σπρώξτε τον μοναχικό βασιλιά στην άκρη με τη βασίλισσά σας, φέρτε κοντά τον δικό σας βασιλιά και προσέξτε το πατ. Ο προπονητής αμύνεται με τις καλύτερες κινήσεις του.
challenge.kr.name = Πύργος και βασιλιάς εναντίον βασιλιά
challenge.kr.desc = Ματ με τον πύργο.
challenge.kr.detail = Ο πύργος αποκόπτει τον βασιλιά, γραμμή προς γραμμή· ο βασιλιάς σας παίρνει την αντίθεση. Ο προπονητής αμύνεται με τις καλύτερες κινήσεις του.
challenge.kp.name = Βασιλιάς και πιόνι εναντίον βασιλιά
challenge.kp.desc = Κερδίστε την αντίθεση και κάντε προαγωγή.
challenge.kp.detail = Μπροστά πηγαίνει ο βασιλιάς σας, όχι το πιόνι. Πάρτε την αντίθεση και φτιάξτε μια βασίλισσα που ο προπονητής δεν μπορεί να προλάβει.
challenge.kp_hold.name = Σταματήστε το πιόνι
challenge.kp_hold.desc = Μοναχικός βασιλιάς εναντίον βασιλιά και πιονιού: κρατήστε την ισοπαλία.
challenge.kp_hold.detail = Σταθείτε μπροστά από το πιόνι και κρατήστε την αντίθεση. Αντέξτε για δέκα κινήσεις.
challenge.rook.name = Φινάλε πύργων
challenge.rook.desc = Η γέφυρα Λουσένα και η άμυνα Φιλιντόρ.
challenge.rook.detail = Οι δύο θέσεις που πρέπει να ξέρει κάθε παίκτης: πώς κερδίζετε με πιόνι στην έβδομη γραμμή και πώς αμύνεστε με τον πύργο στην τρίτη.
challenge.endgame.name = Τακτική στο φινάλε
challenge.endgame.desc = Λίγα κομμάτια, οξείες ιδέες.
challenge.endgame.detail = Κούρσες πιονιών, διασπάσεις και φινάλε πύργων από πραγματικές παρτίδες.
# The column of the selected challenge. {0} = the number of positions in the set
coach.challenge.positions = {0} θέση|{0} θέσεις
coach.challenge.done = Ολοκληρώθηκε
coach.challenge.start = Έναρξη
coach.challenge.note.white = Παίζετε με τα λευκά· ο προπονητής στήνει κάθε θέση στη σκακιέρα.
coach.challenge.note.hint = Κολλήσατε; Πατήστε H για υπόδειξη. Μετά από μερικές προσπάθειες, ο προπονητής θα σας προτείνει μία.
