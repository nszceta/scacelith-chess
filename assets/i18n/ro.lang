challenge.group.endgames = FINALURI
# Each challenge (assets/coach/challenges/challenges.txt): a name, a one-line description (about 60
# characters) and a paragraph for the column of the selected challenge
challenge.mate1.name = Mat într-o mutare
challenge.mate1.desc = O singură mutare, și e mat.
challenge.mate1.detail = Priviți mai întâi fiecare șah: unul dintre ele nu lasă regelui niciun câmp și nu poate fi parat nici prin interpunere, nici prin captură.
challenge.mate2.name = Mat în două mutări
challenge.mate2.desc = O mutare care nu lasă nicio apărare, apoi mat.
challenge.mate2.detail = Prima mutare este adesea un șah sau un sacrificiu care îi ia regelui un câmp. Antrenorul se apără cât de bine poate.
challenge.mate3.name = Mat în trei mutări
challenge.mate3.desc = Variante forțate mai lungi.
challenge.mate3.detail = Șahuri, capturi și amenințări, pe trei mutări în adâncime. Calculați cel mai bun răspuns al antrenorului la fiecare pas înainte de a atinge o piesă.
challenge.backrank.name = Maturi pe ultima linie
challenge.backrank.desc = Un rege prins în spatele propriilor pioni.
challenge.backrank.detail = Când pionii din fața unui rege care a făcut rocada nu s-au mișcat, un turn sau o damă pe ultima linie poate da mat. Eliminați sau deviați mai întâi apărătorii.
challenge.patterns.name = Modele de mat
challenge.patterns.desc = Matul înăbușit, matul Anastasiei, matul arab și alte maturi clasice.
challenge.patterns.detail = Rețele de mat celebre, care revin iar și iar. Învățați să recunoașteți așezarea pieselor și lovitura finală.
challenge.hanging.name = Piese în priză
challenge.hanging.desc = Observați ce a rămas neapărat.
challenge.hanging.detail = O piesă sau un pion pe care nu îl apără nimeni poate fi pur și simplu luat. Verificați de cine este apărată fiecare piesă a antrenorului.
challenge.fork.name = Furculițe
challenge.fork.desc = O piesă atacă două deodată.
challenge.fork.detail = Caii, pionii, damele și chiar regii pot face furculițe. Adversarul nu poate salva decât una dintre cele două ținte.
challenge.pin.name = Legări
challenge.pin.desc = O piesă care nu se poate mișca fără să piardă ce se află în spatele ei.
challenge.pin.detail = Legați o piesă de regele ei sau de o piesă mai valoroasă, apoi atacați-o din nou sau folosiți faptul că nu se poate mișca.
challenge.skewer.name = Frigări
challenge.skewer.desc = Atacați o piesă valoroasă și câștigați-o pe cea din spatele ei.
challenge.skewer.detail = Inversul legării: piesa mai valoroasă stă în față, trebuie să se mute și o descoperă pe cea din spatele ei.
challenge.discovered.name = Atacuri descoperite
challenge.discovered.desc = Mutați o piesă pentru a dezlănțui alta.
challenge.discovered.detail = Când o piesă iese de pe o linie de atac, piesa din spatele ei atacă. Cu șah sau cu șah dublu, adversarul nu are timp să răspundă ambelor amenințări.
challenge.deflection.name = Deviere și atragere
challenge.deflection.desc = Îndepărtați un apărător sau atrageți o piesă pe un câmp fatal.
challenge.deflection.detail = Un apărător care are două sarcini nu le poate îndeplini pe amândouă. Atacați-l, oferiți-i ceva sau forțați o piesă pe câmpul unde va fi pierdută.
challenge.intermezzo.name = Mutări intermediare
challenge.intermezzo.desc = Nu reluați imediat: există ceva mai puternic.
challenge.intermezzo.detail = Înaintea mutării așteptate, un șah sau o amenințare mai mare intercalată schimbă totul.
challenge.trapped.name = Piese prinse
challenge.trapped.desc = O piesă care nu mai are niciun câmp sigur.
challenge.trapped.detail = Luați-i unei piese ultimele câmpuri de retragere, apoi câștigați-o.
challenge.promotion.name = Promovare
challenge.promotion.desc = Duceți un pion până pe ultima linie.
challenge.promotion.detail = Pionii avansați valorează mult. Eliberați drumul, deviați piesele care îl blochează și obțineți o damă nouă.
challenge.quiet.name = Mutări liniștite
challenge.quiet.desc = Mutarea câștigătoare nu este nici șah, nici captură.
challenge.quiet.detail = Uneori, cea mai puternică mutare doar pregătește o amenințare care nu mai poate fi parată. Sunt cele mai greu de văzut.
challenge.opening.name = Capcane în deschidere
challenge.opening.desc = Pedepsiți greșelile timpurii.
challenge.opening.detail = Poziții din primele mutări ale unor partide reale, în care o singură mutare neatentă poate fi exploatată imediat.
challenge.escape.name = Găsiți scăparea
challenge.escape.desc = Regele dvs. este în pericol: o singură mutare îl salvează.
challenge.escape.detail = Orice altă mutare pierde. Priviți toate șahurile și amenințările împotriva regelui dvs., apoi găsiți singura ieșire.
challenge.defend.name = Mutări defensive
challenge.defend.desc = Parați amenințarea fără să pierdeți material.
challenge.defend.detail = Antrenorul amenință ceva. Găsiți mutarea precisă care ține totul laolaltă.
challenge.kq.name = Damă și rege contra rege
challenge.kq.desc = Mat cu dama.
challenge.kq.detail = Împingeți cu dama regele rămas singur spre margine, apropiați-vă propriul rege și feriți-vă de pat. Antrenorul se apără cu cele mai bune mutări.
challenge.kr.name = Turn și rege contra rege
challenge.kr.desc = Mat cu turnul.
challenge.kr.detail = Turnul taie regele, linie cu linie; regele dvs. ia opoziția. Antrenorul se apără cu cele mai bune mutări.
challenge.kp.name = Rege și pion contra rege
challenge.kp.desc = Câștigați opoziția și promovați pionul.
challenge.kp.detail = Conduceți cu regele, nu cu pionul. Luați opoziția și faceți o damă pe care antrenorul nu o poate prinde.
challenge.kp_hold.name = Opriți pionul
challenge.kp_hold.desc = Un rege singur contra rege și pion: țineți remiza.
challenge.kp_hold.detail = Așezați regele în fața pionului și păstrați opoziția. Rezistați zece mutări.
challenge.rook.name = Finaluri de turnuri
challenge.rook.desc = Podul lui Lucena și apărarea Philidor.
challenge.rook.detail = Cele două poziții pe care orice jucător ar trebui să le cunoască: cum se câștigă cu un pion pe linia a șaptea și cum se apără cu turnul pe linia a treia.
challenge.endgame.name = Tactică în final
challenge.endgame.desc = Puține piese, idei ascuțite.
challenge.endgame.detail = Curse de pioni, străpungeri și finaluri de turnuri din partide reale.
# The column of the selected challenge. {0} = the number of positions in the set
coach.challenge.positions = {0} poziție|{0} poziții|{0} de poziții
coach.challenge.done = Finalizată
coach.challenge.start = Start
coach.challenge.note.white = Jucați cu albele; antrenorul așază fiecare poziție pe tablă.
coach.challenge.note.hint = V-ați blocat? Apăsați H pentru un indiciu. După câteva încercări, antrenorul vă va oferi unul.
coach.challenge.note.unsaved = Provocările nu contează pentru rating și nu se salvează; o bifă le marchează pe cele pe care le-ați finalizat.
# At the table: the band at the top, after the challenge's name. {0} = the position being solved, {1} = the number of positions
coach.challenge.progress = {0} / {1}
