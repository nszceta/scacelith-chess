challenge.group.endgames = SLUTSPEL
# Each challenge (assets/coach/challenges/challenges.txt): a name, a one-line description (about 60
# characters) and a paragraph for the column of the selected challenge
challenge.mate1.name = Matt i ett drag
challenge.mate1.desc = Ett drag, och det är schackmatt.
challenge.mate1.detail = Titta först på alla schackar: en av dem lämnar kungen utan ruta att fly till, utan pjäs att ställa emellan och utan något att slå.
challenge.mate2.name = Matt i två drag
challenge.mate2.desc = Ett drag som inte lämnar något försvar, sedan matt.
challenge.mate2.detail = Det första draget är ofta en schack eller ett offer som tar en ruta från kungen. Tränaren försvarar sig så gott han kan.
challenge.mate3.name = Matt i tre drag
challenge.mate3.desc = Längre forcerande varianter.
challenge.mate3.detail = Schackar, slag och hot, tre drag djupt. Räkna ut tränarens bästa svar i varje steg innan du rör en pjäs.
challenge.backrank.name = Baslinjematt
challenge.backrank.desc = En kung instängd bakom sina egna bönder.
challenge.backrank.detail = När bönderna framför en rockerad kung inte har flyttats kan ett torn eller en dam på sista raden sätta matt. Ta först bort eller avled försvararna.
challenge.patterns.name = Mattmönster
challenge.patterns.desc = Kvävningsmatt, Anastasias matt, arabisk matt med flera.
challenge.patterns.detail = Berömda mattnät som återkommer gång på gång. Lär dig känna igen pjäsernas uppställning och det avgörande slaget.
challenge.hanging.name = Gratispjäser
challenge.hanging.desc = Hitta det som står oskyddat.
challenge.hanging.detail = En pjäs eller bonde som ingen försvarar kan helt enkelt slås. Kontrollera vad var och en av tränarens pjäser skyddas av.
challenge.fork.name = Gafflar
challenge.fork.desc = En pjäs angriper två samtidigt.
challenge.fork.detail = Springare, bönder, damer och till och med kungar kan gaffla. Motståndaren kan bara rädda det ena av de två målen.
challenge.pin.name = Bindningar
challenge.pin.desc = En pjäs som inte kan flytta utan att förlora det bakom sig.
challenge.pin.detail = Bind en pjäs mot kungen eller mot en mer värdefull pjäs, och angrip den sedan en gång till, eller utnyttja att den inte kan flytta.
challenge.skewer.name = Spett
challenge.skewer.desc = Angrip en värdefull pjäs och vinn den som står bakom.
challenge.skewer.detail = Motsatsen till en bindning: den mer värdefulla pjäsen står framför, måste flytta undan och blottar pjäsen bakom sig.
challenge.discovered.name = Avdragsangrepp
challenge.discovered.desc = Flytta en pjäs för att släppa loss en annan.
challenge.discovered.detail = När en pjäs kliver ut ur en linje angriper pjäsen bakom den. Med schack, eller med dubbelschack, hinner motståndaren inte möta båda hoten.
challenge.deflection.name = Avledning och lockning
challenge.deflection.desc = Locka bort en försvarare, eller in på en ödesdiger ruta.
challenge.deflection.detail = En försvarare som har två uppgifter kan inte klara båda. Angrip den, erbjud den något, eller tvinga in en pjäs på rutan där den går förlorad.
challenge.intermezzo.name = Mellandrag
challenge.intermezzo.desc = Slå inte tillbaka direkt: det finns något starkare.
challenge.intermezzo.detail = En inskjuten schack eller ett större hot före det väntade draget ändrar allt.
challenge.trapped.name = Instängda pjäser
challenge.trapped.desc = En pjäs utan någon säker ruta kvar.
challenge.trapped.detail = Ta ifrån en pjäs dess sista flyktrutor och vinn den sedan.
challenge.promotion.name = Förvandling
challenge.promotion.desc = Driv fram en bonde till sista raden.
challenge.promotion.detail = Långt framskjutna bönder är värda mycket. Röj vägen, locka bort blockörerna och gör en ny dam.
challenge.quiet.name = Tysta drag
challenge.quiet.desc = Det vinnande draget är varken en schack eller ett slag.
challenge.quiet.detail = Ibland förbereder det starkaste draget bara ett hot som inte går att parera. Den svåraste sorten att se.
challenge.opening.name = Öppningsfällor
challenge.opening.desc = Straffa tidiga misstag.
challenge.opening.detail = Ställningar från de första dragen i verkliga partier, där ett slarvigt drag kan utnyttjas direkt.
challenge.escape.name = Hitta räddningen
challenge.escape.desc = Din kung är i fara: ett drag räddar den.
challenge.escape.detail = Alla andra drag förlorar. Titta på alla schackar och hot mot din kung, och hitta den enda vägen ut.
challenge.defend.name = Försvarsdrag
challenge.defend.desc = Parera hotet utan att förlora material.
challenge.defend.detail = Tränaren hotar något. Hitta det exakta draget som håller ihop allt.
challenge.kq.name = Dam och kung mot kung
challenge.kq.desc = Sätt matt med damen.
challenge.kq.detail = Driv den ensamma kungen mot kanten med din dam, för din egen kung närmare och se upp för patt. Tränaren försvarar sig med sina bästa drag.
challenge.kr.name = Torn och kung mot kung
challenge.kr.desc = Sätt matt med tornet.
challenge.kr.detail = Tornet skär av kungen, rad för rad; din kung tar oppositionen. Tränaren försvarar sig med sina bästa drag.
challenge.kp.name = Kung och bonde mot kung
challenge.kp.desc = Vinn oppositionen och förvandla bonden.
challenge.kp.detail = Gå före med kungen, inte med bonden. Ta oppositionen och gör dam utan att tränaren hinner ifatt.
challenge.kp_hold.name = Stoppa bonden
challenge.kp_hold.desc = Ensam kung mot kung och bonde: håll remi.
challenge.kp_hold.detail = Ställ dig framför bonden och behåll oppositionen. Håll ut i tio drag.
challenge.rook.name = Tornslutspel
challenge.rook.desc = Lucenas brobygge och Philidors försvar.
challenge.rook.detail = De två ställningarna som varje spelare bör kunna: hur man vinner med en bonde på sjunde raden, och hur man försvarar sig med tornet på tredje.
challenge.endgame.name = Slutspelstaktik
challenge.endgame.desc = Få pjäser, skarpa idéer.
challenge.endgame.detail = Bondekapplöpningar, genombrott och tornslutspel från verkliga partier.
