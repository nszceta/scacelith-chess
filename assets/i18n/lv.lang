coach.level.4.name = Kluba spēlētājs
coach.level.4.desc = Kandidātgājieni, novērtējums bandiniekos.
coach.level.4.detail = Treneris izvērtē kandidātgājienus un sniedz novērtējumu bandiniekos, kā to darītu kluba treneris.
coach.level.5.name = Spēcīgs kluba spēlētājs
