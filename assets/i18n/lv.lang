# Each challenge (assets/coach/challenges/challenges.txt): a name, a one-line description (about 60
# characters) and a paragraph for the column of the selected challenge
challenge.mate1.name = Mats vienā gājienā
challenge.mate1.desc = Viens gājiens — un tas ir mats.
challenge.mate1.detail = Vispirms apskatiet visus šahus: viens no tiem neatstāj karalim ne brīva lauciņa, ne iespējas aizsegties, ne ņemt.
challenge.mate2.name = Mats divos gājienos
challenge.mate2.desc = Gājiens, pret kuru nav aizsardzības, tad mats.
challenge.mate2.detail = Pirmais gājiens bieži ir šahs vai upuris, kas atņem karalim lauciņu. Treneris aizsargājas, cik labi vien spēj.
challenge.mate3.name = Mats trijos gājienos
challenge.mate3.desc = Garāki forsēti varianti.
challenge.mate3.detail = Šahi, ņemšanas un draudi trīs gājienu dziļumā. Pirms pieskaraties figūrai, katrā solī aprēķiniet trenera labāko atbildi.
challenge.backrank.name = Mats pa pēdējo horizontāli
challenge.backrank.desc = Karalis ieslēgts aiz saviem bandiniekiem.
challenge.backrank.detail = Ja bandinieki karaļa priekšā pēc rokādes nav pakustējušies, tornis vai dāma pēdējā horizontālē var pieteikt matu. Vispirms likvidējiet aizsargus vai novirziet tos.
challenge.patterns.name = Mata motīvi
challenge.patterns.desc = Nosmacētais mats, Anastasijas mats, arābu mats un citi klasiski motīvi.
challenge.patterns.detail = Slaveni matu tīkli, kas atkārtojas atkal un atkal. Iemācieties atpazīt figūru izvietojumu un izšķirošo triecienu.
challenge.hanging.name = Neaizsargātas figūras
challenge.hanging.desc = Pamaniet, kas palicis neaizsargāts.
challenge.hanging.detail = Figūru vai bandinieku, ko neviens neaizsargā, var vienkārši paņemt. Pārbaudiet, kas aizsargā katru trenera figūru.
challenge.fork.name = Dakšas
challenge.fork.desc = Viena figūra uzbrūk divām vienlaikus.
challenge.fork.detail = Dakšu var izveidot zirgi, bandinieki, dāmas un pat karaļi. Pretinieks var paglābt tikai vienu no diviem mērķiem.
challenge.pin.name = Piesaistes
challenge.pin.desc = Figūra, kas nevar pakustēties, nezaudējot to, kas stāv aiz tās.
challenge.pin.detail = Piesaistiet figūru tās karalim vai vērtīgākai figūrai, tad uzbrūciet tai vēlreiz vai izmantojiet to, ka tā nevar pakustēties.
challenge.skewer.name = Iesmi
challenge.skewer.desc = Uzbrūciet vērtīgai figūrai un iegūstiet to, kas aiz tās.
challenge.skewer.detail = Piesaistes pretstats: vērtīgākā figūra stāv priekšā, tai jāatkāpjas un jāatsedz figūra aiz sevis.
challenge.discovered.name = Atklātie uzbrukumi
challenge.discovered.desc = Pārvietojiet vienu figūru, lai atbrīvotu citu.
challenge.discovered.detail = Kad figūra pamet līniju, uzbrūk figūra, kas stāv aiz tās. Ar šahu vai dubultšahu pretiniekam nav laika atbildēt uz abiem draudiem.
challenge.deflection.name = Novirzīšana un pievilināšana
challenge.deflection.desc = Novirziet aizsargu vai ieviliniet to liktenīgā lauciņā.
challenge.deflection.detail = Aizsargs, kuram ir divi uzdevumi, nevar paveikt abus. Uzbrūciet tam, piedāvājiet tam kaut ko vai piespiediet figūru iet uz lauciņu, kur tā tiks zaudēta.
challenge.intermezzo.name = Starpgājieni
challenge.intermezzo.desc = Nesteidzieties ņemt atpakaļ: ir kaut kas spēcīgāks.
challenge.intermezzo.detail = Ja pirms gaidītā gājiena tiek pieteikts šahs vai radīti lielāki draudi, tas maina visu.
challenge.trapped.name = Ieslēgtas figūras
challenge.trapped.desc = Figūra, kurai vairs nav droša lauciņa.
challenge.trapped.detail = Atņemiet figūrai pēdējos atkāpšanās lauciņus, tad iegūstiet to.
challenge.promotion.name = Bandinieka pārvēršana
challenge.promotion.desc = Izvediet bandinieku līdz pēdējai horizontālei.
challenge.promotion.detail = Tālu pavirzīti bandinieki ir daudz vērti. Atbrīvojiet ceļu, novirziet bloķētājus un iegūstiet jaunu dāmu.
challenge.quiet.name = Klusie gājieni
challenge.quiet.desc = Uzvarošais gājiens nav ne šahs, ne ņemšana.
challenge.quiet.detail = Dažreiz spēcīgākais gājiens tikai sagatavo draudus, kurus nevar novērst. Visgrūtāk pamanāmais gājienu veids.
challenge.opening.name = Atklātņu slazdi
challenge.opening.desc = Sodiet par agrīnām kļūdām.
challenge.opening.detail = Pozīcijas no īstu partiju pirmajiem gājieniem, kur vienu neuzmanīgu gājienu var uzreiz izmantot.
challenge.escape.name = Atrodiet izeju
challenge.escape.desc = Jūsu karalis ir briesmās: to izglābj viens gājiens.
challenge.escape.detail = Visi citi gājieni zaudē. Apskatiet visus šahus un draudus jūsu karalim, tad atrodiet vienīgo izeju.
challenge.defend.name = Aizsardzības gājieni
challenge.defend.desc = Novērsiet draudus, nezaudējot materiālu.
challenge.defend.detail = Treneris rada draudus. Atrodiet precīzo gājienu, kas notur visu kopā.
challenge.kq.name = Dāma un karalis pret karali
challenge.kq.desc = Mats ar dāmu.
challenge.kq.detail = Ar dāmu aizdzeniet vientuļo karali uz malu, pievediet tuvāk savu karali un uzmanieties no pata. Treneris aizsargājas ar labākajiem gājieniem.
challenge.kr.name = Tornis un karalis pret karali
challenge.kr.desc = Mats ar torni.
challenge.kr.detail = Tornis nogriež karali horizontāli pēc horizontāles; jūsu karalis ieņem opozīciju. Treneris aizsargājas ar labākajiem gājieniem.
challenge.kp.name = Karalis un bandinieks pret karali
challenge.kp.desc = Iegūstiet opozīciju un pārvērtiet bandinieku.
challenge.kp.detail = Ejiet pa priekšu ar karali, nevis ar bandinieku. Ieņemiet opozīciju un iegūstiet dāmu, ko treneris nespēs noķert.
challenge.kp_hold.name = Apturiet bandinieku
challenge.kp_hold.desc = Vientuļš karalis pret karali un bandinieku: noturiet neizšķirtu.
challenge.kp_hold.detail = Nostājieties bandiniekam priekšā un saglabājiet opozīciju. Izturiet desmit gājienus.
challenge.rook.name = Torņu galotnes
challenge.rook.desc = Lusenas tilts un Filidora aizsardzība.
challenge.rook.detail = Divas pozīcijas, kas jāzina katram spēlētājam: kā uzvarēt ar bandinieku septītajā horizontālē un kā aizsargāties ar torni trešajā.
challenge.endgame.name = Galotņu taktika
challenge.endgame.desc = Maz figūru, asas idejas.
challenge.endgame.detail = Bandinieku sacīkstes, izrāvieni un torņu galotnes no īstām partijām.
