coach.challenge.done = Läbitud
coach.challenge.start = Alusta
coach.challenge.note.white = Te mängite valgetega; treener seab iga seisu lauale üles.
coach.challenge.note.hint = Jäite toppama? Vihje saamiseks vajutage H. Mõne katse järel pakub treener ise vihjet.
coach.challenge.note.unsaved = Väljakutsed ei mõjuta reitingut ja neid ei salvestata; linnuke märgib need, mille olete läbinud.
# At the table: the band at the top, after the challenge's name. {0} = the position being solved, {1} = the number of positions
