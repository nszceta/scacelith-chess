challenge.group.endgames = LÕPPMÄNGUD
# Each challenge (assets/coach/challenges/challenges.txt): a name, a one-line description (about 60
# characters) and a paragraph for the column of the selected challenge
challenge.mate1.name = Matt ühe käiguga
challenge.mate1.desc = Üks käik ja ongi matt.
challenge.mate1.detail = Vaadake kõigepealt läbi kõik tuled: üks neist ei jäta kuningale vaba välja ega võimalust tuld katta või tuld andvat malendit lüüa.
challenge.mate2.name = Matt kahe käiguga
challenge.mate2.desc = Käik, mille vastu pole kaitset, ja siis matt.
challenge.mate2.detail = Esimene käik on sageli tuli või ohverdus, mis võtab kuningalt ühe välja. Treener kaitseb end nii hästi, kui oskab.
challenge.mate3.name = Matt kolme käiguga
challenge.mate3.desc = Pikemad sundvariandid.
challenge.mate3.detail = Tuled, löömised ja ähvardused kolm käiku ette. Arvutage igal sammul välja treeneri parim vastus, enne kui malendit puudutate.
challenge.backrank.name = Tagumise rea matid
challenge.backrank.desc = Kuningas on lõksus oma etturite taga.
challenge.backrank.detail = Kui vangerdanud kuninga ees olevad etturid pole liikunud, võib vanker või lipp viimasel horisontaalil matti panna. Kõigepealt kõrvaldage kaitsjad või tõrjuge need eemale.
challenge.patterns.name = Matipildid
challenge.patterns.desc = Umbmatt, Anastasia matt, araabia matt ja muud klassikalised matid.
challenge.patterns.detail = Kuulsad mativõrgud, mis korduvad ikka ja jälle. Õppige ära tundma malendite paigutust ja lõpplööki.
challenge.hanging.name = Kaitseta malendid
challenge.hanging.desc = Märgake, mis on jäänud kaitseta.
challenge.hanging.detail = Nupu või etturi, mida keegi ei kaitse, saab lihtsalt ära lüüa. Kontrollige, mis kaitseb treeneri iga malendit.
challenge.fork.name = Kahvlid
challenge.fork.desc = Üks malend ründab korraga kahte.
challenge.fork.detail = Kahvlit saavad teha ratsud, etturid, lipud ja isegi kuningad. Vastane suudab päästa ainult ühe kahest sihtmärgist.
challenge.pin.name = Sidumised
challenge.pin.desc = Malend, mis ei saa liikuda, ilma et selle taga seisev kaotsi läheks.
challenge.pin.detail = Siduge malend, mille taga on kuningas või väärtuslikum malend, seejärel rünnake seda veel kord või kasutage ära seda, et see ei saa liikuda.
challenge.skewer.name = Läbilöögid
challenge.skewer.desc = Rünnake väärtuslikku malendit ja võitke selle taga olev.
challenge.skewer.detail = Sidumise vastand: väärtuslikum malend seisab ees, peab eest ära minema ja jätab oma taga oleva malendi löögi alla.
challenge.discovered.name = Avatud rünnakud
challenge.discovered.desc = Liigutage üht malendit ja vabastage teine.
challenge.discovered.detail = Kui malend astub liinilt kõrvale, ründab selle taga olev malend. Kui sellega kaasneb tuli või kahekordne tuli, pole vastasel aega mõlemale ähvardusele vastata.
challenge.deflection.name = Eemaletõrjumine ja meelitus
challenge.deflection.desc = Meelitage kaitsja eemale või saatuslikule väljale.
challenge.deflection.detail = Kahe ülesandega kaitsja ei suuda mõlemat täita. Rünnake seda, pakkuge talle midagi või sundige malend väljale, kus see läheb kaotsi.
challenge.intermezzo.name = Vahekäigud
challenge.intermezzo.desc = Ärge lööge kohe tagasi: on midagi tugevamat.
challenge.intermezzo.detail = Enne oodatud käiku muudab vahepealne tuli või suurem ähvardus kõik.
challenge.trapped.name = Lõksus malendid
challenge.trapped.desc = Malend, millel pole enam ühtki ohutut välja.
challenge.trapped.detail = Võtke malendilt viimased põgenemisväljad ja võitke see siis.
challenge.promotion.name = Muundumine
challenge.promotion.desc = Viige ettur läbi viimasele horisontaalile.
challenge.promotion.detail = Kaugele edenenud etturid on palju väärt. Tehke tee vabaks, tõrjuge blokeerijad eemale ja tehke uus lipp.
challenge.quiet.name = Vaiksed käigud
challenge.quiet.desc = Võitev käik pole tuli ega löömine.
challenge.quiet.detail = Mõnikord valmistab tugevaim käik lihtsalt ette ähvarduse, mille vastu pole kaitset. Seda liiki on kõige raskem märgata.
challenge.opening.name = Avangulõksud
challenge.opening.desc = Karistage varajaste vigade eest.
challenge.opening.detail = Seisud päris partiide esimestest käikudest, kus ühte hooletut käiku saab kohe ära kasutada.
challenge.escape.name = Leia pääsetee
challenge.escape.desc = Teie kuningas on ohus: üks käik päästab ta.
challenge.escape.detail = Kõik teised käigud kaotavad. Vaadake läbi kõik oma kuningale suunatud tuled ja ähvardused ning leidke ainus pääsetee.
challenge.defend.name = Kaitsekäigud
challenge.defend.desc = Tõrjuge ähvardus materjali kaotamata.
challenge.defend.detail = Treener ähvardab midagi. Leidke täpne käik, mis hoiab kõik koos.
challenge.kq.name = Lipp ja kuningas kuninga vastu
challenge.kq.desc = Matt lipuga.
challenge.kq.detail = Suruge üksik kuningas lipuga laua servale, tooge oma kuningas lähemale ja hoiduge patist. Treener kaitseb end parimate käikudega.
challenge.kr.name = Vanker ja kuningas kuninga vastu
challenge.kr.desc = Matt vankriga.
challenge.kr.detail = Vanker lõikab kuninga ära, horisontaal horisontaali järel; teie kuningas võtab opositsiooni. Treener kaitseb end parimate käikudega.
challenge.kp.name = Kuningas ja ettur kuninga vastu
challenge.kp.desc = Võitke opositsioon ja muundage ettur.
challenge.kp.detail = Ees peab käima kuningas, mitte ettur. Võtke opositsioon ja tehke lipp, mida treener ei suuda kinni püüda.
challenge.kp_hold.name = Peata ettur
challenge.kp_hold.desc = Üksik kuningas kuninga ja etturi vastu: hoidke viiki.
challenge.kp_hold.detail = Seiske etturi ees ja hoidke opositsiooni. Pidage vastu kümme käiku.
challenge.rook.name = Vankrilõppmängud
challenge.rook.desc = Lucena sild ja Philidori kaitse.
challenge.rook.detail = Kaks seisu, mida iga mängija peaks teadma: kuidas võita, kui ettur on seitsmendal horisontaalil, ja kuidas kaitsta vankriga kolmandal horisontaalil.
challenge.endgame.name = Lõppmängutaktika
challenge.endgame.desc = Vähe malendeid, teravad ideed.
challenge.endgame.detail = Etturite võidujooksud, läbimurded ja vankrilõppmängud päris partiidest.
