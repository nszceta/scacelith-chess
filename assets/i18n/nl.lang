# Each challenge (assets/coach/challenges/challenges.txt): a name, a one-line description (about 60
# characters) and a paragraph for the column of the selected challenge
challenge.mate1.name = Mat in één
challenge.mate1.desc = Eén zet, en het is mat.
challenge.mate1.detail = Bekijk eerst alle schaakzetten: bij één ervan heeft de koning geen vluchtveld, kan er niets tussen en valt er niets te slaan.
challenge.mate2.name = Mat in twee
challenge.mate2.desc = Een zet waartegen geen verdediging bestaat, dan mat.
challenge.mate2.detail = De eerste zet is vaak een schaak of een offer dat de koning een veld afneemt. De coach verdedigt zo goed als hij kan.
challenge.mate3.name = Mat in drie
challenge.mate3.desc = Langere forcerende varianten.
challenge.mate3.detail = Schaakzetten, slagzetten en dreigingen, drie zetten diep. Bereken bij elke stap het beste antwoord van de coach voordat je een stuk aanraakt.
challenge.backrank.name = Mat op de achterste rij
challenge.backrank.desc = Een koning opgesloten achter zijn eigen pionnen.
challenge.backrank.detail = Als de pionnen voor een gerokeerde koning nog niet zijn opgerukt, kan een toren of dame op de laatste rij mat zetten. Schakel eerst de verdedigers uit of leid ze af.
challenge.patterns.name = Matpatronen
challenge.patterns.desc = Stikmat, Anastasia's mat, Arabisch mat en andere klassiekers.
challenge.patterns.detail = Beroemde matnetten die steeds weer terugkomen. Leer de opstelling van de stukken en de genadeklap te herkennen.
challenge.hanging.name = Gratis stukken
challenge.hanging.desc = Ontdek wat er ongedekt staat.
challenge.hanging.detail = Een stuk of pion dat door niemand wordt gedekt, kun je gewoon slaan. Kijk waardoor elk stuk van de coach wordt gedekt.
challenge.fork.name = Vorken
challenge.fork.desc = Eén stuk valt er twee tegelijk aan.
challenge.fork.detail = Paarden, pionnen, dames en zelfs koningen kunnen een vork zetten. De tegenstander kan maar één van de twee doelwitten redden.
challenge.pin.name = Penningen
challenge.pin.desc = Een stuk dat niet weg kan zonder te verliezen wat erachter staat.
challenge.pin.detail = Pen een stuk tegen zijn koning of tegen een waardevoller stuk, val het daarna nog eens aan, of maak gebruik van het feit dat het niet weg kan.
challenge.skewer.name = Spiesen
challenge.skewer.desc = Val een waardevol stuk aan en win het stuk erachter.
challenge.skewer.detail = Het omgekeerde van een penning: het waardevollere stuk staat vooraan, moet weg en geeft het stuk erachter bloot.
challenge.discovered.name = Aftrekaanvallen
challenge.discovered.desc = Zet een stuk weg om een ander te ontketenen.
challenge.discovered.detail = Als een stuk opzijgaat, valt het stuk erachter aan. Met schaak, of met dubbelschaak, heeft de tegenstander geen tijd om beide dreigingen te pareren.
challenge.deflection.name = Afleiden en lokken
challenge.deflection.desc = Lok een verdediger weg, of naar een fataal veld.
challenge.deflection.detail = Een verdediger met twee taken kan ze niet allebei uitvoeren. Val hem aan, bied hem iets aan, of dwing een stuk naar het veld waar het verloren gaat.
challenge.intermezzo.name = Tussenzetten
challenge.intermezzo.desc = Sla niet meteen terug: er is iets sterkers.
challenge.intermezzo.detail = Vóór de verwachte zet verandert een schaak of een grotere dreiging tussendoor alles.
challenge.trapped.name = Ingesloten stukken
challenge.trapped.desc = Een stuk zonder veilig veld.
challenge.trapped.detail = Neem een stuk zijn laatste vluchtvelden af en win het dan.
challenge.promotion.name = Promotie
challenge.promotion.desc = Duw een pion door tot de laatste rij.
challenge.promotion.detail = Ver opgerukte pionnen zijn veel waard. Maak de weg vrij, leid de blokkeerders af en haal een nieuwe dame.
challenge.quiet.name = Stille zetten
challenge.quiet.desc = De winnende zet is geen schaak en geen slagzet.
challenge.quiet.detail = Soms bereidt de sterkste zet alleen een dreiging voor die niet te pareren is. Dat soort zetten is het moeilijkst te zien.
challenge.opening.name = Openingsvallen
challenge.opening.desc = Straf vroege fouten af.
challenge.opening.detail = Stellingen uit de eerste zetten van echte partijen, waarin één onvoorzichtige zet meteen kan worden uitgebuit.
challenge.escape.name = Vind de uitweg
challenge.escape.desc = Je koning is in gevaar: één zet redt hem.
challenge.escape.detail = Elke andere zet verliest. Bekijk alle schaakzetten en dreigingen tegen je koning en vind dan de enige uitweg.
challenge.defend.name = Verdedigende zetten
challenge.defend.desc = Pareer de dreiging zonder materiaal te verliezen.
challenge.defend.detail = De coach dreigt iets. Vind de precieze zet die alles bij elkaar houdt.
challenge.kq.name = Dame en koning tegen koning
challenge.kq.desc = Mat zetten met de dame.
challenge.kq.detail = Drijf de eenzame koning met je dame naar de rand, breng je eigen koning dichterbij en pas op voor pat. De coach verdedigt met zijn beste zetten.
challenge.kr.name = Toren en koning tegen koning
challenge.kr.desc = Mat zetten met de toren.
challenge.kr.detail = De toren snijdt de koning rij voor rij af; je koning neemt de oppositie. De coach verdedigt met zijn beste zetten.
challenge.kp.name = Koning en pion tegen koning
challenge.kp.desc = Win de oppositie en promoveer.
challenge.kp.detail = Ga voorop met je koning, niet met de pion. Neem de oppositie en haal een dame die de coach niet meer kan tegenhouden.
challenge.kp_hold.name = Stop de pion
challenge.kp_hold.desc = Een eenzame koning tegen koning en pion: houd de remise.
challenge.kp_hold.detail = Ga voor de pion staan en houd de oppositie. Houd tien zetten stand.
challenge.rook.name = Toreneindspelen
challenge.rook.desc = De brug van Lucena en de verdediging van Philidor.
challenge.rook.detail = De twee stellingen die elke speler moet kennen: hoe je wint met een pion op de zevende rij, en hoe je verdedigt met de toren op de derde.
challenge.endgame.name = Eindspeltactiek
challenge.endgame.desc = Weinig stukken, scherpe ideeën.
challenge.endgame.detail = Pionnenwedlopen, doorbraken en toreneindspelen uit echte partijen.
