# ---- Coach challenges (src/ui/ui_coach.cpp; the coach's spoken lines are in assets/coach/speech/<lang>/challenge.lang)
# Challenge names are the ones the coach says at the start of each challenge (ch.intro.* in
# assets/coach/speech/pl/challenge.lang).
# The tabs of the Coach page: games with the coach, and short sets of positions to solve
coach.tab.training = Trening
coach.tab.challenges = Wyzwania
# Group headings of the list (capitals: section headings)
challenge.group.mates = MATY
challenge.group.tactics = TAKTYKA
challenge.group.defence = OBRONA
challenge.group.endgames = KOŃCÓWKI
# Each challenge (assets/coach/challenges/challenges.txt): a name, a one-line description (about 60
# characters) and a paragraph for the column of the selected challenge
challenge.mate1.name = Mat w jednym ruchu
challenge.mate1.desc = Jeden ruch i jest mat.
challenge.mate1.detail = Najpierw sprawdź wszystkie szachy: po jednym z nich król nie ma ani pola ucieczki, ani zasłony, ani bicia.
challenge.mate2.name = Mat w dwóch ruchach
challenge.mate2.desc = Ruch, po którym nie ma obrony, a potem mat.
challenge.mate2.detail = Pierwszy ruch to często szach albo poświęcenie, które odbiera królowi pole. Trener broni się najlepiej, jak potrafi.
challenge.mate3.name = Mat w trzech ruchach
challenge.mate3.desc = Dłuższe warianty forsujące.
challenge.mate3.detail = Szachy, bicia i groźby na trzy ruchy w głąb. Zanim dotkniesz bierki, na każdym kroku wylicz najlepszą odpowiedź trenera.
challenge.backrank.name = Maty na ostatniej linii
challenge.backrank.desc = Król uwięziony za własnymi pionkami.
challenge.backrank.detail = Gdy pionki przed królem po roszadzie się nie ruszyły, wieża lub hetman na ostatniej linii mogą dać mata. Najpierw usuń albo odciągnij obrońców.
challenge.patterns.name = Typowe maty
challenge.patterns.desc = Mat zduszony, mat Anastazji, mat arabski i inne klasyki.
challenge.patterns.detail = Słynne sieci matowe, które powracają raz za razem. Naucz się rozpoznawać ustawienie bierek i ostatni cios.
challenge.hanging.name = Bierki bez obrony
challenge.hanging.desc = Wypatrz, co zostało bez obrony.
challenge.hanging.detail = Figurę lub pionka, których nikt nie broni, można po prostu zbić. Sprawdź, co chroni każdą bierkę trenera.
challenge.fork.name = Widełki
challenge.fork.desc = Jedna bierka atakuje dwie naraz.
challenge.fork.detail = Widełki mogą dać skoczki, pionki, hetmany, a nawet króle. Przeciwnik może uratować tylko jeden z dwóch celów.
challenge.pin.name = Związania
challenge.pin.desc = Bierka, która nie może się ruszyć bez straty tego, co za nią stoi.
challenge.pin.detail = Zwiąż bierkę z jej królem lub z cenniejszą bierką, a potem zaatakuj ją ponownie albo wykorzystaj to, że nie może się ruszyć.
challenge.skewer.name = Przeszycia
challenge.skewer.desc = Zaatakuj cenną bierkę i zdobądź tę, która stoi za nią.
challenge.skewer.detail = Odwrotność związania: cenniejsza bierka stoi z przodu, musi zejść z linii i odsłania bierkę za sobą.
challenge.discovered.name = Ataki z odsłony
challenge.discovered.desc = Rusz jedną bierkę, aby uwolnić drugą.
challenge.discovered.detail = Gdy bierka zejdzie z linii, atakuje bierka stojąca za nią. Przy szachu z odsłony lub podwójnym szachu przeciwnik nie zdąży odpowiedzieć na obie groźby.
challenge.deflection.name = Odciągnięcie i zwabienie
challenge.deflection.desc = Odciągnij obrońcę albo zwab go na zgubne pole.
challenge.deflection.detail = Obrońca, który ma dwa zadania, nie wykona obu. Zaatakuj go, zaoferuj mu coś albo zmuś bierkę do wejścia na pole, na którym zginie.
challenge.intermezzo.name = Ruchy pośrednie
challenge.intermezzo.desc = Nie odbijaj od razu: jest coś silniejszego.
challenge.intermezzo.detail = Przed oczekiwanym ruchem szach albo większa groźba wtrącona po drodze zmienia wszystko.
challenge.trapped.name = Uwięzione bierki
challenge.trapped.desc = Bierka, której nie zostało już żadne bezpieczne pole.
challenge.trapped.detail = Odbierz bierce ostatnie pola ucieczki, a potem ją zdobądź.
challenge.promotion.name = Promocja
challenge.promotion.desc = Przeprowadź pionka na ostatnią linię.
challenge.promotion.detail = Wysunięte pionki są dużo warte. Oczyść drogę, odciągnij blokujące bierki i zrób nowego hetmana.
challenge.quiet.name = Ciche ruchy
challenge.quiet.desc = Wygrywający ruch nie jest ani szachem, ani biciem.
challenge.quiet.detail = Czasem najsilniejszy ruch tylko przygotowuje groźbę, której nie da się odeprzeć. Takie ruchy najtrudniej dostrzec.
challenge.opening.name = Pułapki debiutowe
challenge.opening.desc = Ukarz wczesne błędy.
challenge.opening.detail = Pozycje z pierwszych ruchów prawdziwych partii, w których jeden nieostrożny ruch można od razu wykorzystać.
challenge.escape.name = Znajdź ucieczkę
challenge.escape.desc = Twój król jest w niebezpieczeństwie: ratuje go jeden ruch.
challenge.escape.detail = Każdy inny ruch przegrywa. Przejrzyj wszystkie szachy i groźby wobec twojego króla, a potem znajdź jedyne wyjście.
challenge.defend.name = Ruchy obronne
challenge.defend.desc = Odeprzyj groźbę bez straty materiału.
challenge.defend.detail = Trener czymś grozi. Znajdź precyzyjny ruch, który utrzymuje całą pozycję.
challenge.kq.name = Hetman i król przeciw królowi
challenge.kq.desc = Mat hetmanem.
challenge.kq.detail = Zepchnij hetmanem samotnego króla na brzeg szachownicy, podprowadź własnego króla i uważaj na pata. Trener broni się najlepszymi ruchami.
challenge.kr.name = Wieża i król przeciw królowi
challenge.kr.desc = Mat wieżą.
challenge.kr.detail = Wieża odcina króla rząd po rzędzie; twój król zajmuje opozycję. Trener broni się najlepszymi ruchami.
challenge.kp.name = Król i pionek przeciw królowi
challenge.kp.desc = Zdobądź opozycję i przeprowadź pionka.
challenge.kp.detail = Prowadź królem, nie pionkiem. Zajmij opozycję i zrób hetmana, którego trener nie zdoła zatrzymać.
challenge.kp_hold.name = Zatrzymaj pionka
challenge.kp_hold.desc = Samotny król przeciw królowi z pionkiem: utrzymaj remis.
challenge.kp_hold.detail = Stań przed pionkiem i trzymaj opozycję. Wytrzymaj dziesięć ruchów.
challenge.rook.name = Końcówki wieżowe
challenge.rook.desc = Most Luceny i obrona Philidora.
challenge.rook.detail = Dwie pozycje, które powinien znać każdy gracz: jak wygrać z pionkiem na siódmym rzędzie i jak bronić się wieżą na trzecim.
challenge.endgame.name = Taktyka w końcówce
challenge.endgame.desc = Mało bierek, ostre pomysły.
challenge.endgame.detail = Wyścigi pionków, przełamania i końcówki wieżowe z prawdziwych partii.
# The column of the selected challenge. {0} = the number of positions in the set
coach.challenge.positions = {0} pozycja|{0} pozycje|{0} pozycji
coach.challenge.done = Ukończone
coach.challenge.start = Rozpocznij
coach.challenge.note.white = Grasz białymi; trener ustawia każdą pozycję na szachownicy.
coach.challenge.note.hint = Nie wiesz, co dalej? Naciśnij H, aby dostać podpowiedź. Po kilku próbach trener sam ją zaproponuje.
coach.challenge.note.unsaved = Wyzwania nie są rankingowe ani zapisywane; ukończone są oznaczone ptaszkiem.
# At the table: the band at the top, after the challenge's name. {0} = the position being solved, {1} = the number of positions
coach.challenge.progress = {0} / {1}
# The card at the end of a challenge
coach.challenge.complete = WYZWANIE UKOŃCZONE
coach.challenge.complete.line = Wszystkie pozycje rozwiązane.
coach.challenge.next = Następne wyzwanie
coach.challenge.again = Jeszcze raz
# The coach's offer of a hint (a card like the takeback offer), and the key cap of the hint at the bottom of the screen
coach.hint.title = PODPOWIEDŹ?
coach.hint.text = Trener proponuje ci podpowiedź.
coach.hint.hint = H daje podpowiedź. Dotknięcie bierki oznacza dalsze szukanie.
coach.hint.accept = Podpowiedź
coach.hint.decline = Nie, dziękuję
coach.hint.key = Podpowiedź

