coach.recommended = Polecany
# Levels: a name, a one-line description (60 characters at most) and a paragraph for the lesson column
coach.level.0.name = Zasady gry w szachy
coach.level.0.desc = Interaktywna lekcja, po jednej zasadzie naraz.
coach.level.0.detail = Trener ustawia małe pozycje i pokazuje, jak porusza się i bije każda bierka, a potem roszadę, promocję, szach i mat. Każdy pomysł wypróbowujesz samodzielnie na szachownicy.
coach.level.1.name = Pierwsze kroki
coach.level.1.desc = Co jest atakowane, a co zostaje bez obrony.
coach.level.1.detail = Trener gra łagodnie i mówi prostymi słowami: które z twoich bierek są atakowane, które zostają bez obrony i jak ich nie stracić.
coach.level.2.name = Początkujący
coach.level.2.desc = Prosta taktyka, rozwój, bezpieczeństwo króla.
coach.level.2.detail = Trener nazywa po imieniu widełki i związania oraz mówi o wyprowadzaniu figur i o bezpieczeństwie twojego króla.
coach.level.3.name = Średnio zaawansowany
coach.level.3.desc = Plany, struktura pionkowa, jedyne ruchy.
coach.level.3.detail = Trener objaśnia plany i struktury pionkowe oraz ostrzega cię, gdy pozycję utrzymuje tylko jeden ruch.
coach.level.4.name = Gracz klubowy
coach.level.4.desc = Ruchy kandydackie, ocena w pionkach.
coach.level.4.detail = Trener rozważa ruchy kandydackie i podaje ocenę w pionkach, tak jak trener w klubie.
coach.level.5.name = Silny gracz klubowy
coach.level.5.desc = Zwięzłe warianty, terminologia pozycyjna.
coach.level.5.detail = Krótkie uwagi, konkretne warianty i słownictwo gry pozycyjnej.
coach.level.6.name = Ekspert
coach.level.6.desc = Lakoniczne uwagi, głębokie warianty, oceny liczbowe.
coach.level.6.detail = Mało słów, jak między silnymi graczami: warianty na kilka ruchów w głąb i liczbowe oceny pozycji.
coach.note.clock = Bez zegara: masz tyle czasu, ile potrzebujesz.
coach.note.takeback = Po grubym błędzie trener pokazuje, co poszło nie tak, i proponuje cofnięcie ruchu.
coach.note.lesson = Grasz białymi; trener ustawia każde ćwiczenie na szachownicy.
coach.note.unrated = Partie z trenerem nie są rankingowe.
coach.note.fallible = Trener nie jest nieomylny: czasem może źle ocenić ruch.
coach.colour = Twój kolor
coach.colour.help = Kolor, którym grasz przeciwko trenerowi. Na zmianę: białe, potem czarne, w kolejnych partiach. Lekcję zasad zawsze gra się białymi.
coach.colour.alternate = Na zmianę
coach.take_time = Przypomnienie „Nie spiesz się”
coach.take_time.help = Po minucie namysłu trener mówi, że nie ma pośpiechu. Tylko poziomy od 1 do 3.
coach.danger_markers = Pokazuj bierki w niebezpieczeństwie
coach.danger_markers.help = Na poziomach 1 i 2, w twoim ruchu, pod każdą twoją bierką, którą trener może teraz wygrać, pojawia się kolorowe pole.
# Shown when the coach's voice cannot be heard: its model is not downloaded, or Options > Audio > Coach voice is off.
coach.no_voice = Głos trenera nie jest zainstalowany lub jest wyłączony (Opcje > Dźwięk): jego słowa będą wyświetlane na ekranie.
# At the table
coach.speaker = TRENER
coach.skip = Pomiń
coach.offer.title = COFNĄĆ RUCH?
coach.offer.text = Trener proponuje cofnięcie twojego ostatniego ruchu, aby można było poszukać lepszego.
coach.offer.hint = Backspace cofa ruch. Dotknięcie bierki oznacza dalszą grę.
coach.offer.accept = Cofnij
coach.offer.decline = Graj dalej
# Levels 4-6: the coach's takeback offers the player may still accept this game (bottom corner
# of the screen, and on the takeback card)
coach.takebacks_left = Pozostałe cofnięcia: {0}
coach.pause.take_back = Cofnij mój ruch
coach.pause.take_back.help = Cofa twój ostatni ruch, a także odpowiedź trenera, jeśli już ją zagrał.
coach.confirm.resign = Poddać tę partię? Zwycięzcą zostanie ogłoszony trener.
coach.confirm.resign_draw = Poddać tę partię? Trener nie może już dać mata: partia zakończy się remisem.
coach.confirm.leave = Wrócić do menu głównego? Ta partia z trenerem zostanie porzucona.
