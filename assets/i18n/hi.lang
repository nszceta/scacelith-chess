coach.recommended = सुझाया गया
# Levels: a name, a one-line description (60 characters at most) and a paragraph for the lesson column
coach.level.0.name = शतरंज के नियम
coach.level.0.desc = एक इंटरैक्टिव पाठ, एक बार में एक नियम।
coach.level.0.detail = कोच छोटी-छोटी स्थितियाँ लगाता है और दिखाता है कि हर मोहरा कैसे चलता और काटता है, फिर कैसलिंग, प्रमोशन, शह और मात। हर विचार को बोर्ड पर ख़ुद आज़माने का मौक़ा मिलता है।
coach.level.1.name = पहले क़दम
coach.level.1.desc = किस पर हमला है, क्या बिना बचाव के छूटा है।
coach.level.1.detail = कोच नरमी से खेलता है और सीधी-सादी भाषा में बताता है: आपके किन मोहरों पर हमला है, कौन से बिना बचाव के छूटे हैं, और उन्हें कैसे बचाया जाए।
coach.level.2.name = शुरुआती
coach.level.2.desc = आसान टैक्टिक्स, मोहरों का विकास, राजा की सुरक्षा।
coach.level.2.detail = फ़ोर्क और पिन को उनके नाम से पुकारा जाता है। कोच मोहरों को बाहर निकालने और राजा को सुरक्षित रखने की बात करता है।
coach.level.3.name = उभरता खिलाड़ी
coach.level.3.desc = योजनाएँ, प्यादों की संरचना, एकमात्र चालें।
coach.level.3.detail = कोच योजनाएँ और प्यादों की संरचना समझाता है, और जब केवल एक ही चाल स्थिति बचा सकती हो, तब आपको सावधान करता है।
coach.level.4.name = क्लब खिलाड़ी
coach.level.4.desc = संभावित चालें, प्यादों में मूल्यांकन।
coach.level.4.detail = कोच संभावित चालों को तौलता है और मूल्यांकन प्यादों में बताता है, जैसे कोई क्लब ट्रेनर बताता।
coach.level.5.name = मज़बूत क्लब खिलाड़ी
coach.level.5.desc = संक्षिप्त लाइनें, पोज़िशनल शब्दावली।
coach.level.5.detail = छोटी टिप्पणियाँ, ठोस लाइनें और पोज़िशनल खेल की शब्दावली।
coach.level.6.name = विशेषज्ञ
coach.level.6.desc = संक्षिप्त टिप्पणियाँ, गहरी लाइनें, मूल्यांकन के आँकड़े।
coach.level.6.detail = कम शब्द, जैसे मज़बूत खिलाड़ियों के बीच होते हैं: कई चालों तक गहरी लाइनें और मूल्यांकन के आँकड़े।
coach.note.clock = कोई घड़ी नहीं: जितना चाहें, उतना समय लें।
coach.note.takeback = ब्लंडर के बाद कोच दिखाता है कि क्या ग़लत हुआ और चाल वापस लेने की पेशकश करता है।
coach.note.lesson = आपके मोहरे सफ़ेद हैं; कोच हर अभ्यास बोर्ड पर लगाता है।
coach.note.unrated = कोच के साथ बाज़ियाँ रेटेड नहीं होतीं।
coach.note.fallible = कोच अचूक नहीं है: कभी-कभी वह किसी चाल का ग़लत आकलन कर सकता है।
coach.colour = आपका रंग
coach.colour.help = कोच के ख़िलाफ़ आपके मोहरों का रंग। बारी-बारी: एक बाज़ी में सफ़ेद, अगली में काला। नियमों का पाठ हमेशा सफ़ेद मोहरों से खेला जाता है।
coach.colour.alternate = बारी-बारी
coach.take_time = "आराम से सोचिए" याद दिलाना
coach.take_time.help = एक मिनट सोचने के बाद कोच कहता है कि कोई जल्दी नहीं है। केवल स्तर 1 से 3 तक।
# Shown when the coach's voice cannot be heard: its model is not downloaded, or Options > Audio > Coach voice is off.
coach.no_voice = कोच की आवाज़ इंस्टॉल नहीं है या बंद है (विकल्प > ऑडियो): उसकी बातें स्क्रीन पर लिखी जाएँगी।
# At the table
coach.speaker = कोच
coach.skip = छोड़ें
coach.offer.title = चाल वापस लें?
coach.offer.text = कोच आपकी पिछली चाल वापस लेने की पेशकश करता है, ताकि आप उससे बेहतर चाल खोज सकें।
coach.offer.hint = Backspace से चाल वापस होती है। कोई मोहरा छूने पर खेल जारी रहता है।
coach.offer.accept = वापस लें
coach.offer.decline = खेल जारी रखें
# Levels 4-6: the coach's takeback offers the player may still accept this game (bottom corner
# of the screen, and on the takeback card)
coach.takebacks_left = चाल वापसी के बाक़ी मौक़े: {0}
coach.pause.take_back = अपनी चाल वापस लें
coach.pause.take_back.help = आपकी पिछली चाल वापस लेता है, और अगर कोच जवाब दे चुका हो, तो उसकी चाल भी।
coach.confirm.resign = इस बाज़ी में हार मानें? कोच को विजेता घोषित किया जाएगा।
coach.confirm.resign_draw = इस बाज़ी में हार मानें? कोच के लिए अब मात देना संभव नहीं: बाज़ी ड्रॉ होगी।
coach.confirm.leave = मुख्य मेनू पर लौटें? कोच के साथ यह बाज़ी छोड़ दी जाएगी।
# Game over card of a coach game, and the end of the lesson on the rules
coach.gameover.again = फिर से खेलें
coach.gameover.unrated = कोच के साथ यह बाज़ी रेटेड नहीं है।
coach.lesson.done = शाबाश
coach.lesson.done.line = अब आपको शतरंज के नियम आते हैं।
coach.lesson.next = पहली बाज़ी

# ---- Coach challenges (src/ui/ui_coach.cpp; the coach's spoken lines are in assets/coach/speech/<lang>/challenge.lang)
# The tabs of the Coach page: games with the coach, and short sets of positions to solve
coach.tab.training = अभ्यास
coach.tab.challenges = चुनौतियाँ
# Group headings of the list (capitals: section headings)
challenge.group.mates = मात
challenge.group.tactics = टैक्टिक्स
challenge.group.defence = बचाव
challenge.group.endgames = एंडगेम
# Each challenge (assets/coach/challenges/challenges.txt): a name, a one-line description (about 60
# characters) and a paragraph for the column of the selected challenge
challenge.mate1.name = एक चाल में मात
challenge.mate1.desc = एक ही चाल में शह और मात।
challenge.mate1.detail = पहले हर शह को देखें: उनमें से एक के बाद न राजा के लिए कोई खाना बचता है, न बीच में मोहरा लाकर बचाव, न शह देने वाले मोहरे को काटने का मौक़ा।
challenge.mate2.name = दो चालों में मात
challenge.mate2.desc = ऐसी चाल जिसका कोई बचाव न हो, फिर मात।
challenge.mate2.detail = पहली चाल अक्सर शह या बलिदान होती है, जो राजा से एक खाना छीन लेती है। कोच जितना हो सके, उतना अच्छा बचाव करता है।
challenge.mate3.name = तीन चालों में मात
challenge.mate3.desc = मजबूर करने वाली लंबी लाइनें।
challenge.mate3.detail = शह, काटने की चालें और ख़तरे, तीन चालों की गहराई तक। मोहरा छूने से पहले हर क़दम पर कोच के सबसे अच्छे जवाब की गणना करें।
challenge.backrank.name = पिछली रैंक पर मात
challenge.backrank.desc = अपने ही प्यादों के पीछे फँसा राजा।
challenge.backrank.detail = जब कैसलिंग किए हुए राजा के सामने के प्यादे अपनी जगह से न हिले हों, तो आख़िरी रैंक पर आया हाथी या वज़ीर मात दे सकता है। पहले रक्षकों को हटाएँ या उनका ध्यान भटकाएँ।
challenge.patterns.name = मात के पैटर्न
challenge.patterns.desc = स्मदर्ड मात, अनास्तासिया मात, अरेबियन मात जैसे क्लासिक पैटर्न।
challenge.patterns.detail = मात के मशहूर जाल, जो बार-बार सामने आते हैं। मोहरों की जमावट और आख़िरी वार पहचानना सीखें।
challenge.hanging.name = मुफ़्त मोहरे
challenge.hanging.desc = पहचानें कि क्या बिना बचाव के छूटा है।
challenge.hanging.detail = जिस मोहरे या प्यादे का कोई बचाव नहीं कर रहा, उसे सीधे काटा जा सकता है। देखें कि कोच के हर मोहरे की रक्षा कौन कर रहा है।
challenge.fork.name = फ़ोर्क
challenge.fork.desc = एक मोहरा एक साथ दो पर हमला करता है।
challenge.fork.detail = घोड़े, प्यादे, वज़ीर और राजा तक फ़ोर्क कर सकते हैं। प्रतिद्वंद्वी दोनों निशानों में से केवल एक को बचा सकता है।
challenge.pin.name = पिन
challenge.pin.desc = ऐसा मोहरा जो अपने पीछे खड़ा मोहरा गँवाए बिना हिल नहीं सकता।
challenge.pin.detail = किसी मोहरे को उसके राजा या किसी ज़्यादा क़ीमती मोहरे के आगे पिन करें, फिर उस पर दोबारा हमला करें, या इस बात का फ़ायदा उठाएँ कि वह हिल नहीं सकता।
challenge.skewer.name = स्क्यूअर
challenge.skewer.desc = किसी क़ीमती मोहरे पर हमला करें और उसके पीछे वाला मोहरा जीतें।
challenge.skewer.detail = पिन का उलटा: ज़्यादा क़ीमती मोहरा आगे खड़ा होता है, उसे हटना पड़ता है, और उसके पीछे का मोहरा खुल जाता है।
challenge.discovered.name = डिस्कवर्ड अटैक
challenge.discovered.desc = एक मोहरा हटाकर दूसरे का हमला खोलें।
challenge.discovered.detail = जब कोई मोहरा किसी लाइन से हटता है, तो उसके पीछे वाला मोहरा हमला करता है। अगर साथ में शह हो, या दोहरी शह, तो प्रतिद्वंद्वी के पास दोनों ख़तरों का जवाब देने का समय नहीं होता।
challenge.deflection.name = डिफ़्लेक्शन और डिकॉय
challenge.deflection.desc = किसी रक्षक को दूर भटकाएँ, या किसी घातक खाने पर खींच लाएँ।
challenge.deflection.detail = जिस रक्षक के ज़िम्मे दो काम हों, वह दोनों नहीं कर सकता। उस पर हमला करें, उसे कुछ पेश करें, या किसी मोहरे को उस खाने पर आने के लिए मजबूर करें जहाँ वह खो जाएगा।
challenge.intermezzo.name = बीच की चालें
challenge.intermezzo.desc = तुरंत वापस न काटें: इससे ज़्यादा ताक़तवर चाल मौजूद है।
challenge.intermezzo.detail = अपेक्षित चाल से पहले, बीच में दी गई एक शह या उससे बड़ा ख़तरा सब कुछ बदल देता है।
challenge.trapped.name = फँसे हुए मोहरे
challenge.trapped.desc = ऐसा मोहरा जिसके पास कोई सुरक्षित खाना नहीं बचा।
challenge.trapped.detail = किसी मोहरे के बचकर निकलने के आख़िरी खाने छीन लें, फिर उसे जीत लें।
challenge.promotion.name = प्रमोशन
challenge.promotion.desc = प्यादे को आख़िरी रैंक तक पहुँचाएँ।
challenge.promotion.detail = आगे बढ़े हुए प्यादे बहुत क़ीमती होते हैं। रास्ता साफ़ करें, रोकने वालों को हटाएँ और नया वज़ीर बनाएँ।
challenge.quiet.name = शांत चालें
challenge.quiet.desc = जीतने वाली चाल न शह है, न काटने की चाल।
challenge.quiet.detail = कभी-कभी सबसे ताक़तवर चाल बस एक ऐसा ख़तरा तैयार करती है जिसे रोका नहीं जा सकता। ऐसी चालें देखना सबसे मुश्किल होता है।
challenge.opening.name = ओपनिंग के जाल
challenge.opening.desc = शुरुआती ग़लतियों की सज़ा दें।
challenge.opening.detail = असली बाज़ियों की पहली चालों से ली गई स्थितियाँ, जहाँ एक लापरवाह चाल का तुरंत फ़ायदा उठाया जा सकता है।
challenge.escape.name = बचने का रास्ता खोजें
challenge.escape.desc = आपका राजा ख़तरे में है: केवल एक चाल उसे बचाती है।
challenge.escape.detail = बाक़ी हर चाल हार की ओर ले जाती है। अपने राजा के ख़िलाफ़ सभी शह और ख़तरे देखें, फिर बचने का एकमात्र रास्ता खोजें।
challenge.defend.name = बचाव की चालें
challenge.defend.desc = मटीरियल गँवाए बिना ख़तरा टालें।
challenge.defend.detail = कोच कोई ख़तरा पैदा करता है। वह सटीक चाल खोजें जो सब कुछ सँभाले रखे।
challenge.kq.name = वज़ीर और राजा बनाम राजा
challenge.kq.desc = वज़ीर से मात।
challenge.kq.detail = अकेले राजा को अपने वज़ीर से किनारे की ओर धकेलें, अपने राजा को पास लाएँ, और स्टेलमेट से सावधान रहें। कोच अपनी सबसे अच्छी चालों से बचाव करता है।
challenge.kr.name = हाथी और राजा बनाम राजा
challenge.kr.desc = हाथी से मात।
challenge.kr.detail = हाथी रैंक दर रैंक राजा का रास्ता बंद करता है; आपका राजा ऑपोज़िशन लेता है। कोच अपनी सबसे अच्छी चालों से बचाव करता है।
challenge.kp.name = राजा और प्यादा बनाम राजा
challenge.kp.desc = ऑपोज़िशन जीतें और प्यादे को वज़ीर बनाएँ।
