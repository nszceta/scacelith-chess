# Each challenge (assets/coach/challenges/challenges.txt): a name, a one-line description (about 60
# characters) and a paragraph for the column of the selected challenge
challenge.mate1.name = Mate em um
challenge.mate1.desc = Um lance, e é xeque-mate.
challenge.mate1.detail = Examine primeiro todos os xeques: um deles deixa o rei sem casa de fuga, sem bloqueio e sem captura.
challenge.mate2.name = Mate em dois
challenge.mate2.desc = Um lance que não deixa defesa, depois o mate.
challenge.mate2.detail = O primeiro lance costuma ser um xeque ou um sacrifício que tira uma casa do rei. O treinador se defende da melhor forma possível.
challenge.mate3.name = Mate em três
challenge.mate3.desc = Linhas forçadas mais longas.
challenge.mate3.detail = Xeques, capturas e ameaças, com três lances de profundidade. Calcule a melhor resposta do treinador em cada etapa antes de tocar em uma peça.
challenge.backrank.name = Mates do corredor
challenge.backrank.desc = Um rei preso atrás dos próprios peões.
challenge.backrank.detail = Quando os peões na frente de um rei rocado não se moveram, uma torre ou uma dama na última fileira pode dar mate. Elimine ou desvie os defensores primeiro.
challenge.patterns.name = Padrões de mate
challenge.patterns.desc = Mate sufocado, mate de Anastasia, mate árabe e outros clássicos.
challenge.patterns.detail = Redes de mate famosas que aparecem repetidas vezes. Aprenda a reconhecer a disposição das peças e o golpe final.
challenge.hanging.name = Peças soltas
challenge.hanging.desc = Encontre o que ficou sem proteção.
challenge.hanging.detail = Uma peça ou um peão que ninguém defende pode simplesmente ser capturado. Verifique o que protege cada uma das peças do treinador.
challenge.fork.name = Garfos
challenge.fork.desc = Uma peça ataca duas ao mesmo tempo.
challenge.fork.detail = Cavalos, peões, damas e até reis podem dar garfo. O adversário só consegue salvar um dos dois alvos.
challenge.pin.name = Cravadas
challenge.pin.desc = Uma peça que não pode se mover sem perder o que está atrás dela.
challenge.pin.detail = Crave uma peça no rei ou em uma peça mais valiosa, depois ataque-a de novo, ou aproveite o fato de ela não poder se mover.
challenge.skewer.name = Espetos
challenge.skewer.desc = Ataque uma peça valiosa e ganhe a que está atrás dela.
challenge.skewer.detail = O inverso da cravada: a peça mais valiosa está na frente, precisa sair e descobre a peça que está atrás dela.
challenge.discovered.name = Ataques descobertos
challenge.discovered.desc = Mova uma peça para liberar outra.
challenge.discovered.detail = Quando uma peça sai de uma linha, a peça atrás dela ataca. Com xeque, ou com xeque duplo, o adversário não tem tempo de responder às duas ameaças.
challenge.deflection.name = Desvio e atração
challenge.deflection.desc = Afaste um defensor, ou atraia-o para uma casa fatal.
challenge.deflection.detail = Um defensor com duas tarefas não consegue cumprir as duas. Ataque-o, ofereça algo a ele, ou force uma peça a ir para a casa onde ela será perdida.
challenge.intermezzo.name = Lances intermediários
challenge.intermezzo.desc = Não recapture imediatamente: há um lance melhor.
challenge.intermezzo.detail = Antes do lance esperado, um xeque ou uma ameaça maior no meio do caminho muda tudo.
challenge.trapped.name = Peças presas
challenge.trapped.desc = Uma peça sem nenhuma casa segura.
challenge.trapped.detail = Tire de uma peça as últimas casas de fuga e depois ganhe-a.
challenge.promotion.name = Promoção
challenge.promotion.desc = Leve um peão até a última fileira.
challenge.promotion.detail = Peões avançados valem muito. Abra caminho, desvie os bloqueadores e faça uma nova dama.
challenge.quiet.name = Lances tranquilos
challenge.quiet.desc = O lance vencedor não é nem xeque nem captura.
challenge.quiet.detail = Às vezes o lance mais forte só prepara uma ameaça impossível de evitar. O tipo de lance mais difícil de enxergar.
challenge.opening.name = Armadilhas de abertura
challenge.opening.desc = Puna os erros na abertura.
challenge.opening.detail = Posições dos primeiros lances de partidas reais, em que um lance descuidado pode ser explorado na hora.
challenge.escape.name = Encontre a saída
challenge.escape.desc = Seu rei está em perigo: um único lance o salva.
