# Each challenge (assets/coach/challenges/challenges.txt): a name, a one-line description (about 60
# characters) and a paragraph for the column of the selected challenge
challenge.mate1.name = Mate num lance
challenge.mate1.desc = Um lance, e é xeque-mate.
challenge.mate1.detail = Veja primeiro todos os xeques: um deles não deixa ao rei nenhuma casa, nenhuma interposição e nenhuma captura.
challenge.mate2.name = Mate em dois
challenge.mate2.desc = Um lance que não deixa defesa e, depois, mate.
challenge.mate2.detail = O primeiro lance é muitas vezes um xeque ou um sacrifício que tira uma casa ao rei. O treinador defende-se o melhor que pode.
challenge.mate3.name = Mate em três
challenge.mate3.desc = Variantes forçadas mais longas.
challenge.mate3.detail = Xeques, capturas e ameaças, com três lances de profundidade. Calcule a melhor resposta do treinador em cada passo antes de tocar numa peça.
challenge.backrank.name = Mates na última fila
challenge.backrank.desc = Um rei preso atrás dos seus próprios peões.
challenge.backrank.detail = Quando os peões à frente de um rei rocado não se moveram, uma torre ou uma dama na última fila pode dar xeque-mate. Elimine ou desvie primeiro os defensores.
challenge.patterns.name = Padrões de mate
challenge.patterns.desc = Mate sufocado, de Anastásia, árabe e outros clássicos.
challenge.patterns.detail = Redes de mate famosas que aparecem vezes sem conta. Aprenda a reconhecer a disposição das peças e o golpe final.
challenge.hanging.name = Peças indefesas
challenge.hanging.desc = Descubra o que ficou sem proteção.
challenge.hanging.detail = Uma peça ou um peão que ninguém defende pode simplesmente ser capturado. Verifique o que protege cada uma das peças do treinador.
challenge.fork.name = Garfos
challenge.fork.desc = Uma peça ataca duas ao mesmo tempo.
challenge.fork.detail = Os cavalos, os peões, as damas e até os reis podem fazer garfos. O adversário só consegue salvar um dos dois alvos.
challenge.pin.name = Cravadas
challenge.pin.desc = Uma peça que não se pode mover sem perder o que está atrás dela.
challenge.pin.detail = Crave uma peça ao seu rei ou a uma peça mais valiosa e, depois, ataque-a outra vez, ou aproveite o facto de ela não se poder mover.
challenge.skewer.name = Espetos
challenge.skewer.desc = Ataque uma peça valiosa e ganhe a que está atrás dela.
challenge.skewer.detail = O inverso da cravada: a peça mais valiosa está à frente, tem de sair e descobre a peça que está atrás.
challenge.discovered.name = Ataques descobertos
challenge.discovered.desc = Mova uma peça para desencadear o ataque de outra.
challenge.discovered.detail = Quando uma peça sai de uma linha, a peça que está atrás ataca. Com xeque, ou com xeque duplo, o adversário não tem tempo para responder às duas ameaças.
challenge.deflection.name = Desvio e atração
challenge.deflection.desc = Afaste um defensor ou atraia-o para uma casa fatal.
challenge.deflection.detail = Um defensor com duas tarefas não consegue cumprir ambas. Ataque-o, ofereça-lhe algo ou obrigue uma peça a ir para a casa onde será perdida.
challenge.intermezzo.name = Lances intermédios
challenge.intermezzo.desc = Não retome de imediato: há algo mais forte.
challenge.intermezzo.detail = Antes do lance esperado, um xeque ou uma ameaça maior pelo meio muda tudo.
challenge.trapped.name = Peças presas
challenge.trapped.desc = Uma peça sem nenhuma casa segura.
challenge.trapped.detail = Tire a uma peça as últimas casas de fuga e, depois, ganhe-a.
challenge.promotion.name = Promoção
challenge.promotion.desc = Leve um peão até à última fila.
challenge.promotion.detail = Os peões avançados valem muito. Abra caminho, desvie os bloqueadores e faça uma nova dama.
challenge.quiet.name = Lances tranquilos
challenge.quiet.desc = O lance vencedor não é nem um xeque nem uma captura.
challenge.quiet.detail = Por vezes, o lance mais forte limita-se a preparar uma ameaça que não pode ser evitada. O tipo de lance mais difícil de ver.
challenge.opening.name = Armadilhas de abertura
challenge.opening.desc = Castigue os erros precoces.
challenge.opening.detail = Posições dos primeiros lances de partidas reais, em que um lance descuidado pode ser aproveitado de imediato.
challenge.escape.name = Encontrar a saída
challenge.escape.desc = O seu rei está em perigo: um lance salva-o.
challenge.escape.detail = Todos os outros lances perdem. Veja todos os xeques e ameaças contra o seu rei e encontre a única saída.
challenge.defend.name = Lances defensivos
challenge.defend.desc = Neutralize a ameaça sem perder material.
challenge.defend.detail = O treinador ameaça algo. Encontre o lance preciso que mantém tudo protegido.
challenge.kq.name = Dama e rei contra rei
challenge.kq.desc = Xeque-mate com a dama.
challenge.kq.detail = Empurre o rei isolado para a borda do tabuleiro com a sua dama, aproxime o seu próprio rei e tenha cuidado com o afogamento. O treinador defende-se com os seus melhores lances.
challenge.kr.name = Torre e rei contra rei
challenge.kr.desc = Xeque-mate com a torre.
challenge.kr.detail = A torre corta o caminho ao rei, fila a fila; o seu rei toma a oposição. O treinador defende-se com os seus melhores lances.
challenge.kp.name = Rei e peão contra rei
challenge.kp.desc = Ganhe a oposição e promova o peão.
challenge.kp.detail = Avance com o rei à frente, não com o peão. Tome a oposição e faça uma dama que o treinador não consiga apanhar.
challenge.kp_hold.name = Travar o peão
challenge.kp_hold.desc = Um rei isolado contra rei e peão: segure o empate.
challenge.kp_hold.detail = Coloque o rei à frente do peão e mantenha a oposição. Aguente durante dez lances.
challenge.rook.name = Finais de torres
challenge.rook.desc = A ponte de Lucena e a defesa de Philidor.
challenge.rook.detail = As duas posições que todos os jogadores devem conhecer: como ganhar com um peão na sétima fila e como defender com a torre na terceira.
challenge.endgame.name = Tática nos finais
challenge.endgame.desc = Poucas peças, ideias incisivas.
challenge.endgame.detail = Corridas de peões, ruturas e finais de torres de partidas reais.
