coach.challenge.complete = اكتمل التحدي
coach.challenge.complete.line = حللت كل الوضعيات.
coach.challenge.next = التحدي التالي
coach.challenge.again = مرة أخرى
# The coach's offer of a hint (a card like the takeback offer), and the key cap of the hint at the bottom of the screen
coach.hint.title = تلميح؟
coach.hint.text = يعرض عليك المدرّب تلميحًا.
coach.hint.hint = مفتاح H يعطيك التلميح. لمس أي قطعة يعني مواصلة البحث.
coach.hint.accept = تلميح
coach.hint.decline = لا، شكرًا
