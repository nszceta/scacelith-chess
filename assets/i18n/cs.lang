# Each challenge (assets/coach/challenges/challenges.txt): a name, a one-line description (about 60
# characters) and a paragraph for the column of the selected challenge
challenge.mate1.name = Mat 1. tahem
challenge.mate1.desc = Jeden tah a je to mat.
challenge.mate1.detail = Nejprve se podívejte na všechny šachy: po jednom z nich král nemá kam ustoupit, šach nelze zaclonit a šachující figuru nelze vzít.
challenge.mate2.name = Mat 2. tahem
challenge.mate2.desc = Tah, proti kterému není obrana, a pak mat.
challenge.mate2.detail = První tah je často šach nebo oběť, která králi vezme jedno pole. Trenér se brání, jak nejlépe umí.
challenge.mate3.name = Mat 3. tahem
challenge.mate3.desc = Delší vynucené varianty.
challenge.mate3.detail = Šachy, braní a hrozby do hloubky tří tahů. Než se dotknete figury, propočítejte v každém kroku nejlepší odpověď trenéra.
challenge.backrank.name = Maty na základní řadě
challenge.backrank.desc = Král uvězněný za vlastními pěšci.
challenge.backrank.detail = Když se pěšci před králem po rošádě nepohnuli, může věž nebo dáma na poslední řadě dát mat. Nejprve obránce odstraňte nebo odlákejte.
challenge.patterns.name = Matové obrazce
challenge.patterns.desc = Dušený mat, Anastázin mat, arabský mat a další klasické maty.
challenge.patterns.detail = Slavné matové sítě, které se objevují znovu a znovu. Naučte se poznávat rozestavení figur a závěrečný úder.
challenge.hanging.name = Figury zadarmo
challenge.hanging.desc = Najděte, co zůstalo bez krytí.
challenge.hanging.detail = Figuru nebo pěšce, které nikdo nebrání, lze prostě vzít. Zkontrolujte, čím je kryta každá trenérova figura.
challenge.fork.name = Vidličky
challenge.fork.desc = Jedna figura napadá dvě najednou.
challenge.fork.detail = Vidličku umí jezdci, pěšci, dámy, a dokonce i králové. Soupeř může zachránit jen jeden ze dvou cílů.
challenge.pin.name = Vazby
challenge.pin.desc = Figura, která nemůže táhnout, aniž by ztratila, co stojí za ní.
challenge.pin.detail = Svažte figuru s jejím králem nebo s cennější figurou, pak ji napadněte ještě jednou, nebo využijte toho, že nemůže táhnout.
challenge.skewer.name = Napíchnutí
challenge.skewer.desc = Napadněte cennou figuru a získejte tu, která stojí za ní.
challenge.skewer.detail = Opak vazby: cennější figura stojí vpředu, musí ustoupit a odkryje figuru za sebou.
challenge.discovered.name = Odtažné útoky
challenge.discovered.desc = Táhněte jednou figurou a uvolněte jinou.
challenge.discovered.detail = Když figura odejde z linie, zaútočí figura za ní. Se šachem nebo s dvojitým šachem nemá soupeř čas odpovědět na obě hrozby.
challenge.deflection.name = Odlákání a vlákání
challenge.deflection.desc = Odlákejte obránce, nebo ho vlákejte na osudné pole.
challenge.deflection.detail = Obránce, který má dva úkoly, nezvládne oba. Napadněte ho, něco mu nabídněte, nebo donuťte figuru vstoupit na pole, kde bude ztracena.
challenge.intermezzo.name = Mezitahy
challenge.intermezzo.desc = Neberte hned zpět: je tu něco silnějšího.
challenge.intermezzo.detail = Šach nebo větší hrozba vložená před očekávaný tah změní všechno.
challenge.trapped.name = Chycené figury
challenge.trapped.desc = Figura, která už nemá žádné bezpečné pole.
challenge.trapped.detail = Vezměte figuře poslední úniková pole a pak ji získejte.
challenge.promotion.name = Proměna
challenge.promotion.desc = Protlačte pěšce až na poslední řadu.
challenge.promotion.detail = Daleko postoupení pěšci mají velkou cenu. Uvolněte cestu, odlákejte blokující figury a udělejte si novou dámu.
challenge.quiet.name = Tiché tahy
challenge.quiet.desc = Vítězný tah není ani šach, ani braní.
challenge.quiet.detail = Někdy nejsilnější tah jen připraví hrozbu, kterou nelze odvrátit. Takový tah se hledá nejhůř.
challenge.opening.name = Pasti v zahájení
challenge.opening.desc = Potrestejte brzké chyby.
challenge.opening.detail = Pozice z prvních tahů skutečných partií, kde lze jeden neopatrný tah okamžitě využít.
challenge.escape.name = Najděte únik
challenge.escape.desc = Váš král je v nebezpečí: zachrání ho jediný tah.
challenge.escape.detail = Každý jiný tah prohrává. Prohlédněte si všechny šachy a hrozby proti vašemu králi a pak najděte jedinou cestu ven.
challenge.defend.name = Obranné tahy
challenge.defend.desc = Odvraťte hrozbu bez ztráty materiálu.
challenge.defend.detail = Trenér něčím hrozí. Najděte přesný tah, který všechno udrží pohromadě.
challenge.kq.name = Dáma a král proti králi
challenge.kq.desc = Mat dámou.
challenge.kq.detail = Zatlačte osamělého krále dámou na okraj, přiveďte blíž vlastního krále a dejte si pozor na pat. Trenér se brání svými nejlepšími tahy.
challenge.kr.name = Věž a král proti králi
challenge.kr.desc = Mat věží.
challenge.kr.detail = Věž odřízne krále řadu po řadě; váš král zaujme opozici. Trenér se brání svými nejlepšími tahy.
challenge.kp.name = Král a pěšec proti králi
challenge.kp.desc = Získejte opozici a proměňte pěšce.
challenge.kp.detail = Veďte králem, ne pěšcem. Zaujměte opozici a proměňte pěšce v dámu tak, aby ho trenér nemohl chytit.
challenge.kp_hold.name = Zastavte pěšce
challenge.kp_hold.desc = Osamělý král proti králi a pěšci: udržte remízu.
challenge.kp_hold.detail = Postavte se před pěšce a držte opozici. Vydržte deset tahů.
challenge.rook.name = Věžové koncovky
challenge.rook.desc = Lucenův most a Philidorova obrana.
challenge.rook.detail = Dvě pozice, které by měl znát každý hráč: jak vyhrát s pěšcem na sedmé řadě a jak se bránit s věží na třetí.
challenge.endgame.name = Taktika v koncovce
challenge.endgame.desc = Málo figur, ostré nápady.
challenge.endgame.detail = Pěšcové závody, průlomy a věžové koncovky ze skutečných partií.
# The column of the selected challenge. {0} = the number of positions in the set
coach.challenge.positions = {0} pozice|{0} pozice|{0} pozic
coach.challenge.done = Dokončeno
coach.challenge.start = Začít
coach.challenge.note.white = Hrajete bílými; trenér na šachovnici rozestaví každou pozici.
coach.challenge.note.hint = Nevíte si rady? Stiskněte H pro nápovědu. Po několika pokusech ji trenér nabídne sám.
coach.challenge.note.unsaved = Výzvy nejsou na rating a neukládají se; ty dokončené označuje fajfka.
# At the table: the band at the top, after the challenge's name. {0} = the position being solved, {1} = the number of positions
coach.challenge.progress = {0} / {1}
# The card at the end of a challenge
coach.challenge.complete = VÝZVA SPLNĚNA
coach.challenge.complete.line = Všechny pozice jsou vyřešené.
coach.challenge.next = Další výzva
coach.challenge.again = Znovu
# The coach's offer of a hint (a card like the takeback offer), and the key cap of the hint at the bottom of the screen
coach.hint.title = NÁPOVĚDA?
coach.hint.text = Trenér vám nabízí nápovědu.
coach.hint.hint = Klávesa H nápovědu zobrazí. Dotknutím figury hledáte dál.
coach.hint.accept = Nápověda
coach.hint.decline = Ne, děkuji
coach.hint.key = Nápověda

