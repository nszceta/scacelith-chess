# ---- Coach challenges (src/ui/ui_coach.cpp; the coach's spoken lines are in assets/coach/speech/<lang>/challenge.lang)
# The tabs of the Coach page: games with the coach, and short sets of positions to solve
coach.tab.training = Treniruotės
coach.tab.challenges = Iššūkiai
# Group headings of the list (capitals: section headings)
challenge.group.mates = MATAI
challenge.group.tactics = TAKTIKA
challenge.group.defence = GYNYBA
challenge.group.endgames = ENDŠPILIAI
# Each challenge (assets/coach/challenges/challenges.txt): a name, a one-line description (about 60
# characters) and a paragraph for the column of the selected challenge
# Names as the coach quotes them (challenge.lang); the two imperative names take the formal form here.
challenge.mate1.name = Matas per vieną ėjimą
challenge.mate1.desc = Vienas ėjimas – ir matas.
challenge.mate1.detail = Pirmiausia peržiūrėkite visus šachus: vienas iš jų nepalieka karaliui nei laisvo langelio, nei galimybės užsidengti ar kirsti.
challenge.mate2.name = Matas per du ėjimus
challenge.mate2.desc = Ėjimas, po kurio nebėra gynybos, o tada – matas.
challenge.mate2.detail = Pirmasis ėjimas dažnai būna šachas arba auka, atimanti iš karaliaus langelį. Treneris ginasi, kiek tik gali.
challenge.mate3.name = Matas per tris ėjimus
challenge.mate3.desc = Ilgesni priverstiniai variantai.
challenge.mate3.detail = Šachai, kirtimai ir grėsmės trijų ėjimų gyliu. Prieš liečiant figūrą, kiekviename žingsnyje apskaičiuokite geriausią trenerio atsakymą.
challenge.backrank.name = Matai paskutinėje horizontalėje
challenge.backrank.desc = Karalius įkalintas už savo pėstininkų.
challenge.backrank.detail = Kai pėstininkai prieš rokiruotą karalių dar nepajudėjo, bokštas ar valdovė paskutinėje horizontalėje gali paskelbti matą. Pirmiausia pašalinkite arba atitraukite gynėjus.
challenge.patterns.name = Tipiniai matai
challenge.patterns.desc = Uždusintas matas, Anastasijos, arabiškasis ir kita klasika.
challenge.patterns.detail = Garsūs matiniai tinklai, kurie kartojasi vėl ir vėl. Išmokite atpažinti figūrų išsidėstymą ir lemiamą smūgį.
challenge.hanging.name = Neapgintos figūros
challenge.hanging.desc = Pastebėkite, kas paliekama neapginta.
challenge.hanging.detail = Figūrą ar pėstininką, kurio niekas negina, galima tiesiog nukirsti. Patikrinkite, kas saugo kiekvieną trenerio figūrą.
challenge.fork.name = Šakutės
challenge.fork.desc = Viena figūra puola dvi iš karto.
challenge.fork.detail = Šakutę gali padaryti žirgai, pėstininkai, valdovės ir net karaliai. Varžovas gali išgelbėti tik vieną iš dviejų taikinių.
challenge.pin.name = Surišimai
challenge.pin.desc = Figūra, kuri negali pajudėti neprarasdama to, kas stovi už jos.
challenge.pin.detail = Suriškite figūrą su jos karaliumi arba su vertingesne figūra, tada pulkite ją dar kartą arba pasinaudokite tuo, kad ji negali pajudėti.
challenge.skewer.name = Pradūrimai
challenge.skewer.desc = Pulkite vertingą figūrą ir laimėkite už jos stovinčią.
challenge.skewer.detail = Surišimo priešingybė: vertingesnė figūra stovi priekyje, turi pasitraukti ir atidengia už jos esančią figūrą.
challenge.discovered.name = Atidengti puolimai
challenge.discovered.desc = Pajudinkite vieną figūrą ir paleiskite į kovą kitą.
challenge.discovered.detail = Kai figūra pasitraukia iš linijos, už jos stovinti figūra ima pulti. Su šachu ar dvigubu šachu varžovas nespėja atremti abiejų grėsmių.
challenge.deflection.name = Nukreipimas ir suviliojimas
challenge.deflection.desc = Atitraukite gynėją arba suviliokite figūrą į pražūtingą langelį.
challenge.deflection.detail = Gynėjas, turintis dvi užduotis, negali atlikti abiejų. Pulkite jį, ką nors jam pasiūlykite arba priverskite figūrą užeiti į langelį, kuriame ji bus prarasta.
challenge.intermezzo.name = Tarpiniai ėjimai
challenge.intermezzo.desc = Nekirskite atgal iš karto: yra kai kas stipresnio.
challenge.intermezzo.detail = Prieš laukiamą ėjimą įterptas šachas ar didesnė grėsmė viską pakeičia.
challenge.trapped.name = Įkalintos figūros
challenge.trapped.desc = Figūra, kuriai nebeliko saugių langelių.
challenge.trapped.detail = Atimkite iš figūros paskutinius pasitraukimo langelius, tada laimėkite ją.
challenge.promotion.name = Pėstininko virsmas
challenge.promotion.desc = Prasiveržkite pėstininku iki paskutinės horizontalės.
challenge.promotion.detail = Pažengę pėstininkai labai vertingi. Atlaisvinkite kelią, nukreipkite blokuojančias figūras ir pasidarykite naują valdovę.
challenge.quiet.name = Tylūs ėjimai
challenge.quiet.desc = Laimintis ėjimas nėra nei šachas, nei kirtimas.
challenge.quiet.detail = Kartais stipriausias ėjimas tik paruošia grėsmę, kurios neįmanoma atremti. Tokius ėjimus pamatyti sunkiausia.
challenge.opening.name = Debiuto spąstai
challenge.opening.desc = Nubauskite už ankstyvas klaidas.
challenge.opening.detail = Pozicijos iš pirmųjų tikrų partijų ėjimų, kuriose vieną neapdairų ėjimą galima iš karto išnaudoti.
challenge.escape.name = Raskite išsigelbėjimą
challenge.escape.desc = Jūsų karaliui gresia pavojus: jį išgelbės vienas ėjimas.
challenge.escape.detail = Visi kiti ėjimai pralaimi. Peržiūrėkite visus šachus ir grėsmes jūsų karaliui, tada raskite vienintelę išeitį.
challenge.defend.name = Gynybiniai ėjimai
challenge.defend.desc = Atremkite grėsmę be medžiagos nuostolių.
challenge.defend.detail = Treneris kuo nors grasina. Raskite tikslų ėjimą, kuris viską išlaiko.
challenge.kq.name = Valdovė ir karalius prieš karalių
challenge.kq.desc = Matas valdove.
challenge.kq.detail = Valdove nustumkite vienišą karalių prie lentos krašto, atveskite arčiau savo karalių ir saugokitės pato. Treneris ginasi geriausiais ėjimais.
challenge.kr.name = Bokštas ir karalius prieš karalių
challenge.kr.desc = Matas bokštu.
challenge.kr.detail = Bokštas atkerta karalių horizontalė po horizontalės, o jūsų karalius užima opoziciją. Treneris ginasi geriausiais ėjimais.
challenge.kp.name = Karalius ir pėstininkas prieš karalių
challenge.kp.desc = Užimkite opoziciją ir paverskite pėstininką valdove.
challenge.kp.detail = Pirmiausia veskite karalių, o ne pėstininką. Užimkite opoziciją ir pasidarykite valdovę, kurios treneris nebepagaus.
challenge.kp_hold.name = Sustabdykite pėstininką
challenge.kp_hold.desc = Vienišas karalius prieš karalių ir pėstininką: išlaikykite lygiąsias.
challenge.kp_hold.detail = Stovėkite priešais pėstininką ir išlaikykite opoziciją. Išsilaikykite dešimt ėjimų.
challenge.rook.name = Bokštų endšpiliai
challenge.rook.desc = Lucenos tiltas ir Filidoro gynyba.
challenge.rook.detail = Dvi pozicijos, kurias turėtų žinoti kiekvienas žaidėjas: kaip laimėti, kai pėstininkas septintoje horizontalėje, ir kaip gintis, kai bokštas trečioje.
challenge.endgame.name = Taktika endšpilyje
challenge.endgame.desc = Mažai figūrų, aštrios idėjos.
challenge.endgame.detail = Pėstininkų lenktynės, prasiveržimai ir bokštų endšpiliai iš tikrų partijų.
# The column of the selected challenge. {0} = the number of positions in the set
coach.challenge.positions = {0} pozicija|{0} pozicijos|{0} pozicijų
coach.challenge.done = Įveikta
coach.challenge.start = Pradėti
coach.challenge.note.white = Žaidžiate baltosiomis; treneris kiekvieną poziciją išdėsto lentoje.
coach.challenge.note.hint = Įstrigote? Paspauskite H ir gausite užuominą. Po kelių bandymų treneris ją pasiūlys pats.
coach.challenge.note.unsaved = Iššūkiai neturi įtakos reitingui ir neįrašomi; varnelė žymi tuos, kuriuos jau įveikėte.
# At the table: the band at the top, after the challenge's name. {0} = the position being solved, {1} = the number of positions
coach.challenge.progress = {0} / {1}
# The card at the end of a challenge
coach.challenge.complete = IŠŠŪKIS ĮVEIKTAS
coach.challenge.complete.line = Išsprendėte visas pozicijas.
coach.challenge.next = Kitas iššūkis
coach.challenge.again = Dar kartą
# The coach's offer of a hint (a card like the takeback offer), and the key cap of the hint at the bottom of the screen
coach.hint.title = UŽUOMINA?
coach.hint.text = Treneris siūlo jums užuominą.
coach.hint.hint = H – gauti užuominą. Palietus figūrą, ieškoma toliau.
coach.hint.accept = Užuomina
coach.hint.decline = Ne, ačiū
coach.hint.key = Užuomina

