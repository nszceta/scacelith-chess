# ---- Coach challenges (src/ui/ui_coach.cpp; the coach's spoken lines are in assets/coach/speech/<lang>/challenge.lang)
# The tabs of the Coach page: games with the coach, and short sets of positions to solve
coach.tab.training = Trening
coach.tab.challenges = Izzivi
# Group headings of the list (capitals: section headings)
challenge.group.mates = MAT
challenge.group.tactics = TAKTIKA
challenge.group.defence = OBRAMBA
challenge.group.endgames = KONČNICE
# Each challenge (assets/coach/challenges/challenges.txt): a name, a one-line description (about 60
# characters) and a paragraph for the column of the selected challenge
challenge.mate1.name = Mat v eni potezi
challenge.mate1.desc = Ena poteza – in je mat.
challenge.mate1.detail = Najprej preglejte vse šahe: po enem od njih kralj nima polja za umik, šaha ni mogoče zapreti in napadalca ni mogoče vzeti.
challenge.mate2.name = Mat v dveh potezah
challenge.mate2.desc = Poteza, proti kateri ni obrambe, nato mat.
challenge.mate2.detail = Prva poteza je pogosto šah ali žrtev, ki kralju odvzame polje. Trener se brani, kakor najbolje zna.
challenge.mate3.name = Mat v treh potezah
challenge.mate3.desc = Daljše prisilne variante.
challenge.mate3.detail = Šahi, jemanja in grožnje, tri poteze v globino. Preden se dotaknete figure, na vsakem koraku izračunajte trenerjev najboljši odgovor.
challenge.backrank.name = Mat na zadnji vrsti
challenge.backrank.desc = Kralj, ujet za lastnimi kmeti.
challenge.backrank.detail = Kadar se kmeti pred rokiranim kraljem niso premaknili, lahko trdnjava ali dama na zadnji vrsti da mat. Najprej odstranite ali odvrnite branilce.
challenge.patterns.name = Matni vzorci
challenge.patterns.desc = Zadušeni mat, Anastazijin mat, arabski mat in druge klasike.
challenge.patterns.detail = Slavne matne mreže, ki se vedno znova ponavljajo. Naučite se prepoznati postavitev figur in končni udarec.
challenge.hanging.name = Nezaščitene figure
challenge.hanging.desc = Opazite, kaj je ostalo brez zaščite.
challenge.hanging.detail = Figuro ali kmeta, ki ga nihče ne brani, lahko preprosto vzamete. Preverite, kaj ščiti vsako od trenerjevih figur.
challenge.fork.name = Vilice
challenge.fork.desc = Ena figura napade dve hkrati.
challenge.fork.detail = Vilice lahko naredijo skakači, kmeti, dame in celo kralji. Nasprotnik lahko reši le eno od obeh tarč.
challenge.pin.name = Vezave
challenge.pin.desc = Figura, ki se ne more premakniti, ne da bi izgubila tisto, kar stoji za njo.
challenge.pin.detail = Figuro vežite na njenega kralja ali na dragocenejšo figuro, nato jo še enkrat napadite ali izkoristite to, da se ne more premakniti.
challenge.skewer.name = Ražnji
challenge.skewer.desc = Napadite dragoceno figuro in pridobite tisto za njo.
challenge.skewer.detail = Obratno kot pri vezavi: dragocenejša figura stoji spredaj, se mora umakniti in odkrije figuro za seboj.
challenge.discovered.name = Odkriti napadi
challenge.discovered.desc = Premaknite eno figuro, da sprostite drugo.
challenge.discovered.detail = Ko se figura umakne s poti, napade figura za njo. S šahom ali dvojnim šahom nasprotnik nima časa odgovoriti na obe grožnji.
challenge.deflection.name = Odvračanje in privabljanje
challenge.deflection.desc = Odvrnite branilca ali ga zvabite na usodno polje.
challenge.deflection.detail = Branilec, ki ima dve nalogi, ne more opraviti obeh. Napadite ga, mu kaj ponudite ali figuro prisilite na polje, kjer bo izgubljena.
challenge.intermezzo.name = Vmesne poteze
challenge.intermezzo.desc = Ne jemljite takoj nazaj: obstaja nekaj močnejšega.
challenge.intermezzo.detail = Šah ali večja grožnja vmes, pred pričakovano potezo, spremeni vse.
challenge.trapped.name = Ujete figure
challenge.trapped.desc = Figura brez varnega polja.
challenge.trapped.detail = Figuri odvzemite zadnja polja za umik, nato jo pridobite.
challenge.promotion.name = Promocija
challenge.promotion.desc = Prebijte se s kmetom do zadnje vrste.
challenge.promotion.detail = Daleč prodrli kmeti so veliko vredni. Očistite pot, odvrnite figure, ki jih zapirajo, in naredite novo damo.
challenge.quiet.name = Tihe poteze
challenge.quiet.desc = Zmagovita poteza ni ne šah ne jemanje.
challenge.quiet.detail = Včasih najmočnejša poteza le pripravi grožnjo, ki je ni mogoče odbiti. Take poteze je najteže opaziti.
challenge.opening.name = Pasti v otvoritvi
challenge.opening.desc = Kaznujte zgodnje napake.
challenge.opening.detail = Pozicije iz prvih potez resničnih partij, kjer je eno nepremišljeno potezo mogoče takoj izkoristiti.
challenge.escape.name = Poiščite izhod
challenge.escape.desc = Vaš kralj je v nevarnosti: reši ga ena sama poteza.
challenge.escape.detail = Vsaka druga poteza izgubi. Preglejte vse šahe in grožnje proti svojemu kralju, nato poiščite edini izhod.
challenge.defend.name = Obrambne poteze
challenge.defend.desc = Odbijte grožnjo brez izgube materiala.
challenge.defend.detail = Trener ustvari grožnjo. Poiščite natančno potezo, ki vse drži skupaj.
challenge.kq.name = Dama in kralj proti kralju
challenge.kq.desc = Mat z damo.
challenge.kq.detail = Z damo potisnite osamljenega kralja na rob, pripeljite bližje svojega kralja in pazite na pat. Trener se brani z najboljšimi potezami.
challenge.kr.name = Trdnjava in kralj proti kralju
challenge.kr.desc = Mat s trdnjavo.
challenge.kr.detail = Trdnjava odreže kralja, vrsto za vrsto; vaš kralj zavzame opozicijo. Trener se brani z najboljšimi potezami.
challenge.kp.name = Kralj in kmet proti kralju
challenge.kp.desc = Osvojite opozicijo in izvedite promocijo.
challenge.kp.detail = Vodite s kraljem, ne s kmetom. Zavzemite opozicijo in naredite damo, ki je trener ne more ujeti.
challenge.kp_hold.name = Ustavite kmeta
challenge.kp_hold.desc = Osamljeni kralj proti kralju in kmetu: ubranite remi.
challenge.kp_hold.detail = Postavite se pred kmeta in obdržite opozicijo. Zdržite deset potez.
challenge.rook.name = Trdnjavske končnice
challenge.rook.desc = Lucenov most in Philidorjeva obramba.
challenge.rook.detail = Dve poziciji, ki ju mora poznati vsak igralec: kako zmagati s kmetom na sedmi vrsti in kako se braniti s trdnjavo na tretji.
challenge.endgame.name = Taktika v končnici
challenge.endgame.desc = Malo figur, ostre zamisli.
challenge.endgame.detail = Kmečke dirke, preboji in trdnjavske končnice iz resničnih partij.
# The column of the selected challenge. {0} = the number of positions in the set
