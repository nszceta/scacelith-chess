coach.challenge.done = Opravljeno
coach.challenge.start = Začni
coach.challenge.note.white = Igrate z belimi; trener vsako pozicijo postavi na šahovnico.
coach.challenge.note.hint = Ne najdete rešitve? Za namig pritisnite H. Po nekaj poskusih vam ga trener ponudi sam.
coach.challenge.note.unsaved = Izzivi ne štejejo za rating in se ne shranjujejo; kljukica označuje opravljene.
