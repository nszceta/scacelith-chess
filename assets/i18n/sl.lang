coach.skip = Preskoči
coach.offer.title = VRNITEV POTEZE?
coach.offer.text = Trener vam ponuja, da vrnete zadnjo potezo in poiščete boljšo.
coach.offer.hint = Tipka vračalka potezo vrne. Dotik figure nadaljuje igro.
coach.offer.accept = Vrni potezo
coach.offer.decline = Igraj naprej
