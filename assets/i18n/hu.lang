# Each challenge (assets/coach/challenges/challenges.txt): a name, a one-line description (about 60
# characters) and a paragraph for the column of the selected challenge. Names are nouns, as the
# menu entries.
challenge.mate1.name = Matt egy lépésben
challenge.mate1.desc = Egy lépés, és matt.
challenge.mate1.detail = Először nézzen meg minden sakkot: az egyik után a királynak nincs menekülőmezője, nem lehet közbelépni, és a sakkot adó bábut sem lehet leütni.
challenge.mate2.name = Matt két lépésben
challenge.mate2.desc = Egy lépés, amely ellen nincs védekezés, aztán matt.
challenge.mate2.detail = Az első lépés gyakran sakk vagy áldozat, amely elvesz egy mezőt a királytól. Az edző a lehető legjobban védekezik.
challenge.mate3.name = Matt három lépésben
challenge.mate3.desc = Hosszabb kényszerítő változatok.
challenge.mate3.detail = Sakkok, ütések és fenyegetések, három lépés mélységben. Mielőtt megérint egy bábut, minden lépésnél számolja ki az edző legjobb válaszát.
challenge.backrank.name = Alapsormattok
challenge.backrank.desc = A saját gyalogjai mögé szorult király.
challenge.backrank.detail = Ha a sáncolt király előtti gyalogok még nem léptek, egy bástya vagy egy vezér az utolsó soron mattot adhat. Előbb távolítsa el vagy terelje el a védőket.
challenge.patterns.name = Mattképek
challenge.patterns.desc = Fojtott matt, Anasztázia-matt, arab matt és más klasszikusok.
challenge.patterns.detail = Híres matthálók, amelyek újra meg újra előfordulnak. Tanulja meg felismerni a bábuk elrendezését és a döntő csapást.
challenge.hanging.name = Védtelen bábuk
challenge.hanging.desc = Vegye észre, mi maradt védelem nélkül.
challenge.hanging.detail = Azt a tisztet vagy gyalogot, amelyet senki sem véd, egyszerűen le lehet ütni. Nézze meg, mi védi az edző egyes bábuit.
challenge.fork.name = Villák
challenge.fork.desc = Egy bábu egyszerre kettőt támad.
challenge.fork.detail = Huszár, gyalog, vezér, sőt király is adhat villát. Az ellenfél a két célpont közül csak az egyiket mentheti meg.
challenge.pin.name = Kötések
challenge.pin.desc = Bábu, amely nem léphet el anélkül, hogy a mögötte álló el ne vesszen.
challenge.pin.detail = Kösse le a bábut a királyához vagy egy értékesebb bábuhoz, aztán támadja meg még egyszer, vagy használja ki, hogy nem léphet el.
challenge.skewer.name = Nyársak
challenge.skewer.desc = Támadjon meg egy értékes bábut, és nyerje el a mögötte állót.
challenge.skewer.detail = A kötés fordítottja: az értékesebb bábu áll elöl, el kell lépnie, és szabaddá teszi a mögötte álló bábut.
challenge.discovered.name = Felfedett támadások
challenge.discovered.desc = Lépjen el egy bábuval, hogy szabad utat adjon egy másiknak.
challenge.discovered.detail = Amikor egy bábu kilép egy vonalból, a mögötte álló bábu támad. Sakkal vagy kettős sakkal az ellenfélnek nincs ideje mindkét fenyegetésre válaszolni.
challenge.deflection.name = Eltérítés és odacsalás
challenge.deflection.desc = Csalja el a védőt, vagy csalja végzetes mezőre.
challenge.deflection.detail = Az a védő, amelynek két feladata van, nem tudja mindkettőt ellátni. Támadja meg, kínáljon fel neki valamit, vagy kényszerítsen egy bábut arra a mezőre, ahol elvész.
challenge.intermezzo.name = Közbeiktatott lépések
challenge.intermezzo.desc = Ne üssön vissza azonnal: van erősebb lépés.
challenge.intermezzo.detail = A várt lépés előtt egy közbeiktatott sakk vagy nagyobb fenyegetés mindent megváltoztat.
challenge.trapped.name = Csapdába esett bábuk
challenge.trapped.desc = Bábu, amelynek nem maradt biztonságos mezője.
challenge.trapped.detail = Vegye el egy bábu utolsó menekülőmezőit, aztán nyerje el.
challenge.promotion.name = Átváltozás
challenge.promotion.desc = Juttasson el egy gyalogot az utolsó sorig.
challenge.promotion.detail = Az előretolt gyalogok sokat érnek. Tegye szabaddá az utat, térítse el az útjukat elzáró bábukat, és szerezzen új vezért.
challenge.quiet.name = Csendes lépések
challenge.quiet.desc = A nyerő lépés se nem sakk, se nem ütés.
challenge.quiet.detail = Néha a legerősebb lépés csak előkészít egy kivédhetetlen fenyegetést. Ezt a legnehezebb észrevenni.
challenge.opening.name = Megnyitási csapdák
challenge.opening.desc = Büntesse meg a korai hibákat.
challenge.opening.detail = Állások valódi játszmák első lépéseiből, ahol egy figyelmetlen lépés azonnal kihasználható.
challenge.escape.name = Kiút keresése
challenge.escape.desc = A királya veszélyben van: egyetlen lépés menti meg.
challenge.escape.detail = Minden más lépés veszít. Nézze meg az összes sakkot és fenyegetést a királya ellen, majd találja meg az egyetlen kiutat.
challenge.defend.name = Védekező lépések
challenge.defend.desc = Hárítsa a fenyegetést anyagvesztés nélkül.
challenge.defend.detail = Az edző valamivel fenyeget. Találja meg azt a pontos lépést, amellyel minden egyben marad.
challenge.kq.name = Vezér és király a magányos király ellen
challenge.kq.desc = Matt a vezérrel.
challenge.kq.detail = Szorítsa a magányos királyt a tábla szélére a vezérével, hozza közelebb a saját királyát, és vigyázzon a pattra. Az edző a legjobb lépéseivel védekezik.
challenge.kr.name = Bástya és király a magányos király ellen
challenge.kr.desc = Matt a bástyával.
challenge.kr.detail = A bástya sorról sorra elvágja a királyt; az Ön királya elfoglalja az oppozíciót. Az edző a legjobb lépéseivel védekezik.
challenge.kp.name = Király és gyalog a magányos király ellen
challenge.kp.desc = Szerezze meg az oppozíciót, és változtassa át a gyalogot.
challenge.kp.detail = A királlyal vezessen, ne a gyaloggal. Foglalja el az oppozíciót, és változtassa vezérré a gyalogot úgy, hogy az edző ne érhesse utol.
challenge.kp_hold.name = A gyalog megállítása
challenge.kp_hold.desc = Magányos király gyalog és király ellen: tartsa a döntetlent.
challenge.kp_hold.detail = Álljon a gyalog elé, és tartsa meg az oppozíciót. Tartson ki tíz lépésen át.
challenge.rook.name = Bástyavégjátékok
challenge.rook.desc = A Lucena-híd és a Philidor-védelem.
challenge.rook.detail = A két állás, amelyet minden játékosnak ismernie kell: hogyan lehet nyerni a hetedik soron álló gyaloggal, és hogyan lehet védekezni a harmadik soron álló bástyával.
challenge.endgame.name = Végjátéktaktika
challenge.endgame.desc = Kevés bábu, éles ötletek.
challenge.endgame.detail = Gyalogversenyek, áttörések és bástyavégjátékok valódi játszmákból.
# The column of the selected challenge. {0} = the number of positions in the set
coach.challenge.positions = {0} állás|{0} állás
coach.challenge.done = Teljesítve
coach.challenge.start = Kezdés
coach.challenge.note.white = Ön világossal játszik; az edző minden állást felállít a táblán.
coach.challenge.note.hint = Elakadt? Tippért nyomja meg a H billentyűt. Néhány próbálkozás után az edző maga ajánl fel egyet.
coach.challenge.note.unsaved = A kihívások nem értékeltek, és nem mentődnek; pipa jelzi a már teljesítetteket.
# At the table: the band at the top, after the challenge's name. {0} = the position being solved, {1} = the number of positions
