coach.challenge.done = Selesai
coach.challenge.start = Mulai
coach.challenge.note.white = Anda bermain sebagai Putih; pelatih menyiapkan setiap posisi di papan.
coach.challenge.note.hint = Buntu? Tekan H untuk petunjuk. Setelah beberapa percobaan, pelatih akan menawarkannya.
coach.challenge.note.unsaved = Tantangan tidak dinilai atau disimpan; tanda centang menunjukkan tantangan yang sudah Anda selesaikan.
# At the table: the band at the top, after the challenge's name. {0} = the position being solved, {1} = the number of positions
