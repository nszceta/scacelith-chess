challenge.mate3.name = Mat dalam tiga langkah
challenge.mate3.desc = Variasi paksa yang lebih panjang.
challenge.mate3.detail = Skak, makan, dan ancaman, sedalam tiga langkah. Hitung jawaban terbaik pelatih di setiap langkah sebelum Anda menyentuh buah.
challenge.backrank.name = Mat baris belakang
challenge.backrank.desc = Raja yang terkurung di balik pion-pionnya sendiri.
challenge.backrank.detail = Jika pion-pion di depan raja yang sudah rokade belum bergerak, benteng atau menteri di baris terakhir bisa memberi skakmat. Singkirkan atau alihkan para pelindung terlebih dahulu.
challenge.patterns.name = Pola mat
challenge.patterns.desc = Mat tercekik, mat Anastasia, mat Arab, dan pola klasik lainnya.
challenge.patterns.detail = Jaring mat terkenal yang muncul berulang kali. Belajarlah mengenali susunan buahnya dan pukulan terakhirnya.
challenge.hanging.name = Buah gratis
challenge.hanging.desc = Temukan apa yang dibiarkan tak terlindungi.
challenge.hanging.detail = Buah atau pion yang tidak dilindungi apa pun bisa langsung dimakan. Periksa apa saja yang melindungi setiap buah pelatih.
challenge.fork.name = Garpu
challenge.fork.desc = Satu buah menyerang dua buah sekaligus.
challenge.fork.detail = Kuda, pion, menteri, bahkan raja bisa melakukan garpu. Lawan hanya bisa menyelamatkan salah satu dari dua sasaran.
challenge.pin.name = Kunci
challenge.pin.desc = Buah yang tidak dapat bergerak tanpa kehilangan apa yang ada di belakangnya.
challenge.pin.detail = Kunci sebuah buah ke rajanya atau ke buah yang lebih berharga, lalu serang lagi buah itu, atau manfaatkan kenyataan bahwa buah itu tidak dapat bergerak.
challenge.skewer.name = Tusuk sate
challenge.skewer.desc = Serang buah yang berharga dan menangkan buah di belakangnya.
challenge.skewer.detail = Kebalikan dari kunci: buah yang lebih berharga berada di depan, harus menyingkir, dan membuka buah di belakangnya.
challenge.discovered.name = Serangan tersingkap
challenge.discovered.desc = Gerakkan satu buah untuk melepaskan serangan buah lain.
challenge.discovered.detail = Ketika sebuah buah keluar dari suatu garis, buah di belakangnya menyerang. Dengan skak, atau dengan skak ganda, lawan tidak punya waktu untuk menjawab kedua ancaman.
challenge.deflection.name = Pembelokan dan pancingan
challenge.deflection.desc = Alihkan pelindung, atau pancing buah ke petak yang fatal.
challenge.deflection.detail = Pelindung yang punya dua tugas tidak dapat melakukan keduanya. Serang pelindung itu, tawarkan sesuatu kepadanya, atau paksa sebuah buah ke petak tempat buah itu akan hilang.
challenge.intermezzo.name = Langkah sela
challenge.intermezzo.desc = Jangan langsung memakan kembali: ada yang lebih kuat.
challenge.intermezzo.detail = Sebelum langkah yang diharapkan, sebuah skak atau ancaman yang lebih besar yang diselipkan di antaranya mengubah segalanya.
challenge.trapped.name = Buah terjebak
challenge.trapped.desc = Buah yang tidak lagi punya petak aman.
challenge.trapped.detail = Rampas petak pelarian terakhir sebuah buah, lalu menangkan buah itu.
challenge.promotion.name = Promosi
challenge.promotion.desc = Majukan pion hingga ke baris terakhir.
challenge.promotion.detail = Pion yang sudah maju jauh sangat berharga. Bersihkan jalannya, singkirkan para penghadang, dan buat menteri baru.
challenge.quiet.name = Langkah tenang
challenge.quiet.desc = Langkah yang menang bukanlah skak, bukan pula memakan.
challenge.quiet.detail = Terkadang langkah terkuat hanya menyiapkan ancaman yang tidak dapat ditangkis. Jenis yang paling sulit dilihat.
challenge.opening.name = Jebakan pembukaan
challenge.opening.desc = Hukum kesalahan di awal permainan.
challenge.opening.detail = Posisi dari langkah-langkah pertama permainan sungguhan, tempat satu langkah ceroboh bisa langsung dimanfaatkan.
challenge.escape.name = Temukan jalan keluar
challenge.escape.desc = Raja Anda dalam bahaya: satu langkah menyelamatkannya.
challenge.escape.detail = Semua langkah lain kalah. Periksa semua skak dan ancaman terhadap raja Anda, lalu temukan satu-satunya jalan keluar.
challenge.defend.name = Langkah bertahan
challenge.defend.desc = Tangkis ancaman tanpa kehilangan materi.
challenge.defend.detail = Pelatih mengancam sesuatu. Temukan langkah tepat yang menjaga semuanya tetap utuh.
challenge.kq.name = Menteri dan raja melawan raja
challenge.kq.desc = Skakmat dengan menteri.
challenge.kq.detail = Desak raja yang sendirian ke tepi dengan menteri Anda, dekatkan raja Anda sendiri, dan waspadai pat. Pelatih bertahan dengan langkah-langkah terbaiknya.
challenge.kr.name = Benteng dan raja melawan raja
challenge.kr.desc = Skakmat dengan benteng.
challenge.kr.detail = Benteng memotong jalan raja, baris demi baris; raja Anda mengambil oposisi. Pelatih bertahan dengan langkah-langkah terbaiknya.
challenge.kp.name = Raja dan pion melawan raja
challenge.kp.desc = Rebut oposisi dan lakukan promosi.
challenge.kp.detail = Majulah dengan raja Anda di depan, bukan pionnya. Ambil oposisi dan buat menteri yang tidak dapat dikejar pelatih.
challenge.kp_hold.name = Hentikan pion
challenge.kp_hold.desc = Raja sendirian melawan raja dan pion: pertahankan remis.
challenge.kp_hold.detail = Berdirilah di depan pion dan pertahankan oposisi. Bertahanlah selama sepuluh langkah.
challenge.rook.name = Permainan akhir benteng
challenge.rook.desc = Jembatan Lucena dan pertahanan Philidor.
challenge.rook.detail = Dua posisi yang wajib diketahui setiap pemain: cara menang dengan pion di baris ketujuh, dan cara bertahan dengan benteng di baris ketiga.
challenge.endgame.name = Taktik permainan akhir
challenge.endgame.desc = Sedikit buah, ide tajam.
challenge.endgame.detail = Adu cepat pion, terobosan, dan permainan akhir benteng dari permainan sungguhan.
