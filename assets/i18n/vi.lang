coach.level.4.name = Kỳ thủ câu lạc bộ
coach.level.4.desc = Nước đi ứng viên, đánh giá theo đơn vị Tốt.
coach.level.4.detail = Huấn luyện viên cân nhắc các nước đi ứng viên và đưa ra đánh giá theo đơn vị Tốt, như một huấn luyện viên câu lạc bộ.
coach.level.5.name = Kỳ thủ câu lạc bộ mạnh
coach.level.5.desc = Biến ngắn gọn, thuật ngữ thế trận.
coach.level.5.detail = Nhận xét ngắn, các biến cụ thể và thuật ngữ của lối chơi thế trận.
coach.level.6.name = Chuyên gia
coach.level.6.desc = Nhận xét cô đọng, biến sâu, điểm đánh giá bằng số.
coach.level.6.detail = Ít lời, như giữa những kỳ thủ mạnh: các biến sâu nhiều nước và điểm đánh giá bằng con số.
coach.note.clock = Không có đồng hồ: bạn có thể suy nghĩ bao lâu tùy thích.
coach.note.takeback = Sau một sai lầm nghiêm trọng, huấn luyện viên chỉ ra chỗ sai và đề nghị cho bạn đi lại.
coach.note.lesson = Bạn chơi bên Trắng; huấn luyện viên bày từng bài tập lên bàn cờ.
coach.note.unrated = Các ván với huấn luyện viên không được tính điểm.
coach.note.fallible = Huấn luyện viên không phải lúc nào cũng đúng: đôi khi có thể đánh giá sai một nước đi.
coach.colour = Màu quân của bạn
coach.colour.help = Màu quân bạn chơi khi đấu với huấn luyện viên. Luân phiên: Trắng, rồi Đen, từ ván này sang ván sau. Bài học về luật cờ luôn được chơi bên Trắng.
coach.colour.alternate = Luân phiên
coach.take_time = Nhắc "Cứ từ từ"
coach.take_time.help = Sau một phút suy nghĩ, huấn luyện viên sẽ nói rằng bạn không cần vội. Chỉ áp dụng cho cấp độ 1 đến 3.
# Shown when the coach's voice cannot be heard: its model is not downloaded, or Options > Audio > Coach voice is off.
coach.no_voice = Giọng nói của huấn luyện viên chưa được cài đặt hoặc đang tắt (Tùy chọn > Âm thanh): lời của huấn luyện viên sẽ được hiển thị trên màn hình.
# At the table
coach.speaker = HUẤN LUYỆN VIÊN
coach.skip = Bỏ qua
coach.offer.title = ĐI LẠI NƯỚC NÀY?
coach.offer.text = Huấn luyện viên đề nghị cho bạn đi lại nước vừa rồi, để bạn tìm một nước đi hay hơn.
coach.offer.hint = Nhấn Backspace để đi lại. Chạm vào một quân để chơi tiếp.
coach.offer.accept = Đi lại
coach.offer.decline = Chơi tiếp
# Levels 4-6: the coach's takeback offers the player may still accept this game (bottom corner
