coach.takebacks_left = Số lần đi lại còn lại: {0}
coach.pause.take_back = Đi lại nước của tôi
coach.pause.take_back.help = Đi lại nước vừa rồi của bạn, và cả nước đáp của huấn luyện viên nếu đã đi.
coach.confirm.resign = Xin thua ván này? Huấn luyện viên sẽ được xử thắng.
coach.confirm.resign_draw = Xin thua ván này? Huấn luyện viên không còn khả năng chiếu hết: ván cờ sẽ được xử hòa.
coach.confirm.leave = Quay về menu chính? Ván cờ với huấn luyện viên sẽ bị bỏ dở.
# Game over card of a coach game, and the end of the lesson on the rules
coach.gameover.again = Chơi lại
coach.gameover.unrated = Ván cờ với huấn luyện viên không được tính điểm.
coach.lesson.done = GIỎI LẮM
coach.lesson.done.line = Giờ bạn đã biết luật cờ vua.
coach.lesson.next = Ván đầu tiên

# ---- Coach challenges (src/ui/ui_coach.cpp; the coach's spoken lines are in assets/coach/speech/<lang>/challenge.lang)
# The tabs of the Coach page: games with the coach, and short sets of positions to solve
coach.tab.training = Luyện tập
coach.tab.challenges = Thử thách
# Group headings of the list (capitals: section headings)
challenge.group.mates = CHIẾU HẾT
challenge.group.tactics = CHIẾN THUẬT
challenge.group.defence = PHÒNG THỦ
challenge.group.endgames = TÀN CUỘC
# Each challenge (assets/coach/challenges/challenges.txt): a name, a one-line description (about 60
# characters) and a paragraph for the column of the selected challenge
challenge.mate1.name = Chiếu hết sau một nước
challenge.mate1.desc = Một nước đi, và đó là chiếu hết.
challenge.mate1.detail = Hãy xem xét mọi nước chiếu trước tiên: một trong số đó khiến Vua không còn ô để chạy, không thể chặn và không thể bắt quân chiếu.
challenge.mate2.name = Chiếu hết sau hai nước
challenge.mate2.desc = Một nước đi khiến đối phương hết cách phòng thủ, rồi chiếu hết.
challenge.mate2.detail = Nước đầu tiên thường là một nước chiếu hoặc một nước thí quân lấy đi một ô của Vua. Huấn luyện viên phòng thủ hết sức có thể.
challenge.mate3.name = Chiếu hết sau ba nước
challenge.mate3.desc = Những biến cưỡng bức dài hơn.
challenge.mate3.detail = Chiếu, bắt quân và đe dọa, sâu ba nước. Hãy tính nước đáp tốt nhất của huấn luyện viên ở mỗi bước trước khi chạm vào quân.
challenge.backrank.name = Chiếu hết ở hàng cuối
challenge.backrank.desc = Vua bị nhốt sau chính các con Tốt của mình.
challenge.backrank.detail = Khi các con Tốt trước con Vua đã nhập thành vẫn chưa di chuyển, một con Xe hoặc Hậu ở hàng cuối có thể chiếu hết. Hãy loại bỏ hoặc đánh lạc hướng các quân phòng thủ trước.
challenge.patterns.name = Các mẫu chiếu hết
challenge.patterns.desc = Chiếu hết ngạt thở, thế Anastasia, Ả Rập và các thế kinh điển khác.
challenge.patterns.detail = Những mạng lưới chiếu hết nổi tiếng xuất hiện hết lần này đến lần khác. Hãy học cách nhận ra cách bố trí các quân và đòn kết liễu.
challenge.hanging.name = Quân cho không
challenge.hanging.desc = Phát hiện những quân không được bảo vệ.
challenge.hanging.detail = Một quân hay một con Tốt không được bảo vệ có thể bị bắt ngay. Hãy kiểm tra xem mỗi quân của huấn luyện viên được những quân nào bảo vệ.
challenge.fork.name = Đòn chĩa đôi
challenge.fork.desc = Một quân tấn công hai quân cùng lúc.
challenge.fork.detail = Mã, Tốt, Hậu và cả Vua đều có thể chĩa đôi. Đối thủ chỉ cứu được một trong hai mục tiêu.
challenge.pin.name = Đòn ghim
challenge.pin.desc = Một quân không thể di chuyển mà không làm mất quân đứng sau nó.
challenge.pin.detail = Hãy ghim một quân vào Vua hoặc vào một quân giá trị hơn, rồi tấn công nó thêm lần nữa, hoặc tận dụng việc nó không thể di chuyển.
challenge.skewer.name = Đòn xiên
challenge.skewer.desc = Tấn công một quân giá trị và ăn quân đứng sau nó.
challenge.skewer.detail = Ngược lại với đòn ghim: quân giá trị hơn đứng phía trước, buộc phải tránh đi, và để lộ quân đứng sau.
challenge.discovered.name = Đòn tấn công mở
challenge.discovered.desc = Di chuyển một quân để mở đường cho quân khác.
challenge.discovered.detail = Khi một quân rời khỏi một đường, quân đứng sau nó sẽ tấn công. Kèm theo nước chiếu, hoặc chiếu đôi, đối thủ không có thời gian đối phó cả hai mối đe dọa.
challenge.deflection.name = Đánh lạc hướng và dụ quân
challenge.deflection.desc = Kéo quân phòng thủ đi chỗ khác, hoặc dụ nó vào một ô chết người.
challenge.deflection.detail = Một quân phòng thủ có hai nhiệm vụ thì không làm tròn được cả hai. Hãy tấn công nó, đưa mồi cho nó, hoặc buộc một quân phải vào ô mà nó sẽ bị mất.
challenge.intermezzo.name = Nước trung gian
challenge.intermezzo.desc = Đừng bắt lại ngay: có nước mạnh hơn.
challenge.intermezzo.detail = Trước nước đi mà ai cũng chờ đợi, một nước chiếu hoặc một mối đe dọa lớn hơn chen vào giữa sẽ thay đổi tất cả.
challenge.trapped.name = Quân bị nhốt
challenge.trapped.desc = Một quân không còn ô an toàn nào.
challenge.trapped.detail = Lấy đi những ô thoát cuối cùng của một quân, rồi ăn quân đó.
challenge.promotion.name = Phong cấp
challenge.promotion.desc = Đưa một con Tốt tiến tới hàng cuối.
challenge.promotion.detail = Những con Tốt đã tiến xa rất có giá trị. Hãy dọn đường, đánh lạc hướng các quân cản, và tạo ra một Hậu mới.
challenge.quiet.name = Nước đi lặng
challenge.quiet.desc = Nước thắng không phải nước chiếu, cũng không phải nước bắt quân.
challenge.quiet.detail = Đôi khi nước mạnh nhất chỉ chuẩn bị một mối đe dọa không thể ngăn chặn. Đây là loại nước khó thấy nhất.
challenge.opening.name = Bẫy khai cuộc
challenge.opening.desc = Trừng phạt những sai lầm sớm.
challenge.opening.detail = Các thế cờ từ những nước đầu tiên của các ván đấu thật, nơi một nước đi bất cẩn có thể bị khai thác ngay lập tức.
challenge.escape.name = Tìm lối thoát
challenge.escape.desc = Vua của bạn gặp nguy: một nước đi sẽ cứu nó.
challenge.escape.detail = Mọi nước khác đều thua. Hãy xem xét tất cả các nước chiếu và mối đe dọa nhắm vào Vua của bạn, rồi tìm lối thoát duy nhất.
challenge.defend.name = Nước phòng thủ
challenge.defend.desc = Ngăn chặn mối đe dọa mà không mất lực lượng.
challenge.defend.detail = Huấn luyện viên đang đe dọa điều gì đó. Hãy tìm nước đi chính xác giữ cho mọi thứ vững chắc.
challenge.kq.name = Hậu và Vua đấu Vua
challenge.kq.desc = Chiếu hết bằng Hậu.
challenge.kq.detail = Dùng Hậu dồn Vua đơn độc ra mép bàn cờ, đưa Vua của bạn lại gần, và coi chừng thế hết nước đi. Huấn luyện viên phòng thủ bằng những nước tốt nhất.
challenge.kr.name = Xe và Vua đấu Vua
challenge.kr.desc = Chiếu hết bằng Xe.
challenge.kr.detail = Con Xe cắt đường Vua đối phương, từng hàng một; Vua của bạn giành thế đối Vua. Huấn luyện viên phòng thủ bằng những nước tốt nhất.
challenge.kp.name = Vua và Tốt đấu Vua
challenge.kp.desc = Giành thế đối Vua và phong cấp.
challenge.kp.detail = Hãy dẫn đường bằng Vua, không phải bằng Tốt. Giành thế đối Vua và phong Hậu mà huấn luyện viên không kịp ngăn cản.
challenge.kp_hold.name = Chặn Tốt
challenge.kp_hold.desc = Vua đơn độc chống Vua và Tốt: giữ hòa.
challenge.kp_hold.detail = Đứng chắn trước con Tốt và giữ thế đối Vua. Cầm cự trong mười nước.
challenge.rook.name = Tàn cuộc Xe
challenge.rook.desc = Thế bắc cầu Lucena và thế phòng thủ Philidor.
challenge.rook.detail = Hai thế cờ mà mọi người chơi đều nên biết: cách thắng với con Tốt ở hàng bảy, và cách phòng thủ với con Xe ở hàng ba.
challenge.endgame.name = Chiến thuật tàn cuộc
challenge.endgame.desc = Ít quân, ý tưởng sắc bén.
challenge.endgame.detail = Đua Tốt, đột phá và tàn cuộc Xe từ các ván đấu thật.
# The column of the selected challenge. {0} = the number of positions in the set
coach.challenge.positions = {0} thế cờ
coach.challenge.done = Đã hoàn thành
coach.challenge.start = Bắt đầu
coach.challenge.note.white = Bạn chơi bên Trắng; huấn luyện viên bày từng thế cờ lên bàn cờ.
coach.challenge.note.hint = Bí nước? Nhấn H để xem gợi ý. Sau vài lần thử, huấn luyện viên sẽ đề nghị gợi ý cho bạn.
coach.challenge.note.unsaved = Thử thách không được tính điểm hay lưu lại; dấu tích cho biết những thử thách bạn đã hoàn thành.
# At the table: the band at the top, after the challenge's name. {0} = the position being solved, {1} = the number of positions
coach.challenge.progress = {0} / {1}
# The card at the end of a challenge
coach.challenge.complete = HOÀN THÀNH THỬ THÁCH
coach.challenge.complete.line = Bạn đã giải được mọi thế cờ.
coach.challenge.next = Thử thách tiếp theo
coach.challenge.again = Làm lại
# The coach's offer of a hint (a card like the takeback offer), and the key cap of the hint at the bottom of the screen
coach.hint.title = XEM GỢI Ý?
coach.hint.text = Huấn luyện viên đề nghị cho bạn một gợi ý.
coach.hint.hint = Nhấn H để xem gợi ý. Chạm vào một quân để tiếp tục tự tìm.
coach.hint.accept = Gợi ý
coach.hint.decline = Không, cảm ơn
coach.hint.key = Gợi ý

