# Each challenge (assets/coach/challenges/challenges.txt): a name, a one-line description (about 60
# characters) and a paragraph for the column of the selected challenge
challenge.mate1.name = Tek hamlede mat
challenge.mate1.desc = Tek bir hamle ve şah mat.
challenge.mate1.detail = Önce şah çeken bütün hamlelere bakın: biri, şaha ne kaçacak kare, ne araya taş koyma ne de alma imkânı bırakır.
challenge.mate2.name = İki hamlede mat
challenge.mate2.desc = Savunma bırakmayan bir hamle, ardından mat.
challenge.mate2.detail = İlk hamle çoğu zaman şahın elinden bir kareyi alan bir şah çekme ya da bir fedadır. Eğitmen elinden geldiğince iyi savunur.
challenge.mate3.name = Üç hamlede mat
challenge.mate3.desc = Daha uzun zorlayıcı varyantlar.
challenge.mate3.detail = Üç hamle derinliğinde şahlar, taş almalar ve tehditler. Bir taşa dokunmadan önce her adımda eğitmenin en iyi cevabını hesaplayın.
challenge.backrank.name = Koridor matları
challenge.backrank.desc = Kendi piyonlarının arkasında sıkışmış bir şah.
challenge.backrank.detail = Rok atmış bir şahın önündeki piyonlar hiç oynamamışsa son yataydaki bir kale ya da vezir mat edebilir. Önce savunucuları ortadan kaldırın ya da başka yere çekin.
challenge.patterns.name = Mat kalıpları
challenge.patterns.desc = Boğulmuş mat, Anastasia matı, Arap matı ve diğer klasikler.
challenge.patterns.detail = Tekrar tekrar karşınıza çıkan ünlü mat ağları. Taşların dizilişini ve son darbeyi tanımayı öğrenin.
challenge.hanging.name = Bedava taşlar
challenge.hanging.desc = Korumasız kalanı bulun.
challenge.hanging.detail = Kimsenin korumadığı bir taş ya da piyon kolayca alınabilir. Eğitmenin her taşını hangi taşların koruduğuna bakın.
challenge.fork.name = Çatallar
challenge.fork.desc = Bir taş aynı anda iki taşa saldırır.
challenge.fork.detail = Atlar, piyonlar, vezirler, hatta şahlar çatal yapabilir. Rakip iki hedeften yalnızca birini kurtarabilir.
challenge.pin.name = Açmazlar
challenge.pin.desc = Arkasındakini kaybetmeden hareket edemeyen bir taş.
challenge.pin.detail = Bir taşı şahına ya da daha değerli bir taşa karşı açmaza alın, sonra ona yeniden saldırın ya da hareket edememesinden yararlanın.
challenge.skewer.name = Şişler
challenge.skewer.desc = Değerli bir taşa saldırın ve arkasındakini kazanın.
challenge.skewer.detail = Açmazın tersi: daha değerli taş öndedir, çekilmek zorundadır ve arkasındaki taşı açıkta bırakır.
challenge.discovered.name = Açarak saldırılar
challenge.discovered.desc = Bir taşı oynayarak başka bir taşın önünü açın.
challenge.discovered.detail = Bir taş bir hattan çekildiğinde arkasındaki taş saldırıya geçer. Bu bir şahla ya da çifte şahla olursa rakibin iki tehdide birden cevap verecek zamanı olmaz.
challenge.deflection.name = Saptırma ve cezbetme
challenge.deflection.desc = Bir savunucuyu uzaklaştırın ya da ölümcül bir kareye çekin.
challenge.deflection.detail = İki görevi olan bir savunucu ikisini birden yapamaz. Ona saldırın, ona bir şey sunun ya da bir taşı kaybedileceği kareye gitmeye zorlayın.
challenge.intermezzo.name = Ara hamleler
challenge.intermezzo.desc = Taşı hemen geri almayın: daha güçlü bir şey var.
challenge.intermezzo.detail = Beklenen hamleden önce araya giren bir şah ya da daha büyük bir tehdit her şeyi değiştirir.
challenge.trapped.name = Kapana kısılmış taşlar
challenge.trapped.desc = Gidecek güvenli karesi kalmamış bir taş.
challenge.trapped.detail = Bir taşın son kaçış karelerini elinden alın, sonra onu kazanın.
challenge.promotion.name = Terfi
challenge.promotion.desc = Bir piyonu son yataya kadar sürün.
challenge.promotion.detail = İlerlemiş piyonlar çok değerlidir. Yolu açın, önünü kesen taşları saptırın ve yeni bir vezir çıkarın.
challenge.quiet.name = Sessiz hamleler
challenge.quiet.desc = Kazandıran hamle ne şah ne de taş alma.
challenge.quiet.detail = Bazen en güçlü hamle yalnızca karşılanamayacak bir tehdit hazırlar. Görülmesi en zor hamle türüdür.
challenge.opening.name = Açılış tuzakları
challenge.opening.desc = Erken hataları cezalandırın.
challenge.opening.detail = Tek bir dikkatsiz hamlenin hemen değerlendirilebildiği, gerçek oyunların ilk hamlelerinden pozisyonlar.
challenge.escape.name = Kaçış yolunu bul
challenge.escape.desc = Şahınız tehlikede: onu tek bir hamle kurtarır.
challenge.escape.detail = Diğer bütün hamleler kaybettirir. Şahınıza yönelik bütün şahlara ve tehditlere bakın, sonra tek çıkış yolunu bulun.
challenge.defend.name = Savunma hamleleri
challenge.defend.desc = Materyal kaybetmeden tehdidi karşılayın.
challenge.defend.detail = Eğitmen bir şeyi tehdit ediyor. Her şeyi bir arada tutan kesin hamleyi bulun.
challenge.kq.name = Vezir ve şah, şaha karşı
challenge.kq.desc = Vezirle mat edin.
challenge.kq.detail = Yalnız kalan şahı vezirinizle kenara itin, kendi şahınızı yaklaştırın ve pata dikkat edin. Eğitmen en iyi hamleleriyle savunur.
challenge.kr.name = Kale ve şah, şaha karşı
challenge.kr.desc = Kaleyle mat edin.
challenge.kr.detail = Kale, şahın yolunu yatay yatay keser; şahınız opozisyonu alır. Eğitmen en iyi hamleleriyle savunur.
challenge.kp.name = Şah ve piyon, şaha karşı
challenge.kp.desc = Opozisyonu kazanın ve terfi edin.
challenge.kp.detail = Piyonla değil, şahınızla önden gidin. Opozisyonu alın ve eğitmenin yakalayamayacağı bir vezir çıkarın.
challenge.kp_hold.name = Piyonu durdur
challenge.kp_hold.desc = Şah ve piyona karşı yalnız şah: beraberliği koruyun.
challenge.kp_hold.detail = Piyonun önünde durun ve opozisyonu koruyun. On hamle dayanın.
challenge.rook.name = Kale oyun sonları
challenge.rook.desc = Lucena köprüsü ve Philidor savunması.
challenge.rook.detail = Her oyuncunun bilmesi gereken iki pozisyon: piyon yedinci yataydayken nasıl kazanılır, kale üçüncü yataydayken nasıl savunulur.
challenge.endgame.name = Oyun sonu taktikleri
challenge.endgame.desc = Az taş, keskin fikirler.
challenge.endgame.detail = Gerçek oyunlardan piyon yarışları, yarmalar ve kale oyun sonları.
# The column of the selected challenge. {0} = the number of positions in the set
coach.challenge.positions = {0} pozisyon|{0} pozisyon
coach.challenge.done = Tamamlandı
coach.challenge.start = Başla
coach.challenge.note.white = Beyaz taşlarla oynarsınız; eğitmen her pozisyonu tahtada kurar.
coach.challenge.note.hint = Takıldınız mı? İpucu için H tuşuna basın. Birkaç denemeden sonra eğitmen size ipucu önerir.
coach.challenge.note.unsaved = Meydan okumalar puanlanmaz ve kaydedilmez; tamamladıklarınızın yanında bir onay işareti görünür.
# At the table: the band at the top, after the challenge's name. {0} = the position being solved, {1} = the number of positions
