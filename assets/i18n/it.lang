# ---- Coach challenges (src/ui/ui_coach.cpp; the coach's spoken lines are in assets/coach/speech/<lang>/challenge.lang)
# The tabs of the Coach page: games with the coach, and short sets of positions to solve
coach.tab.training = Allenamento
coach.tab.challenges = Sfide
# Group headings of the list (capitals: section headings)
challenge.group.mates = MATTI
challenge.group.tactics = TATTICA
challenge.group.defence = DIFESA
challenge.group.endgames = FINALI
# Each challenge (assets/coach/challenges/challenges.txt): a name, a one-line description (about 60
# characters) and a paragraph for the column of the selected challenge
challenge.mate1.name = Matto in una
challenge.mate1.desc = Una mossa, ed è scacco matto.
challenge.mate1.detail = Guarda prima tutti gli scacchi: uno di essi non lascia al re nessuna casa di fuga, nessuna interposizione e nessuna cattura.
challenge.mate2.name = Matto in due
challenge.mate2.desc = Una mossa che non lascia difese, poi il matto.
challenge.mate2.detail = La prima mossa è spesso uno scacco o un sacrificio che toglie una casa al re. L’allenatore si difende meglio che può.
challenge.mate3.name = Matto in tre
challenge.mate3.desc = Varianti forzate più lunghe.
challenge.mate3.detail = Scacchi, catture e minacce, con tre mosse di profondità. Calcola la miglior risposta dell’allenatore a ogni passo prima di toccare un pezzo.
challenge.backrank.name = Matti del corridoio
challenge.backrank.desc = Un re intrappolato dietro i propri pedoni.
challenge.backrank.detail = Quando i pedoni davanti a un re arroccato non si sono mossi, una torre o una donna sull’ultima traversa può dare scacco matto. Prima elimina o distrai i difensori.
challenge.patterns.name = Schemi di matto
challenge.patterns.desc = Matto affogato, di Anastasia, arabo e altri classici.
challenge.patterns.detail = Famose reti di matto che ritornano di continuo. Impara a riconoscere la disposizione dei pezzi e il colpo finale.
challenge.hanging.name = Pezzi in presa
challenge.hanging.desc = Trova ciò che è rimasto senza protezione.
challenge.hanging.detail = Un pezzo o un pedone che nessuno difende si può semplicemente prendere. Controlla da cosa è protetto ogni pezzo dell’allenatore.
challenge.fork.name = Forchette
challenge.fork.desc = Un pezzo ne attacca due contemporaneamente.
challenge.fork.detail = Cavalli, pedoni, donne e persino re possono fare una forchetta. L’avversario può salvare solo uno dei due bersagli.
challenge.pin.name = Inchiodature
challenge.pin.desc = Un pezzo che non può muoversi senza perdere ciò che ha dietro.
challenge.pin.detail = Inchioda un pezzo al suo re o a un pezzo di maggior valore, poi attaccalo di nuovo, o sfrutta il fatto che non può muoversi.
challenge.skewer.name = Infilate
challenge.skewer.desc = Attacca un pezzo di valore e vinci quello che sta dietro.
challenge.skewer.detail = Il contrario dell’inchiodatura: il pezzo di maggior valore sta davanti, deve spostarsi e scopre il pezzo dietro di sé.
challenge.discovered.name = Attacchi di scoperta
challenge.discovered.desc = Muovi un pezzo per scatenarne un altro.
challenge.discovered.detail = Quando un pezzo esce da una linea, il pezzo alle sue spalle attacca. Con uno scacco, o con uno scacco doppio, l’avversario non ha il tempo di parare entrambe le minacce.
challenge.deflection.name = Deviazione e adescamento
challenge.deflection.desc = Allontana un difensore, o attiralo su una casa fatale.
challenge.deflection.detail = Un difensore con due compiti non può svolgerli entrambi. Attaccalo, offrigli qualcosa, o costringi un pezzo sulla casa dove andrà perso.
challenge.intermezzo.name = Mosse intermedie
challenge.intermezzo.desc = Non riprendere subito: c’è qualcosa di più forte.
challenge.intermezzo.detail = Prima della mossa attesa, uno scacco o una minaccia più grande inseriti nel mezzo cambiano tutto.
challenge.trapped.name = Pezzi intrappolati
challenge.trapped.desc = Un pezzo senza più case sicure.
challenge.trapped.detail = Togli a un pezzo le ultime case di fuga, poi vincilo.
challenge.promotion.name = Promozione
challenge.promotion.desc = Porta un pedone fino all’ultima traversa.
challenge.promotion.detail = I pedoni avanzati valgono molto. Libera la strada, devia i pezzi che bloccano e fai una nuova donna.
challenge.quiet.name = Mosse tranquille
challenge.quiet.desc = La mossa vincente non è né uno scacco né una cattura.
challenge.quiet.detail = A volte la mossa più forte prepara semplicemente una minaccia che non si può parare. Il tipo più difficile da vedere.
challenge.opening.name = Trappole d’apertura
challenge.opening.desc = Punisci gli errori precoci.
challenge.opening.detail = Posizioni tratte dalle prime mosse di partite reali, dove una mossa avventata si può sfruttare subito.
challenge.escape.name = Trova la via di fuga
challenge.escape.desc = Il tuo re è in pericolo: una mossa lo salva.
challenge.escape.detail = Ogni altra mossa perde. Guarda tutti gli scacchi e le minacce contro il tuo re, poi trova l’unica via d’uscita.
challenge.defend.name = Mosse difensive
challenge.defend.desc = Para la minaccia senza perdere materiale.
challenge.defend.detail = L’allenatore minaccia qualcosa. Trova la mossa precisa che tiene tutto insieme.
challenge.kq.name = Donna e re contro re
challenge.kq.desc = Scacco matto con la donna.
challenge.kq.detail = Spingi il re solitario verso il bordo con la donna, avvicina il tuo re e fai attenzione allo stallo. L’allenatore si difende con le sue mosse migliori.
challenge.kr.name = Torre e re contro re
challenge.kr.desc = Scacco matto con la torre.
challenge.kr.detail = La torre taglia fuori il re, traversa dopo traversa; il tuo re prende l’opposizione. L’allenatore si difende con le sue mosse migliori.
challenge.kp.name = Re e pedone contro re
challenge.kp.desc = Conquista l’opposizione e promuovi.
challenge.kp.detail = Avanza con il re, non con il pedone. Prendi l’opposizione e fai una donna che l’allenatore non può raggiungere.
challenge.kp_hold.name = Ferma il pedone
challenge.kp_hold.desc = Un re solo contro re e pedone: tieni la patta.
challenge.kp_hold.detail = Mettiti davanti al pedone e mantieni l’opposizione. Resisti per dieci mosse.
challenge.rook.name = Finali di torre
challenge.rook.desc = Il ponte di Lucena e la difesa di Philidor.
challenge.rook.detail = Le due posizioni che ogni giocatore dovrebbe conoscere: come vincere con un pedone in settima traversa e come difendersi con la torre in terza.
challenge.endgame.name = Tattica nei finali
challenge.endgame.desc = Pochi pezzi, idee taglienti.
challenge.endgame.detail = Corse di pedoni, sfondamenti e finali di torre tratti da partite reali.
