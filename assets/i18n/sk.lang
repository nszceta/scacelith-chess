challenge.group.tactics = TAKTIKA
challenge.group.defence = OBRANA
challenge.group.endgames = KONCOVKY
# Each challenge (assets/coach/challenges/challenges.txt): a name, a one-line description (about 60
# characters) and a paragraph for the column of the selected challenge
# "Mate in two" = "Mat 2. ťahom" (read "mat druhým ťahom"), as in Slovak problem books.
challenge.mate1.name = Mat 1. ťahom
challenge.mate1.desc = Jeden ťah a je to mat.
challenge.mate1.detail = Najprv si pozrite všetky šachy: jeden z nich nenechá kráľovi žiadne pole na ústup, žiadne zaclonenie ani branie.
challenge.mate2.name = Mat 2. ťahom
challenge.mate2.desc = Ťah, proti ktorému niet obrany, a potom mat.
challenge.mate2.detail = Prvý ťah je často šach alebo obeť, ktorá kráľovi vezme pole. Tréner sa bráni, ako najlepšie vie.
challenge.mate3.name = Mat 3. ťahom
challenge.mate3.desc = Dlhšie vynútené varianty.
challenge.mate3.detail = Šachy, brania a hrozby tri ťahy do hĺbky. Skôr než sa dotknete figúry, prepočítajte v každom kroku najlepšiu odpoveď trénera.
challenge.backrank.name = Maty na poslednom rade
challenge.backrank.desc = Kráľ uväznený za vlastnými pešiakmi.
challenge.backrank.detail = Keď sa pešiaci pred kráľom po rošáde nepohli, veža alebo dáma na poslednom rade môže dať mat. Najprv odstráňte alebo odlákajte obrancov.
challenge.patterns.name = Typické maty
challenge.patterns.desc = Udusený mat, mat Anastázie, arabský mat a ďalšia klasika.
challenge.patterns.detail = Slávne matové siete, ktoré sa objavujú znova a znova. Naučte sa rozpoznať rozostavenie figúr a záverečný úder.
challenge.hanging.name = Figúry zadarmo
challenge.hanging.desc = Odhaľte, čo zostalo nekryté.
challenge.hanging.detail = Figúru alebo pešiaka, ktorých nikto nebráni, možno jednoducho vziať. Skontrolujte, čím je krytá každá figúra trénera.
challenge.fork.name = Vidličky
challenge.fork.desc = Jedna figúra napáda dve naraz.
challenge.fork.detail = Vidličku môžu urobiť jazdci, pešiaci, dámy, ba aj králi. Súper môže zachrániť iba jeden z dvoch cieľov.
challenge.pin.name = Väzby
challenge.pin.desc = Figúra, ktorá sa nemôže pohnúť bez straty toho, čo stojí za ňou.
challenge.pin.detail = Viažte figúru k jej kráľovi alebo k cennejšej figúre, potom ju znova napadnite alebo využite to, že sa nemôže pohnúť.
challenge.skewer.name = Napichnutia
challenge.skewer.desc = Napadnite cennú figúru a získajte tú, ktorá stojí za ňou.
challenge.skewer.detail = Opak väzby: cennejšia figúra stojí vpredu, musí ustúpiť a odkryje figúru za sebou.
challenge.discovered.name = Odkryté útoky
challenge.discovered.desc = Ťahom jednej figúry uvoľnite inú.
challenge.discovered.detail = Keď figúra opustí líniu, zaútočí figúra, ktorá stojí za ňou. So šachom alebo s dvojitým šachom súper nestihne odpovedať na obe hrozby.
challenge.deflection.name = Odlákanie a prilákanie
challenge.deflection.desc = Odlákajte obrancu alebo prilákajte figúru na osudné pole.
challenge.deflection.detail = Obranca s dvoma úlohami nezvládne obe. Napadnite ho, niečo mu ponúknite alebo prinúťte figúru vstúpiť na pole, kde padne.
challenge.intermezzo.name = Medziťahy
challenge.intermezzo.desc = Neberte hneď späť: je tu niečo silnejšie.
challenge.intermezzo.detail = Pred očakávaným ťahom zmení šach alebo väčšia hrozba všetko.
challenge.trapped.name = Chytené figúry
challenge.trapped.desc = Figúra, ktorej nezostalo žiadne bezpečné pole.
challenge.trapped.detail = Vezmite figúre posledné únikové polia a potom ju získajte.
challenge.promotion.name = Premena
challenge.promotion.desc = Dostaňte pešiaka až na posledný rad.
challenge.promotion.detail = Postúpení pešiaci majú veľkú cenu. Uvoľnite cestu, odlákajte blokujúce figúry a získajte novú dámu.
challenge.quiet.name = Tiché ťahy
challenge.quiet.desc = Víťazný ťah nie je ani šach, ani branie.
challenge.quiet.detail = Niekedy najsilnejší ťah iba pripraví hrozbu, ktorú nemožno odvrátiť. Takýto ťah sa hľadá najťažšie.
challenge.opening.name = Pasce v otvorení
challenge.opening.desc = Potrestajte skoré chyby.
challenge.opening.detail = Pozície z prvých ťahov skutočných partií, v ktorých sa dá jeden neopatrný ťah okamžite využiť.
challenge.escape.name = Nájdite únik
challenge.escape.desc = Váš kráľ je v nebezpečenstve: zachráni ho jediný ťah.
challenge.escape.detail = Každý iný ťah prehráva. Pozrite sa na všetky šachy a hrozby proti vášmu kráľovi a potom nájdite jediné východisko.
challenge.defend.name = Obranné ťahy
challenge.defend.desc = Odvráťte hrozbu bez straty materiálu.
challenge.defend.detail = Tréner niečím hrozí. Nájdite presný ťah, ktorý všetko udrží pohromade.
challenge.kq.name = Dáma a kráľ proti kráľovi
challenge.kq.desc = Mat dámou.
challenge.kq.detail = Zatlačte osamoteného kráľa dámou na okraj, priveďte bližšie svojho kráľa a dajte si pozor na pat. Tréner sa bráni najlepšími ťahmi.
challenge.kr.name = Veža a kráľ proti kráľovi
challenge.kr.desc = Mat vežou.
challenge.kr.detail = Veža odrezáva kráľa rad za radom; váš kráľ zaujme opozíciu. Tréner sa bráni najlepšími ťahmi.
challenge.kp.name = Kráľ a pešiak proti kráľovi
challenge.kp.desc = Získajte opozíciu a premeňte pešiaka.
challenge.kp.detail = Vpredu nech ide kráľ, nie pešiak. Zaujmite opozíciu a premeňte pešiaka na dámu tak, aby ho tréner nemohol chytiť.
challenge.kp_hold.name = Zastavte pešiaka
challenge.kp_hold.desc = Osamotený kráľ proti kráľovi a pešiakovi: udržte remízu.
challenge.kp_hold.detail = Postavte sa pred pešiaka a držte opozíciu. Vydržte desať ťahov.
challenge.rook.name = Vežové koncovky
challenge.rook.desc = Lucenova pozícia a Philidorova obrana.
challenge.rook.detail = Dve pozície, ktoré by mal poznať každý hráč: ako vyhrať s pešiakom na siedmom rade a ako sa brániť s vežou na treťom.
challenge.endgame.name = Taktika v koncovke
challenge.endgame.desc = Málo figúr, ostré nápady.
challenge.endgame.detail = Preteky pešiakov, prieniky a vežové koncovky zo skutočných partií.
# The column of the selected challenge. {0} = the number of positions in the set
coach.challenge.positions = {0} pozícia|{0} pozície|{0} pozícií
coach.challenge.done = Dokončené
coach.challenge.start = Začať
coach.challenge.note.white = Hráte bielymi; tréner rozostaví každú pozíciu na šachovnici.
coach.challenge.note.hint = Neviete si rady? Stlačte H a dostanete nápovedu. Po niekoľkých pokusoch ju tréner ponúkne sám.
coach.challenge.note.unsaved = Výzvy sa nehodnotia ani neukladajú; dokončené výzvy sú označené značkou začiarknutia.
# At the table: the band at the top, after the challenge's name. {0} = the position being solved, {1} = the number of positions
coach.challenge.progress = {0} / {1}
# The card at the end of a challenge
coach.challenge.complete = VÝZVA SPLNENÁ
coach.challenge.complete.line = Vyriešili ste všetky pozície.
coach.challenge.next = Ďalšia výzva
coach.challenge.again = Znova
