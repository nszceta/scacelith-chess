coach.hint.title = NÁPOVEDA?
coach.hint.text = Tréner vám ponúka nápovedu.
coach.hint.hint = H zobrazí nápovedu. Dotykom figúry hľadáte ďalej.
coach.hint.accept = Nápoveda
coach.hint.decline = Nie, ďakujem
coach.hint.key = Nápoveda

